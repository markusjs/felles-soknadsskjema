<li><a href="/forskning/forskningsgrupper/stiftelserogsamfunn/">Forskningsnettverk - Stiftelser og samfunn</a></li>
<li><a href="/forskning/forskningsgrupper/ideaslab/">IDEAS LAB</a></li>
<li><a href="/forskning/forskningsgrupper/ied/">Innovation</a></li>
<li><a href="/forskning/forskningsgrupper/pepp/">Politikk, innovasjon og ledelse</a></li>
<li><a href="/forskning/forskningsgrupper/SEITPedagogy/">SEIT Pedagogy</a></li>
<li><a href="/forskning/forskningsgrupper/SmartSecLab/">Smart Security Lab (SmartSecLab)</a></li>
<li><a href="/forskning/forskningsgrupper/samfunnsokonomi2/"><span>Supply Chain Management (SCM)</span></a></li>
<li><a href="/forskning/forskningsgrupper/ailab/">The AI Lab</a></li>
<li><a href="/forskning/forskningsgrupper/kai-krisitania-ai-senter/">KAI-senteret</a></li>
</ul></div></div></div>

        </div>
    </div>
</section>
</section><section class="Richtext__block">

<div id="6247310d"><div class="T9s2xkF6zj_7pUCGDUHb"><div class="tQw_ZqnEHaMnd30McsXW UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef nuydYi_Wd6zwyeTcuMig" role="none"><div class="aF5b1xTlFkv6HfFub_RV fVpr9NOhprgyM4So4r6u"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/40930c934fb44d748ae88ba694947c60/smartsecurity.jpg?width=375 375w, /contentassets/40930c934fb44d748ae88ba694947c60/smartsecurity.jpg?width=500 500w, /contentassets/40930c934fb44d748ae88ba694947c60/smartsecurity.jpg?width=768 768w, /contentassets/40930c934fb44d748ae88ba694947c60/smartsecurity.jpg?width=1024 1024w"><img src="/contentassets/40930c934fb44d748ae88ba694947c60/smartsecurity.jpg?width=500" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA NyI9CyT88UVrxbfIWHRP"><h2 class="ZiduBuPrxHXQhabvP6SQ">Smart Security Lab</h2><div class="BrxHX8d3IdyRW2EN5wWq">Smart Security Lav forsker på hvordan kunstig intelligens kan forbedre cybersikkerhet og gjøre smarte miljøer sikrere, mer miljøvennlige og bruke mindre strøm.</div><a href="/forskning/forskningsgrupper/SmartSecLab/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['6247310d-json'] = {"image":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[375,500,768,1024],"sizes":["(min-width: 1440px) 768px","(min-width: 768px) 50vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":null,"caption":null,"url":"/contentassets/40930c934fb44d748ae88ba694947c60/smartsecurity.jpg","alt":null,"focalPoint":null,"lazyLoading":true},"imageFitBehavior":"fill","imageAlignment":"left","orientation":"horizontal","contentCardViewModel":{"title":"Smart Security Lab","description":"Smart Security Lav forsker på hvordan kunstig intelligens kan forbedre cybersikkerhet og gjøre smarte miljøer sikrere, mer miljøvennlige og bruke mindre strøm.","callToActionLink":{"label":"Les mer","href":"/forskning/forskningsgrupper/SmartSecLab/","external":false,"showIsExternal":true},"useLegacyLink":false,"variant":"lightTransparent","size":"large","buttonType":"normalButton"}};</script></div>
