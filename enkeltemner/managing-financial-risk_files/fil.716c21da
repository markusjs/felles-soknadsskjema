    </div>
</section>
</section><section class="Richtext__block">

<div id="6fc3ee27"><div class="T9s2xkF6zj_7pUCGDUHb"><div class="tQw_ZqnEHaMnd30McsXW UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef nuydYi_Wd6zwyeTcuMig" role="none"><div class="aF5b1xTlFkv6HfFub_RV fVpr9NOhprgyM4So4r6u"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/0eaa0ef5cd8a416799e2934bfdfed6a6/widai.jpg?width=375 375w, /contentassets/0eaa0ef5cd8a416799e2934bfdfed6a6/widai.jpg?width=500 500w, /contentassets/0eaa0ef5cd8a416799e2934bfdfed6a6/widai.jpg?width=768 768w, /contentassets/0eaa0ef5cd8a416799e2934bfdfed6a6/widai.jpg?width=1024 1024w"><img src="/contentassets/0eaa0ef5cd8a416799e2934bfdfed6a6/widai.jpg?width=500" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA NyI9CyT88UVrxbfIWHRP"><h2 class="ZiduBuPrxHXQhabvP6SQ">Workplace, Inclusion, and Diversity</h2><div class="BrxHX8d3IdyRW2EN5wWq">WID har som formål å fremme mangfold, inkludering og tilhørighet i norske virksomheter gjennom utvikling av forskningsprosjekter av høy kvalitet, aktiv formidling av kunnskap og bygging av sterke faglige nettverk.</div><a href="/forskning/forskningsgrupper/wid-/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['6fc3ee27-json'] = {"image":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[375,500,768,1024],"sizes":["(min-width: 1440px) 768px","(min-width: 768px) 50vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":null,"caption":null,"url":"/contentassets/0eaa0ef5cd8a416799e2934bfdfed6a6/widai.jpg","alt":null,"focalPoint":null,"lazyLoading":true},"imageFitBehavior":"fill","imageAlignment":"left","orientation":"horizontal","contentCardViewModel":{"title":"Workplace, Inclusion, and Diversity","description":"WID har som formål å fremme mangfold, inkludering og tilhørighet i norske virksomheter gjennom utvikling av forskningsprosjekter av høy kvalitet, aktiv formidling av kunnskap og bygging av sterke faglige nettverk.","callToActionLink":{"label":"Les mer","href":"/forskning/forskningsgrupper/wid-/","external":false,"showIsExternal":true},"useLegacyLink":false,"variant":"lightTransparent","size":"large","buttonType":"normalButton"}};</script></div>
