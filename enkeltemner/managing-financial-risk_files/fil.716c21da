<li><span><a href="/forskning/forskningsgrupper/artsmanagement/">Center for Arts Management and Leadership Research</a></span></li>
<li><a href="/forskning/forskningsgrupper/collaborative-media-arts-coma/"><span>Collaborative Media Arts (CoMA) Lab</span></a></li>
<li><a href="/forskning/forskningsgrupper/ecosystem/"><span>EcoSystem</span></a></li>
<li><span><a href="/forskning/forskningsgrupper/foku/">Forskning møter kunst (FOKU)</a></span></li>
<li><a href="/forskning/forskningsgrupper/forskningpaascenekunst/"><span>Forskning på scenekunst</span></a></li>
<li><span><a href="/forskning/forskningsgrupper/FOSFOR/">FOSFOR</a></span></li>
<li><a href="/forskning/forskningsgrupper/phygital-lab/"><span>Phygital Lab</span></a></li>
<li><a href="/forskning/forskningsgrupper/prisma/"><span>PRISMA</span></a></li>
<li><a href="/forskning/forskningsgrupper/rampp/">RAMPP – Research in Applied Music Production Practices</a></li>
<li><a href="/forskning/forskningsgrupper/talknature/"><span>Talk</span><span>&nbsp;</span>Nature</a></li>
<li><a href="/forskning/forskningsgrupper/Typ-0.Lab">Typ-0.Lab</a></li>
</ul></div></div></div>

        </div>
    </div>
</section>
</section><section class="Richtext__block">

