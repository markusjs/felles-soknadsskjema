    <div id="72fa0599"><div class="BHZEJUDSIPpKa0oPrsHx xy4iFrsV2Sz8Qp0apyvq KL9_OjJF_WIv4QAJIRsp wGdptzOmQMiOATX3lnBc NBcU6wm7Ql3ucaRy0EDH"><div class="bLAdaCckoHBaiIC97_jU xkhMLuVVk6wWWHYY98W6"><div class="eh99tHo126OqTC2jRbLr"><div class="VzZYZpe50JO2h5FBr4N5"><ol class="jIjgn7qoTMH3b4e0jW3j ElJvRYAzb3LOesAtWOY3" id="breadcrumbs"><li><a class="QqohSkg5NSBKEgLCAL46" href="/">Kristiania</a></li><li><a class="QqohSkg5NSBKEgLCAL46">Om Kristiania</a></li></ol><div class="_F4aP0i0hzV9vBAPo3P7"><div class="cPhlwLgkNO_8rPuimnOV"><h1 class="j3qgdNbfXpLB3KO3Z2Hg tj0RGZ9PWQ0Q8Xf5IQZy">Om Kristiania</h1><div class="oW0xSqTqKcSkxv2BQAiF">Kristiania er en ideell og uavhengig utdanningsstiftelse som jobber for &aring; gj&oslash;re utdanning tilgjengelig for flest mulig gjennom h&oslash;yskole, fagskole og nettstudier. &nbsp;&nbsp;</div></div></div></div></div></div><div class="slJnKPGAAIKofsQwQBjL dabmDRgUTnFwXNJ_grkU"><picture><source sizes="100vw" srcSet="/contentassets/515da12226f843c4b81085e44e128144/kirkegata_nytt_bygg_innsiden-5-1.jpg?width=375 375w, /contentassets/515da12226f843c4b81085e44e128144/kirkegata_nytt_bygg_innsiden-5-1.jpg?width=480 480w, /contentassets/515da12226f843c4b81085e44e128144/kirkegata_nytt_bygg_innsiden-5-1.jpg?width=640 640w, /contentassets/515da12226f843c4b81085e44e128144/kirkegata_nytt_bygg_innsiden-5-1.jpg?width=768 768w, /contentassets/515da12226f843c4b81085e44e128144/kirkegata_nytt_bygg_innsiden-5-1.jpg?width=1024 1024w, /contentassets/515da12226f843c4b81085e44e128144/kirkegata_nytt_bygg_innsiden-5-1.jpg?width=1440 1440w, /contentassets/515da12226f843c4b81085e44e128144/kirkegata_nytt_bygg_innsiden-5-1.jpg?width=1920 1920w"/><img src="/contentassets/515da12226f843c4b81085e44e128144/kirkegata_nytt_bygg_innsiden-5-1.jpg?width=1440" alt="Bilde av trappehuset til Kristinias nye undervisningsbygg. " style="object-position:74% 74%" loading="eager"/></picture></div></div><script>(window.__reactProps = window.__reactProps || {})['72fa0599-json'] = {"hea