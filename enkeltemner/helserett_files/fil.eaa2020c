vbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Historie</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></li></ul></div></div></div><script>(window.__reactProps = window.__reactProps || {})['971622b5-json'] = {"type":"plain","items":[{"link":{"label":"Høyskolen Kristiania","href":"/om-kristiania/om-hoyskolen/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Fagskolen Kristiania","href":"/om-kristiania/om-fagskolen/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Styret","href":"/om-kristiania/om-hoyskolen/styret/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Strategi og rapporter","href":"/om-kristiania/om-hoyskolen/strategi-og-rapporter/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Presserom","href":"/om-kristiania/presserom/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Kontaktinformasjon","href":"/om-kristiania/kontakt-oss/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Finn ansatt","href":"/om-kristiania/ansatte/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Historie","href":"/om-kristiania/historie/","external":false,"showIsExternal":true},"additionalNotes":null}],"title":"","description":null,"variant":"white","columnsLayout":"triple"};</script></div>
