                                        <div id="9e268116"><table class="nWIPSJlVRmxAXAoCQOEo"><thead></thead><tbody><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-award"></use></svg></span><span>Studieoppsett</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">165 studiepoeng kjerneemne</p><p>+ 15 studiepoeng valgemne</div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Heltid</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">Ca. 40 timers studier per uke</p><p>30 studiepoeng per semester</p><p>Totalt 6 semestere over 3 &#229;r</div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Deltid</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">Ca. 20 timers studier per uke</p><p>15 studiepoeng per semester</p><p>Totalt 12 semestere over 6 &#229;r</div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Enkeltemne</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">10-40 timers studier per uke</p><p>7.5-30 studiepoeng per semester</div></td></tr></tbody><tfoot></tfoot></table><script>(window.__reactProps = window.__reactProps || {})['9e268116-json'] = {"tableItems":[{"icon":"award","label":"Studieoppsett","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"165 studiepoeng kjerneemne</p><p>+ 15 studiepoeng valgemne"}}]},{"icon":"activity","label":"Heltid","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"Ca. 40 timers studier per uke</p><p>30 studiepoeng per semester</p><p>Totalt 6 semestere over 3 &#229;r"}}]},{"icon":"activity","label":"Deltid","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"