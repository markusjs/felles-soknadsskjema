<div id="89cc85be"><div class="T9s2xkF6zj_7pUCGDUHb"><div class="GVCcM3ty8VKYbJ2XT_Dk UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef xYQo22CVUbne62uHl6zy nuydYi_Wd6zwyeTcuMig" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/75e06ac6eb04467686c1df8cf11b64ad/due_2305.jpg?width=375 375w, /contentassets/75e06ac6eb04467686c1df8cf11b64ad/due_2305.jpg?width=500 500w, /contentassets/75e06ac6eb04467686c1df8cf11b64ad/due_2305.jpg?width=768 768w, /contentassets/75e06ac6eb04467686c1df8cf11b64ad/due_2305.jpg?width=1024 1024w"><img src="/contentassets/75e06ac6eb04467686c1df8cf11b64ad/due_2305.jpg?width=500" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA mUg4eEAIUffj8Zar9HZK"><h2 class="ZiduBuPrxHXQhabvP6SQ">Videreutdanning til din bedrift? </h2><div class="BrxHX8d3IdyRW2EN5wWq">Kristiania tilbyr flere løsninger for kompetanseheving for din virksomhet. </div><a href="/studier/videreutdanning/videreutdanning-for-virksomheter/" title="Gå til videreutdanning for bedrifter" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Gå til videreutdanning for bedrifter</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['89cc85be-json'] = {"image":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[375,500,768,1024],"sizes":["(min-width: 1440px) 768px","(min-width: 768px) 50vw","100vw"],"mode":"default","targetAspectRatio":{