<div id="9652d9a2"><section class="cHJuzEmXmacjVj5xP6iZ mt6a75ovnlMLPE9Loln5"><div class="DXb3Ua5pMEXHHEWX1SA7"><div id="8c74c05d-0ea9-4397-827c-bc12478b2f01" class="DvegeScMnacdRemVyrm0"></div><h2 class="aiIhzQ_HVaul7y_AkKJm">Nytt om videreutdanning</h2><div class="XRp6wsxkeTvkZeQyXQxl"><ul class="oRspAuvbMi0pXLrX9u7q bZgG4t1Ka6aKFFpX3BbZ"><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/f1f938ef609f4e8ba88c2dd42949eb4c/tom-karp-pa-taket.webp?width=175 175w, /contentassets/f1f938ef609f4e8ba88c2dd42949eb4c/tom-karp-pa-taket.webp?width=375 375w, /contentassets/f1f938ef609f4e8ba88c2dd42949eb4c/tom-karp-pa-taket.webp?width=500 500w, /contentassets/f1f938ef609f4e8ba88c2dd42949eb4c/tom-karp-pa-taket.webp?width=768 768w"><img src="/contentassets/f1f938ef609f4e8ba88c2dd42949eb4c/tom-karp-pa-taket.webp?width=500" alt="Professor Tom Karp står på taket av Kristianias nybygg, med en vakker utsikt over Oslo i bakgrunnen" style="object-position:50% 44%" loading="lazy"></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Erfaringsbasert master</span><h3 class="qELDWCSeSJ1SDxUrtw0c">Å være leder er krevende. Derfor trenger du mer enn teori</h3><div class="kF4KqV8ac8a9rdoWGCg8">Hvordan håndterer du utfordringer som ikke passer inn i teorier? På Kristianias erfaringsbaserte master i ledelse brukes egen arbeidshverdag som utgangspunkt for læring.</div></div><a href="/aktuelt/2026/06/erfaringsbasert-master-ledelse-mer-enn-teori/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">Å være leder er krevende. Derfor trenger du mer enn teori</div></a></li><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/7b2001319fc64b25b6be3ae6a847c8b2/kenan-ibrahimefendic-1.jpg?width=175 175w, /contentassets/7b2001319fc64b25b6be3ae6a847c8b2/kenan-ibrahimefendic-1.jpg?width=375 375w, /contentassets/7b2001319fc64b25b6be3ae6a847c8b2/kenan-ibrahimefendic-1.jpg?width=500 500w, /contentassets/7b2001319fc64b25b6be3ae6a847c8b2/kenan-ibrahimefendic-1.jpg?width=768 768w"><img src="/contentassets/7b2001319fc64b25b6be3ae6a847c8b2/kenan-ibrahimefendic-1.jpg?width=500" alt="Portrett av Kenan på campus" style="object-position:48% 34%" loading="lazy"></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Videreutdanning</span><h3 class="qELDWCSeSJ1SDxUrtw0c">MBA ga selvtillit og mer ansvar på jobb: – Jeg får både inspirasjon og nettverk</h3><div class="kF4KqV8ac8a9rdoWGCg8">Kenan hadde behov for at studiene var fleksible, slik at hverdagen med fulltidsjobb og som far til to små skulle gå opp.</div></div><a href="/aktuelt/2026/02/mba-ga-selvtillit-og-mer-ansvar-pa-jobb--jeg-far-bade-inspirasjon-og-nettverk/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">MBA ga selvtillit og mer ansvar på jobb: – Jeg får både inspirasjon og nettverk</div></a></li><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/609183f0de554e608dc3909e7af34796/helene-tronstad-moe-nettstudier-tine-chan-aller-12-1.jpg?width=175 175w, /contentassets/609183f0de554e608dc3909e7af34796/helene-tronstad-moe-nettstudier-tine-chan-aller-12-1.jpg?width=375 375w, /contentassets/609183f0de554e608dc3909e7af34796/helene-tronstad-moe-nettstudier-tine-chan-aller-12-1.jpg?width=500 500w, /contentassets/609183f0de554e608dc3909e7af34796/helene-tronstad-moe-nettstudier-tine-chan-aller-12-1.jpg?width=768 768w"><img src="/contentassets/609183f0de554e608dc3909e7af34796/helene-tronstad-moe-nettstudier-tine-chan-aller-12-1.jpg?width=500" alt="Helene står i trappene på et av Kristianias campus" style="object-position:47% 28.000000000000004%" loading="lazy"></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Videreutdanning</span><h3 class="qELDWCSeSJ1SDxUrtw0c">Arbeidsliv i endring: Slik kan norske bedrifter rustes for fremtiden</h3><div class="kF4KqV8ac8a9rdoWGCg8">– Alle virksomheter bør ha oppdatert kompetanse innen ledelse, både på mellomledernivå, HR og toppledelsesnivå.</div></div><a href="/aktuelt/slik-kan-norske-bedrifter-rustes-for-fremtiden/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">Arbeidsliv i endring: Slik kan norske bedrifter rustes for fremtiden</div></a></li><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/912206b9104646b7b74be6db940687dc/image-3.jpeg?width=175 175w, /contentassets/912206b9104646b7b74be6db940687dc/image-3.jpeg?width=375 375w, /contentassets/912206b9104646b7b74be6db940687dc/image-3.jpeg?width=500 500w, /contentassets/912206b9104646b7b74be6db940687dc/image-3.jpeg?width=768 768w"><img src="/contentassets/912206b9104646b7b74be6db940687dc/image-3.jpeg?width=500" alt="De uteksaminerte studentene i Dalane sammen med rektor på Kristiania Trine J. Meza og Lise Gjellestad jobber som seniorrådgiver for etter- og videreutdanning i avdeling for Fleksibel og livslang læring" loading="lazy"></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Erfaringsbasert master</span><h3 class="qELDWCSeSJ1SDxUrtw0c">Kompetanseløft i Dalane-regionen gjennom videreutdanning</h3><div class="kF4KqV8ac8a9rdoWGCg8">Takket være lokalt samarbeid og engasjement tilbyr Kristiania videreutdanning i Dalane. </div></div><a href="/aktuelt/2025/07/kompetanseloft-i-dalane-regionen-gjennom-videreutdanning/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">Kompetanseløft i Dalane-regionen gjennom videreutdanning</div></a></li></ul></div><div class="Il_qdxf2TN2nYj4Jn0mz"><div class="VQF0u2qRs2qtpyVLGNYs"><button type="button" class="NtmtjnwY8FdZxOUBkRwT YBPRkb9AIKTsMfnifn6d"><span>Vis flere</span><span class="SvgIcon cVzq0GUVWaVur9PebxdU"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-right"></use></svg></span></button></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['9652d9a2-json'] = {"displayRows":[{"type":"oneOnFour","itemsCount":4}],"posters":[{"id":"4f60f4ea-4fd8-4006-85e2-f17c99bfca90","category":"Erfaringsbasert master","title":{"value":"&Aring; v&aelig;re leder er krevende. Derfor trenger du mer enn teori"},"text":{"value":"Hvordan håndterer du utfordringer som ikke passer inn i teorier? På Kristianias erfaringsbaserte master i ledelse brukes egen arbeidshverdag som utgangspunkt for læring."},"primaryLinkUrl":"/aktuelt/2026/06/erfaringsbasert-master-ledelse-mer-enn-teori/","image":{"author":null,"caption":"– Klasserommet blir nærmest som et laboratorium. Vi prøver så godt vi kan å stimulere til kreativitet og diskusjon, sier professor Tom Karp om læringsmiljøet på Erfaringsbasert master i ledelse.","url":"/contentassets/f1f938ef609f4e8ba88c2dd42949eb4c/tom-karp-pa-taket.webp","alt":"Professor Tom Karp står på taket av Kristianias nybygg, med en vakker utsikt over Oslo i bakgrunnen","focalPoint":{"x":0.5,"y":0.44},"lazyLoading":true}},{"id":"308aef12-0409-4dd7-979f-1b1f29a5a810","category":"Videreutdanning","title":{"value":"MBA ga selvtillit og mer ansvar p&aring; jobb: &ndash; Jeg f&aring;r b&aring;de inspirasjon og nettverk"},"text":{"value":"Kenan hadde behov for at studiene var fleksible, slik at hverdagen med fulltidsjobb og som far til to små skulle gå opp."},"primaryLinkUrl":"/aktuelt/2026/02/mba-ga-selvtillit-og-mer-ansvar-pa-jobb--jeg-far-bade-inspirasjon-og-nettverk/","image":{"author":"Kr