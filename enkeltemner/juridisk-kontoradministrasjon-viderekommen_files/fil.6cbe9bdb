    <div id="b2861c1d"><div class="KL9_OjJF_WIv4QAJIRsp NBcU6wm7Ql3ucaRy0EDH"><div class="VzZYZpe50JO2h5FBr4N5"><ol class="jIjgn7qoTMH3b4e0jW3j ElJvRYAzb3LOesAtWOY3" id="breadcrumbs"><li><a class="QqohSkg5NSBKEgLCAL46" href="/">Kristiania</a></li><li><a class="QqohSkg5NSBKEgLCAL46" href="/studier/">Studier</a></li><li><a class="QqohSkg5NSBKEgLCAL46">Videreutdanning</a></li></ol><div class="_F4aP0i0hzV9vBAPo3P7"><div class="cPhlwLgkNO_8rPuimnOV"><h1 class="j3qgdNbfXpLB3KO3Z2Hg tj0RGZ9PWQ0Q8Xf5IQZy">Videreutdanning</h1><div class="oW0xSqTqKcSkxv2BQAiF">Videreutdanning hos Kristiania er fleksibelt og kan tas nettbasert eller som samlingsbaserte studier p&aring; deltid. Perfekt for deg som &oslash;nsker &aring; holde deg oppdatert, men som m&aring; kombinere studier med jobb og en hektisk hverdag. Velg mellom enkeltemner eller en hel grad.</div></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['b2861c1d-json'] = {"heading":{"value":"Videreutdanning"},"intro":{"value":"Videreutdanning hos Kristiania er fleksibelt og kan tas nettbasert eller som samlingsbaserte studier p&aring; deltid. Perfekt for deg som &oslash;nsker &aring; holde deg oppdatert, men som m&aring; kombinere studier med jobb og en hektisk hverdag. Velg mellom enkeltemner eller en hel grad."},"headingSize":"large","variant":"red","image":null,"videoUrl":null,"breadcrumbs":{"breadcrumbs":[{"name":"Kristiania","link":"/"},{"name":"Studier","link":"/studier/"},{"name":"Videreutdanning","link":null}]}};</script></div>

