:"circleButton"}}]};</script></div>
</section><section class="Richtext__block">


<div id="3ae11388"></div>

<section class="TextSection TextSection--light TextSection--rounded">
    <div class="TextSection__content">
<div class="wrapper"><div class="PageLayout__grid"><div class="PageLayout__content Richtext__content">                <h2 class="TextSection__heading">Hvorfor ta videreutdanning?</h2>
</div></div></div>        <div class="TextSection__body">
            
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content RichtextContent--dark PageLayout__content"><p>Etter- og videreutdanning er viktig for å holde seg oppdatert. Derfor tilbyr Kristiania alt fra kurs med studiepoeng til master, både nettbasert og samlingsbaserte studier. Lurer du på hvorfor du skal søke videreutdanning? Her får du seks gode argumenter:</p>
</div></div></div><section class="Richtext__block">
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="f6b543f0"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">6 gode grunner til å ta videreutdanning</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__108559"><div class="RichtextContent RichtextContent--dark"><h4>1. Få flere valgmuligheter &nbsp;</h4>
<p>Etter- og videreutdanning kan åpne flere nye dører. Andre oppgaver som før har vært utilgjengelige, kan nå bli din nye hverdag. Istedenfor å gå i det samme sporet som du alltid har gjort, vil et kompetanseløft gi deg sjansen til å prøve ut flere ting. Det vil bli verdsatt av arbeidsgiveren som kan tildele deg nye utfordringer uten problemer. &nbsp;&nbsp;</p>
<h4>2. Høyere lønn</h4>
<p>Det er ingen hemmelighet at høyere utdanning kan gi lønnsøkning. Jo mer kunnskap du besitter, jo mer kan du bidra med, og det kan lønne seg. Med litt ekstra relevant kompetanse – og studiepoeng – kan du kvalifisere til nye oppgaver, og med det følger også bedre betingelser for deg. Ofte er det ikke mye som skal til. Med gode løsninger som kan tilpasses din hverdag kan du fortsette å jobbe, samtidig som du videreutdanner deg. &nbsp;</p>
<h4>3. Du vil bytte jobb</h4>
<p>Er det på tide å bytte jobb? Føler du at det er lite mulighet for utvikling i jobben du har? Kanskje du har en sterk interesse for noe annet enn den stillingen du allerede har. Da kan litt mer utdanning kan være løftet du trenger, og kan til og med hjelpe deg på veien til det som faktisk er akkurat din drømmejobb. Tørk støvet av ambisjonene og sett i gang!</p>
<h4>4. Få bevis på det du kan</h4>
<p>Kanskje du har vært så heldig å jobbe i flere år med noe du nå kan godt. Men har du papirer på det? Hvis du skal bytte jobb, så har du kanskje ingen måter å dokumentere hva du kan på. Flere år med jobberfaring er gull, men det nytter lite om du ikke kan bevise dette, og havner bak andre utdannede jobbsøkere. Med et dokument som viser nøyaktig hva du har kunnskaper om, vil du stille sterkere i en jobbsøkerprosess. &nbsp;</p>
<h4>5. Heng med i utviklingen &nbsp;</h4>
<p>Verden er stadig i utvikling, og vi må bare henge med. Har du kanskje merket at på arbeidsplassen dukker det opp nye metoder og teknologier som ikke alltid er like lette å forstå? Sjansen er stor for at den utdanningen du tok for mange år siden kunne trengt en oppfriskning. For å ikke falle bakut, men heller være en ressurs og kunne bidra, så kan litt påfyll med av kunnskap gi deg det du trenger for å kunne takle nye oppgaver når arbeidsplassen din forandrer seg.</p>
<h4>6. Lær deg noe nytt!&nbsp;</h4>
<p>Hodet trenger å brukes! Vi har alle godt av å lære nye ting, og ny kunnskap gjør at en føler seg bedre – man har mer å bidra med, mer å tilføre andre, og ikke minst: Man forstår mer av hvordan verden henger sammen. Kunnskap er ikke tungt å bære, så hvorfor ikke berike deg selv med mer kunnskap om noe du interesserer deg for?&nbsp;<strong></strong></p></div></div></div><button aria-expanded="false" aria-controls="FactBox__108559" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['f6b543f0-json'] = {"heading":"6 gode grunner til å ta videreutdanning","variant":"light","content":{"value":"<h4>1. F&aring; flere valgmuligheter &nbsp;</h4>\n<p>Etter- og videreutdanning kan &aring;pne flere nye d&oslash;rer. Andre oppgaver som f&oslash;r har v&aelig;rt utilgjengelige, kan n&aring; bli din nye hverdag. Istedenfor &aring; g&aring; i det samme sporet som du alltid har gjort, vil et kompetansel&oslash;ft gi deg sjansen til &aring; pr&oslash;ve ut flere ting. Det vil bli verdsatt av arbeidsgiveren som kan tildele deg nye utfordringer uten problemer. &nbsp;&nbsp;</p>\n<h4>2. H&oslash;yere l&oslash;nn</h4>\n<p>Det er ingen hemmelighet at h&oslash;yere utdanning kan gi l&oslash;nns&oslash;kning. Jo mer kunnskap du besitter, jo mer kan du bidra med, og det kan l&oslash;nne seg. Med litt ekstra relevant kompetanse &ndash; og studiepoeng &ndash; kan du kvalifisere til nye oppgaver, og med det f&oslash;lger ogs&aring; bedre betingelser for deg. Ofte er det ikke mye som skal til. Med gode l&oslash;sninger som kan tilpasses din hverdag kan du fortsette &aring; jobbe, samtidig som du videreutdanner deg. &nbsp;</p>\n<h4>3. Du vil bytte jobb</h4>\n<p>Er det p&aring; tide &aring; bytte jobb? F&oslash;ler du at det er lite mulighet for utvikling i jobben du har? Kanskje du har en sterk interesse for noe annet enn den stillingen du allerede har. Da kan litt mer utdanning kan v&aelig;re l&oslash;ftet du trenger, og kan til og med hjelpe deg p&aring; veien til det som faktisk er akkurat din dr&oslash;mmejobb. T&oslash;rk st&oslash;vet av ambisjonene og sett i gang!</p>\n<h4>4. F&aring; bevis p&aring; det du kan</h4>\n<p>Kanskje du har v&aelig;rt s&aring; heldig &aring; jobbe i flere &aring;r med noe du n&aring; kan godt. Men har du papirer p&aring; det? Hvis du skal bytte jobb, s&aring; har du kanskje ingen m&aring;ter &aring; dokumentere hva du kan p&aring;. Flere &aring;r med jobberfaring er gull, men det nytter lite om du ikke kan bevise dette, og havner bak andre utdannede jobbs&oslash;kere. Med et dokument som viser n&oslash;yaktig hva du har kunnskaper om, vil du stille sterkere i en jobbs&oslash;kerprosess. &nbsp;</p>\n<h4>5. Heng med i utviklingen &nbsp;</h4>\n<p>Verden er stadig i utvikling, og vi m&aring; bare henge med. Har du kanskje merket at p&aring; arbeidsplassen dukker det opp nye metoder og teknologier som ikke alltid er like lette &aring; forst&aring;? Sjansen er stor for at den utdanningen du tok for mange &aring;r siden kunne trengt en oppfriskning. For &aring; ikke falle bakut, men heller v&aelig;re en ressurs og kunne bidra, s&aring; kan litt p&aring;fyll med av kunnskap gi deg det du trenger for &aring; kunne takle nye oppgaver n&aring;r arbeidsplassen din forandrer seg.</p>\n<h4>6. L&aelig;r deg noe nytt!&nbsp;</h4>\n<p>Hodet trenger &aring; brukes! Vi har alle godt av &aring; l&aelig;re nye ting, og ny kunnskap gj&oslash;r at en f&oslash;ler seg bedre &ndash; man har mer &aring; bidra med, mer &aring; tilf&oslash;re andre, og ikke minst: Man forst&aring;r mer av hvordan verden henger sammen. Kunnskap er ikke tungt &aring; b&aelig;re, s&aring; hvorfor ikke berike deg selv med mer kunnskap om noe du interesserer deg for?&nbsp;<strong></strong>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section>

        </div>
    </div>
</section>
</section><section class="Richtext__block">

