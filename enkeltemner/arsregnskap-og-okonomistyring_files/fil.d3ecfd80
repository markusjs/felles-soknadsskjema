n-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania","caption":"– Jeg blir egentlig engasjert av det meste som er urettferdig. Det kan være alt fra Israels angrep mot befolkningen i Gaza til at skeive blir diskriminert på bakgrunn av den de er, sier Frida. ","url":"/contentassets/ae359060ac3b4922bedb4be6517f65ed/frida-marie-grande-kristiania-6.jpg","alt":"– Jeg ønsker meg en verden fri for hat og diskriminering ","focalPoint":null,"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2024/05/-jeg-onsker-meg-en-verden-fri-for-hat-og-diskriminering/","external":false,"showIsExternal":true}},{"id":"116176","title":"Salar Bahador er nominert til Årets lederstjerne med bruktbutikken Ditto ","description":{"value":"Salar åpnet bruktbutikken Ditto for fire år siden. I dag er han nominert som en av årets lederstjerner i D2. "},"category":"Bachelor i markedsføring og merkevareledelse","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania/Stina Myhre Pedersen","caption":"Salar Bahador (26) vurderer plaggene nøye før de blir hengt opp i butikken.  ","url":"/contentassets/f2abedeee7a2441eb101be079d4842d7/ditto_store_salar-5.jpg","alt":"Salar Bahador er nominert til Årets lederstjerne med bruktbutikken Ditto ","focalPoint":{"x":0.52,"y":0.39},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2023/12/salar-bahador-er-karet-til-arets-lederstjerne-med-sin-bruktbutikk-ditto/","external":false,"showIsExternal":true}},{"id":"112861","title":"– Vi kan gjøre akkurat som vi vil ","description":{"value":"For duoen i markedsføringsbyrået Meraki fungerer det best å være sine egne sjefer, uten eget kontor. "},"category":"Master i markedsføringsledelse","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania","caption":"Helene Hedenstad (til venstre) og Cathrine Bjerkeli Halvorsen startet eget markedsføringsbyrå mens de studerte. De har gjort Meraki Marketing til et smidig byrå som jobber tett på kundene sine. – Det er viktig at vi finner stemmen til kunden når vi skal kommunisere for dem, og det er jo lettere når vi besøker dem, enn hvis de kommer til oss, sier de.","url":"/contentassets/b0f1d11a36824570baff2a5bfe46ce85/merakimarketing19.jpg","alt":"– Vi kan gjøre akkurat som vi vil ","focalPoint":{"x":0.68,"y":0.3},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/kristiania-stories/-vi-kan-gjore-akkurat-som-vi-vil/","external":false,"showIsExternal":true}}],"layoutVariant":"titleAndLinkTop","columnVariant":"four","backgroundVariant":"dark"};</script></div>
