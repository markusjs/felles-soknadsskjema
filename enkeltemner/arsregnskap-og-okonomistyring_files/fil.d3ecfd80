e10/hero_fredrik.jpg","alt":"Fredrik fikk jobb hos en spennende teknologibedrift fem dager etter eksamen ","focalPoint":{"x":0.49,"y":0.36},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2023/05/fredrik-fikk-jobb-hos-en-spennende-teknologibedrift-fem-dager-etter-eksamen/","external":false,"showIsExternal":true}},{"id":"103697","title":"Ida valgte denne mastergraden i stedet for et jobbtilbud. Det lønnet seg. ","description":{"value":"Ida Merete Markussen ønsket en ettertraktet utdanning. Valget falt på IT-studier ved Kristiania."},"category":"Bergen","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Benjamin Åvitsland ","caption":"Med en bachelor- og mastergrad i IT har Ida mange spennende muligheter. Akkurat nå jobber hun i Aprila Bank og stortrives. ","url":"/contentassets/61deb72a4006423cbc057ca5d3a793a3/some_ida_masterinformationsystems_rekrutteringskampanje23_benjaminavitsland-3.jpg","alt":"Ida valgte denne mastergraden i stedet for et jobbtilbud. Det lønnet seg. ","focalPoint":null,"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2023/04/ida-onsket-bred-og-etterspurt-kompetanse--valgte-it-studier-ved-kristiania/","external":false,"showIsExternal":true}}],"layoutVariant":"titleAndLinkTop","columnVariant":"four","backgroundVariant":"dark"};</script></div>
