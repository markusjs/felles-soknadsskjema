,"100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania/Benjamin Åvitsland","caption":"Motedrømmen som gikk i oppfyllelse: Anna-Kristine Soltvedt har jobbet dedikert og målrettet fra ung alder for å skape seg en karriere i motebransjen. Allerede før hun leverte avgangskolleksjonen ved ESMOD Oslo, fikk hun jobbtilbud fra et av Norges ledende motehus. ","url":"/contentassets/bbf238f8b5c747d6966a207c6e72d804/anna-kristine-soltvedt-hero.jpg","alt":"Anna-Kristine er produktutvikler for et stort motehus","focalPoint":{"x":0.51,"y":0.36},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2023/aktuelt--januar-2023--kristiania/anna-kristine-ble-produktutvikler-for-stort-motehus/","external":false,"showIsExternal":true}}],"layoutVariant":"titleAndLinkTop","columnVariant":"four","backgroundVariant":"grey"};</script></div>
