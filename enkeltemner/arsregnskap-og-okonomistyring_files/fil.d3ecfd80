land-3.jpg?width=500" alt="Ida valgte denne mastergraden i stedet for et jobbtilbud. Det lønnet seg. " loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Bergen</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Ida valgte denne mastergraden i stedet for et jobbtilbud. Det lønnet seg. </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Ida Merete Markussen ønsket en ettertraktet utdanning. Valget falt på IT-studier ved Kristiania.</div></div><a href="/aktuelt/2023/04/ida-onsket-bred-og-etterspurt-kompetanse--valgte-it-studier-ved-kristiania/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li></ul></div></div></div><script>(window.__reactProps = window.__reactProps || {})['c0b74b79-json'] = {"title":"Teknologi og innovasjon","link":{"label":"Se alle studier","href":"/utdanning/teknologi-og-innovasjon/","external":false,"showIsExternal":true},"contentListItems":[{"id":"118620","title":"Speed-dating førte til drømmejobb ","description":{"value":"Slike IT-studenter løser problemer for bedrifter – og får jobb etterpå!"},"category":"Bergen","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania","caption":"Kristiania-alumni Martin Taranger Hansen jobber i dag fulltid hos Mimir Media Tech AS, hvor de lager et prisvinnende, skybasert system for video- og fotoprodusenter.","url":"/contentassets/f807043504a6477eb8e8a16ebd2bff8c/martin-taranger-hansen-bachelor-i-frontend-og-mobilutvikling-mjoll-kristiania1.jpg","alt":"Speed-dating førte til drømmejobb ","focalPoint":{"x":0.34,"y":0.47},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2024/01/speed-