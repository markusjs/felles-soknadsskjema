<div id="52350f55"><div class="rGe6TU4YqsXtkoX7XdK8 D03pMHJmzX1gSZKcJq8C ZuYj6Na7uskDL5VuL7Bp"><div class="OuOgujIRxM4MHS7v2CAm" id="økonomi-og-bærekraft"><div class="IvDqood9UqphKP7DPbDR"><h2 class="YNyG2EAabV44ENhJW5Z3">Økonomi og bærekraft</h2><a href="/utdanning/teknologi-og-innovasjon/okonomi-og-administrasjon/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Se alle studier</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div><div class="W9zdKGpfzlMkq36ZQPco RPFLAVFLDpjxyNY1Crfa"><ul class="hu88n87boJGqs0wZE6DO"><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/5a4ebf728769467182f8965c4259648b/june-helene-heen-lien.jpg?width=175 175w, /contentassets/5a4ebf728769467182f8965c4259648b/june-helene-heen-lien.jpg?width=375 375w, /contentassets/5a4ebf728769467182f8965c4259648b/june-helene-heen-lien.jpg?width=500 500w, /contentassets/5a4ebf728769467182f8965c4259648b/june-helene-heen-lien.jpg?width=768 768w"><img src="/contentassets/5a4ebf728769467182f8965c4259648b/june-helene-heen-lien.jpg?width=500" alt="June jobber for likestilling i fotballen " style="object-position:36% 62%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Bachelor i kreativitet, innovasjon og forretningsutvikling</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">June jobber for likestilling i fotballen </h3></div><div class="u5K49m8sCAFQhMpYrwdt">– Mye handler om å rekruttere unge kvinner til å satse på fotball. Vi må vise at det er mulig, og legge til rette for at de skal kunne leve av fotball, sier June. </div></div><a href="/aktuelt/2024/04/june-jobber-for-likestilling-i-fotballen/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/7fcb256512ae435d9e1551f775ed97a8/studio_som-12.jpg?width=175 175w, /contentassets/7fcb256512ae435d9e1551f775ed97a8/studio_som-12.jpg?width=375 375w, /contentassets/7fcb256512ae435d9e1551f775ed97a8/studio_som-12.jpg?width=500 500w, /contentassets/7fcb256512ae435d9e1551f775ed97a8/studio_som-12.jpg?width=768 768w"><img src="/contentassets/7fcb256512ae435d9e1551f775ed97a8/studio_som-12.jpg?width=500" alt="Fra faglærer til student: Trine studerer på fulltid og driver samtidig bedrift med Tuva " loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Nyheter</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Fra faglærer til student: Trine studerer på fulltid og driver samtidig bedrift med Tuva </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Trine startet opp egen bedrift på Aker Brygge mens hun var fulltidsstudent.</div></div><a href="/aktuelt/2023/12/fra-faglarer-til-student---trine-studerer-pa-fulltid-og-driver-samtidig-bedrift-med-tuva/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/globalassets/simen_kruger-2.jpg?width=175 175w, /globalassets/simen_kruger-2.jpg?width=375 375w, /globalassets/simen_kruger-2.jpg?width=500 500w, /globalassets/simen_kruger-2.jpg?width=768 768w"><img src="/globalassets/simen_kruger-2.jpg?width=500" alt="&nbsp;Kombinerer toppidrettskarriere med nettstudier ved Kristiania " style="object-position:31% 46%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Nyheter</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">&nbsp;Kombinerer toppidrettskarriere med nettstudier ved Kristiania </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Selv om Simen Hegstad Krüger satser for fullt som langrennsløper, har han gjort seg noen tanker om fremtiden. Nå blir han snart nettstudent ved Kristiania og skal studere bedriftsøkonomi mellom treningsøktene og mesterskapene. </div></div><a href="/aktuelt/kristiania-stories/kombinerer-toppidrettskarriere-med-nettstudier-ved-kristiania/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/473d70a5dbb747958421436e7a11e300/silje_morin_lisether-37.jpg?width=175 175w, /contentassets/473d70a5dbb747958421436e7a11e300/silje_morin_lisether-37.jpg?width=375 375w, /contentassets/473d70a5dbb747958421436e7a11e300/silje_morin_lisether-37.jpg?width=500 500w, /contentassets/473d70a5dbb747958421436e7a11e300/silje_morin_lisether-37.jpg?width=768 768w"><img src="/contentassets/473d70a5dbb747958421436e7a11e300/silje_morin_lisether-37.jpg?width=500" alt="Silje fikk jobbtilbud før hun leverte masteroppgaven " style="object-position:49% 32%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Høyskole</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Silje fikk jobbtilbud før hun leverte masteroppgaven </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Silje Morin (36) hadde flere års entreprenørerfaring, men digitaliseringen krevde ny kompetanse. Nå har hun mastergrad, nye «briller», og ny jobb.</div></div><a href="/aktuelt/2024/02/silje-fikk-nye-briller-med-master-i-innovasjonsledelse/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li></ul></div></div></div><script>(window.__reactProps = window.__reactProps || {})['52350f55-json'] = {"title":"Økonomi og bærekraft","link":{"label":"Se alle studier","href":"/utdanning/teknologi-og-innovasjon/okonomi-og-administrasjon/","external":false,"showIsExternal":true},"contentListItems":[{"id":"122613","title":"June jobber for likestilling i fotballen ","description":{"value":"– Mye handler om å rekruttere unge kvinner til å satse på fotball. Vi må vise at det er mulig, og legge til rette for at de skal kunne leve av fotball, sier June. "},"category":"Bachelor i kreativitet, innovasjon og forretningsutvikling","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania/Amir Raaholdt","caption":"Den norske kvinnefotballen er i sterk vekst. June jobber med å utvikle kvinnefotballen i samarbeid med klubbene i Toppserien, Norsk Fotballforbund og andre samarbeidspartnere.","url":"/contentassets/5a4ebf728769467182f8965c4259648b/june-helene-heen-lien.jpg","alt":"June jobber for likestilling i fotballen ","focalPoint":{"x":0.36,"y":0.62},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2024/04/june-jobber-for-likestilling-i-fotballen/","external":false,"showIsExternal":true}},{"id":"117038","title":"Fra faglærer til student: Trine studerer på fulltid og driver samtidig bedrift med Tuva ","description":{"value":"Trine 