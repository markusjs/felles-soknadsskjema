<div id="68a56d19"><div class="rGe6TU4YqsXtkoX7XdK8 tITCdCfHjIHcQOBepie1 ZuYj6Na7uskDL5VuL7Bp"><div class="OuOgujIRxM4MHS7v2CAm" id="film-og-medier"><div class="IvDqood9UqphKP7DPbDR"><h2 class="YNyG2EAabV44ENhJW5Z3">Film og medier</h2><a href="/utdanning/kunst-og-design/film-foto-og-spill/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn LVwfmt8Qy2xfZW7GrHx_ Pf5HgbFCxXwoDDfyfLsp" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Se alle studier</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div><div class="W9zdKGpfzlMkq36ZQPco RPFLAVFLDpjxyNY1Crfa"><ul class="hu88n87boJGqs0wZE6DO"><li><div class="fZJVSAOhjE5zCRGyxzhi F_as4N7ckoDQHikdStXf"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/fc0e9aaef22d499e83e6b27f9ec42718/ingvild-rein--storm-studios-hero-kristiania.jpg?width=175 175w, /contentassets/fc0e9aaef22d499e83e6b27f9ec42718/ingvild-rein--storm-studios-hero-kristiania.jpg?width=375 375w, /contentassets/fc0e9aaef22d499e83e6b27f9ec42718/ingvild-rein--storm-studios-hero-kristiania.jpg?width=500 500w, /contentassets/fc0e9aaef22d499e83e6b27f9ec42718/ingvild-rein--storm-studios-hero-kristiania.jpg?width=768 768w"><img src="/contentassets/fc0e9aaef22d499e83e6b27f9ec42718/ingvild-rein--storm-studios-hero-kristiania.jpg?width=500" alt="Slik fikk Ingvild jobben med å lage effekter for «The Last of Us» og Marvels «Black Panther» " style="object-position:33% 33%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Bachelor i Visual Effects</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Slik fikk Ingvild jobben med å lage effekter for «The Last of Us» og Marvels «Black Panther» </h3></div><div class="u5K49m8sCAFQhMpYrwdt">– Jeg får være med på å lage min egen underholdning.</div></div><a href="/aktuelt/2024/06/ingvild-kunne-ikke-noe-om-vfx--na-jobber-hun-pa-de-store-marvel-filmene/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi F_as4N7ckoDQHikdStXf"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/b0a302eea3b9400dafbe6cdeaab615ad/munch_spillutvikling-2ny.jpeg?width=175 175w, /contentassets/b0a302eea3b9400dafbe6cdeaab615ad/munch_spillutvikling-2ny.jpeg?width=375 375w, /contentassets/b0a302eea3b9400dafbe6cdeaab615ad/munch_spillutvikling-2ny.jpeg?width=500 500w, /contentassets/b0a302eea3b9400dafbe6cdeaab615ad/munch_spillutvikling-2ny.jpeg?width=768 768w"><img src="/contentassets/b0a302eea3b9400dafbe6cdeaab615ad/munch_spillutvikling-2ny.jpeg?width=500" alt="Nå kan alle «stjele» kunst fra Munchmuseet! " style="object-position:63% 41%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Spillutvikling</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Nå kan alle «stjele» kunst fra Munchmuseet! </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Kim og spillstudioet Tooth Games stakk av med seieren i NM i Gameplay 2023. Nå er spillet deres utstilt på Munchmuseet!
