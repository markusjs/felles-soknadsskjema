<div id="14777aa9"><div class="rGe6TU4YqsXtkoX7XdK8 tITCdCfHjIHcQOBepie1 ZuYj6Na7uskDL5VuL7Bp"><div class="OuOgujIRxM4MHS7v2CAm" id="musikk-og-scenekunst"><div class="IvDqood9UqphKP7DPbDR"><h2 class="YNyG2EAabV44ENhJW5Z3">Musikk og scenekunst</h2><a href="/utdanning/kunst-og-design/musikk-og-scenekunst/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn LVwfmt8Qy2xfZW7GrHx_ Pf5HgbFCxXwoDDfyfLsp" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Se alle studier</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div><div class="W9zdKGpfzlMkq36ZQPco RPFLAVFLDpjxyNY1Crfa"><ul class="hu88n87boJGqs0wZE6DO"><li><div class="fZJVSAOhjE5zCRGyxzhi F_as4N7ckoDQHikdStXf"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/cbf0a4aa6c4a451995ef9123dff1bd68/peder-elias-c-henning-lefsaker.jpg?width=175 175w, /contentassets/cbf0a4aa6c4a451995ef9123dff1bd68/peder-elias-c-henning-lefsaker.jpg?width=375 375w, /contentassets/cbf0a4aa6c4a451995ef9123dff1bd68/peder-elias-c-henning-lefsaker.jpg?width=500 500w, /contentassets/cbf0a4aa6c4a451995ef9123dff1bd68/peder-elias-c-henning-lefsaker.jpg?width=768 768w"><img src="/contentassets/cbf0a4aa6c4a451995ef9123dff1bd68/peder-elias-c-henning-lefsaker.jpg?width=500" alt="Skaper forandring med musikk " style="object-position:53% 27%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Bachelor i populærmusikk</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Skaper forandring med musikk </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Peder Elias gikk fra å studere musikk ved Kristiania, til å bli superstjerne i Asia. Nå påvirker låtene hans livet til fans over store deler av verden.</div></div><a href="/aktuelt/2024/10/peder-elias-gjor-braksuksess-i-asia/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi F_as4N7ckoDQHikdStXf"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/91899561e2a44541892262b9df35691c/maja-christiansen-1.webp?width=175 175w, /contentassets/91899561e2a44541892262b9df35691c/maja-christiansen-1.webp?width=375 375w, /contentassets/91899561e2a44541892262b9df35691c/maja-christiansen-1.webp?width=500 500w, /contentassets/91899561e2a44541892262b9df35691c/maja-christiansen-1.webp?width=768 768w"><img src="/contentassets/91899561e2a44541892262b9df35691c/maja-christiansen-1.webp?width=500" alt="&nbsp;– Før trodde jeg ikke yrket mitt var viktig " style="object-position:56.99999999999999% 39%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">School of Arts, Design, and Media</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">&nbsp;– Før trodde jeg ikke yrket mitt var viktig </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Som 19-åring var Maja Christiansen sikker på én ting: Hun ville bli skuespiller.</div></div><a href="/aktuelt/2024/11/de-magiske-oyeblikkene-som-skuespiller/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi F_as4N7ckoDQHikdStXf"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/a50653472ff94b7c839e76987c6fea9f/img_8067.jpg?width=175 175w, /contentassets/a50653472ff94b7c839e76987c6fea9f/img_8067.jpg?width=375 375w, /contentassets/a50653472ff94b7c839e76987c6fea9f/img_8067.jpg?width=500 500w, /contentassets/a50653472ff94b7c839e76987c6fea9f/img_8067.jpg?width=768 768w"><img src="/contentassets/a50653472ff94b7c839e76987c6fea9f/img_8067.jpg?width=500" alt="Slik fikk Alicia og Michelle drømmejobben som dansere " style="object-position:40% 39%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Oslo</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Slik fikk Alicia og Michelle drømmejobben som dansere </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Auditiontreningen på fagskolestudiet i kommersiell scenekunst, førte Alicia og Michelle til drømmejobben hos Wallmans. </div></div><a href="/aktuelt/2023/02/slik-fikk-alicia-og-michelle-drommejobben-som-dansere/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi F_as4N7ckoDQHikdStXf"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/6ce626977544432eab257fd3a0cb442b/William_Roed_Musikkdesign_Kristiania-1.jpg?width=175 175w, /contentassets/6ce626977544432eab257fd3a0cb442b/William_Roed_Musikkdesign_Kristiania-1.jpg?width=375 375w, /contentassets/6ce626977544432eab257fd3a0cb442b/William_Roed_Musikkdesign_Kristiania-1.jpg?width=500 500w, /contentassets/6ce626977544432eab257fd3a0cb442b/William_Roed_Musikkdesign_Kristiania-1.jpg?width=768 768w"><img src="/contentassets/6ce626977544432eab257fd3a0cb442b/William_Roed_Musikkdesign_Kristiania-1.jpg?width=500" alt="Låtene til William har over seks millioner månedlige lyttere" style="object-position:50% 33%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Musikkdesign</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Låtene til William har over seks millioner månedlige lyttere</h3></div><div class="u5K49m8sCAFQhMpYrwdt">William Rød gikk nylig ut fra fagskoleutdanning i Musikkdesign ved Kristiania. Nå har han over seks millioner månedlige lyttere på Spotify. </div></div><a href="/aktuelt/2023/08/latene-til-william-har-over-seks-millioner-manedlige-lyttere/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li></ul></div></div></div><script>(window.__reactProps = window.__reactProps || {})['14777aa9-json'] = {"title":"Musikk og scenekunst","link":{"label":"Se alle studier","href":"/utdanning/kunst-og-design/musikk-og-scenekunst/","external":false,"showIsExternal":true},"contentListItems":[{"id":"117351","title":"Skaper forandring med musikk ","description":{"value":"Peder Elias gikk fra å studere musikk ved Kristiania, til å bli superstjerne i Asia. Nå påvirker låtene hans livet til fans over store deler av verden."},"category":"Bachelor i populærmusikk","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":null,"caption":"27-åringen Peder Elias vant Spellemannsprisen i 2022. Nå har han over en halv milliard strømminger og et stort internasjonalt publikum. Foto: Henning Lefsaker.","url":"/contentassets/cbf0a4aa6c4a451995ef9123dff1bd68/peder-elias-c-henning-lefsaker.jpg","alt":"Skaper forandring med musikk ","focalPoint":{"x":0.53,"y":0.27},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2024/10/peder-elias-gjor-braksuksess-i-asia/","external":false,"showIsExternal":true}},{"id":"132317","title":" – Før trodde jeg ikke yrket mitt var viktig ","description":{"value":"Som 19-åring var Maja Christiansen sikker på én ting: Hun ville bli skuespiller."},"category":"School of Arts, Design, and Media","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania","caption":"Maja Christiansen fikk to Gullruten-nominasjoner for sin rolle i Rådebank.","url":"/contentassets/91899561e2a44541892262b9df35691c/maja-christiansen-1.webp","alt":" – Før trodde jeg ikke yrket mitt var viktig ","focalPoint":{"x":0.57,"y":0.39},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2024/11/de-magiske-oyeblikkene-som-skuespiller/","external":false,"showIsExternal":true}},{"id":"101468","title":"Slik fikk Alicia og Michelle drømmejobben som dansere ","description":{"value":"Auditiontreningen på fagskolestudiet i kommersiell scenekunst, førte Alicia og Michelle til drømmejobben hos Wallmans. "},"category":"Oslo","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania/Victoria Dahlen","caption":"— Det var en spontan avgjørelse å flytte til Norge. Vi hadde en danselærer i Stockholm som kjente en faglig ved Kristiania, og som foreslo at vi skulle søke på kommersiell scenekunst. Vi tenkte at vi kom til å angre om vi ikke tok sjansen – og bestemte oss for å hoppe i det, forteller de to svenske jentene, Alicia Widlund og Michelle Holmstrøm. ","url":"/contentassets/a50653472ff94b7c839e76987c6fea9f/img_8067.jpg","alt":"Slik fikk Alicia og Michelle drømmejobben som dansere ","focalPoint":{"x":0.4,"y":0.39},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2023/02/slik-fikk-alicia-og-michelle-drommejobben-som-dansere/","external":false,"showIsExternal":true}},{"id":"110788","title":"Låtene til William har over seks millioner månedlige lyttere","description":{"value":"William Rød gikk nylig ut fra fagskoleutdanning i Musikkdesign ved Kristiania. Nå har han over seks millioner månedlige lyttere på Spotify. "},"category":"Musikkdesign","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania/Victoria Dahlen","caption":"– Jeg kan jobbe med musikken min fra jeg våkner til jeg legger meg. Jeg har sett hvor mye som kan skje bare av å jobbe litt hardere, sier William Rød.","url":"/contentassets/6ce626977544432eab257fd3a0cb442b/William_Roed_Musikkdesign_Kristiania-1.jpg","alt":"Låtene til William har over seks millioner månedlige lyttere","focalPoint":{"x":0.5,"y":0.33},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2023/08/latene-til-william-har-over-seks-millioner-manedlige-lyttere/","external":false,"showIsExternal":true}}],"layoutVariant":"titleAndLinkTop","columnVariant":"four","backgroundVariant":"dark"};</script></div>
</section><section class="Richtext__block">

<div id="68634d90"><div class="rGe6TU4YqsXtkoX7XdK8 D03pMHJmzX1gSZKcJq8C ZuYj6Na7uskDL5VuL7Bp"><div class="OuOgujIRxM4MHS7v2CAm" id="helse-og-trening"><div class="IvDqood9UqphKP7DPbDR"><h2 class="YNyG2EAabV44ENhJW5Z3">Helse og trening</h2><a href="/utdanning/helse-og-psykologi/helse-ernaring-og-trening/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Se alle studier</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div><div class="W9zdKGpfzlMkq36ZQPco RPFLAVFLDpjxyNY1Crfa"><ul class="hu88n87boJGqs0wZE6DO"><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/b6c89e9d11c54d94a6f135e1998d0cc6/vilde_marie_christoffersen-3.jpg?width=175 175w, /contentassets/b6c89e9d11c54d94a6f135e1998d0cc6/vilde_marie_christoffersen-3.jpg?width=375 375w, /contentassets/b6c89e9d11c54d94a6f135e1998d0cc6/vilde_marie_christoffersen-3.jpg?width=500 500w, /contentassets/b6c89e9d11c54d94a6f135e1998d0cc6/vilde_marie_christoffersen-3.jpg?width=768 768w"><img src="/contentassets/b6c89e9d11c54d94a6f135e1998d0cc6/vilde_marie_christoffersen-3.jpg?width=500" alt="Dette er de nye utfordringene for folkehelsen " style="object-position:50% 31%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Nyheter</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Dette er de nye utfordringene for folkehelsen </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Med denne utdanningen vil sykepleier Vilde Marie Christoffersen forebygge sykdom.</div></div><a href="/aktuelt/2023/03/-samfunnet-trenger-mer-kompetanse-innen-folkehelse/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/bf0c22815b0f436cbb6d599aabde31b4/irene-zumbo-bachelor-i-biomedisin-kristiania-2.jpg?width=175 175w, /contentassets/bf0c22815b0f436cbb6d599aabde31b4/irene-zumbo-bachelor-i-biomedisin-kristiania-2.jpg?width=375 375w, /contentassets/bf0c22815b0f436cbb6d599aabde31b4/irene-zumbo-bachelor-i-biomedisin-kristiania-2.jpg?width=500 500w, /contentassets/bf0c22815b0f436cbb6d599aabde31b4/irene-zumbo-bachelor-i-biomedisin-kristiania-2.jpg?width=768 768w"><img src="/contentassets/bf0c22815b0f436cbb6d599aabde31b4/irene-zumbo-bachelor-i-biomedisin-kristiania-2.jpg?width=500" alt="Irene vil skape endring med forskning " style="object-position:50% 48%" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Bachelor i biomedisin </span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Irene vil skape endring med forskning </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Det var på Kristiania at Irene Zumbo oppdaget hvordan hun kan gjøre verden bedre. </div></div><a href="/aktuelt/2024/12/irene-vil-skape-endring-med-forskning/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/5d7dca6a094241669c8b40ca9a7a1324/frsusannetiller16.jpg?width=175 175w, /contentassets/5d7dca6a094241669c8b40ca9a7a1324/frsusannetiller16.jpg?width=375 375w, /contentassets/5d7dca6a094241669c8b40ca9a7a1324/frsusannetiller16.jpg?width=500 500w, /contentassets/5d7dca6a094241669c8b40ca9a7a1324/frsusannetiller16.jpg?width=768 768w"><img src="/contentassets/5d7dca6a094241669c8b40ca9a7a1324/frsusannetiller16.jpg?width=500" alt="Susanne har et triks for å lære barn å like fisk " loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">Bachelor i anvendt folkehelsearbeid</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Susanne har et triks for å lære barn å like fisk </h3></div><div class="u5K49m8sCAFQhMpYrwdt">– Barn er skikkelig kresne, de kan sette seg på bakbeina med en gang og si «æsj».</div></div><a href="/aktuelt/kristiania-stories/Susanne-har-et-triks-for-aa-laere-barn-aa-like-fisk/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 375px, (min-width: 768px) 25vw, 100vw" srcset="/contentassets/0f1e642f9d154fb9adfa2c005518d0e6/marcus-andreas-hansen-osteopati-kristiania11.jpg?width=175 175w, /contentassets/0f1e642f9d154fb9adfa2c005518d0e6/marcus-andreas-hansen-osteopati-kristiania11.jpg?width=375 375w, /contentassets/0f1e642f9d154fb9adfa2c005518d0e6/marcus-andreas-hansen-osteopati-kristiania11.jpg?width=500 500w, /contentassets/0f1e642f9d154fb9adfa2c005518d0e6/marcus-andreas-hansen-osteopati-kristiania11.jpg?width=768 768w"><img src="/contentassets/0f1e642f9d154fb9adfa2c005518d0e6/marcus-andreas-hansen-osteopati-kristiania11.jpg?width=500" alt="Marcus er osteopat: – Jeg liker godt å jobbe med mennesker " loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><span class="TU_pgLgsSXmSqRrkGhN2">School of Health Sciences</span><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Marcus er osteopat: – Jeg liker godt å jobbe med mennesker </h3></div><div class="u5K49m8sCAFQhMpYrwdt">Kristiania er den eneste høyskolen i Norge som tilbyr utdanning i osteopati. Marcus Andreas Hansen har tatt utdannelsen og jobber i dag som osteopat ved Sano klinikken i Oslo. &nbsp; </div></div><a href="/aktuelt/2024/01/marcus-er-osteopat/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li></ul></div></div></div><script>(window.__reactProps = window.__reactProps || {})['68634d90-json'] = {"title":"Helse og trening","link":{"label":"Se alle studier","href":"/utdanning/helse-og-psykologi/helse-ernaring-og-trening/","external":false,"showIsExternal":true},"contentListItems":[{"id":"103170","title":"Dette er de nye utfordringene for folkehelsen ","description":{"value":"Med denne utdanningen vil sykepleier Vilde Marie Christoffersen forebygge sykdom."},"category":"Nyheter","picture":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[175,375,500,768],"sizes":["(min-width: 1440px) 375px","(min-width: 768px) 25vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Kristiania/Jonatan Quintero","caption":"Sykepleier Vilde Marie Christoffersen forteller at masterstudiet i anvendt folkehelsevitenskap ga henne et bredere perspektiv på folkehelse. – Jeg fikk også mulighet til å fordype meg i en rekke andre spennende temaer og fikk påfyll av kunnskap som jeg manglet fra tidligere studier.","url":"/contentassets/b6c89e9d11c54d94a6f135e1998d0cc6/vilde_marie_christoffersen-3.jpg","alt":"Dette er de nye utfordringene for folkehelsen ","focalPoint":{"x":0.5,"y":0.31},"lazyLoading":true},"link":{"label":"Les mer","href":"/aktuelt/2023/03/-samfunnet-trenger-mer-kompetanse-innen-folkehelse/","external":false,"showIsExternal":true}},{"id":"134951","title":"Irene vil skape endring med forskning ","description":{"va