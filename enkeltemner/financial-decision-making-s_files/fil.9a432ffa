jgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef AHXY6KuZSDnpZWG0CfLj" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/43f75087c8a54c9d8fa1c624785e004a/miljobilder_m_studentambassadorer-51.jpg?width=375 375w, /contentassets/43f75087c8a54c9d8fa1c624785e004a/miljobilder_m_studentambassadorer-51.jpg?width=500 500w, /contentassets/43f75087c8a54c9d8fa1c624785e004a/miljobilder_m_studentambassadorer-51.jpg?width=768 768w, /contentassets/43f75087c8a54c9d8fa1c624785e004a/miljobilder_m_studentambassadorer-51.jpg?width=1024 1024w"><img src="/contentassets/43f75087c8a54c9d8fa1c624785e004a/miljobilder_m_studentambassadorer-51.jpg?width=500" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA LJogGaMDWMkAWNeNWLSA la0uKOQNZdLd8OUc_QfI"><h2 class="ZiduBuPrxHXQhabvP6SQ">Systematisk kvalitetsarbeid</h2><div class="BrxHX8d3IdyRW2EN5wWq">På Kristiania skal alle studenter møte studier av høy kvalitet. Kristianias overordnete mål for kvalitetsarbeidet er å tilrettelegge for et utdanningsløp som legger grunnlaget for at studentene oppnår best mulig læringsutbytte og personlig utvikling i utdanninger som forbereder dem for et arbeids- og samfunnsliv i endring. &nbsp; </div><a href="/pedagogisk-utvikling-og-kvalitetsarbeid/systematisk-kvalitetsarbeid/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></div></div></li></ul></div><script>(window.__reactProps = window.__reactProps || {})['f5d65bd5-json'] = {"title":"Pedagogisk utvikling og kvalitet