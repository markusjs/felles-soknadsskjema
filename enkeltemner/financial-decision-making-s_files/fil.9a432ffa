nk":{"label":"Les mer","href":"/pedagogisk-utvikling-og-kvalitetsarbeid/systematisk-kvalitetsarbeid/","external":false,"showIsExternal":true},"useLegacyLink":false,"variant":"lightGreyPrimary","size":"large","buttonType":"normalButton"}}]};</script></div>
