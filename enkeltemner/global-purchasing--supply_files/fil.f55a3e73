    <div id="45b44236"><div class="BHZEJUDSIPpKa0oPrsHx xy4iFrsV2Sz8Qp0apyvq KL9_OjJF_WIv4QAJIRsp wGdptzOmQMiOATX3lnBc NBcU6wm7Ql3ucaRy0EDH"><div class="bLAdaCckoHBaiIC97_jU xkhMLuVVk6wWWHYY98W6"><div class="eh99tHo126OqTC2jRbLr"><div class="VzZYZpe50JO2h5FBr4N5"><ol class="jIjgn7qoTMH3b4e0jW3j ElJvRYAzb3LOesAtWOY3" id="breadcrumbs"><li><a class="QqohSkg5NSBKEgLCAL46" href="/">Kristiania</a></li><li><a class="QqohSkg5NSBKEgLCAL46">Nettstudier</a></li></ol><div class="_F4aP0i0hzV9vBAPo3P7"><div class="cPhlwLgkNO_8rPuimnOV"><h1 class="j3qgdNbfXpLB3KO3Z2Hg tj0RGZ9PWQ0Q8Xf5IQZy">Nettstudier</h1><div class="oW0xSqTqKcSkxv2BQAiF">Nettstudier gir deg fleksibilitet i hverdagen, enten du skal studere for f&oslash;rste gang eller ta videreutdanning. Vi tilbyr nettbaserte studier p&aring; deltid og heltid.</div></div></div></div></div></div><div class="slJnKPGAAIKofsQwQBjL dabmDRgUTnFwXNJ_grkU"><picture><source sizes="100vw" srcSet="/contentassets/5d9e2f5f8c5f48d19b2646cd0c95e7ed/hero_nettstudier_2027.jpg?width=375 375w, /contentassets/5d9e2f5f8c5f48d19b2646cd0c95e7ed/hero_nettstudier_2027.jpg?width=480 480w, /contentassets/5d9e2f5f8c5f48d19b2646cd0c95e7ed/hero_nettstudier_2027.jpg?width=640 640w, /contentassets/5d9e2f5f8c5f48d19b2646cd0c95e7ed/hero_nettstudier_2027.jpg?width=768 768w, /contentassets/5d9e2f5f8c5f48d19b2646cd0c95e7ed/hero_nettstudier_2027.jpg?width=1024 1024w, /contentassets/5d9e2f5f8c5f48d19b2646cd0c95e7ed/hero_nettstudier_2027.jpg?width=1440 1440w, /contentassets/5d9e2f5f8c5f48d19b2646cd0c95e7ed/hero_nettstudier_2027.jpg?width=1920 1920w"/><img src="/contentassets/5d9e2f5f8c5f48d19b2646cd0c95e7ed/hero_nettstudier_2027.jpg?width=1440" alt="Kvinne sitter på kafe med en mac. Hun smiler til kamera. " style="object-position:60% 41%" loading="eager"/></picture></div></div><script>(window.__reactProps = window.__reactProps || {})['45b44236-json'] = {"heading":{"value":"Nettstudier"},"intro":{"value":"Nettstudier gir deg fleksibilitet i hverdagen, enten du skal stude