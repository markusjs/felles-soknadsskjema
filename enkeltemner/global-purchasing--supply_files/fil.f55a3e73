<div id="82ae6060"><div class="T9s2xkF6zj_7pUCGDUHb"><div class="GVCcM3ty8VKYbJ2XT_Dk UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef nuydYi_Wd6zwyeTcuMig" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/callout-block-spor-en-student.jpg?width=375 375w, /globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/callout-block-spor-en-student.jpg?width=500 500w, /globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/callout-block-spor-en-student.jpg?width=768 768w, /globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/callout-block-spor-en-student.jpg?width=1024 1024w"><img src="/globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/callout-block-spor-en-student.jpg?width=500" alt="Bildelenke til kontaktside." style="object-position:61% 38%" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA mUg4eEAIUffj8Zar9HZK"><h2 class="ZiduBuPrxHXQhabvP6SQ">Spørsmål om nettstudier eller videreutdanning?</h2><div class="BrxHX8d3IdyRW2EN5wWq">Nysgjerrig på studier ved Kristiania og vil snakke med noen hos oss? Bestill gjerne en gratis og uforpliktende veiledningssamtale!</div><a href="https://outlook.office365.com/book/Bestillveiledningstudier@egms.onmicrosoft.com/" title="Bestill veiledning. her" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Bestill veiledning. her</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['82ae6060-json'] = {"image":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[375,500,768,1024],"sizes":["(min-width: 1440px) 768px","(min-width: 768px) 50vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":null,"caption":null,"url":"/globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/callout-block-spor-en-student.jpg","alt":"Bildelenke til kontaktside.","focalPoint":{"x":0.61,"y":0.38},"lazyLoading":true},"imageFitBehavior":"fill","imageAlignment":"left","orientation":"horizontal","contentCardViewModel":{"title":"Spørsmål om nettstudier eller videreutdanning?","description":"Nysgjerrig på studier ved Kristiania og vil snakke med noen hos oss? Bestill gjerne en gratis og uforpliktende veiledningssamtale!","callToActionLink":{"label":"Bestill veiledning. her","href":"https://outlook.office365.com/book/Bestillveiledningstudier@egms.onmicrosoft.com/","external":false,"showIsExternal":true},"useLegacyLink":false,"variant":"blackPrimary","size":"large","buttonType":"circleButton"}};</script></div>
