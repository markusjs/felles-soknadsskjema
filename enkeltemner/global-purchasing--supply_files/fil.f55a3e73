<div id="af9b00b8"><div class="HVEFaX3Xhdad0zHYPsqr"><h2 class="visuallyHidden">Artikler</h2><ul class="BHOhHAvbNpiTc98k3PWM"><li><div class="LQwCx4VsA_20nL7PJl_A UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef AHXY6KuZSDnpZWG0CfLj" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/4736dd6afb27409a816e39551b00bb6b/frida_maanum_nettstudent-4.webp?width=375 375w, /contentassets/4736dd6afb27409a816e39551b00bb6b/frida_maanum_nettstudent-4.webp?width=500 500w, /contentassets/4736dd6afb27409a816e39551b00bb6b/frida_maanum_nettstudent-4.webp?width=768 768w, /contentassets/4736dd6afb27409a816e39551b00bb6b/frida_maanum_nettstudent-4.webp?width=1024 1024w"><img src="/contentassets/4736dd6afb27409a816e39551b00bb6b/frida_maanum_nettstudent-4.webp?width=500" alt="Frida står på banen og smiler mens hun holder en fotball." style="object-position:62% 26%" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA lwj1fS09bnWFOXW1AKFu la0uKOQNZdLd8OUc_QfI"><h2 class="ZiduBuPrxHXQhabvP6SQ">Frida Maanum kombinerer toppfotball og nettstudier</h2><div class="BrxHX8d3IdyRW2EN5wWq">Frida har etablert seg på øverste nivå i internasjonal fotball, men det er fortsatt viktig for henne å ha en plan for livet etter fotballkarrieren.</div><a href="/aktuelt/2026/05/frida-maanum-kombinerer-toppfotball-og-nettstudier--det-er-mulig-a-vare-profesjonell-idrettsutover-samtidig-som-man-studerer/" title="Les mer om Frida Maanum" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Les mer om Frida Maanum</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></li><li><div class="LQwCx4VsA_20nL7PJl_A UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef AHXY6KuZSDnpZWG0CfLj" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/d10cdf12464a4fca8e583ed8d69af03e/funda-sulejman-nettstudier-2.jpg?width=375 375w, /contentassets/d10cdf12464a4fca8e583ed8d69af03e/funda-sulejman-nettstudier-2.jpg?width=500 500w, /contentassets/d10cdf12464a4fca8e583ed8d69af03e/funda-sulejman-nettstudier-2.jpg?width=768 768w, /contentassets/d10cdf12464a4fca8e583ed8d69af03e/funda-sulejman-nettstudier-2.jpg?width=1024 1024w"><img src="/contentassets/d10cdf12464a4fca8e583ed8d69af03e/funda-sulejman-nettstudier-2.jpg?width=500" alt="Funda Sulejman sitter på fortauskafé med baby og en lærebok." style="object-position:48% 39%" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA lwj1fS09bnWFOXW1AKFu la0uKOQNZdLd8OUc_QfI"><h2 class="ZiduBuPrxHXQhabvP6SQ">Tok studiene med babyen på armen</h2><div class="BrxHX8d3IdyRW2EN5wWq">– Jeg trengte ikke forplikte meg, jeg kunne prøve ett emne om gangen og se hvordan det gikk.</div><a href="/aktuelt/2025/09/tok-studiene-med-babyen-pa-armen/" title="Les mer om Funda Sulejman" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Les mer om Funda Sulejman</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></li></ul></div><script>(window.__reactProps = window.__reactProps || {})['af9b00b8-json'] = {"title":"Artikler","items":[{"image":{"profi