:true},"additionalNotes":null},{"link":{"label":"Rekrutter en student","href":"/arbeidsliv/rekrutter-en-student/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Samarbeid med fag- og forskningsmiljø","href":"/arbeidsliv/fag-og-forskningsmiljo/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Videreutdanning for virksomheter","href":"/studier/videreutdanning/videreutdanning-for-virksomheter/","external":false,"showIsExternal":true},"additionalNotes":null}],"title":"Hvordan kan vi hjelpe din virksomhet?","description":null,"variant":"primary","columnsLayout":"single"};</script></div>
