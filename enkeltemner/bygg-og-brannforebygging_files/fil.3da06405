ettstudier/enkeltemne/forvaltningsrett/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Grunnleggende regnskap","href":"/studier/nettstudier/enkeltemne/fagskole-grunnleggende-regnskap/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Interiørdesign og boliginnredning","href":"/studier/nettstudier/enkeltemne/interiordesign-og-boliginnredning/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Personalforvaltning","href":"/studier/nettstudier/enkeltemne/personalforvaltning/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Se flere enkeltemner","href":"/fagskolen-kristiania/nettstudier/enkeltemner/","external":false,"showIsExternal":true},"additionalNotes":null}],"title":"Enkeltemner ","description":"Våre fleksible enkeltemner har oppstart hver dag, hele året!","variant":"white","columnsLayout":"double"};</script></div>
</section><div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
<p>&nbsp;</p>
</div></div></div><section class="Richtext__block">

<div id="61efdec2"></div>

<section class="TextSection TextSection--light TextSection--rounded">
    <div class="TextSection__content">
<div class="wrapper"><div class="PageLayout__grid"><div class="PageLayout__content Richtext__content">                <h2 class="TextSection__heading">Dette er fagskole på nett</h2>
</div></div></div>        <div class="TextSection__body">
            
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content RichtextContent--dark PageLayout__content"><ul class="Richtext__ul">
<li>Med Kristianias nettbaserte fagskole får du full frihet til å velge den studieformen som passer deg og din hverdag.&nbsp;</li>
<li>Studer på heltid eller deltid, ta et enkeltemne eller et helt nettstudium.&nbsp;</li>
<li>Uansett hva du velger, kan fagskole på nett enkelt kombineres med jobb, familie, reise eller andre forpliktelser.</li>
<li><span>Alle våre nettstudier er utviklet i samarbeid med arbeidslivet og gir deg yrkesrettet og etterspurt kompetanse.</span></li>
</ul>
</div></div></div><section class="Richtext__block">
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="95c2fa40"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Sammenligning av våre nettstudier</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__53481"><div class="RichtextContent RichtextContent--dark">Hos oss kan du studere på dine premisser. Velg mellom nettstudier med fleksibel oppstart og fri progresjon, eller studier med oppstart to ganger i året og fast progresjon.<p></p>
<p><span data-teams="true">Begge studiemodellene gir deg tilgang til et digitalt læringsmiljø med videoer, oppgaver, quizer, faglig veiledning og støtte fra lærere og studentveiledere.</span></p>
<h3>Fleksibel oppstart og fri progresjon</h3>
<ul class="Richtext__ul">
<li>For deg som ønsker full fleksibilitet.</li>
<li>Studér når du vil og hvor du vil.&nbsp;</li>
<li>Oppstart hver dag, hele året.&nbsp;</li>
<li>Studer på heltid eller deltid.</li>
<li>Velg mellom enkeltemner eller et helt nettstudium.</li>
<li>18 måneders studierett&nbsp;</li>
<li>Studiepoeng er inkludert.</li>
</ul>
<h3>Fast oppstart og jevnlige nettsamlinger</h3>
<ul class="Richtext__ul">
<li>For deg som ønsker faste rammer og jevn progresjon.</li>
<li>Oppstart to ganger i året, vår og høst.</li>
<li>Deltidsstudier over 1-2 år.</li>
<li>Digitale samlinger og selvstudier.</li>
<li>Bli en del av et klassemiljø og få tettere oppfølging.</li>
<li>Studiepoeng er inkludert.</li>
</ul></div></div></div><button aria-expanded="false" aria-controls="FactBox__53481" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['95c2fa40-json'] = {"heading":"Sammenligning av våre nettstudier","variant":"light","content":{"value":"Hos oss kan du studere p&aring; dine premisser. Velg mellom nettstudier med fleksibel oppstart og fri progresjon, eller studier med oppstart to ganger i &aring;ret og fast progresjon.</p>\n<p><span data-teams=\"true\">Begge studiemodellene gir deg tilgang til et digitalt l&aelig;ringsmilj&oslash; med videoer, oppgaver, quizer, faglig veiledning og st&oslash;tte fra l&aelig;rere og studentveiledere.</span></p>\n<h3>Fleksibel oppstart og fri progresjon</h3>\n<ul class=\"Richtext__ul\">\n<li>For deg som &oslash;nsker full fleksibilitet.</li>\n<li>Stud&eacute;r n&aring;r du vil og hvor du vil.&nbsp;</li>\n<li>Oppstart hver dag, hele &aring;ret.&nbsp;</li>\n<li>Studer p&aring; heltid eller deltid.</li>\n<li>Velg mellom enkeltemner eller et helt nettstudium.</li>\n<li>18 m&aring;neders studierett&nbsp;</li>\n<li>Studiepoeng er inkludert.</li>\n</ul>\n<h3>Fast oppstart og jevnlige nettsamlinger</h3>\n<ul class=\"Richtext__ul\">\n<li>For deg som &oslash;nsker faste rammer og jevn progresjon.</li>\n<li>Oppstart to ganger i &aring;ret, v&aring;r og h&oslash;st.</li>\n<li>Deltidsstudier over 1-2 &aring;r.</li>\n<li>Digitale samlinger og selvstudier.</li>\n<li>Bli en del av et klassemilj&oslash; og f&aring; tettere oppf&oslash;lging.</li>\n<li>Studiepoeng er inkludert.</li>\n</ul>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section>

        </div>
    </div>
</section>
</section><section class="Richtext__block">

<div id="2aedc660"><div class="T9s2xkF6zj_7pUCGDUHb"><div class="LQwCx4VsA_20nL7PJl_A UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef nuydYi_Wd6zwyeTcuMig" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/12860d14238c47b4a369e04fa81fe98c/malin_advokat_kristiania_2026_1.jpg?width=375 375w, /contentassets/12860d14238c47b4a369e04fa81fe98c/malin_advokat_kristiania_2026_1.jpg?width=500 500w, /contentassets/12860d14238c47b4a369e04fa81fe98c/malin_advokat_kristiania_2026_1.jpg?width=768 768w, /contentassets/12860d14238c47b4a369e04fa81fe98c/malin_advokat_kristiania_2026_1.jpg?width=1024 1024w"><img src="/contentassets/12860d14238c47b4a369e04fa81fe98c/malin_advokat_kristiania_2026_1.jpg?width=500" alt="Kvinne ved pc smiler i kamera" style="object-position:33% 32%" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA lwj1fS09bnWFOXW1AKFu"><h2 class="ZiduBuPrxHXQhabvP6SQ">Malin følte seg rett og slett smartere</h2><div class="BrxHX8d3IdyRW2EN5wWq">For Malin Smådal (29) var det viktigste å utvikle seg, utfordre seg selv og åpne nye dører</div><a href="/aktuelt/2026/06/malin-folte-seg-rett-og-slett-smartere/" title="Les hvordan Malin kombinerte nettstudier med jobb og familieliv" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Les hvordan Malin kombinerte nettstudier med jobb og familieliv</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['2aedc660-json'] = {"image":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[375,500,768,1024],"sizes":["(min-width: 1440px) 768px","(min-width: 768px) 50vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Terje Borud","caption":"For Malin Smådal (29) fra Bodø handlet det ikke bare om å ta en utdanning. Det handlet om å utvikle seg og utfordre seg selv.","url":"/contentassets/12860d14238c47b4a369e04fa81fe98c/malin_advokat_kristiania_2026_1.jpg","alt":"Kvinne ved pc smiler i kamera","focalPoint":{"x":0.33,"y":0.32},"lazyLoading":true},"imageFitBehavior":"fill","imageAlignment":"left","orientation":"horizontal","contentCardViewModel":{"title":"Malin følte seg rett og slett smartere","description":"For Malin Smådal (29) var det viktigste å utvikle seg, utfordre seg selv og åpne nye dører","callToActionLink":{"label":"Les hvordan Malin kombinerte nettstudier med jobb og familieliv","href":"/aktuelt/2026/06/malin-folte-seg-rett-og-slett-smartere/","external":false,"showIsExternal":true},"useLegacyLink":false,"variant":"darkRed","size":"large","buttonType":"circleButton"}};</script></div>
</section><section class="Richtext__block">

<div id="98f0aa17"><section id="ofte-stilte-sp-oslash-rsm-aring-l-om-fagskole-p-aring-nett" class="B_EDxoOxVgAU8kPXBQWa"><h2 class="FrR9v_ssranAjR5kDzwF Lz7bstkpq5d6FanMqkLu">Ofte stilte spørsmål om fagskole på nett</h2><div class="XmC_S2INgPyqbncnXLoy XL4KGq1qGQz8WwtKJ_pg"><div class="YKYBQ3jDmxdtO9SEemuL"><div class="uJgrlGAPM7ozrDvgjXt0"><ul class="csX3C9e9jiZog4fiK1f5"><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__53482" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Når kan jeg starte?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__53482" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent"><strong>Nettstudier med fast oppstart</strong> har studiestart to ganger i året: i uke 35 på høsten og uke 5 på våren. Som student får du tilgang til timeplan og eksakt startdato i Canvas når semesterstart nærmer seg.<p></p>
<p><strong>Nettstudier med fleksibel oppstart</strong> har oppstart hver dag, hele året. Du velger selv når du vil starte. Du får tilgang til Canvas på den datoen du har valgt som oppstartsdato.</p></div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__53483" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Når er søknadsfristen?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__53483" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent"><strong>Nettstudier med fast oppstart</strong> har løpende opptak så lenge det er ledige studieplasser og opptaket er åpent. Det lønner seg derfor å søke tidlig. Når alle studieplassene er fylt opp, kan det opprettes venteliste.<p></p>
<p>For å sikre studieplassen må du sende inn nødvendig dokumentasjon og takke ja til tilbudet innen fristen.</p>
<p><strong>Nettstudier med fleksibel oppstart</strong> har ingen søknadsfrist. Du kan søke hele året og velge ønsket oppstartsdato.</p></div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__53484" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Er det karakterkrav for å komme inn?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__53484" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">Nei. Det er ikke karakterene dine som avgjør om du får studieplass. Du må oppfylle opptakskravene, og ved studier med begrenset antall studieplasser er det viktig å søke tidlig.</div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__53485" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Kan jeg søke uten generell studiekompetanse?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__53485" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">Ja.&nbsp;<p></p>
<p>Opptakskravene kan variere mellom de ulike fagskoleutdanningene. Vanligvis kan du kvalifisere til opptak gjennom <strong>ett</strong> av følgende:</p>
<ul class="Richtext__ul">
<li>generell studiekompetanse</li>
<li>treårig yrkesfaglig opplæring</li>
<li>fagbrev eller svennebrev</li>
<li>realkompetansevurdering</li>
</ul>
<p>Du finner de detaljerte opptakskravene på siden til det enkelte studiet.</p>
<p><strong>Realkompetansevurdering</strong> kan være aktuelt dersom du ikke har generell studiekompetanse eller yrkeskompetanse. Realkompetanse er all formell og ikke-formell kompetanse du har opparbeidet deg gjennom blant annet utdanning, arbeid og fritid. Søknader på grunnlag av realkompetanse vurderes individuelt. Du må fylle 23 år i opptaksåret.</p>
<p>Har du utenlandsk utdanning eller annet morsmål enn norsk, kan det også være krav til dokumentasjon av norskkunnskaper. Se opptakskravene på studiesiden til det aktuelle nettstudiet.&nbsp;</p></div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__53486" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Hvordan foregår søknadsprosessen?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__53486" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent"><strong>Nettstudier med fast oppstart</strong><p></p>
<p>Når du søker på <a href="/soknad/">kristiania.no</a>, får du en søknadsbekreftelse på e-post. Du får deretter tilgang til søkeportalen «Min side for søkere», hvor du kan følge søknaden din og eventuelt laste opp dokumentasjon.</p>
<p>Når søknaden er behandlet, får du tilbud om studieplass dersom du oppfyller opptakskravene og det er ledig studieplass. På enkelte studier må du dokumentere at du oppfyller opptakskravene før du får tilbud om studieplass.</p>
<p>Når du har fått tilbud, må du takke ja til studieplassen innen fristen. Du vil da motta en kvitteringskopi på e-post.&nbsp;</p>
<p><strong>Nettstudier med fleksibel oppstart</strong></p>
<p>Når du søker på en fagskoleutdanning med fleksibel oppstart, velger du hvilke emner du ønsker å starte med og ønsket oppstartsdato. Du mottar deretter informasjon om videre prosess og laster opp nødvendig dokumentasjon via <a href="/login/?returnTo=/min-side/">Mitt Kristiania</a>.</p>
<p>Når opptaket er godkjent, får du tilgang til emnet/emnene i Canvas på valgt oppstartsdato.</p></div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__53487" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Hva koster et nettstudium?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__53487" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">Studieavgiften varierer mellom de ulike nettstudiene. Du finner aktuell pris på siden til det enkelte studiet.<p></p>
<p>I tillegg til eventuell studieavgift kommer semesteravgift til studentsamskipnaden. Det kan også komme kostnader til pensum og nødvendig utstyr. Du bør ha tilgang til egen PC eller Mac. Se studiesiden for informasjon om eventuelle krav til utstyr.</p>
<p><strong>Hva betyr fullfinansiert studium?</strong></p>
<p>Noen av fagskoleutdanningene med fast oppstart er fullfinansierte. Det betyr at <span>selve studiet er kostnadsfritt</span>, og du betaler kun semesteravgift og lisensavgift (350,-).</p>
<p>Se siden til det enkelte studiet for informasjon om hva som gjelder.</p>
<p><a href="/aktuelt/velg-fullfinansierte-studier-fra-kristiania/">Se alle fullfinansierte studier fra Kristiania her.</a></p>
<p><strong>Hva koster fleksible nettstudier?</strong></p>
<p>For fleksible nettstudier får du rabatt på studieavgiften:</p>
<ul class="Richtext__ul">
<li><span>60 studiepoeng:</span><span> 20 % rabatt med rabattkoden </span><span>FAGSKOLE20 </span></li>
<li><span>30 studiepoeng:</span><span> 10 % rabatt med rabattkoden </span><span>FAGSKOLE10 </span></li>
</ul>
<p>Du kan også ta ett eller flere emner av gangen. Når du legger inn emner i handlekurven, kan du velge <span>«del av et studieløp»</span> og få rabatt. Dersom du kun ønsker å ta ett enkeltstående emne, finner du aktuell pris på siden til emnet.</p>
<p>Studenter som tar utdanninger på <span>15 studiepoeng eller mer per semester</span>, må betale semesteravgift.</p>
<p><strong>Hva er semesteravgift?</strong></p>
<p>Som student ved Fagskolen Kristiania blir du automatisk medlem av <span>studensamskipnaden</span>, som Kristiania samarbeider med. Som medlem får du tilgang til blant annet helsetjenester, rådgivning, treningstilbud, rabatter og sosiale aktiviteter.</p>
<p>Semesteravgiften er obligatorisk og går til studentsamskipnaden.</p></div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__53488" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Er nettstudier lånekassegodkjent?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__53488" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent"><span>Ja! </span><span>Alle nettstudiene ved Kristiania er godkjent for støtte hos Lånekassen.</span><p></p>
<p>Hvor mye støtte du kan få, avhenger blant annet av studiebelastning og din situasjon. Du finner oppdatert informasjon om støtteordningene hos Lånekassen.</p>
<p><a href="/studere-hos-oss/opptaksinformasjon/lanekassen/#nettstudier">Her kan du lese mer om hvordan du søker hos Lånekassen.</a></p></div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__53489" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Hvordan er nettstudiene lagt opp?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__53489" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent"><strong>Nettstudier med fast oppstart</strong><p></p>
<p>Studiene gjennomføres på deltid med fast progresjon. Du følger et klassemiljø med medstudenter og har jevnlige digitale samlinger, arbeidskrav og innleveringer.</p>
<p>Du får tett faglig oppfølging gjennom studieløpet. Samlingene tas opp, slik at du kan se dem i etterkant dersom du ikke har anledning til å delta.</p>
<p>I Canvas får du tilgang til undervisningsmateriell og kan kommunisere med medstudenter og faglærere.</p>
<p>Les mer om&nbsp;<a href="/fagskolen-kristiania/nettstudier/slik-studerer-du-pa-nett/">hvordan nettstudiene er lagt opp her</a>.</p>
<p><strong>&nbsp;Nettstudier med fleksibel oppstart</strong></p>
<p>Du gjennomfører studiet i eget tempo og kan tilpasse studiehverdagen etter din egen situasjon. Du velger selv når du vil starte og kan jobbe med emnene når det passer deg.</p>
<p>I Canvas får du tilgang til faglig innhold, oppgaver, videoer og andre læringsaktiviteter. Du har også tilgang til faglærer, som gir tilbakemeldinger på obligatoriske oppgaver underveis.</p></div></div></div></div></div></li></ul></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['98f0aa17-json'] = {"id":"ofte-stilte-sp-oslash-rsm-aring-l-om-fagskole-p-aring-nett","heading":{"value":"Ofte stilte sp&oslash;rsm&aring;l om fagskole p&aring; nett"},"accordionItems":[{"id":"162094","displayName":"Når kan jeg starte?","introText":{"value":"<strong>Nettstudier med fast oppstart</strong> har studiestart to ganger i &aring;ret: i uke 35 p&aring; h&oslash;sten og uke 5 p&aring; v&aring;ren. Som student f&aring;r du tilgang til timeplan og eksakt startdato i Canvas n&aring;r semesterstart n&aelig;rmer seg.</p>\n<p><strong>Nettstudier med fleksibel oppstart</strong> har oppstart hver dag, hele &aring;ret. Du velger selv n&aring;r du vil starte. Du f&aring;r tilgang til Canvas p&aring; den datoen du har valgt som oppstartsdato."},"callToAction":null,"linkAsButton":false},{"id":"162095","displayName":"Når er søknadsfristen?","introText":{"value":"<strong>Nettstudier med fast oppstart</strong> har l&oslash;pende opptak s&aring; lenge det er ledige studieplasser og opptaket er &aring;pent. Det l&oslash;nner seg derfor &aring; s&oslash;ke tidlig. N&aring;r alle studieplassene er fylt opp, kan det opprettes venteliste.</p>\n<p>For &aring; sikre studieplassen m&aring; du sende inn n&oslash;dvendig dokumentasjon og takke ja til tilbudet innen fristen.</p>\n<p><strong>Nettstudier med fleksibel oppstart</strong> har ingen s&oslash;knadsfrist. Du kan s&oslash;ke hele &aring;ret og velge &oslash;nsket oppstartsdato."},"callToAction":null,"linkAsButton":false},{"id":"162096","displayName":"Er det karakterkrav for å komme inn?","introText":{"value":"Nei. Det er ikke karakterene dine som avgj&oslash;r om du f&aring;r studieplass. Du m&aring; oppfylle opptakskravene, og ved studier med begrenset antall studieplasser er det viktig &aring; s&oslash;ke tidlig."},"callToAction":null,"linkAsButton":false},{"id":"162097","displayName":"Kan jeg søke uten generell studiekompetanse?","introText":{"value":"Ja.&nbsp;</p>\n<p>Opptakskravene kan variere mellom de ulike fagskoleutdanningene. Vanligvis kan du kvalifisere til opptak gjennom <strong>ett</strong> av f&oslash;lgende:</p>\n<ul class=\"Richtext__ul\">\n<li>generell studiekompetanse</li>\n<li>tre&aring;rig yrkesfaglig oppl&aelig;ring</li>\n<li>fagbrev eller svennebrev</li>\n<li>realkompetansevurdering</li>\n</ul>\n<p>Du finner de detaljerte opptakskravene p&aring; siden til det enkelte studiet.</p>\n<p><strong>Realkompetansevurdering</strong> kan v&aelig;re aktuelt dersom du ikke har generell studiekompetanse eller yrkeskompetanse. Realkompetanse er all formell og ikke-formell kompetanse du har opparbeidet deg gjennom blant annet utdanning, arbeid og fritid. S&oslash;knader p&aring; grunnlag av realkompetanse vurderes individuelt. Du m&aring; fylle 23 &aring;r i opptaks&aring;ret.</p>\n<p>Har du utenlandsk utdanning eller annet morsm&aring;l enn norsk, kan det ogs&aring; v&aelig;re krav til dokumentasjon av norskkunnskaper. Se opptakskravene p&aring; studiesiden til det aktuelle nettstudiet.&nbsp;"},"callToAction":null,"linkAsButton":false},{"id":"162106","displayName":"Hvordan foregår søknadsprosessen?","introText":{"value":"<strong>Nettstudier med fast oppstart</strong></p>\n<p>N&aring;r du s&oslash;ker p&aring; <a href=\"/soknad/\">kristiania.no</a>, f&aring;r du en s&oslash;knadsbekreftelse p&aring; e-post. Du f&aring;r deretter tilgang til s&oslash;keportalen &laquo;Min side for s&oslash;kere&raquo;, hvor du kan f&oslash;lge s&oslash;knaden din og eventuelt laste opp dokumentasjon.</p>\n<p>N&aring;r s&oslash;knaden er behandlet, f&aring;r du tilbud om studieplass dersom du oppfyller opptakskravene og det er ledig studieplass. P&aring; enkelte studier m&aring; du dokumentere at du oppfyller opptakskravene f&oslash;r du f&aring;r tilbud om studieplass.</p>\n<p>N&aring;r du har f&aring;tt tilbud, m&aring; du takke ja til studieplassen innen fristen. Du vil da motta en kvitteringskopi p&aring; e-post.&nbsp;</p>\n<p><strong>Nettstudier med fleksibel oppstart</strong></p>\n<p>N&aring;r du s&oslash;ker p&aring; en fagskoleutdanning med fleksibel oppstart, velger du hvilke emner du &oslash;nsker &aring; starte med og &oslash;nsket oppstartsdato. Du mottar deretter informasjon om videre prosess og laster opp n&oslash;dvendig dokumentasjon via <a href=\"/login/?returnTo=/min-side/\">Mitt Kristiania</a>.</p>\n<p>N&aring;r opptaket er godkjent, f&aring;r du tilgang til emnet/emnene i Canvas p&aring; valgt oppstartsdato."},"callToAction":null,"linkAsButton":false},{"id":"162316","displayName":"Hva koster et nettstudium?","introText":{"value":"Studieavgiften varierer mellom de ulike nettstudiene. Du finner aktuell pris p&aring; siden til det enkelte studiet.</p>\n<p>I tillegg til eventuell studieavgift kommer semesteravgift til studentsamskipnaden. Det kan ogs&aring; komme kostnader til pensum og n&oslash;dvendig utstyr. Du b&oslash;r ha tilgang til egen PC eller Mac. Se studiesiden for informasjon om eventuelle krav til utstyr.</p>\n<p><strong>Hva betyr fullfinansiert studium?</strong></p>\n<p>Noen av fagskoleutdanningene med fast oppstart er fullfinansierte. Det betyr at <span>selve studiet er kostnadsfritt</span>, og du betaler kun semesteravgift og lisensavgift (350,-).</p>\n<p>Se siden til det enkelte studiet for informasjon om hva som gjelder.</p>\n<p><a href=\"/aktuelt/velg-fullfinansierte-studier-fra-kristiania/\">Se alle fullfinansierte studier fra Kristiania her.</a></p>\n<p><strong>Hva koster fleksible nettstudier?</strong></p>\n<p>For fleksible nettstudier f&aring;r du rabatt p&aring; studieavgiften:</p>\n<ul class=\"Richtext__ul\">\n<li><span>60 studiepoeng:</span><span> 20 % rabatt med rabattkoden </span><span>FAGSKOLE20 </span></li>\n<li><span>30 studiepoeng:</span><span> 10 % rabatt med rabattkoden </span><span>FAGSKOLE10 </span></li>\n</ul>\n<p>Du kan ogs&aring; ta ett eller flere emner av gangen. N&aring;r du legger inn emner i handlekurven, kan du velge <span>&laquo;del av et studiel&oslash;p&raquo;</span> og f&aring; rabatt. Dersom du kun &oslash;nsker &aring; ta ett enkeltst&aring;ende emne, finner du aktuell pris p&aring; siden til emnet.</p>\n<p>Studenter som tar utdanninger p&aring; <span>15 studiepoeng eller mer per semester</span>, m&aring; betale semesteravgift.</p>\n<p><strong>Hva er semesteravgift?</strong></p>\n<p>Som student ved Fagskolen Kristiania blir du automatisk medlem av <span>studensamskipnaden</span>, som Kristiania samarbeider med. Som medlem f&aring;r du tilgang til blant annet helsetjenester, r&aring;dgivning, treningstilbud, rabatter og sosiale aktiviteter.</p>\n<p>Semesteravgiften er obligatorisk og g&aring;r til studentsamskipnaden."},"callToAction":null,"linkAsButton":false},{"id":"162319","displayName":"Er nettstudier lånekassegodkjent?","introText":{"value":"<span>Ja! </span><span>Alle nettstudiene ved Kristiania er godkjent for st&oslash;tte hos L&aring;nekassen.</span></p>\n<p>Hvor mye st&oslash;tte du kan f&aring;, avhenger blant annet av studiebelastning og din situasjon. Du finner oppdatert informasjon om st&oslash;tteordningene hos L&aring;nekassen.</p>\n<p><a href=\"/studere-hos-oss/opptaksinformasjon/lanekassen/#nettstudier\">Her kan du lese mer om hvordan du s&oslash;ker hos L&aring;nekassen.</a>"},"callToAction":null,"linkAsButton":false},{"id":"162321","displayName":"Hvordan er nettstudiene lagt opp?","introText":{"value":"<strong>Nettstudier med fast oppstart</strong></p>\n<p>Studiene gjennomf&oslash;res p&aring; deltid med fast progresjon. Du f&oslash;lger et klassemilj&oslash; med medstudenter og har jevnlige digitale samlinger, arbeidskrav og innleveringer.</p>\n<p>Du f&aring;r tett faglig oppf&oslash;lging gjennom studiel&oslash;pet. Samlingene tas opp, slik at du kan se dem i etterkant dersom du ikke har anledning til &aring; delta.</p>\n<p>I Canvas f&aring;r du tilgang til undervisningsmateriell og kan kommunisere med medstudenter og fagl&aelig;rere.</p>\n<p>Les mer om&nbsp;<a href=\"/fagskolen-kristiania/nettstudier/slik-studerer-du-pa-nett/\">hvordan nettstudiene er lagt opp her</a>.</p>\n<p><strong>&nbsp;Nettstudier med fleksibel oppstart</strong></p>\n<p>Du gjennomf&oslash;rer studiet i eget tempo og kan tilpasse studiehverdagen etter din egen situasjon. Du velger selv n&aring;r du vil starte og kan jobbe med emnene n&aring;r det passer deg.</p>\n<p>I Canvas f&aring;r du tilgang til faglig innhold, oppgaver, videoer og andre l&aelig;ringsaktiviteter. Du har ogs&aring; tilgang til fagl&aelig;rer, som gir tilbakemeldinger p&aring; obligatoriske oppgaver underveis."},"callToAction":null,"linkAsButton":false}]};</script></div>
</section><section class="Richtext__block">

<div id="89a07e82"><div class="T9s2xkF6zj_7pUCGDUHb"><div class="LQwCx4VsA_20nL7PJl_A UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef nuydYi_Wd6zwyeTcuMig" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/db9083e61b814f86b8c60ac3fe99dab0/bestill-veiledning-jo.jpg?width=375 375w, /contentassets/db9083e61b814f86b8c60ac3fe99dab0/bestill-veiledning-jo.jpg?width=500 500w, /contentassets/db9083e61b814f86b8c60ac3fe99dab0/bestill-veiledning-jo.jpg?width=768 768w, /contentassets/db9083e61b814f86b8c60ac3fe99dab0/bestill-veiledning-jo.jpg?width=1024 1024w"><img src="/contentassets/db9083e61b814f86b8c60ac3fe99dab0/bestill-veiledning-jo.jpg?width=500" alt="Person ser i kamera med rød lue utenfor Kristiania Campus" style="object-position:45% 47%" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA lwj1fS09bnWFOXW1AKFu"><h2 class="ZiduBuPrxHXQhabvP6SQ">Kontakt oss</h2><div class="BrxHX8d3IdyRW2EN5wWq">Har du spørsmål om våre studier, søknadsprosessen, opptakskrav eller hvordan det faktisk er å studere? Bestill en uforpliktende studieveiledning her!</div><a href="https://bookings.cloud.microsoft/book/Bestillveiledningstudier@egms.onmicrosoft.com/?ismsaljsauthenabled=true" title="Bestill veiledning her" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" target="_blank" rel="noopener noreferrer" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Bestill veiledning her</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['89a07e82-json'] = {"image