<div id="5ff2df60"><div class="wpzR7Ubo_xEutl52Zp75 KlGxSEqTI292tgJncb5g"><div class="V8aOwwiJRFBxJgusm4aF"><div class="remSENexFlbG30oZzt_h iMpK2rC3YIXyLMIJ0FpQ"><ul class="yNGO7WHwhaEM3FcSwcNJ rDMWsGczj8DJuJw6oY0Z qfLA3b6B9Wn1nFrFWcfS"><li><div class="DpBBdJZCNvH11Iv1zDLu"><a href="/for-studenter/karriere/karriere-og-praksisveiledning/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q klC6xPNTZ6AQDOpmaCtZ" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Bestill karriereveiledning</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></li><li><div class="DpBBdJZCNvH11Iv1zDLu"><a href="/for-studenter/karriere/karrieredagene-kristiania/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q klC6xPNTZ6AQDOpmaCtZ" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Karrieredagene</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></li><li><div class="DpBBdJZCNvH11Iv1zDLu"><a href="https://app.candeno.com/login?lang=no" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q klC6xPNTZ6AQDOpmaCtZ" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Karriereportal</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></li><li><div class="DpBBdJZCNvH11Iv1zDLu"><a href="/arbeidsliv/alumni/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q klC6xPNTZ6AQDOpmaCtZ" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Kristiania Alumni</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></li></ul></div></div></div><script>(window.__reactProps = window.__reactProps || {})['5ff2df60-json'] = {"type":"plain","items":[{"link":{"label":"Bestill karriereveiledning","href":"/for-studenter/karriere/karriere-og-praksisveiledning/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Karrieredagene","href":"/for-studenter/karriere/karrieredagene-kristiania/","external":false,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Karriereportal","href":"https://app.candeno.com/login?lang=no","external":true,"showIsExternal":true},"additionalNotes":null},{"link":{"label":"Kristiania Alumni","href":"/arbeidsliv/alumni/","external":false,"showIsExternal":true},"additionalNotes":null}],"title":"","description":null,"variant":"white","columnsLayout":"double"};</script></div>
