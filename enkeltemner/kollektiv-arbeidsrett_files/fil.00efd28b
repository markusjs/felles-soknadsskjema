    <main id="mainContent">
        <script>const GLOBAL_CONTEXT={"contentLanguage":"norwegian","isModernPage":true,"logoSettings":{"headerVariant":"default","defaultAltText":"Kristiania logo","headerAltText":"Kristiania logo"},"frontendSettings":{"checkboxVariant":"default","enableMyPageBreadcrumbs":true},"myPageGlobalConfiguration":null};</script>


<article class="Page SectionPage">
    <div id="3b014f37"><div class="KL9_OjJF_WIv4QAJIRsp NBcU6wm7Ql3ucaRy0EDH"><div class="VzZYZpe50JO2h5FBr4N5"><ol class="jIjgn7qoTMH3b4e0jW3j ElJvRYAzb3LOesAtWOY3" id="breadcrumbs"><li><a class="QqohSkg5NSBKEgLCAL46" href="/">Kristiania</a></li><li><a class="QqohSkg5NSBKEgLCAL46" href="/studere-hos-oss/opptaksinformasjon/">Opptaksinformasjon</a></li><li><a class="QqohSkg5NSBKEgLCAL46">Lånekassen</a></li></ol><div class="_F4aP0i0hzV9vBAPo3P7"><div class="cPhlwLgkNO_8rPuimnOV"><h1 class="j3qgdNbfXpLB3KO3Z2Hg eA1uKeTzBrhrjsSLuTEs">L&aring;nekassen</h1><div class="oW0xSqTqKcSkxv2BQAiF">P&aring; denne siden f&aring;r du svar p&aring; ofte stilte sp&oslash;rsm&aring;l om L&aring;nekassen og hvordan du g&aring;r frem for &aring; s&oslash;ke om l&aring;n og stipend til studier med fast og fri progresjon.</div></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['3b014f37-json'] = {"heading":{"value":"L&aring;nekassen"},"intro":{"value":"P&aring; denne siden f&aring;r du svar p&aring; ofte stilte sp&oslash;rsm&aring;l om L&aring;nekassen og hvordan du g&aring;r frem for &aring; s&oslash;ke om l&aring;n og stipend til studier med fast og fri progresjon."},"headingSize":"medium","variant":"red","image":null,"videoUrl":null,"breadcrumbs":{"breadcrumbs":[{"name":"Kristiania","link":"/"},{"name":"Opptaksinformasjon","link":"/studere-hos-oss/opptaksinformasjon/"},{"name":"Lånekassen","link":null}]}};</script></div>

    <div class="Page__body">
        <div class="Richtext Richtext--wide">
            
<section class="Richtext__block">

<div id="32705f02"></div>

<section class="TextSection TextSection--transparent TextSection--rounded">
    <div class="TextSection__content">
        <div class="TextSection__body">
            
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content RichtextContent--dark PageLayout__content"><p>Det er litt ulike prosesser for å søke om lån til studier med fast progresjon og studier med fri progresjon. Under finner du veiledende informasjon for begge gjennomføringsmodellene.&nbsp;</p>
<p><span>Hopp til informasjon om&nbsp;<a href="/studere-hos-oss/opptaksinformasjon/lanekassen/#nettstudier">studier med fri progresjon</a>.</span></p>
<p><span><strong>NB!</strong> Kristiania er ikke en part i avtalen mellom Lånekassen og deg som student. Informasjonen på disse sidene er kun veiledende.&nbsp;Ta kontakt med <a href="https://lanekassen.no/nb-NO/">Lånekassen</a> for ytterligere spørsmål eller informasjon.</span></p></div></div></div>

        </div>
    </div>
</section>
</section><section class="Richtext__block">


<div id="66c2a999"></div>

<section class="TextSection TextSection--transparent TextSection--rounded">
    <div class="TextSection__content">
<div class="wrapper"><div class="PageLayout__grid"><div class="PageLayout__content Richtext__content">                <h2 class="TextSection__heading">Studier med fast progresjon</h2>
</div></div></div>        <div class="TextSection__body">
            
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content RichtextContent--dark PageLayout__content"><p>Dette er studier med oppstart én til to ganger i året med fastsatte rammer og fremdrift i studieløpet.&nbsp;</p>
<p><strong>Dette gjelder:</strong></p>
<ul class="Richtext__ul">
<li>campusstudier i Oslo eller Bergen</li>
<li>fagskoleutdanning på nett (deltid)</li>
<li>erfaringsbasert master</li>
</ul>
</div></div></div><section class="Richtext__block">
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="e1921727"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Får jeg støtte fra Lånekassen når jeg studerer på Kristiania?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__118962"><div class="RichtextContent RichtextContent--dark">Alle våre studier i Oslo og Bergen er offentlig godkjent og gir rett til å søke lån og stipend fra Lånekassen.&nbsp;</div></div></div><button aria-expanded="false" aria-controls="FactBox__118962" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['e1921727-json'] = {"heading":"Får jeg støtte fra Lånekassen når jeg studerer på Kristiania?","variant":"light","content":{"value":"Alle v&aring;re studier i Oslo og Bergen er offentlig godkjent og gir rett til &aring; s&oslash;ke l&aring;n og stipend fra L&aring;nekassen.&nbsp;"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="811aca03"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Når kan jeg søke om støtte fra Lånekassen?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__122804"><div class="RichtextContent RichtextContent--dark"><span>Du kan </span><span><a href="https://lanekassen.no/nb-NO/stipend-og-lan/">søke om støtte fra Lånekassen</a> så fort du har fått studieplass.&nbsp;</span><p></p>
<p>For at Lånekassen skal kunne behandle din søknad om stipend og lån, må du ha <a href="/for-studenter/studentweb/">semesterregistrert deg i StudentWeb</a>.</p>
<p>Etter at du har semesterregistrert deg, vil Lånekassen sende ut gjeldsbrev som du må signere og returnere før første utbetaling foretas. Du kan semesterregistrere deg fra begynnelsen av august.</p></div></div></div><button aria-expanded="false" aria-controls="FactBox__122804" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['811aca03-json'] = {"heading":"Når kan jeg søke om støtte fra Lånekassen?","variant":"light","content":{"value":"<span>Du kan </span><span><a href=\"https://lanekassen.no/nb-NO/stipend-og-lan/\">s&oslash;ke om st&oslash;tte fra L&aring;nekassen</a> s&aring; fort du har f&aring;tt studieplass.&nbsp;</span></p>\n<p>For at L&aring;nekassen skal kunne behandle din s&oslash;knad om stipend og l&aring;n, m&aring; du ha <a href=\"/for-studenter/studentweb/\">semesterregistrert deg i StudentWeb</a>.</p>\n<p>Etter at du har semesterregistrert deg, vil L&aring;nekassen sende ut gjeldsbrev som du m&aring; signere og returnere f&oslash;r f&oslash;rste utbetaling foretas. Du kan semesterregistrere deg fra begynnelsen av august."},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="0badbcb0"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Hva må jeg vite før jeg søker støtte?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__118963"><div class="RichtextContent RichtextContent--dark"><strong>Støtten vurderes ut fra:</strong><p></p>
<ol class="Richtext__ol">
<li>Studiebelastning – hvor mange studiepoeng du tar</li>
<li>Studieperiode – når du starter og når du avslutter studiet.</li>
</ol>
<p>Vi anbefaler at du leser gjennom informasjon på Lånekassens sider angående <a href="https://www.lanekassen.no/nb-NO/Stipend-og-lan/utdanning-i-norge/Hoyere-utdanning/krav-og-vilkar-for-a-fa-stotte/forsinket/">studieprogresjon</a>&nbsp;og&nbsp;<a href="https://www.lanekassen.no/opplysningsplikt">ditt ansvar</a>&nbsp;i henhold til dette.</p></div></div></div><button aria-expanded="false" aria-controls="FactBox__118963" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['0badbcb0-json'] = {"heading":"Hva må jeg vite før jeg søker støtte?","variant":"light","content":{"value":"<strong>St&oslash;tten vurderes ut fra:</strong></p>\n<ol class=\"Richtext__ol\">\n<li>Studiebelastning &ndash; hvor mange studiepoeng du tar</li>\n<li>Studieperiode &ndash; n&aring;r du starter og n&aring;r du avslutter studiet.</li>\n</ol>\n<p>Vi anbefaler at du leser gjennom informasjon p&aring; L&aring;nekassens sider ang&aring;ende <a href=\"https://www.lanekassen.no/nb-NO/Stipend-og-lan/utdanning-i-norge/Hoyere-utdanning/krav-og-vilkar-for-a-fa-stotte/forsinket/\">studieprogresjon</a>&nbsp;og&nbsp;<a href=\"https://www.lanekassen.no/opplysningsplikt\">ditt ansvar</a>&nbsp;i henhold til dette."},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="ef7e0344"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Hvordan går jeg frem for å søke om støtte?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__122805"><div class="RichtextContent RichtextContent--dark"><a href="https://www.lanekassen.no/nb-NO/stipend-og-lan/norge/universitet-og-hogskole/soknad-for-universitet-og-hogskole/">Gå til Lånekassen</a><span>&nbsp;</span>og fyll ut søknaden trinn for trinn. Velg Kristiania som lærested og den utdanningen du har søkt på.<p></p>
<p>Du må også velge avslutningsmåned og år for graden/utdanningen du er i gang med.</p></div></div></div><button aria-expanded="false" aria-controls="FactBox__122805" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['ef7e0344-json'] = {"heading":"Hvordan går jeg frem for å søke om støtte?","variant":"light","content":{"value":"<a href=\"https://www.lanekassen.no/nb-NO/stipend-og-lan/norge/universitet-og-hogskole/soknad-for-universitet-og-hogskole/\">G&aring; til L&aring;nekassen</a><span>&nbsp;</span>og fyll ut s&oslash;knaden trinn for trinn. Velg Kristiania som l&aelig;rested og den utdanningen du har s&oslash;kt p&aring;.</p>\n<p>Du m&aring; ogs&aring; velge avslutningsm&aring;ned og &aring;r for graden/utdanningen du er i gang med."},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="beb82017"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Hvor mye kan jeg få i støtte?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__118964"><div class="RichtextContent RichtextContent--dark"><span>Ettersom alle studiene hos Kristiania er offentlig godkjent, gir det deg mulighet til å søke om både basisstøtte og lån til skolepenger. Akkurat hvor mye du får utbetalt vurderes av Lånekassen.&nbsp;</span><p></p>
<p><span><a href="https://lanekassen.no/nb-NO/stipend-og-lan/">Sjekk hvor mye stipend og lån du kan få på Lånekassens sider</a>.</span></p></div></div></div><button aria-expanded="false" aria-controls="FactBox__118964" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['beb82017-json'] = {"heading":"Hvor mye kan jeg få i støtte?","variant":"light","content":{"value":"<span>Ettersom alle studiene hos Kristiania er offentlig godkjent, gir det deg mulighet til &aring; s&oslash;ke om b&aring;de basisst&oslash;tte og l&aring;n til skolepenger. Akkurat hvor mye du f&aring;r utbetalt vurderes av L&aring;nekassen.&nbsp;</span></p>\n<p><span><a href=\"https://lanekassen.no/nb-NO/stipend-og-lan/\">Sjekk hvor mye stipend og l&aring;n du kan f&aring; p&aring; L&aring;nekassens sider</a>.</span>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="dbb31d36"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Når får jeg utbetalt støtten?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__122806"><div class="RichtextContent RichtextContent--dark"><span>Dette avhenger av når du søkte i Lånekassen og saksbehandlingstiden der. Lånekassen vil først utbetale studielån etter at du har bekreftet utdanningsplanen din i Studentweb. Dette gjøres i oppstartsuken.</span></div></div></div><button aria-expanded="false" aria-controls="FactBox__122806" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['dbb31d36-json'] = {"heading":"Når får jeg utbetalt støtten?","variant":"light","content":{"value":"<span>Dette avhenger av n&aring;r du s&oslash;kte i L&aring;nekassen og saksbehandlingstiden der. L&aring;nekassen vil f&oslash;rst utbetale studiel&aring;n etter at du har bekreftet utdanningsplanen din i Studentweb. Dette gj&oslash;res i oppstartsuken.</span>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section>

        </div>
    </div>
</section>
</section><div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
<p>&nbsp;<a id="nettstudier"></a>&nbsp;</p>
</div></div></div><section class="Richtext__block">

<div id="56c66da3"></div>

<section class="TextSection TextSection--transparent TextSection--rounded">
    <div class="TextSection__content">
<div class="wrapper"><div class="PageLayout__grid"><div class="PageLayout__content Richtext__content">                <h2 class="TextSection__heading">Studier med fri progresjon</h2>
</div></div></div>        <div class="TextSection__body">
            
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content RichtextContent--dark PageLayout__content"><p>Dette er nettstudier med fleksibel oppstart hver dag, hele året. Studiene har fri progresjon, som betyr at du legger opp studieløpet selv innenfor studierettsperioden.</p>
<p><strong>Dette gjelder:</strong></p>
<ul class="Richtext__ul">
<li>nettbaserte emner og studier på høyskole</li>
<li>nettbaserte emner og studier på fagskole</li>
</ul>
</div></div></div><section class="Richtext__block">
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="a6bbff58"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Når kan jeg søke om lån/stipend fra Lånekassen?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__118965"><div class="RichtextContent RichtextContent--dark"><span>Du kan søke om lån/stipend hos Lånekassen når du har meldt deg på ett eller flere emner hos oss. Når man bestiller emner på nett, anbefales det at man er tidlig ute med bestilling, da Lånekassen har periodevis lang behandlingstid.</span><br><br><strong>Vårsemesteret:</strong><span>&nbsp;bestill i november/desember og flytt startdatoen din frem til 16. januar (starten på vårsemesteret hos Lånekassen).</span><br><br><strong>Høstsemesteret</strong><span>: bestill i juni og flytt startdatoen din frem til f.eks. 16. august (starten på høstsemesteret).</span><p></p>
<p>Vi kan bekrefte at du er student til Lånekassen når du har:</p>
<ul class="Richtext__ul">
<li>fått innvilget opptak</li>
<li>bestillingen din er ferdig behandlet (gjelder også godkjenning av betalingsalternativet)</li>
<li>vi har mottatt bekreftelse på når du skal avlegge eksamen</li>
</ul>
<p>Ved å bestille i god tid kan søknaden din behandles hos Lånekassen frem mot startdatoen. Da vil heller ikke betalingsforfall og oppsigelse løpe før ønsket startdato.</p>
<p>Søknadsfristen er 15. mars dersom du ønsker lån/stipend for vårsemesteret og 15. november dersom du ønsker lån/stipend for høstsemesteret. Lånekassen gir ikke støtte for perioden 16. juni til 15. august.&nbsp;<br><br>Det er ikke anledning til å ta forbehold om at du får lån/stipend hos Lånekassen. Angrefristen/oppsigelsen er på 14 dager etter at du har fått tilgang til emnet/emnene i læringsportalen. Betalingsfristen må overholdes uavhengig av søknaden hos Lånekassen. Når du får svar fra Lånekassen, er det opp til deres behandlingstid.<br><br><a href="https://www.lanekassen.no/nb-NO/" target="_blank" rel="noopener">Du er selv ansvarlig for å kjenne til Lånekassen sine regler og forskrifter, som du finner på Lånekassen sine hjemmesider.</a></p></div></div></div><button aria-expanded="false" aria-controls="FactBox__118965" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['a6bbff58-json'] = {"heading":"Når kan jeg søke om lån/stipend fra Lånekassen?","variant":"light","content":{"value":"<span>Du kan s&oslash;ke om l&aring;n/stipend hos L&aring;nekassen n&aring;r du har meldt deg p&aring; ett eller flere emner hos oss. N&aring;r man bestiller emner p&aring; nett, anbefales det at man er tidlig ute med bestilling, da L&aring;nekassen har periodevis lang behandlingstid.</span><br /><br /><strong>V&aring;rsemesteret:</strong><span>&nbsp;bestill i november/desember og flytt startdatoen din frem til 16. januar (starten p&aring; v&aring;rsemesteret hos L&aring;nekassen).</span><br /><br /><strong>H&oslash;stsemesteret</strong><span>: bestill i juni og flytt startdatoen din frem til f.eks. 16. august (starten p&aring; h&oslash;stsemesteret).</span></p>\n<p>Vi kan bekrefte at du er student til L&aring;nekassen n&aring;r du har:</p>\n<ul class=\"Richtext__ul\">\n<li>f&aring;tt innvilget opptak</li>\n<li>bestillingen din er ferdig behandlet (gjelder ogs&aring; godkjenning av betalingsalternativet)</li>\n<li>vi har mottatt bekreftelse p&aring; n&aring;r du skal avlegge eksamen</li>\n</ul>\n<p>Ved &aring; bestille i god tid kan s&oslash;knaden din behandles hos L&aring;nekassen frem mot startdatoen. Da vil heller ikke betalingsforfall og oppsigelse l&oslash;pe f&oslash;r &oslash;nsket startdato.</p>\n<p>S&oslash;knadsfristen er 15. mars dersom du &oslash;nsker l&aring;n/stipend for v&aring;rsemesteret og 15. november dersom du &oslash;nsker l&aring;n/stipend for h&oslash;stsemesteret. L&aring;nekassen gir ikke st&oslash;tte for perioden 16. juni til 15. august.&nbsp;<br /><br />Det er ikke anledning til &aring; ta forbehold om at du f&aring;r l&aring;n/stipend hos L&aring;nekassen. Angrefristen/oppsigelsen er p&aring; 14 dager etter at du har f&aring;tt tilgang til emnet/emnene i l&aelig;ringsportalen. Betalingsfristen m&aring; overholdes uavhengig av s&oslash;knaden hos L&aring;nekassen. N&aring;r du f&aring;r svar fra L&aring;nekassen, er det opp til deres behandlingstid.<br /><br /><a href=\"https://www.lanekassen.no/nb-NO/\" target=\"_blank\" rel=\"noopener\">Du er selv ansvarlig for &aring; kjenne til L&aring;nekassen sine regler og forskrifter, som du finner p&aring; L&aring;nekassen sine hjemmesider.</a>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="36cc4651"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Viktig informasjon før du søker</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__122807"><div class="RichtextContent RichtextContent--dark"><strong>Lån/stipend vurderes ut fra:</strong><br><br><span>1. Studiebelastning - hvor mange studiepoeng du tar i din studieperiode, i tilknytning til Lånekassen sine semestre.</span><br><br><span>2. Studieperiode - når du starter og når du avslutter emnet/emnene (avlegger eksamen).</span><br><br><span>NB! Studieperioden din må være på minimum 4 måneder fra startdato til sluttdato (når du skal avlegge eksamen). Høstsemesteret hos Lånekassen går fra 16. august til 15. januar og vårsemesteret går fra 16. januar til 15. juni.</span><br><span>Se også avsnittet «Hvordan beregnes lån/stipend?».</span><br><br><span>Informasjon om studiepoeng finner du på nettsidene til det aktuelle emnet. Her kan du også se om emnet er støtteberettiget hos Lånekassen.</span><br><br><a href="https://www.lanekassen.no/nb-NO/" target="_blank" rel="noopener">Du er selv ansvarlig for å kjenne til Lånekassen sine regler og forskrifter, som du finner på Lånekassen sine hjemmesider.</a></div></div></div><button aria-expanded="false" aria-controls="FactBox__122807" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['36cc4651-json'] = {"heading":"Viktig informasjon før du søker","variant":"light","content":{"value":"<strong>L&aring;n/stipend vurderes ut fra:</strong><br /><br /><span>1. Studiebelastning - hvor mange studiepoeng du tar i din studieperiode, i tilknytning til L&aring;nekassen sine semestre.</span><br /><br /><span>2. Studieperiode - n&aring;r du starter og n&aring;r du avslutter emnet/emnene (avlegger eksamen).</span><br /><br /><span>NB! Studieperioden din m&aring; v&aelig;re p&aring; minimum 4 m&aring;neder fra startdato til sluttdato (n&aring;r du skal avlegge eksamen). H&oslash;stsemesteret hos L&aring;nekassen g&aring;r fra 16. august til 15. januar og v&aring;rsemesteret g&aring;r fra 16. januar til 15. juni.</span><br /><span>Se ogs&aring; avsnittet &laquo;Hvordan beregnes l&aring;n/stipend?&raquo;.</span><br /><br /><span>Informasjon om studiepoeng finner du p&aring; nettsidene til det aktuelle emnet. Her kan du ogs&aring; se om emnet er st&oslash;tteberettiget hos L&aring;nekassen.</span><br /><br /><a href=\"https://www.lanekassen.no/nb-NO/\" target=\"_blank\" rel=\"noopener\">Du er selv ansvarlig for &aring; kjenne til L&aring;nekassen sine regler og forskrifter, som du finner p&aring; L&aring;nekassen sine hjemmesider.</a>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="e984575c"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Hvordan beregnes lån/stipend?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__118966"><div class="RichtextContent RichtextContent--dark"><span>Lån/stipend regnes ut ifra den reelle studiebelastningen du har. Dersom du tar 30 studiepoeng i semesteret, tilsvarer dette heltidsstudium, og tar du 15 studiepoeng i semesteret, tilsvarer det deltidsstudium. Det gis ikke lån/stipend for mer enn 30 studiepoeng i semesteret.</span><p></p>
<p>Du kan bruke<span>&nbsp;</span><a href="https://lanekassen.no/nb-NO/stipend-og-lan/">Lånekassens kalkulator</a><span>&nbsp;</span>for å regne ut lån og stipend.<br><br>Vær obs. på Lånekassens semestre. Ett semester er mellom fire og fem måneder, 150 dager. Akkurat fem måneder eller mer kan vurderes som en lengre studieperiode enn ett semester. <br><br>For eksempel: 16. august til 15. januar er ett semester, mens 16. august til 16. januar kan regnes som mer enn ett semester.<br><br><a href="https://www.lanekassen.no/nb-NO/" target="_blank" rel="noopener">Du er selv ansvarlig for å kjenne til Lånekassen sine regler og forskrifter, som du finner på Lånekassen sine hjemmesider.</a></p></div></div></div><button aria-expanded="false" aria-controls="FactBox__118966" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['e984575c-json'] = {"heading":"Hvordan beregnes lån/stipend?","variant":"light","content":{"value":"<span>L&aring;n/stipend regnes ut ifra den reelle studiebelastningen du har. Dersom du tar 30 studiepoeng i semesteret, tilsvarer dette heltidsstudium, og tar du 15 studiepoeng i semesteret, tilsvarer det deltidsstudium. Det gis ikke l&aring;n/stipend for mer enn 30 studiepoeng i semesteret.</span></p>\n<p>Du kan bruke<span>&nbsp;</span><a href=\"https://lanekassen.no/nb-NO/stipend-og-lan/\">L&aring;nekassens kalkulator</a><span>&nbsp;</span>for &aring; regne ut l&aring;n og stipend.<br /><br />V&aelig;r obs. p&aring; L&aring;nekassens semestre. Ett semester er mellom fire og fem m&aring;neder, 150 dager. Akkurat fem m&aring;neder eller mer kan vurderes som en lengre studieperiode enn ett semester. <br /><br />For eksempel: 16. august til 15. januar er ett semester, mens 16. august til 16. januar kan regnes som mer enn ett semester.<br /><br /><a href=\"https://www.lanekassen.no/nb-NO/\" target=\"_blank\" rel=\"noopener\">Du er selv ansvarlig for &aring; kjenne til L&aring;nekassen sine regler og forskrifter, som du finner p&aring; L&aring;nekassen sine hjemmesider.</a>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="42b4183c"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Hvordan søke Lånekassen?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__122808"><div class="RichtextContent RichtextContent--dark"><ol class="Richtext__ol">
<li><a href="https://www.lanekassen.no/nb-NO/" target="_blank" rel="noopener">Gå inn på Lånekassen sine sider</a>.</li>
<li>Du logger deg inn ved bruk av elektronisk ID.</li>
<li>Velg ønsket tjeneste ved å trykke på «Søknader». Du må da velge «Gå til søknad» under «Høyere og annen utdanning».</li>
<li>Fyll ut søknaden trinn for trinn. Velg skolevalg "<em>Høyskolen Kristiania / Fagskolen Kristiania".</em>&nbsp;<br><br><strong>NB: </strong>For noen studieløp må informasjonen manuelt bekreftes til Lånekassen, og det er derfor viktig at du velger riktig utdanningsopplegg i søknaden for det du er påmeldt. Du skal velge det studieløpet du planlegger å fullføre eller enkeltemner med fleksibel start og slutt om du tar enkeltemner (som ikke skal resultere i et årsstudium eller grad). Selv om det står oppgitt 0,- på noen av studieløpene, blir dette bekreftet manuelt av skolen.&nbsp;<strong><br></strong></li>
</ol></div></div></div><button aria-expanded="false" aria-controls="FactBox__122808" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['42b4183c-json'] = {"heading":"Hvordan søke Lånekassen?","variant":"light","content":{"value":"<ol class=\"Richtext__ol\">\n<li><a href=\"https://www.lanekassen.no/nb-NO/\" target=\"_blank\" rel=\"noopener\">G&aring; inn p&aring; L&aring;nekassen sine sider</a>.</li>\n<li>Du logger deg inn ved bruk av elektronisk ID.</li>\n<li>Velg &oslash;nsket tjeneste ved &aring; trykke p&aring; &laquo;S&oslash;knader&raquo;. Du m&aring; da velge &laquo;G&aring; til s&oslash;knad&raquo; under &laquo;H&oslash;yere og annen utdanning&raquo;.</li>\n<li>Fyll ut s&oslash;knaden trinn for trinn. Velg skolevalg \"<em>H&oslash;yskolen Kristiania / Fagskolen Kristiania\".</em>&nbsp;<br /><br /><strong>NB: </strong>For noen studiel&oslash;p m&aring; informasjonen manuelt bekreftes til L&aring;nekassen, og det er derfor viktig at du velger riktig utdanningsopplegg i s&oslash;knaden for det du er p&aring;meldt. Du skal velge det studiel&oslash;pet du planlegger &aring; fullf&oslash;re eller enkeltemner med fleksibel start og slutt om du tar enkeltemner (som ikke skal resultere i et &aring;rsstudium eller grad). Selv om det st&aring;r oppgitt 0,- p&aring; noen av studiel&oslash;pene, blir dette bekreftet manuelt av skolen.&nbsp;<strong><br /></strong></li>\n</ol>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="bae4fce8"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Etter du har søkt/sluttdato</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__118967"><div class="RichtextContent RichtextContent--dark"><strong data-start="392" data-end="421">Samlingsbaserte studieløp</strong><span>: rapporteres fortløpende (start- og eksamensdato), så du trenger ikke å sende sluttdato.</span><p></p>
<p data-start="513" data-end="623"><strong data-start="513" data-end="528">Nettstudier</strong>: du må sende inn sluttdato (måned + år for siste eksamen) til<span>&nbsp;</span><a href="mailto:nettstudent@kristiania.no">nettstudent@kristiania.no</a><a data-start="593" data-end="618"></a>. Sluttdato gjelder kun for emnene du har meldt deg på, ikke for en hel grad.</p>
<p data-start="862" data-end="962">Sjekk status for søknaden din på<span>&nbsp;</span><strong data-start="906" data-end="920">Dine sider</strong><span>&nbsp;</span>hos<span>&nbsp;</span><a href="https://lanekassen.no/nb-NO/">Lånekassen</a><span>&nbsp;</span>under «Status søknader».</p></div></div></div><button aria-expanded="false" aria-controls="FactBox__118967" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['bae4fce8-json'] = {"heading":"Etter du har søkt/sluttdato","variant":"light","content":{"value":"<strong data-start=\"392\" data-end=\"421\">Samlingsbaserte studiel&oslash;p</strong><span>: rapporteres fortl&oslash;pende (start- og eksamensdato), s&aring; du trenger ikke &aring; sende sluttdato.</span></p>\n<p data-start=\"513\" data-end=\"623\"><strong data-start=\"513\" data-end=\"528\">Nettstudier</strong>: du m&aring; sende inn sluttdato (m&aring;ned + &aring;r for siste eksamen) til<span>&nbsp;</span><a href=\"mailto:nettstudent@kristiania.no\">nettstudent@kristiania.no</a><a data-start=\"593\" data-end=\"618\"></a>. Sluttdato gjelder kun for emnene du har meldt deg p&aring;, ikke for en hel grad.</p>\n<p data-start=\"862\" data-end=\"962\">Sjekk status for s&oslash;knaden din p&aring;<span>&nbsp;</span><strong data-start=\"906\" data-end=\"920\">Dine sider</strong><span>&nbsp;</span>hos<span>&nbsp;</span><a href=\"https://lanekassen.no/nb-NO/\">L&aring;nekassen</a><span>&nbsp;</span>under &laquo;Status s&oslash;knader&raquo;."},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="e351f6d0"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Når får du utbetaling fra Lånekassen?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__122809"><div class="RichtextContent RichtextContent--dark"><p data-start="240" data-end="450">Du får svar på<span>&nbsp;</span>Dine sider&nbsp;hos<span>&nbsp;</span><a href="https://lanekassen.no/nb-NO/">Lånekassen</a><span>&nbsp;</span>så snart søknaden er ferdigbehandlet. Vedtaket viser om du har fått støtte og hvor mye. Har du ikke samtykket til elektronisk kommunikasjon, får du brevet i posten.</p>
<p data-start="452" data-end="656">Du trenger ikke å semesterregistrere deg. Din studentstatus oppdateres automatisk og rapporteres til Lånekassen etter at du har blitt student.</p>
<p data-start="658" data-end="887">Når status er oppdatert hos Lånekassen, starter de utbetalingen. Hvor lang tid dette tar avhenger av deres saksbehandling. Dersom status ikke er oppdatert innen en uke etter vedtak, kontakt oss på<span>&nbsp;</span><a href="mailto:nettstudent@kristiania.no">nettstudent@kristiania.no.</a></p></div></div></div><button aria-expanded="false" aria-controls="FactBox__122809" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['e351f6d0-json'] = {"heading":"Når får du utbetaling fra Lånekassen?","variant":"light","content":{"value":"<p data-start=\"240\" data-end=\"450\">Du f&aring;r svar p&aring;<span>&nbsp;</span>Dine sider&nbsp;hos<span>&nbsp;</span><a href=\"https://lanekassen.no/nb-NO/\">L&aring;nekassen</a><span>&nbsp;</span>s&aring; snart s&oslash;knaden er ferdigbehandlet. Vedtaket viser om du har f&aring;tt st&oslash;tte og hvor mye. Har du ikke samtykket til elektronisk kommunikasjon, f&aring;r du brevet i posten.</p>\n<p data-start=\"452\" data-end=\"656\">Du trenger ikke &aring; semesterregistrere deg. Din studentstatus oppdateres automatisk og rapporteres til L&aring;nekassen etter at du har blitt student.</p>\n<p data-start=\"658\" data-end=\"887\">N&aring;r status er oppdatert hos L&aring;nekassen, starter de utbetalingen. Hvor lang tid dette tar avhenger av deres saksbehandling. Dersom status ikke er oppdatert innen en uke etter vedtak, kontakt oss p&aring;<span>&nbsp;</span><a href=\"mailto:nettstudent@kristiania.no\">nettstudent@kristiania.no.</a>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="1b7561f6"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Viktig informasjon etter du har søkt</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__118968"><div class="RichtextContent RichtextContent--dark"><span>Du må gi&nbsp;</span><a href="mailto:nettstudent@kristiania.no">beskjed til oss</a><span>&nbsp;dersom noe endrer seg i løpet av studieperioden din. Endres for eksempel sluttdatoen (når du skal avlegge siste eksamen), må du bekrefte ny sluttdato til oss umiddelbart. Da sendes det inn en endringsmelding til Lånekassen. <br><br><strong>NB!</strong> Da kan studiebelastningen din også endre seg. Konsekvenser av dette er opp til Lånekassen å vurdere iht. deres reglement.</span><br><br><span>Dersom det ikke blir informert om endringer, bekreftes kun den nye studieperioden din til Lånekassen (ved en ny bestilling), med mindre det er spesielle omstendigheter. Du må da&nbsp;</span><a href="mailto:nettstudent@kristiania.no">informere oss</a><span>&nbsp;om dette ved ny bestilling.</span><br><br><span>Når du har bestått eksamen, vil resultatet rapporteres automatisk til Lånekassen, men det kan ta noe tid. Du vil finne resultatene for dine emner hos&nbsp;</span><a href="https://lanekassen.no/nb-NO/">Lånekassen</a><span>&nbsp;under Dine side og under "Meny": "Eksamen og grad".&nbsp;</span><br><span>Ved fullført grad blir informasjonen sendt over til Lånekassen 2 ganger i året, for høsten rundt oktober og for våren rundt februar.&nbsp;</span><br><br><a href="https://www.lanekassen.no/nb-NO/" target="_blank" rel="noopener">Du er selv ansvarlig for å kjenne til Lånekassen sine regler og forskrifter, som du finner på Lånekassen sine hjemmesider.</a></div></div></div><button aria-expanded="false" aria-controls="FactBox__118968" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['1b7561f6-json'] = {"heading":"Viktig informasjon etter du har søkt","variant":"light","content":{"value":"<span>Du m&aring; gi&nbsp;</span><a href=\"mailto:nettstudent@kristiania.no\">beskjed til oss</a><span>&nbsp;dersom noe endrer seg i l&oslash;pet av studieperioden din. Endres for eksempel sluttdatoen (n&aring;r du skal avlegge siste eksamen), m&aring; du bekrefte ny sluttdato til oss umiddelbart. Da sendes det inn en endringsmelding til L&aring;nekassen. <br /><br /><strong>NB!</strong> Da kan studiebelastningen din ogs&aring; endre seg. Konsekvenser av dette er opp til L&aring;nekassen &aring; vurdere iht. deres reglement.</span><br /><br /><span>Dersom det ikke blir informert om endringer, bekreftes kun den nye studieperioden din til L&aring;nekassen (ved en ny bestilling), med mindre det er spesielle omstendigheter. Du m&aring; da&nbsp;</span><a href=\"mailto:nettstudent@kristiania.no\">informere oss</a><span>&nbsp;om dette ved ny bestilling.</span><br /><br /><span>N&aring;r du har best&aring;tt eksamen, vil resultatet rapporteres automatisk til L&aring;nekassen, men det kan ta noe tid. Du vil finne resultatene for dine emner hos&nbsp;</span><a href=\"https://lanekassen.no/nb-NO/\">L&aring;nekassen</a><span>&nbsp;under Dine side og under \"Meny\": \"Eksamen og grad\".&nbsp;</span><br /><span>Ved fullf&oslash;rt grad blir informasjonen sendt over til L&aring;nekassen 2 ganger i &aring;ret, for h&oslash;sten rundt oktober og for v&aring;ren rundt februar.&nbsp;</span><br /><br /><a href=\"https://www.lanekassen.no/nb-NO/\" target=\"_blank\" rel=\"noopener\">Du er selv ansvarlig for &aring; kjenne til L&aring;nekassen sine regler og forskrifter, som du finner p&aring; L&aring;nekassen sine hjemmesider.</a>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section><section class="Richtext__block">

<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="770ba22e"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Har du spørsmål?</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__122810"><div class="RichtextContent RichtextContent--dark"><span>Har du spørsmål vedrørende Lånekassen eller ønsker å informere om endringer i ditt studieløp i tilknytning til en søknad hos Lånekassen, ta kontakt med oss på <a href="mailto:nettstudent@kristiania.no">nettstudent@kristiania.no</a></span></div></div></div><button aria-expanded="false" aria-controls="FactBox__122810" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['770ba22e-json'] = {"heading":"Har du spørsmål?","variant":"light","content":{"value":"<span>Har du sp&oslash;rsm&aring;l vedr&oslash;rende L&aring;nekassen eller &oslash;nsker &aring; informere om endringer i ditt studiel&oslash;p i tilknytning til en s&oslash;knad hos L&aring;nekassen, ta kontakt med oss p&aring; <a href=\"mailto:nettstudent@kristiania.no\">nettstudent@kristiania.no</a></span>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section>

        </div>
    </div>
</section>
</section><section class="Richtext__block">

<div id="6c2ef30d"><div class="T9s2xkF6zj_7pUCGDUHb"><div class="LQwCx4VsA_20nL7PJl_A UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef nuydYi_Wd6zwyeTcuMig" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/e194ff4d90d84f61b04f661be028aea0/kristiania_campus_bergen.jpeg?width=375 375w, /contentassets/e194ff4d90d84f61b04f661be028aea0/kristiania_campus_bergen.jpeg?width=500 500w, /contentassets/e194ff4d90d84f61b04f661be028aea0/kristiania_campus_bergen.jpeg?width=768 768w, /contentassets/e194ff4d90d84f61b04f661be028aea0/kristiania_campus_bergen.jpeg?width=1024 1024w"><img src="/contentassets/e194ff4d90d84f61b04f661be028aea0/kristiania_campus_bergen.jpeg?width=500" alt="To studenter på campus i Bergen" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA lwj1fS09bnWFOXW1AKFu"><h2 class="ZiduBuPrxHXQhabvP6SQ">Får jeg støtte fra Lånekassen når jeg studerer på Kristiania?</h2><div class="BrxHX8d3IdyRW2EN5wWq">Alle skal ha rett på en utdanning – uavhengig av sin økonomiske situasjon. Lånekassen gir deg som student tilbud om lån og stipend som kan gjøre studiehverdagen din litt enklere. </div><a href="/aktuelt/2021/10/far-jeg-stotte-fra-lanekassen-nar-jeg-studerer-pa-kristiania/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn LVwfmt8Qy2xfZW7GrHx_ Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Les om støtte fra Lånekassen</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['6c2ef30d-json'] = {"image":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[375,500,768,1024],"sizes":["(min-width: 1440px) 768px","(min-width: 768px) 50vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Haakon Dueland","caption":"Studielån fra Lånekassen er for mange helt essensielt.","url":"/contentassets/e194ff4d90d84f61b04f661be028aea0/kristiania_campus_bergen.jpeg","alt":"To studenter på campus i Bergen","focalPoint":null,"lazyLoading":true},"imageFitBehavior":"fill","imageAlignment":"left","orientation":"horizontal","contentCardViewModel":{"title":"Får jeg støtte fra Lånekassen når jeg studerer på Kristiania?","description":"Alle skal ha rett på en utdanning – uavhengig av sin økonomiske situasjon. Lånekassen gir deg som student tilbud om lån og stipend som kan gjøre studiehverdagen din litt enklere. ","callToActionLink":{"label":"Les om støtte fra Lånekassen","href":"/aktuelt/2021/10/far-jeg-stotte-fra-lanekassen-nar-jeg-studerer-pa-kristiania/","external":false,"showIsExternal":true},"useLegacyLink":false,"variant":"darkRed","size":"large","buttonType":"normalButton"}};</script></div>
