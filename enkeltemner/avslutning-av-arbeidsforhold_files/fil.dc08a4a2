<div id="d7d901fd"><div class="rGe6TU4YqsXtkoX7XdK8 D03pMHJmzX1gSZKcJq8C ZuYj6Na7uskDL5VuL7Bp"><div class="OuOgujIRxM4MHS7v2CAm"><div class="IvDqood9UqphKP7DPbDR"></div><div class="W9zdKGpfzlMkq36ZQPco PExkcHowSWhaU9wyYHFn"><ul class="hu88n87boJGqs0wZE6DO"><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/1a86539fbb914364842bda639d0b928d/nytt-om-arbeidsliv.-photo-by-krakenimages-on-unsplash..jpg?width=375 375w, /contentassets/1a86539fbb914364842bda639d0b928d/nytt-om-arbeidsliv.-photo-by-krakenimages-on-unsplash..jpg?width=500 500w, /contentassets/1a86539fbb914364842bda639d0b928d/nytt-om-arbeidsliv.-photo-by-krakenimages-on-unsplash..jpg?width=768 768w, /contentassets/1a86539fbb914364842bda639d0b928d/nytt-om-arbeidsliv.-photo-by-krakenimages-on-unsplash..jpg?width=1024 1024w"><img src="/contentassets/1a86539fbb914364842bda639d0b928d/nytt-om-arbeidsliv.-photo-by-krakenimages-on-unsplash..jpg?width=500" alt="Nytt om HR, ledelse og arbeidsliv" loading="lazy"></picture></div></div><div class="zOoeSOkOom859N3cCBqY"><div class="ZGOqWTR6X5XVdPOGhaPU"><h3 class="XdNev0WrxmeriTSwiCJG d_REHRglxAIojeV7lyDw">Nytt om HR, ledelse og arbeidsliv</h3></div><div class="u5K49m8sCAFQhMpYrwdt">Hvordan få medarbeiderne til å prestere sitt beste? Våre faglige deler ny kunnskap og gir deg råd om bedre HR, ledelse og arbeidsliv. </div></div><a href="https://kunnskap.kristiania.no/category/hr-ledelse-og-arbeidsliv/" class="ContentListItem__linkOverlay"><span class="visuallyHidden">Les mer</span></a></div></li><li><div class="fZJVSAOhjE5zCRGyxzhi IeGb_X3nJ4kdizBP7Kt0"><div class="N7q9ZTHSSFbVGFD_J2I2"><div class="slJnKPGAAIKofsQwQBjL IEs38zzV4ZJHZFpJJdhd"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/61c44c222b5b41bb9a59721112f6dbb6/o