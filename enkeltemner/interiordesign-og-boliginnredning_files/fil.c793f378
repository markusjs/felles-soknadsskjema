                                <div id="7329fee2"><a href="/fagskolen-kristiania/nettstudier/" class="XezMfDvRba8HKhHr79wm BaRcrU5NpyAMFJiitXyJ" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Fagskoleemner fleksibel start og slutt</div></a><script>(window.__reactProps = window.__reactProps || {})['7329fee2-json'] = {"type":"default","variant":"default","buttonType":"solid","buttonTier":"legacyPrimary","buttonSize":"large","className":"","label":"Fagskoleemner fleksibel start og slutt","href":"/fagskolen-kristiania/nettstudier/","external":false,"showIsExternal":true};</script></div>
                            </li>
                    </ul>
</div></div></div>            </div>
