                                        <div id="316b9ddd"><table class="nWIPSJlVRmxAXAoCQOEo"><thead></thead><tbody><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-award"></use></svg></span><span>Studieoppsett</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">6 kjerneemner</p>
<p>+ 3 valgemner&nbsp;</div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Heltid</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">2 emner per eksamensperiode</div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Deltid</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA"><span>1 emne per eksamensperiode</span></div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Enkeltemne</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">Fri progresjon</div></td></tr></tbody><tfoot></tfoot></table><script>(window.__reactProps = window.__reactProps || {})['316b9ddd-json'] = {"tableItems":[{"icon":"award","label":"Studieoppsett","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"6 kjerneemner</p>\n<p>+ 3 valgemner&nbsp;"}}]},{"icon":"activity","label":"Heltid","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"2 emner per eksamensperiode"}}]},{"icon":"activity","label":"Deltid","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"<span>1 emne per eksamensperiode</span>"}}]},{"icon":"activity","label":"Enkeltemne","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"Fri progresjon"}}]}],"educationElementInfoUrlLink":null,"translations":null};</script></div>
