                                        <div id="8cf5560e"><table class="nWIPSJlVRmxAXAoCQOEo"><thead></thead><tbody><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-award"></use></svg></span><span>Studieoppsett</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">7 kjerneemner&nbsp;</p>
<p>+ 2 valgemner</div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Heltid</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">3 emner per semester</p>
<p>Totalt 3 semestere over 1,5 &aring;r</div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Deltid</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">2 emner per semester og 3 siste semester</p>
<p>Totalt 4 semestere over 2 &aring;r&nbsp;</div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Enkeltemne</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">Fri progresjon</div></td></tr></tbody><tfoot></tfoot></table><script>(window.__reactProps = window.__reactProps || {})['8cf5560e-json'] = {"tableItems":[{"icon":"award","label":"Studieoppsett","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"7 kjerneemner&nbsp;</p>\n<p>+ 2 valgemner"}}]},{"icon":"activity","label":"Heltid","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"3 emner per semester</p>\n<p>Totalt 3 semestere over 1,5 &aring;r"}}]},{"icon":"activity","label":"Deltid","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"2 emner per semester og 3 siste semester</p>\n<p>Totalt 4 semestere over 2 &aring;r&nbsp;"}}]},{"icon":"activity","label":"Enkeltemne","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"Fri progresjon"}}]}],"educationElementInfoUrlLink":null,"translations":null};</script></div>
