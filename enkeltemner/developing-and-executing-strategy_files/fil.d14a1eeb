<div class="frame frame __wc __c">
<div class="__wc">
<div class="__stagger">– Dette er kanskje verdens mest hemmelige yrke</div>
</div>
</div>
</div></div></div></a></h3><div class="jEZzvXBk9gXoSYGacZ1a"><div class="upokinR30SLCCFTdntv0">Sollin Sæle har en helt unik jobb. Hun får nemlig betalt for å komme på gode ideer for andre.</div><span class="SvgIcon PVmLk9OPaS3teC0Olseh"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-<"></use></svg></span></div></div></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['e52b210b-json'] = {"id":"unike-fasiliteter","heading":{"value":"Unike fasiliteter"},"teaser":{"value":"Kunst og design-studentene holder til p&aring; Fjerdingen, Spikersuppa og Urtegata. Her ser du noen av v&aring;re fasiliteter.&nbsp;"},"linkList":[{"label":"Dansesal","href":"/for-studenter/fasiliteter/urtegata/#dansesaler","external":false,"showIsExternal":true},{"label":"Gradekino","href":"/for-studenter/fasiliteter/urtegata/#gradekino","external":false,"showIsExternal":true},{"label":"Hovedscene","href":"/for-studenter/fasiliteter/urtegata/#hovedscene","external":false,"showIsExternal":true},{"label":"Innspillingsstudio","href":"/for-studenter/fasiliteter/fjerdingen/#innspillingsstudio","external":false,"showIsExternal":true},{"label":"Interiørrom","href":"/for-studenter/fasiliteter/fjerdingen/#Interiorrom","external":false,"showIsExternal":true},{"label":"Lydstudio","href":"/for-studenter/fasiliteter/spikersuppa/#lydstudio","external":false,"showIsExternal":true},{"label":"Miksekino","href":"/for-studenter/fasiliteter/urtegata/#miksekinoer","external":false,"showIsExternal":true},{"label":"Printlab","href":"/for-studenter/fasiliteter/spikersuppa/#printlab","external":false,"showIsExternal":true}],"featuredArticle":{"title":{"value":"<div class=\"__a w75y8u1c w75y8u1c\">\n<div class=\"frame frame __wc __c\">\n<div class=\"__wc\">\n<div class=\"__stagger\">&ndash; Dette er kanskje verdens mest hemmelige yrke</div>\n</div>\n</div>\n</div>"},"description":{"value":"Sollin Sæle har en helt unik jobb. Hun får nemlig betalt for å komme på gode i