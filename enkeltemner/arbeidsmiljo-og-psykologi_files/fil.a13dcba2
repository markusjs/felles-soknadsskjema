<div id="b5f78231"><section class="cHJuzEmXmacjVj5xP6iZ mt6a75ovnlMLPE9Loln5"><div class="DXb3Ua5pMEXHHEWX1SA7"><div id="c6bd3858-72f1-47eb-9c38-2b5b16dfc16e" class="DvegeScMnacdRemVyrm0"></div><h2 class="aiIhzQ_HVaul7y_AkKJm">Aktuelle saker om forskning</h2><div class="XRp6wsxkeTvkZeQyXQxl"><ul class="oRspAuvbMi0pXLrX9u7q uVxmZbynFdMeBQDxj2Og"><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 768px) 70vw, 100vw" srcSet="/contentassets/df7442ee2e0d486ebc8f9e93f4f75f04/ai-bilde--forskningsradet.jpeg?width=500 500w, /contentassets/df7442ee2e0d486ebc8f9e93f4f75f04/ai-bilde--forskningsradet.jpeg?width=768 768w, /contentassets/df7442ee2e0d486ebc8f9e93f4f75f04/ai-bilde--forskningsradet.jpeg?width=1024 1024w, /contentassets/df7442ee2e0d486ebc8f9e93f4f75f04/ai-bilde--forskningsradet.jpeg?width=1300 1300w"/><img src="/contentassets/df7442ee2e0d486ebc8f9e93f4f75f04/ai-bilde--forskningsradet.jpeg?width=500" alt="AI-generert bilde som konnoterer Kunstig Intelligens" loading="lazy"/></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Forskning</span><h3 class="qELDWCSeSJ1SDxUrtw0c">Kristiania blir forskningspartner i nasjonalt KI-senter</h3><div class="kF4KqV8ac8a9rdoWGCg8">Kristiania bidrar med tverrfaglig kompetanse og praksisnær forskning på et område i rask utvikling.</div></div><a href="/aktuelt/2025/06/kristiania-blir-forskningspartner-i-nasjonalt-ki-senter/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">Kristiania blir forskningspartner i nasjonalt KI-senter</div></a></li><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcSet="/contentassets/9a88f6b5749d45d59252698b58c47b01/national-institute-of-allergy-and-infectious-diseases-n36qxsknd8g-unsplash-1.jpg?wid