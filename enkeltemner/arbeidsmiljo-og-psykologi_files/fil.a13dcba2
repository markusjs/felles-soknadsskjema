<div id="9c72538e"><section><div class="HjBssCUxWZC9t_uFFeCq PrzSse14QCaR2BlHf5Am hiD00x5iccMRtMmUK797"><div class="YKYBQ3jDmxdtO9SEemuL"><div class="uJgrlGAPM7ozrDvgjXt0"><h2 class="dUMX71OXjk74Og6c82KZ">Fakulteter og institutter</h2><ul class="csX3C9e9jiZog4fiK1f5"><li><div class="zsrYitxhmI4Rdxl8AcId islhpR1mAUILJUWXwzyQ C5aub0yOxUDkiCFlS8yJ o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__39681" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V KOz68aX_1HLGwsoctqxH UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Fakultet for helse og teknologi</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__39681" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="ES0KnQfFCRB9HQO6csxw"><p class="DtsF92GQaa8ZKLp5pcx9">Forskningen ved Schools of Economics, Innovation and Technology har hovedvekt på økonomi, innovasjon og digitalisering. Inkludert er anvendt informatikk, informasjonssystemer og interaksjon mellom teknologi og menneske.</p><a href="/fakulteter/fakultet-for-helse-og-teknologi/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q F5x4yrdJ8wM2sji_Y7wC" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Gå til School</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a><h4 class="ZXinfHvFfI1FrURJURbr">Tilhørende institutter</h4><ul class="cf7vD1zJbGBpt8XKPneb"><li><a href="/fakulteter/fakultet-for-helse-og-teknologi/institutt-for-teknologi/" class="XezMfDvRba8HKhHr79wm 