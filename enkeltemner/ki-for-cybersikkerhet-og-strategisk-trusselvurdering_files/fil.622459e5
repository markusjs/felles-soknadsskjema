                                        <div id="d64f1a9e"><table class="nWIPSJlVRmxAXAoCQOEo"><thead></thead><tbody><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Deltid</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">Ca. 20 timers studier per uke</p>
<p>15 studiepoeng per semester</p>
<p>Totalt 6 semestere over 3 &aring;r</div></td></tr><tr><th><div><div><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span>Enkeltemne</span></div></div></th><td><div class="NszytxQg88Mzv7VZw5OA">10-40 timers studier per uke</p><p>7.5-30 studiepoeng per semester</div></td></tr></tbody><tfoot></tfoot></table><script>(window.__reactProps = window.__reactProps || {})['d64f1a9e-json'] = {"tableItems":[{"icon":"activity","label":"Deltid","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"Ca. 20 timers studier per uke</p>\n<p>15 studiepoeng per semester</p>\n<p>Totalt 6 semestere over 3 &aring;r"}}]},{"icon":"activity","label":"Enkeltemne","values":[{"isAnchor":false,"isRawHtml":true,"link":null,"image":null,"value":{"value":"10-40 timers studier per uke</p><p>7.5-30 studiepoeng per semester"}}]}],"educationElementInfoUrlLink":null,"translations":null};</script></div>
