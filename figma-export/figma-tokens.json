{
  "color": {
    "brand": {
      "maroon":        { "$type": "color", "$value": "#46000A", "$description": "Kristiania mørk bordeaux – overskrifter/steg-titler" },
      "red":           { "$type": "color", "$value": "#AF0018", "$description": "Feil/varsel, destruktive handlinger" },
      "red-soft":      { "$type": "color", "$value": "#F9CCD2", "$description": "Skillelinjer i varsel-/emneflater" },
      "cream":         { "$type": "color", "$value": "#FCF8F5", "$description": "Bakgrunn for varsel-/feilflater" }
    },
    "action": {
      "primary":       { "$type": "color", "$value": "#0A4FB8", "$description": "Primærknapp, lenker, valgt tilstand" },
      "primary-hover": { "$type": "color", "$value": "#083D8F" },
      "primary-bg":    { "$type": "color", "$value": "#F2F7FF", "$description": "Lys blå flate – hover/valgt kort" }
    },
    "text": {
      "default":       { "$type": "color", "$value": "#1A1A1A" },
      "secondary":     { "$type": "color", "$value": "#5C5C5C" },
      "muted":         { "$type": "color", "$value": "#767676" },
      "inverse":       { "$type": "color", "$value": "#FFFFFF" }
    },
    "border": {
      "default":       { "$type": "color", "$value": "#D4D4D4" },
      "subtle":        { "$type": "color", "$value": "#E6E6E6" }
    },
    "surface": {
      "page":          { "$type": "color", "$value": "#FFFFFF" },
      "subtle":        { "$type": "color", "$value": "#F5F5F5" }
    },
    "feedback": {
      "success":       { "$type": "color", "$value": "#166600", "$description": "Betalt/kvittering" },
      "error":         { "$type": "color", "$value": "#AF0018" }
    }
  },
  "font": {
    "family": {
      "sans":  { "$type": "fontFamily", "$value": "Graphik" },
      "serif": { "$type": "fontFamily", "$value": "Produkt" }
    },
    "weight": {
      "regular":  { "$type": "number", "$value": 400 },
      "medium":   { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 }
    },
    "size": {
      "10": { "$type": "number", "$value": 10 },
      "12": { "$type": "number", "$value": 12 },
      "13": { "$type": "number", "$value": 13 },
      "14": { "$type": "number", "$value": 14 },
      "15": { "$type": "number", "$value": 15 },
      "16": { "$type": "number", "$value": 16 },
      "18": { "$type": "number", "$value": 18 },
      "20": { "$type": "number", "$value": 20 },
      "22": { "$type": "number", "$value": 22 },
      "28": { "$type": "number", "$value": 28 },
      "30": { "$type": "number", "$value": 30 }
    }
  },
  "space": {
    "2":  { "$type": "number", "$value": 2 },
    "4":  { "$type": "number", "$value": 4 },
    "6":  { "$type": "number", "$value": 6 },
    "8":  { "$type": "number", "$value": 8 },
    "10": { "$type": "number", "$value": 10 },
    "12": { "$type": "number", "$value": 12 },
    "14": { "$type": "number", "$value": 14 },
    "16": { "$type": "number", "$value": 16 },
    "18": { "$type": "number", "$value": 18 },
    "20": { "$type": "number", "$value": 20 },
    "24": { "$type": "number", "$value": 24 },
    "32": { "$type": "number", "$value": 32 },
    "40": { "$type": "number", "$value": 40 }
  },
  "radius": {
    "sm":    { "$type": "number", "$value": 4 },
    "md":    { "$type": "number", "$value": 8 },
    "lg":    { "$type": "number", "$value": 16 },
    "pill":  { "$type": "number", "$value": 999 }
  },
  "shadow": {
    "modal": { "$type": "shadow", "$value": { "offsetX": 0, "offsetY": 4, "blur": 32, "spread": 0, "color": "#0000001F" } }
  }
}
