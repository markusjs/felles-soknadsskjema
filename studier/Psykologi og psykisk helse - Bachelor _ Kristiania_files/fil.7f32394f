<div id="507357b9"><div id="hva-lurer-du-p-aring" class="gczKN2pSjSR2BtQk5kWK"><div class="BHZEJUDSIPpKa0oPrsHx HKWJI6twVeF2fy35QptA CBihJp3agVQXhuKWcUyR FVBK8j1w9sq6TzHiDhBX dWbYLRuudKTJ6z54CyqI"><div class="bLAdaCckoHBaiIC97_jU uwdDbr8iIUnkWFMVwpIF"><div class="eh99tHo126OqTC2jRbLr"><div class="on3wNZn_jvWu7KfVfYv6"><div class="nlqrHsVbqtUwDBhbo7sE"><h2 class="pkRgi6LaSk6BZGRyxw9q">Hva lurer du p&aring;?</h2><div class="BlbzcwJ6hZiKvNivWB4s">V&aring;re veiledere svarer deg gjerne p&aring; chat, e-post, videosamtale eller telefon &ndash; helt uforpliktende!</div></div><a href="https://outlook.office365.com/book/Bestillveiledningstudier@egms.onmicrosoft.com/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn hk2sUgQrAH9UK8YJmMUQ Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Bestill gratis veiledning</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></div></div><div class="slJnKPGAAIKofsQwQBjL dabmDRgUTnFwXNJ_grkU"><picture><source sizes="100vw" srcSet="/globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/spor-en-student-studieveiledning-content-card-global.jpg?width=375 375w, /globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/spor-en-student-studieveiledning-content-card-global.jpg?width=480 480w, /globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/spor-en-student-studieveiledning-content-card-global.jpg?width=640 640w, /globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/spor-en-student-studieveiledning-content-card-global.jpg?width=768 768w, /globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/spor-en-student-studieveiledning-content-card-global.jpg?width=1024 1024w, /globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/spor-en-student-studieveiledning-content-card-global.jpg?width=1440 1440w, /globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/spor-en-student-studieveiledning-content-card-global.jpg?width=1920 1920w"/><img src="/globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/spor-en-student-studieveiledning-content-card-global.jpg?width=1440" alt="Bildelenke til veiledningsside." style="object-position:77% 42%" loading="lazy"/></picture></div></div></div><script>(window.__reactProps = window.__reactProps || {})['507357b9-json'] = {"id":"hva-lurer-du-p-aring","heading":{"value":"Hva lurer du p&aring;?"},"teaser":{"value":"V&aring;re veiledere svarer deg gjerne p&aring; chat, e-post, videosamtale eller telefon &ndash; helt uforpliktende!"},"callToActionType":"link","callToActionLabel":"Bestill gratis veiledning","submitUrl":"/api/bookMeeting/bookMeeting","termsAndConditionsText":{"value":"Ved &aring; sende dette skjemaet samtykker du til behandling av dine personopplysninger i samsvar med artikkel 6(1)a i personvernforordningen (GDPR) og v&aring;r personvernerkl&aelig;ring. Den behandlingsansvarlige er H&oslash;yskolen Kristiania."},"bookingConfirmationMessage":{"value":"Du blir snart kontaktet av en studentambassad&oslash;r ved Kristiania. Sammen blir dere enig om et passende tidspunkt og gjennomf&oslash;ring for veiledningen. I mellomtiden kan du bli bedre kjent med <a href=\"https://www.youtube.com/watch?v=KYQ5_91-gBo\">v&aring;re campus</a> og <a href=\"/studere-hos-oss/livet-paa-kristiania/\">studentmilj&oslash;et</a> ved Kristiania."},"bookingConfirmationHeading":"Takk for din henvendelse!","formHeading":"Bestill gratis veiledning","image":{"author":"Kristiania","caption":null,"url":"/globalassets/redaksjonen---blokker-til-artikler/blockbilder-global/spor-en-student-studieveiledning-content-card-global.jpg","alt":"Bildelenke til veiledningsside.","focalPoint":{"x":0.77,"y":0.42},"lazyLoading":true},"attendanceOptions":{"Oslo":"Besøke oss i Oslo","Bergen":"Besøke oss i Bergen","Phone":"Over telefon","Zoom":"På Zoom"},"timeSlots":[{"from":{"day":15,"month":1},"to":{"day":1,"month":6},"slots":["09:00 — 12:00","12:00 — 15:00","15:00 — 18:00"]},{"from":{"day":2,"month":6},"to":{"day":15,"month":8},"slots":["10:00 — 12:00","12:00 — 14:00"]},{"from":{"day":16,"month":8},"to":{"day":31,"month":12},"slots":["09:00 — 12:00","12:00 — 14:00"]},{"from":{"day":1,"month":1},"to":{"day":14,"month":1},"slots":["09:00 — 12:00","12:00 — 14:00"]}],"translations":{"invalidEmail":"Ugyldig epost format","genericError":"Feil oppsto","fieldIsRequired":"Dette feltet er påkrevd","fieldIsOptional":"Valgfritt","labelFieldFirstName":"Fornavn","labelFieldLastName":"Etternavn","labelFieldEmail":"E-post","labelFieldPhoneNumber":"Telefonnummer","labelFieldAttendance":"Hvordan vil du delta?","labelFieldTimeSlot":"Velg tidsluke","labelFieldComment":"Kommentar","placeholderFieldComment":"Skriv gjerne hva du lurer på","labelSubmitButton":"Bestill time","labelBookingConfirmationButton":"Tilbake til studiesiden","labelCloseOverlayButton":"Lukk overlagg","labelOverlay":"Book en veiledningssamtale","calendarTranslations":{"labelFieldDate":"Velg dato","expandCalendar":"Utvid kalenderen","applyLabel":"Bruk","cancelLabel":"Avbryt","chooseDayInMonth":"Velg dag i måned","nextMonth":"Neste måned","prevMonth":"Forrige måned"}},"callToActionLink":{"label":"Bestill gratis veiledning","href":"https://outlook.office365.com/book/Bestillveiledningstudier@egms.onmicrosoft.com/","external":false,"showIsExternal":true}};</script></div>
</div><div>
<div id="006d31b4"><section id="ofte-stilte-spørsmål" class="B_EDxoOxVgAU8kPXBQWa"><h2 class="FrR9v_ssranAjR5kDzwF Lz7bstkpq5d6FanMqkLu">Ofte stilte spørsmål</h2><div class="XmC_S2INgPyqbncnXLoy XL4KGq1qGQz8WwtKJ_pg"><div class="YKYBQ3jDmxdtO9SEemuL"><div class="uJgrlGAPM7ozrDvgjXt0"><ul class="csX3C9e9jiZog4fiK1f5"><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__148997" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Hvordan er studentmiljøet?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__148997" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">Vi vet at det &aring; v&aelig;re student handler om mye mer enn &aring; studere. Derfor jobber vi hele tiden med &aring; ivareta studentene v&aring;re, b&aring;de gjennom sosiale arrangementer, linjeforeninger og tett oppf&oslash;lging. Hos oss kan du bli med p&aring; alt fra konserter og fester, til filmvisninger og sosiale hyggekvelder.</p>
<p>Kristiania har sentrumsn&aelig;re og moderne lokaler, med fasiliteter som kafeer, biblioteker, lesesaler og m&oslash;terom. Her finner du ogs&aring; Karrieresenteret, Studentklinikken og en helt egen startup-inkubator, hvor du som student og gr&uuml;nder kan f&aring; god veiledning. M&aring;let er at alle skal f&aring; en spennende og minnerik studiehverdag, ogs&aring; utenfor klasserommet!</div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__148998" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Kan jeg reise på utveksling?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__148998" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">I fjerde semester p&aring; dette studiet har du muligheten til &aring; s&oslash;ke om utveksling i utlandet.&nbsp;For Bachelor i Psykologi og Psykisk helse ligger det et obligatorisk emne i utvekslingssemesteret, og du skal, om du ikke finner tilsvarende emne hos samarbeidspartneren, kun ta 15 ECTS p&aring; utveksling. &nbsp;</p>
<p>&nbsp;P&aring; n&aring;v&aelig;rende tidspunkt er disse samarbeidspartnerne godkjent:</p>
<p><strong>Frankrike</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/frankrike/#EPP">Ecole de Psychologues Praticiens, Paris og Lyons</a></li>
</ul>
<p><strong>Polen&nbsp;</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/polen/?language=no#Humanum">Collegium Humanum</a>, Warszawa</li>
</ul>
<p><strong>Storbritannia</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/storbritannia/#Lincoln">University of Lincoln</a><strong>&nbsp;</strong></li>
</ul>
<p><strong>Tyskland&nbsp;</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/tyskland/#Heidelberg">Heidelberg Universit&auml;t</a></li>
</ul>
<p><strong>S&oslash;r-Korea</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/sor-korea/#Handong">Handong Global University</a>, Pohang</li>
</ul>
<ul class="Richtext__ul"></ul></div><div class="UuEJiQnPXE3nLUxfPzcq"><a href="/for-studenter/studier-i-utlandet/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn hk2sUgQrAH9UK8YJmMUQ Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Les mer om utveksling</div></a></div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__148999" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Hva kan jeg studere videre?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__148999" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">Fullf&oslash;rt bachelor i psykologi og psykisk helse gir mange muligheter til videre utdanning p&aring; masterniv&aring;. Ved Kristiania er du kvalifisert til opptak ved f&oslash;lgende masterprogrammer:</p>
<ul class="Richtext__ul">
<li><strong><a href="/studier/master/anvendt-folkehelsevitenskap/">Master i anvendt folkehelsevitenskap</a></strong><strong></strong></li>
<li><a href="/studier/master/organisasjonspsykologi-og-ledelse/"><strong>Master i organisasjonspsykologi og ledelse</strong></a></li>
<li><strong><a href="/studier/master/ledelse/">Master i ledelse</a></strong></li>
</ul>
<p>Du vil v&aelig;re kvalifisert til de fleste masterprogrammer i psykologi i Norge og i utlandet. Disse krever vanligvis 80 eller 90 studiepoeng i psykologi fra bachelorutdanningen. V&aelig;r oppmerksom p&aring; at noen masterprogrammer krever spesifikke emner. Snakk med en studieveileder hos oss eller ved masterprogrammet du tenker &aring; s&oslash;ke p&aring;.</p>
<p>Bachelorprogrammet i psykologi og psykisk helse gir riktig opptaksgrunnlag hvis du planlegger &aring; s&oslash;ke opptak til videreutdanning i klinisk psykologi i utlandet.</p>
<p><a href="https://www.helsedirektoratet.no/tema/autorisasjon-og-spesialistutdanning/autorisasjon-og-lisens/helsefaglig-utdanning-i-utlandet-tips-for-du-velger-studium">Les mer p&aring; Helsedirektoratets nettsider om helsefaglig utdanning i utlandet og krav om autorisasjon for &aring; jobbe i Norge&nbsp;</a></p>
<p>Du kan ogs&aring; v&aelig;re kvalifisert til masterstudier i andre fagomr&aring;der enn psykologi i Norge og i utlandet, f.eks. innen helse- og sosialvitenskap eller utdanningsvitenskap. V&aelig;r oppmerksom p&aring; at disse kan kreve noe tilleggsutdanning (f.eks. 30 studiepoeng pedagogikk) eller praksiserfaring (f.eks. to &aring;r helse- eller sosialfaglig praksis). <strong>Snakk med en studieveileder hos oss eller ved masterprogrammet du tenker &aring; s&oslash;ke p&aring;.<br /></strong></p>
<p><strong>NB! Dette bachelorstudiet gj&oslash;r deg ikke kvalifisert til &aring; praktisere som psykolog.&nbsp;<br /></strong><br />I Norge er det kun profesjonsstudier i psykologi som gir en slik kvalifikasjon. Dette studiet gj&oslash;r deg kvalifisert til en rekke andre spennende jobber, og da kan ogs&aring; s&oslash;ke deg videre inn p&aring; et profesjonsstudium etter bachelorgraden.<strong><br /></strong></p>
<p><strong>&nbsp;</strong></div><div class="UuEJiQnPXE3nLUxfPzcq"><a href="/studier/master/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn hk2sUgQrAH9UK8YJmMUQ Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Les mer om våre masterstudier</div></a></div></div></div></div></div></li></ul></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['006d31b4-json'] = {"id":"ofte-stilte-spørsmål","heading":{"value":"Ofte stilte spørsmål"},"accordionItems":[{"id":"91370","displayName":"Hvordan er studentmiljøet?","introText":{"value":"Vi vet at det &aring; v&aelig;re student handler om mye mer enn &aring; studere. Derfor jobber vi hele tiden med &aring; ivareta studentene v&aring;re, b&aring;de gjennom sosiale arrangementer, linjeforeninger og tett oppf&oslash;lging. Hos oss kan du bli med p&aring; alt fra konserter og fester, til filmvisninger og sosiale hyggekvelder.</p>\n<p>Kristiania har sentrumsn&aelig;re og moderne lokaler, med fasiliteter som kafeer, biblioteker, lesesaler og m&oslash;terom. Her finner du ogs&aring; Karrieresenteret, Studentklinikken og en helt egen startup-inkubator, hvor du som student og gr&uuml;nder kan f&aring; god veiledning. M&aring;let er at alle skal f&aring; en spennende og minnerik studiehverdag, ogs&aring; utenfor klasserommet!"},"callToAction":null,"linkAsButton":false},{"id":"91372","displayName":"Kan jeg reise på utveksling?","introText":{"value":"I fjerde semester p&aring; dette studiet har du muligheten til &aring; s&oslash;ke om utveksling i utlandet.&nbsp;For Bachelor i Psykologi og Psykisk helse ligger det et obligatorisk emne i utvekslingssemesteret, og du skal, om du ikke finner tilsvarende emne hos samarbeidspartneren, kun ta 15 ECTS p&aring; utveksling. &nbsp;</p>\n<p>&nbsp;P&aring; n&aring;v&aelig;rende tidspunkt er disse samarbeidspartnerne godkjent:</p>\n<p><strong>Frankrike</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/frankrike/#EPP\">Ecole de Psychologues Praticiens, Paris og Lyons</a></li>\n</ul>\n<p><strong>Polen&nbsp;</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/polen/?language=no#Humanum\">Collegium Humanum</a>, Warszawa</li>\n</ul>\n<p><strong>Storbritannia</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/storbritannia/#Lincoln\">University of Lincoln</a><strong>&nbsp;</strong></li>\n</ul>\n<p><strong>Tyskland&nbsp;</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/tyskland/#Heidelberg\">Heidelberg Universit&auml;t</a></li>\n</ul>\n<p><strong>S&oslash;r-Korea</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/sor-korea/#Handong\">Handong Global University</a>, Pohang</li>\n</ul>\n<ul class=\"Richtext__ul\"></ul>"},"callToAction":{"label":"Les mer om utveksling","href":"/for-studenter/studier-i-utlandet/","external":false,"showIsExternal":true},"linkAsButton":true},{"id":"91374","displayName":"Hva kan jeg studere videre?","introText":{"value":"Fullf&oslash;rt bachelor i psykologi og psykisk helse gir mange muligheter til videre utdanning p&aring; masterniv&aring;. Ved Kristiania er du kvalifisert til opptak ved f&oslash;lgende masterprogrammer:</p>\n<ul class=\"Richtext__ul\">\n<li><strong><a href=\"/studier/master/anvendt-folkehelsevitenskap/\">Master i anvendt folkehelsevitenskap</a></strong><strong></strong></li>\n<li><a href=\"/studier/master/organisasjonspsykologi-og-ledelse/\"><strong>Master i organisasjonspsykologi og ledelse</strong></a></li>\n<li><strong><a href=\"/studier/master/ledelse/\">Master i ledelse</a></strong></li>\n</ul>\n<p>Du vil v&aelig;re kvalifisert til de fleste masterprogrammer i psykologi i Norge og i utlandet. Disse krever vanligvis 80 eller 90 studiepoeng i psykologi fra bachelorutdanningen. V&aelig;r oppmerksom p&aring; at noen masterprogrammer krever spesifikke emner. Snakk med en studieveileder hos oss eller ved masterprogrammet du tenker &aring; s&oslash;ke p&aring;.</p>\n<p>Bachelorprogrammet i psykologi og psykisk helse gir riktig opptaksgrunnlag hvis du planlegger &aring; s&oslash;ke opptak til videreutdanning i klinisk psykologi i utlandet.</p>\n<p><a href=\"https://www.helsedirektoratet.no/tema/autorisasjon-og-spesialistutdanning/autorisasjon-og-lisens/helsefaglig-utdanning-i-utlandet-tips-for-du-velger-studium\">Les mer p&aring; Helsedirektoratets nettsider om helsefaglig utdanning i utlandet og krav om autorisasjon for &aring; jobbe i Norge&nbsp;</a></p>\n<p>Du kan ogs&aring; v&aelig;re kvalifisert til masterstudier i andre fagomr&aring;der enn psykologi i Norge og i utlandet, f.eks. innen helse- og sosialvitenskap eller utdanningsvitenskap. V&aelig;r oppmerksom p&aring; at disse kan kreve noe tilleggsutdanning (f.eks. 30 studiepoeng pedagogikk) eller praksiserfaring (f.eks. to &aring;r helse- eller sosialfaglig praksis). <strong>Snakk med en studieveileder hos oss eller ved masterprogrammet du tenker &aring; s&oslash;ke p&aring;.<br /></strong></p>\n<p><strong>NB! Dette bachelorstudiet gj&oslash;r deg ikke kvalifisert til &aring; praktisere som psykolog.&nbsp;<br /></strong><br />I Norge er det kun profesjonsstudier i psykologi som gir en slik kvalifikasjon. Dette studiet gj&oslash;r deg kvalifisert til en rekke andre spennende jobber, og da kan ogs&aring; s&oslash;ke deg videre inn p&aring; et profesjonsstudium etter bachelorgraden.<strong><br /></strong></p>\n<p><strong>&nbsp;</strong>"},"callToAction":{"label":"Les mer om våre masterstudier","href":"/studier/master/","external":false,"showIsExternal":true},"linkAsButton":true}]};</script></div>
</div><div>
<div id="c62de3ec"><section id="les-mer-om-våre-studenter" class="SHBxpvluhwQoYymI1DIv iVlFZsPdf7GCgOU8gGjH"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><div class="E2phzNy8djlaFTH4WR6x"><h2 class="FrR9v_ssranAjR5kDzwF su0JfkSU5NqW5XwuRQWW">Les mer om våre studenter</h2></div><ul class="FB3DZGmtcCVAhhcz68G0 CthI_MDUDXaFm3Q7ylnw"><li class="Gr8VYbsydqQjuQuxwqK5"><div role="none" class="lWrPSruci5J1Pct9eV_o g60OJyzhnb0WaPJax3FT" tabindex="-1"><div class="MgyILGUp5ZXfXioJozjl"><div class="slJnKPGAAIKofsQwQBjL vPKYJ9xnnqorRitmkm3i Rk4XtUg82KBc97x_ZRFE A1reRVHVrrT7Lt9R_8TS"><picture><source sizes="(max-width: 767px) 100vw, (min-width: 768px) 552px" srcSet="/contentassets/c35c3937fb0c4de195cbf9e0a6561fb6/istock-1067934102.jpg?width=375 375w, /contentassets/c35c3937fb0c4de195cbf9e0a6561fb6/istock-1067934102.jpg?width=552 552w, /contentassets/c35c3937fb0c4de195cbf9e0a6561fb6/istock-1067934102.jpg?width=768 768w, /contentassets/c35c3937fb0c4de195cbf9e0a6561fb6/istock-1067934102.jpg?width=1536 1536w"/><img src="/contentassets/c35c3937fb0c4de195cbf9e0a6561fb6/istock-1067934102.jpg?width=552" alt="Trist kvinne ved vindu" loading="lazy"/></picture></div></div><div class="yMY00st3GGEGBJtEvQ73"><h3 class="c_Td561uP1rvuAN4AIF0"><a href="/kunnskap-kristiania/2022/11/vinterdepresjon--7-tips-i-morketida/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><div>Vinterdepresjon -  sju tips i mørketida</div></div></a></h3><div class="jEZzvXBk9gXoSYGacZ1a"><div class="upokinR30SLCCFTdntv0">– Det er håp for de vinterdeprimerte, sier Lars Dehli, klinisk psykolog og førstelektor. Her gir han sine beste råd for å komme gjennom de mørkeste månedene.</div><span class="SvgIcon PVmLk9OPaS3teC0Olseh"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-v"></use></svg></span></div></div></div></li><li class="Gr8VYbsydqQjuQuxwqK5"><div role="none" class="lWrPSruci5J1Pct9eV_o g60OJyzhnb0WaPJax3FT b3JSpHCPkJRpylgdiTos" tabi