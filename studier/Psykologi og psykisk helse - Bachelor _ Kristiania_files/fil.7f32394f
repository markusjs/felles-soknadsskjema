g bør lete.","url":"/contentassets/58eb6f292bbf4ac2a6e1a0dcd79ec2e2/robin-bjorheim-psykologi-kristiania-04.jpg","alt":"Robin Bjorheim sitter bak et bord i et atrium, med studenter i samtale bak seg.","focalPoint":{"x":0.59,"y":0.35},"lazyLoading":true}},{"id":"102554","title":{"value":"Henrik studerer psykologi for &aring; kunne hjelpe andre"},"description":{"value":"– Jeg kan ikke tenke meg noe mer givende enn å hjelpe andre mennesker."},"url":"/aktuelt/2023/03/henrik-studerer-psykologi-for-a-kunne-hjelpe-andre/","image":{"author":"Kristiania/Benjamin Åvitsland","caption":"Henrik Kassimi har alltid visst at han ville satse på et yrke hvor han kan hjelpe andre. – Gjennom studiet lærer vi om veldig viktige og grunnleggende temaer for det meste, tenker jeg i hvert fall, uavhengig av om man går videre med psykologi eller noe helt annet, sier han. ","url":"/contentassets/c23750b42fed42e99e314dfd1d3ba4a0/some_henrik_psykologiogpsykiskhelse_rekrutteringskampanje23_benjaminavitsland-3.jpg","alt":"Foto av Henrik Kassimi","focalPoint":{"x":0.39,"y":0.39},"lazyLoading":true}}]};</script></div>
