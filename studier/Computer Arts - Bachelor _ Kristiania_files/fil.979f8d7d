</ul></div></div></div><ul class="YEXvUjfm6kfiJ5E0RUmA"><li class="BJhDL1ivRTBTTz1M1jNJ"><div role="link" tabindex="-1" class="cebw0X3OhBm1h7iQsiYf EsE9RThZNAFgiUOaDSqu BQNFUP7onZ3DlFRnNk81 mPz0mRIinDxP5lStpF2M vXp_Fkav2sqPTRRNnREp"><div class="slJnKPGAAIKofsQwQBjL vPKYJ9xnnqorRitmkm3i"><picture><source sizes="(max-width: 767px) 90vw, (min-width: 768px) 45vw" srcSet="/contentassets/3b070d04cf3740f7a15df01e4b20466e/visual-effects-vfx-showreel.jpg?width=260 260w, /contentassets/3b070d04cf3740f7a15df01e4b20466e/visual-effects-vfx-showreel.jpg?width=340 340w, /contentassets/3b070d04cf3740f7a15df01e4b20466e/visual-effects-vfx-showreel.jpg?width=410 410w, /contentassets/3b070d04cf3740f7a15df01e4b20466e/visual-effects-vfx-showreel.jpg?width=560 560w, /contentassets/3b070d04cf3740f7a15df01e4b20466e/visual-effects-vfx-showreel.jpg?width=675 675w, /contentassets/3b070d04cf3740f7a15df01e4b20466e/visual-effects-vfx-showreel.jpg?width=710 710w, /contentassets/3b070d04cf3740f7a15df01e4b20466e/visual-effects-vfx-showreel.jpg?width=810 810w, /contentassets/3b070d04cf3740f7a15df01e4b20466e/visual-effects-vfx-showreel.jpg?width=870 870w"/><img src="/contentassets/3b070d04cf3740f7a15df01e4b20466e/visual-effects-vfx-showreel.jpg?width=675" alt="Bildelenke til showreel av person som holder fakkel mot en dinosaur." style="object-position:57.99999999999999% 49%" loading="lazy"/></picture></div><div class="Pmg09aY_TfqRZuMur5zk"></div><div class="sPTS1rMd8cfKEfPWR1Ls"><span class="SvgIcon bb8Dm_nUe5QNENNcsbAA"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-film"></use></svg></span><div class="SkW9abafH6X8KqtaoReu"><div class="BNAfc54g0J03ydAhK9Tl JBFSDJXW2ok2RfS0fEqa"><div class="KVcXmhm9VNM86o03E7VR"><a href="https://www.youtube.com/watch?v=gZpPWGwWYEQ" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi qZPLN8RAtOldsdgz0jVh" target="_blank" rel="noopener noreferrer" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><div class="y92h1QcKH9ifsM8elUj8">Showreel - VFX</div></div></a><