<div class="Page__contentArea"><div>
<div id="bab18ebc"><section id="key-information" class="tDwjVFExbPlqwnaU86Wz"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF tNNRbfeiPsdi3j_gpC7k">Key information</h2><ul class="dE8scaebAaiVDo4BSvWD jQbeCSjNzeFEwKyP9FS0"><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Specialized career path</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Choose from four in-demand specializations&mdash;3D Graphics, Animation, Visual Effects, or Game Design&mdash;tailored to prepare you for specific roles in the digital arts industry.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Global opportunities</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Benefit from international exchange programs, industry connections, and internships with top Scandinavian studios to kickstart your career.&nbsp;</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Hands-on training</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Gain practical experience using Kristiania&rsquo;s state-of-the-art facilities, industry-standard software, and real-world projects to build your professional showreel.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-error-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Academic department</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark"><a href="/en/faculties/faculty-of-health-sciences-and-technology/">School of Economics, Innovation, and Technology</a></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-user"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Admission requirements</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark"><a href="/en/study-at-kristiania/admission-information/#Studiekompetanse" target="_blank" rel="noopener">Higher Education Entrance Qualification<span>&nbsp;</span></a><span>or the equivalent.&nbsp;</span></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-credit-card"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Tuition fees</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">62 100 kr per semester*. <a href="/en/study-at-kristiania/price-overview/"><span>Additional information about prices can be found here.</span></a></div></div></li></ul><ul class="KdKtz5eB9ExUSDYJcdj8"><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Level"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-book"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Bachelor</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Start date"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-clock"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Fall 2026</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Mode of study"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Full-time</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Points"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-award"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">180 Points</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="City"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-map-pin"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Oslo</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Duration"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-calendar"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">3 years</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Language"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-message-square"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">English</span></div></li></ul></div></div></section><script>(window.__reactProps = window.__reactProps || {})['bab18ebc-json'] = {"id":"key-information","title":{"value":"Key information"},"facts":[{"title":{"value":"Specialized career path"},"icon":"check-circle","content":{"value":"Choose from four in-demand specializations&mdash;3D Graphics, Animation, Visual Effects, or Game Design&mdash;tailored to prepare you for specific roles in the digital arts industry."}},{"title":{"value":"Global opportunities"},"icon":"check-circle","content":{"value":"Benefit from international exchange programs, industry connections, and internships with top Scandinavian studios to kickstart your career.&nbsp;"}},{"title":{"value":"Hands-on training"},"icon":"check-circle","content":{"value":"Gain practical experience using Kristiania&rsquo;s state-of-the-art facilities, industry-standard software, and real-world projects to build your professional showreel."}},{"title":{"value":"Academic department"},"icon":"error-circle","content":{"value":"<a href=\"/en/faculties/faculty-of-health-sciences-and-technology/\">School of Economics, Innovation, and Technology</a>"}},{"title":{"value":"Admission requirements"},"icon":"user","content":{"value":"<a href=\"/en/study-at-kristiania/admission-information/#Studiekompetanse\" target=\"_blank\" rel=\"noopener\">Higher Education Entrance Qualification<span>&nbsp;</span></a><span>or the equivalent.&nbsp;</span>"}},{"title":{"value":"Tuition fees"},"icon":"credit-card","content":{"value":"62 100 kr per semester*. <a href=\"/en/study-at-kristiania/price-overview/\"><span>Additional information about prices can be found here.</span></a>"}}],"tags":[{"title":"Level","icon":"book","value":"Bachelor"},{"title":"Start date","icon":"clock","value":"Fall 2026"},{"title":"Mode of study","icon":"activity","value":"Full-time"},{"title":"Points","icon":"award","value":"180 Points"},{"title":"City","icon":"map-pin","value":"Oslo"},{"title":"Duration","icon":"calendar","value":"3 years"},{"title":"Language","icon":"message-square","value":"English"}]};</script></div>
</div><div>
<div id="513c886f"><section id="learning-outcomes" class="cwjtYbGmpj2Fc0XguMNM"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF aZkJAbcjSQdYr77t8LV7">Learning outcomes</h2><div class="zOMHtRvuigbQpkhq8l0i"><div class="FHwe9agruJdTg4dYFHN9"><div class="FktOVJkMpTVphR1rGeNp RichtextContent RichtextContent--light">With this study programme, you will gain a comprehensive understanding of digital content creation across 3D graphics, animation, visual effects, or game design. You&rsquo;ll develop both creative and technical skills, mastering industry-standard software and production techniques while learning to craft compelling visual narratives.&nbsp;</p>
<p>The program emphasizes hands-on experience, interdisciplinary collaboration, and real-world applications, ensuring you are well-equipped to design, animate, and produce professional-quality work. Additionally, you'll build a strong portfolio and develop essential skills in teamwork, problem-solving, and project management, all of which are critical for success in the fast-paced digital arts industry.</p>
<p>The subjects you&rsquo;ll focus on include:</p>
<ul class="Richtext__ul">
<li aria-level="1">Computer Arts Production</li>
<li aria-level="1">Specialized subjects such as cinematography, prototyping or animation</li>
<li aria-level="1">Media Arts Innovation Lab</li>
</ul></div><button title="More about the instruction" aria-expanded="false" aria-controls="overlay_2059" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT f_wbJQigmJWOUtJRHvmX"><span class="visuallyHidden">More about the instruction</span><span class="SvgIcon Kw06kOpEjKtbccDsYKVG"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus-circle"></use></svg></span></button><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_2059" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_2060"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Close overlay" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Close overlay</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_2060" class="visuallyHidden">More about the instruction</span><h3 class="vGAYXQ8qVh3muyCADVi0">More about the instruction</h3><div class="RichtextContent RichtextContent--dark">The Bachelor in Computer Arts is taught in English to prepare students for careers in the global digital arts industry, ensuring they can collaborate effectively and compete internationally. Fancy a semester abroad? This programme offers the possibility of exchange programs in England, Germany or The Netherlands!</p>
<p><strong>Get to know us even better here:</strong></p>
<ul class="Richtext__ul">
<li><strong><a href="https://www.tiktok.com/@computerarts_kristiania">TikTok</a></strong></li>
<li><strong><a href="https://www.instagram.com/computerarts_kristiania/">Instagram</a></strong></li>
</ul></div></div></div></div></div></div></div><div class="qB4kMuPluv5Id4WqPmfn"></div><div class="uMSWbISaLHTvPMbXhnYp"><div class="VNQ7BkWJFagCE_bBjsxQ ZLbmeOzjwEPCnL8UV8zG R1wh_51Fi_Crd9RnsQsw"><span class="FxrXNHIEItswETCvk14E" style="display:block"><span class="EwPhzUN1NfTBa1XOsTE6 TVMntCe8qkWIdDcQxQb6"></span></span></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['513c886f-json'] = {"id":"learning-outcomes","title":{"value":"Learning outcomes"},"content":{"value":"With this study programme, you will gain a comprehensive understanding of digital content creation across 3D graphics, animation, visual effects, or game design. You&rsquo;ll develop both creative and technical skills, mastering industry-standard software and production techniques while learning to craft compelling visual narratives.&nbsp;</p>\n<p>The program emphasizes hands-on experience, interdisciplinary collaboration, and real-world applications, ensuring you are well-equipped to design, animate, and produce professional-quality work. Additionally, you'll build a strong portfolio and develop essential skills in teamwork, problem-solving, and project management, all of which are critical for success in the fast-paced digital arts industry.</p>\n<p>The subjects you&rsquo;ll focus on include:</p>\n<ul class=\"Richtext__ul\">\n<li aria-level=\"1\">Computer Arts Production</li>\n<li aria-level=\"1\">Specialized subjects such as cinematography, prototyping or animation</li>\n<li aria-level=\"1\">Media Arts Innovation Lab</li>\n</ul>"},"overlayTitle":"More about the instruction","overlayContent":{"value":"The Bachelor in Computer Arts is taught in English to prepare students for careers in the global digital arts industry, ensuring they can collaborate effectively and compete internationally. Fancy a semester abroad? This programme offers the possibility of exchange programs in England, Germany or The Netherlands!</p>\n<p><strong>Get to know us even better here:</strong></p>\n<ul class=\"Richtext__ul\">\n<li><strong><a href=\"https://www.tiktok.com/@computerarts_kristiania\">TikTok</a></strong></li>\n<li><strong><a href=\"https://www.instagram.com/computerarts_kristiania/\">Instagram</a></strong></li>\n</ul>"},"gobiStoryId":"geo6r","imageFallback":null,"translations":{"openOverlay":"More about the instruction","closeOverlay":"Close overlay","openPlayer":"Open player","failedToLoadVideo":"Sorry, for some reason we could not load a video"}};</script></div>
</div><div>
<div id="a9d44936"><section id="study-model" class="eXDLkCBTey4RjrTQSVwU"><div class="coBlOy78vCNQoCaBJMWq"><div class="fIm4MtcrG6MCKKd8iidQ"><h2 class="FrR9v_ssranAjR5kDzwF A9Jn0XOSrtngUTCr8gcL">Study model</h2><div class="t78ozlVAuwJUrQItlgiY"><span class="IKcqvZpEOT2PNX0vgEn0">The study model is an excerpt from the program description. It provides you with an overview of mandatory courses and the opportunities you have for internships, exchanges, and specializations. The bachelor&#x27;s degree spans three academic years. Each academic year is divided into two semesters. We reserve the right to make changes. To view the study model for the different specializations, you can click on Specialization and choose the one you want to see.</span></div></div></div><div class="DwbrqOYPLpXMxa_AUi5a"><div class="c4EHzShG0bxjcWsv1iba _jn80nJpcKPRabCSPcI8 o7i_4ji7xZ2pdim0DGGS r6PBO9Z23nGvfMtmlwMK dT6kOO1SWAAgm3_8NHMn"><div class="w6rdwzyeKdZC4QEQQdUG"><div class="FQnvPH3eSTnAU6bvrkhn"><div class="IbD8iYA8j6gRUkFt19Qt nUUm_USrpFGrNosOvcCN gXLqKND3fX0_VG9NQewb"><div role="tablist" class="_NQp5NLSF5eDFXAqjrMf" aria-label="Select year"><button id="tab_1" role="tab" aria-selected="true" aria-controls="tabPanel_1" type="button" class="wSwA7V6mKnVhr5xFafzq Sqayds_IfbVRGAlPcZz1"><span class="bAoReRDLMgoAniQxqdep">First year</span></button><button id="tab_2" role="tab" aria-selected="false" aria-controls="tabPanel_2" type="button" class="wSwA7V6mKnVhr5xFafzq"><span class="bAoReRDLMgoAniQxqdep">Second year</span></button><button id="tab_3" role="tab" aria-selected="false" aria-controls="tabPanel_3" type="button" class="wSwA7V6mKnVhr5xFafzq"><span class="bAoReRDLMgoAniQxqdep">Third year</span></button></div></div><span class="FaaFQQsQ1uH8384yNffh">180 total credits</span></div><div id="tabPanel_1" class="xD2nuHiyJc0KNBTM5TWg" role="tabpanel" aria-labelledby="tab_1"><div class="XtdQZg9bKtEzGXT39oxb"><div style="will-change:height;overflow:visible;height:auto" class="wpyTqNTlEGsGZ_xfFehk L7NlqGAknErj1_Ksfbxg"><div class="XjUXAnCLxrJU_S3Faibn km5O6Vr04dX9qXqlrGMV"><div id="comboSelect_id2091" class="bbDHU4_JdA0hl9MD1Lrq">Specialization:</div><div class="G7gxiY379IAtJbKPKotG W_Gk92VdcIWIfdXHtrIi JAYJggZS6dLysWsv5IiA KDyaKDlnhHkPeQ8TQpwW"><div class="oNgbub_RmiAb8AEl5vq8"><select id="select2092" class="ej2uuZxjdlcJKkYzu50J" aria-describedby="comboSelect_id2091"><option value="3D-graphics (3D-grafikk)" selected="">3D-graphics (3D-grafikk)</option><option value="Animation (animasjon)">Animation (animasjon)</option><option value="Game Design (spilldesign)">Game Design (spilldesign)</option><option value="Visual Effects">Visual Effects</option></select><span class="SvgIcon mgusG_yyQk0V0MGeK9Ur"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-triangle"></use></svg></span></div></div></div></div><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="wpyTqNTlEGsGZ_xfFehk BK3qq6WSy_IM14HivUP2"><div class="XjUXAnCLxrJU_S3Faibn km5O6Vr04dX9qXqlrGMV Wc0G2UOdAM4L2tA07AtA"><div id="comboSelect_id2093" class="bbDHU4_JdA0hl9MD1Lrq">Options:</div><fieldset aria-describedby="comboSelect_id2093"><div class="drG0qWE9kXwq4x52jnrJ"><div class="Sp19XW4DI_sJH0_4zvTF"><div class="PHAoRS_eP5FouDCPNKdY GhAWyApR_JjGprSMJ2rM yje2hGysH1zQf_D0GsA7 echijgywrVRRk64pe6Cg"><input type="radio" id="FormComponents__radio__2094" class="YfHgbQjwjs4O8VWhll1c" name="study-option-selector" checked="" value="Default path"/><label for="FormComponents__radio__2094" class="XTEgAUAWtLfl5XRg_bT7"><span class="yUjgOv16CeoVvFj3U4nh">Default path</span></label></div><div class="PHAoRS_eP5FouDCPNKdY GhAWyApR_JjGprSMJ2rM yje2hGysH1zQf_D0GsA7 echijgywrVRRk64pe6Cg"><input type="radio" id="FormComponents__radio__2095" class="YfHgbQjwjs4O8VWhll1c" name="study-option-selector" value="Default path"/><label for="FormComponents__radio__2095" class="XTEgAUAWtLfl5XRg_bT7"><span class="yUjgOv16CeoVvFj3U4nh">Exchange</span></label></div></div></div></fieldset></div></div><span class="NPFkgrIiXfIBoY50mCiN">60 credits</span><div class="osNFPrEfj_WDLlms79Vw"><div class="gIhCJK5vlYW4N6yeTlUe C70d_1unGsLcavciTBWP g8GJRoyN3YYrck7buLCF" style="grid-template-columns:auto repeat(4, minmax(min-content, 1fr))"><div class="PVTUTdX7fee_uJTuRkiD ihFnGka9xDug5NPWFh0C"></div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY z7vhCTYrC3rO2VoUPlYT">1. semester</div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY _MLObcIsnBTnfP4F5AQg">2. semester</div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 3;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_2096" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Introduction to Computer Arts</span><span class="scgJDiGbZP69e6JD2e1j">COA100</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">22.5<!-- --> <!-- -->credits</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_2096" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_2097"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Close overlay" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Close overlay</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_2097" class="visuallyHidden">Open subject overlay</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Introduction to Computer Arts</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>The course is an introduction to the Bachelor in Computer Arts programme and gives the student a basic overview of the subject with a focus on the specialisations in the study programme. Emphasis is placed on the student getting an overview of the four areas of study in the programme so that they can make an informed choice after the first semester. The students will work on computer arts related projects to gain insights into the specialisations. They will therefore gain a basic understanding of concepts, methods and tools within all fields of study.</p><p>Furthermore, the student will get an introduction to concepts and topics that cut across all fields of study. The student will also get an overview of the industries in which they will typically be able to work after completing their degree.</p><p>The subject also shows how the student goes about making a showreel which is the basis for a job application in the industry, and the student also makes his/hers first version of this.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Read more</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:5 / span 1;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_2098" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">IMPACT - Introduksjon til tverrfaglig samarbeid</span><span class="scgJDiGbZP69e6JD2e1j">FTV118</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">7.5<!-- --> <!-- -->credits</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_2098" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_2099"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Close overlay" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Close overlay</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_2099" class="visuallyHidden">Open subject overlay</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">IMPACT - Introduksjon til tverrfaglig samarbeid</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Dette emnet gir en introduksjon til tverrfaglig samarbeid innen fagfeltene i film og medier, der utviklingsmetoder, selvstendig refleksjon og ansvar for egen læring står i sentrum. Emnet skal utforske den rollen tverrfaglig samarbeid kan ha i et samfunnsperspektiv. </p><p>Emnet har en undersøkende tilnærming til fagfeltene foto, klipp, lyddesign, manus, regi, produksjon, visual effects, spilldesign, 3D-grafikk og animasjon. Emnet tilbyr en introduksjon til vitenskapelige og kunstneriske metoder. Det skal også diskuteres etiske hensyn og perspektiver, med særlig vekt på inkludering, mangfold og bærekraft. </p><p>Det legges vekt på de felles faglige grunnelementer på tvers av fagene: idé- og konseptutvikling, planlegging og samarbeid i skapende prosesser. Studentene utvikler her begynnende forståelse for fagfeltenes roller. </p><p>Studentene skal jobbe sammen i tverrfaglige grupper, og vil få tilbakemelding på felles oppgaver løst i disse. Studentene skal introduseres for strukturert hverandrevurdering i kunstnerisk utvikling. </p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Read more</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 1;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_2100" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">3D-graphics 1</span><span class="scgJDiGbZP69e6JD2e1j">3DG121</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN ftxYN6Cf0R37irTe8gq3 jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA">Specialization</div><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">7.5<!-- --> <!-- -->credits</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_2100" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_2101"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Close overlay" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Close overlay</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_2101" class="visuallyHidden">Open subject overlay</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">3D-graphics 1</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnet <em>3D graphics 1</em> er et innledende emne i å jobbe med 3D-grafikk og legger grunnlaget for resten av studiet. Å jobbe med 3D-grafikk vil si å skape virtuelle objekter og scener for stillbilder, animasjon og spill/sanntidsapplkasjoner. Emnet gir studenten grunnleggende ferdigheter i modellering, materialer og teksturer, lyssetting av 3D-scener, og grunnleggende prinsipper rundt komposisjon og kamerateknikker for å skape og sette opp scener med 3D-grafikk.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Read more</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:3 / span 1;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_2102" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">3D-graphics 2</span><span class="scgJDiGbZP69e6JD2e1j">3DG122</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN ftxYN6Cf0R37irTe8gq3 jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA">Specialization</div><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">7.5<!-- --> <!-- -->credits</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_2102" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_2103"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Close overlay" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Close overlay</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_2103" class="visuallyHidden">Open subject overlay</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">3D-graphics 2</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnet <em>3D graphics 2</em> er et videregående emne innen 3D-modellering og presentasjon av 3D-scener. Arbeidet innen dette emnet gir studenten dypere kunnskap og ferdigheter innen polygon-modellering, digital skuptering, teksturering og material-innstillinger for karakterer og scener. Emnet fokuserer også på hvordan studenten med lys, materialer og 'compositing' kan oppnå gode visuelle uttrykk i 3D-scener.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Read more</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:4 / span 2;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_2104" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Characters and Environments</span><span class="scgJDiGbZP69e6JD2e1j">3DG216</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN ftxYN6Cf0R37irTe8gq3 jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA">Specialization</div><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">15<!-- --> <!-- -->credits</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_2104" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_2105"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Close overlay" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Close overlay</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_2105" class="visuallyHidden">Open subject overlay</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Characters and Environments</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>The purpose of the course is to give students the knowledge and skills to be able to carry out advanced character and environment design with 3D graphics. The focus of the course is to create a thematic overall style with an emphasis on history and personality in an advanced scene with character and surroundings.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Read more</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="hUrOK4f2t5d89i_al5eu _jBcyRZzOe6QMtbojFs5"></div></div></div></div></div><div class="_qtIUhem1sc1EKjP4UhQ"><div id="tabPanel_2" role="tabpanel" aria-labelledby="tab_2"><ul><li><span>COA200</span><span>Computer Arts Production 1</span><div>
<p>The purpose of the course is to give the student a holistic experience with a larger computer arts production involving their specialization.</p><p>The student will plan and carry out a comprehensive production in a group, and will receive training in both interdisciplinary teamwork and the use of modern techniques, methods and tools used for the organization and production of a large scale project. The student will be able to understand the different phases of production and how each group member contributes, as well as the different team roles.</p>
</div></li><li><span>WFM200</span><span>Media Art Innovation Lab</span><div>
<p>Media Art Innovation Lab (MAIL) er et tverrfaglig fellesemne ved Westerdals Institutt for Film og Medier (WIFM). </p><p>Dette emnet fungerer som et laboratorium for innovasjon, fremmer nye tenkemåter og samarbeidsmetoder, og gir studentene muligheten til å utforske nyskapende, kreative og eksperimentelle tilnærminger innenfor medie- og kunstfeltet. </p><p>En sentral del av emnet er tverrfaglig samarbeid. Studenter fra flere studieprogram jobber sammen i grupper for å planlegge, utvikle og gjennomføre prosjektarbeid. Dette bidrar til å utvikle studentenes samarbeidskompetanse, og gir dem muligheten til å respondere på og kommentere samfunnsspørsmål og den tiden vi lever i.   </p><p>Studentene vil også bli introdusert for verdiperspektiver som bærekraftige vurderinger og prinsipper for grønn produksjon, samt prinsipper for mangfold og integrering. </p><p>I dette emnet er det studentene som driver innovasjon og kreative prosesser, og utvikler kunnskap og ny innsikt i en undervisningskontekst der de er aktive deltakere i læringsprosessen. </p>
</div></li><li><span>3DG114</span><span>Realtime 3D Graphics</span><div>
<p>The subject is about how to create good and aesthetic design and interactions in prototypes made with real-time 3D graphics. The students become familiar with the possibilities of the development environment and effective use of this. Students learn to use advanced materials and lighting in interactive scenes.</p>
</div></li><li><span>3DG215</span><span>Architectural Visualization Theory and Practice</span><div>
<p>In this course students will learn how to visualize architecture or constructions in the different phases of a project. They are introduced to tools that are used for architectural visualization, and techniques applied for this.</p>
</div></li><li><span>ANI200</span><span>Acting for Animators</span><div>
<p>The course explores how acting techniques can be used in animation. To create characters with emotions and empathy, students are introduced to various aspects of acting techniques, including facial expressions for scenes with dialogue and improvisation. Through practical exercises, students will develop a deeper understanding of how to create scenes with characters that think, breathe, feel, and act.</p><p>Students will also learn how to film themselves for reference and how to effectively use this material by analyzing and applying these insights to their animations.</p>
</div></li><li><span>ANI203</span><span>Animation 3</span><div>
<p>Animation 3 builds on the principles from Animation 1 and Animation 2. This course takes you deeper into the fascinating world of storytelling, acting techniques, and dramaturgy to create engaging scenes.</p><p>During Animation 3, you will not only learn advanced animation techniques, such as facial animation, but also how to bring characters to life and imbue them with empathy throughout their journey. From miming to lively scenes with dialogue, we explore how to convey conflict, emotions, and personality through animation.</p><p>We focus on detailing and polishing in the final phase of the animation process. Here, you will fine-tune asymmetry in posing, both in the body and face, as well as variations in curves, spacing, and all the small details that bring the character to life.</p><p>Students will gain extensive experience in giving and receiving constructive feedback on their work.</p>
</div></li><li><span>SPD116</span><span>Prototyping</span><div>
<p>This course covers the fundamentals of system, UX, and UI design. Students learn to create, implement, and evaluate scalable game systems and intuitive, player-focused interfaces through prototypes. Emphasizing the connection between systems and UX/UI, the course teaches how to build gameplay-enhancing, usable designs. Projects include requirements analysis, human-centered design principles, flowcharts, wireframes, and progress from early prototypes to refined designs and user testing.</p>
</div></li><li><span>SPD209</span><span>Narrative and Level Design</span><div>
<p>In this course, the student will get a basic introduction to narrative structures linked to level design and visual storytelling techniques in games. The student will explore how video games tell stories, and how well-known principles from game and level design can enhance the narrative through mechanics, theme and mood. Through the course, the student will be introduced to narrative and level design, and gain practical experience with the design, development and iteration of virtual areas.</p>
</div></li><li><span>VFX221</span><span>Cinematography</span><div>
<p>The course gives students an introduction to photographic technique with a focus on composition and exposure/lighting. Students will learn to see subjects through the camera lens. Students also learn film as visual storytelling and how to use image composition, lighting and camera movement to tell a story. By filming their own VFX sequences, the students will increase their understanding of film and VFX techniques.</p>
</div></li><li><span>VFX222</span><span>3D for VFX</span><div>
<p>In this course the students will get an introduction to 3D graphics used as a tool towards work with visual effects (VFX). The students will gain basic skills in lighting and rendering of digital 3D objects with a view to integration in a VFX work process.</p>
</div></li><li><span>UTV999BA30</span><span>Utveksling</span><div></div></li><li><span>VAL999-7ENG</span><span>Elective course</span><div>
<p lang="en-US" style="text-indent:0pt;margin-left:0pt;margin-top:0pt;margin-bottom:0pt;margin-right:0pt;"><a href="https://www.kristiania.no/for-studenter/valgemner-og-praksis/" style="color:#0000EE;text-decoration:underline ;">See elective courses</a><span lang="en-GB">.</span></p>
</div></li></ul></div><div id="tabPanel_3" role="tabpanel" aria-labelledby="tab_3"><ul><li><span>COA300</span><span>Computer Arts Production 2</span><div>
<p>This course will provide students with relevant experience in executing a major practical project within their field of study, with high standards for quality and execution. The production could be a large-scale game, film/animation, VFX, or visualization project.</p>
</div></li><li><span>COA360</span><span>Bachelor Production</span><div>
<p>The student will gain professional experience by completing a project in a company, establishing their own business, or participating in a self-defined comprehensive research project. In a practical research project, the student will demonstrate broad knowledge of central topics and research methodology, and show skills in teamwork, project management methods, and relevant tools. The project should have a professional character and be of high quality.</p><p>The course also includes a practical introduction to prepare the student for the industry. The student will gain knowledge about industry-specific law, the industry’s institutions and working methods, as well as tools such as application writing and self-presentation.</p>
</div></li><li><span>3DG217</span><span>Realtime 3D Graphics 2</span><div></div></li><li><span>ANI304</span><span>Animation 4</span><div>
<p>The course is an advanced animation course focusing on dramaturgy and behaviour for humans, animals, and creatures. The student will have the opportunity to develop their own expression and style. High standards are set for quality and execution in the last animation polishing phase. </p>
</div></li><li><span>SPD324</span><span>System Design 2</span><div>
<p>This course aims to provide students with a deeper understanding of system design through the lens of game balancing. Students will be introduced to advanced system design, which will be explored in detail. The course will cover various game mechanics, focusing on how these can be utilized, combined, and balanced to create a meaningful experience for the player.</p>
</div></li><li><span>VFX220</span><span>Compositing 3</span><div>
<p>Compositing 3 builds on the Compositing 2 course. The focus is on more advanced projects and typical advanced compositing tasks the students will encounter in the industry as well as completion of shots. Students will get to know some of the latest techniques and be able to make the final touches needed to deliver professional shots.</p>
</div></li></ul></div></div></div></div></div><div class="lv4eNMiZgLixMXhAvacD"><a href="/en/syllabus/faculty-of-society-arts-and-media/first-cycle-degree/bca/bachelor-in-computer-arts/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 AMdryBi_G8WFVbcuUzSv LVwfmt8Qy2xfZW7GrHx_ I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY SwVWunM8J0KL5d8Ov54G" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">See program description</div></a></div></section><script>(window.__reactProps = window.__reactProps || {})['a9d44936-json'] = {"heading":{"value":"Study model"},"getSubjectInfoUrl":"/api/study-pages/133638/subjects-info-url","overlayContentMessages":{"outdated":{"heading":"Subjected to change.","message":null,"variant":"info"},"fallback":{"heading":"Course description coming soon","message":{"value":"At Kristiania, we develop our studies in collaboration with working life. That's why we update the subjects regularly, so that you get the skills that employers are looking for. Soon you can read everything about this subject here, until then you will find more information in the study programme description."},"variant":"info"}},"subjects":[{"code":"COA100","name":"Introduction to Computer Arts","description":"\n<p>The course is an introduction to the Bachelor in Computer Arts programme and gives the student a basic overview of the subject with a focus on the specialisations in the study programme. Emphasis is placed on the student getting an overview of the four areas of study in the programme so that they can make an informed choice after the first semester. The students will work on computer arts related projects to gain insights into the specialisations. They will therefore gain a basic understanding of concepts, methods and tools within all fields of study.</p><p>Furthermore, the student will get an introduction to concepts and topics that cut across all fields of study. The student will also get an overview of the industries in which they will typically be able to work after completing their degree.</p><p>The subject also shows how the student goes about making a showreel which is the basis for a job application in the industry, and the student also makes his/hers first version of this.</p>\n","isDescriptionOutdated":false,"order":11,"points":22.5,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"COA200","name":"Computer Arts Production 1","description":"\n<p>The purpose of the course is to give the student a holistic experience with a larger computer arts production involving their specialization.</p><p>The student will plan and carry out a comprehensive production in a group, and will receive training in both interdisciplinary teamwork and the use of modern techniques, methods and tools used for the organization and production of a large scale project. The student will be able to understand the different phases of production and how each group member contributes, as well as the different team roles.</p>\n","isDescriptionOutdated":true,"order":32,"points":15,"year":2,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"COA300","name":"Computer Arts Production 2","description":"\n<p>This course will provide students with relevant experience in executing a major practical project within their field of study, with high standards for quality and execution. The production could be a large-scale game, film/animation, VFX, or visualization project.</p>\n","isDescriptionOutdated":true,"order":50,"points":22.5,"year":3,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"COA360","name":"Bachelor Production","description":"\n<p>The student will gain professional experience by completing a project in a company, establishing their own business, or participating in a self-defined comprehensive research project. In a practical research project, the student will demonstrate broad knowledge of central topics and research methodology, and show skills in teamwork, project management methods, and relevant tools. The project should have a professional character and be of high quality.</p><p>The course also includes a practical introduction to prepare the student for the industry. The student will gain knowledge about industry-specific law, the industry’s institutions and working methods, as well as tools such as application writing and self-presentation.</p>\n","isDescriptionOutdated":true,"order":60,"points":30,"year":3,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"FTV118","name":"IMPACT - Introduksjon til tverrfaglig samarbeid","description":"\n<p>Dette emnet gir en introduksjon til tverrfaglig samarbeid innen fagfeltene i film og medier, der utviklingsmetoder, selvstendig refleksjon og ansvar for egen læring står i sentrum. Emnet skal utforske den rollen tverrfaglig samarbeid kan ha i et samfunnsperspektiv. </p><p>Emnet har en undersøkende tilnærming til fagfeltene foto, klipp, lyddesign, manus, regi, produksjon, visual effects, spilldesign, 3D-grafikk og animasjon. Emnet tilbyr en introduksjon til vitenskapelige og kunstneriske metoder. Det skal også diskuteres etiske hensyn og perspektiver, med særlig vekt på inkludering, mangfold og bærekraft. </p><p>Det legges vekt på de felles faglige grunnelementer på tvers av fagene: idé- og konseptutvikling, planlegging og samarbeid i skapende prosesser. Studentene utvikler her begynnende forståelse for fagfeltenes roller. </p><p>Studentene skal jobbe sammen i tverrfaglige grupper, og vil få tilbakemelding på felles oppgaver løst i disse. Studentene skal introduseres for strukturert hverandrevurdering i kunstnerisk utvikling. </p>\n","isDescriptionOutdated":false,"order":12,"points":7.5,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"WFM200","name":"Media Art Innovation Lab","description":"\n<p>Media Art Innovation Lab (MAIL) er et tverrfaglig fellesemne ved Westerdals Institutt for Film og Medier (WIFM). </p><p>Dette emnet fungerer som et laboratorium for innovasjon, fremmer nye tenkemåter og samarbeidsmetoder, og gir studentene muligheten til å utforske nyskapende, kreative og eksperimentelle tilnærminger innenfor medie- og kunstfeltet. </p><p>En sentral del av emnet er tverrfaglig samarbeid. Studenter fra flere studieprogram jobber sammen i grupper for å planlegge, utvikle og gjennomføre prosjektarbeid. Dette bidrar til å utvikle studentenes samarbeidskompetanse, og gir dem muligheten til å respondere på og kommentere samfunnsspørsmål og den tiden vi lever i.   </p><p>Studentene vil også bli introdusert for verdiperspektiver som bærekraftige vurderinger og prinsipper for grønn produksjon, samt prinsipper for mangfold og integrering. </p><p>I dette emnet er det studentene som driver innovasjon og kreative prosesser, og utvikler kunnskap og ny innsikt i en undervisningskontekst der de er aktive deltakere i læringsprosessen. </p>\n","isDescriptionOutdated":true,"order":41,"points":22.5,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Default path","isDefault":true},"category":"obligatory"},{"code":"3DG114","name":"Realtime 3D Graphics","description":"\n<p>The subject is about how to create good and aesthetic design and interactions in prototypes made with real-time 3D graphics. The students become familiar with the possibilities of the development environment and effective use of this. Students learn to use advanced materials and lighting in interactive scenes.</p>\n","isDescriptionOutdated":true,"order":30,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":"3D-graphics (3D-grafikk)","studyOption":null,"category":"specialization"},{"code":"3DG121","name":"3D-graphics 1","description":"\n<p>Emnet <em>3D graphics 1</em> er et innledende emne i å jobbe med 3D-grafikk og legger grunnlaget for resten av studiet. Å jobbe med 3D-grafikk vil si å skape virtuelle objekter og scener for stillbilder, animasjon og spill/sanntidsapplkasjoner. Emnet gir studenten grunnleggende ferdigheter i modellering, materialer og teksturer, lyssetting av 3D-scener, og grunnleggende prinsipper rundt komposisjon og kamerateknikker for å skape og sette opp scener med 3D-grafikk.</p>\n","isDescriptionOutdated":false,"order":20,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":"3D-graphics (3D-grafikk)","studyOption":null,"category":"specialization"},{"code":"3DG122","name":"3D-graphics 2","description":"\n<p>Emnet <em>3D graphics 2</em> er et videregående emne innen 3D-modellering og presentasjon av 3D-scener. Arbeidet innen dette emnet gir studenten dypere kunnskap og ferdigheter innen polygon-modellering, digital skuptering, teksturering og material-innstillinger for karakterer og scener. Emnet fokuserer også på hvordan studenten med lys, materialer og 'compositing' kan oppnå gode visuelle uttrykk i 3D-scener.</p>\n","isDescriptionOutdated":false,"order":21,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":"3D-graphics (3D-grafikk)","studyOption":null,"category":"specialization"},{"code":"3DG215","name":"Architectural Visualization Theory and Practice","description":"\n<p>In this course students will learn how to visualize architecture or constructions in the different phases of a project. They are introduced to tools that are used for architectural visualization, and techniques applied for this.</p>\n","isDescriptionOutdated":true,"order":31,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":"3D-graphics (3D-grafikk)","studyOption":null,"category":"specialization"},{"code":"3DG216","name":"Characters and Environments","description":"\n<p>The purpose of the course is to give students the knowledge and skills to be able to carry out advanced character and environment design with 3D graphics. The focus of the course is to create a thematic overall style with an emphasis on history and personality in an advanced scene with character and surroundings.</p>\n","isDescriptionOutdated":false,"order":22,"points":15,"year":1,"semester":"second","isPrerequisite":false,"specialization":"3D-graphics (3D-grafikk)","studyOption":null,"category":"specialization"},{"code":"3DG217","name":"Realtime 3D Graphics 2","description":null,"isDescriptionOutdated":null,"order":50,"points":7.5,"year":3,"semester":"first","isPrerequisite":false,"specialization":"3D-graphics (3D-grafikk)","studyOption":null,"category":"specialization"},{"code":"ANI101","name":"Animation 1","description":"\n<p>The subject Animation 1 gives students an introduction to animation processes and principles. Through practical work, students will learn to apply these animation principles to create vivid and believable animations.</p><p>At the same time, the students will explore the history of animation and learn how to find, analyze and use reference material to animate characters. In addition, the students will be introduced to posing. They will learn how different postures and movements can convey emotions and personality through sculpting poses in 3D.</p><p>This subject provides a solid foundation for further studies and practical work in animation.</p>\n","isDescriptionOutdated":false,"order":20,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":"Animation (animasjon)","studyOption":null,"category":"specialization"},{"code":"ANI102","name":"Animation 2","description":"\n<p>Animation 2 builds on the principles from Animation 1 with a further focus on process, body mechanics, and posing. In this course, the student will develop a broad knowledge of animation principles and their application to character animations.</p><p>We explore reference sources by analyzing body mechanics, anatomy, and physics to understand how movement works and how this is transferred to a 3D character.</p><p>We will particularly focus on body mechanics through the various phases of the animation process, where students learn how animation is gradually shaped to create believable and engaging animations.</p><p>Students will also gain experience in giving and receiving constructive feedback.</p>\n","isDescriptionOutdated":false,"order":22,"points":15,"year":1,"semester":"second","isPrerequisite":false,"specialization":"Animation (animasjon)","studyOption":null,"category":"specialization"},{"code":"ANI200","name":"Acting for Animators","description":"\n<p>The course explores how acting techniques can be used in animation. To create characters with emotions and empathy, students are introduced to various aspects of acting techniques, including facial expressions for scenes with dialogue and improvisation. Through practical exercises, students will develop a deeper understanding of how to create scenes with characters that think, breathe, feel, and act.</p><p>Students will also learn how to film themselves for reference and how to effectively use this material by analyzing and applying these insights to their animations.</p>\n","isDescriptionOutdated":true,"order":30,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":"Animation (animasjon)","studyOption":null,"category":"specialization"},{"code":"ANI203","name":"Animation 3","description":"\n<p>Animation 3 builds on the principles from Animation 1 and Animation 2. This course takes you deeper into the fascinating world of storytelling, acting techniques, and dramaturgy to create engaging scenes.</p><p>During Animation 3, you will not only learn advanced animation techniques, such as facial animation, but also how to bring characters to life and imbue them with empathy throughout their journey. From miming to lively scenes with dialogue, we explore how to convey conflict, emotions, and personality through animation.</p><p>We focus on detailing and polishing in the final phase of the animation process. Here, you will fine-tune asymmetry in posing, both in the body and face, as well as variations in curves, spacing, and all the small details that bring the character to life.</p><p>Students will gain extensive experience in giving and receiving constructive feedback on their work.</p>\n","isDescriptionOutdated":true,"order":31,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":"Animation (animasjon)","studyOption":null,"category":"specialization"},{"code":"ANI304","name":"Animation 4","description":"\n<p>The course is an advanced animation course focusing on dramaturgy and behaviour for humans, animals, and creatures. The student will have the opportunity to develop their own expression and style. High standards are set for quality and execution in the last animation polishing phase. </p>\n","isDescriptionOutdated":true,"order":50,"points":7.5,"year":3,"semester":"first","isPrerequisite":false,"specialization":"Animation (animasjon)","studyOption":null,"category":"specialization"},{"code":"VFX117","name":"Shot Design","description":"\n<p>In this course, the student will learn to design and plan cinematographic film shots that tell a story in an effective and aesthetic way. Through the study of shots from famous films, the student will gain insight into how cinematographers and directors design different types of shots as a tool to create a visual narrative. The student will learn to break down scripts into effective images and to previsualize these images using storyboards and animated previzualisation.</p>\n","isDescriptionOutdated":false,"order":21,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":"Animation (animasjon)","studyOption":null,"category":"specialization"},{"code":"SPD116","name":"Prototyping","description":"\n<p>This course covers the fundamentals of system, UX, and UI design. Students learn to create, implement, and evaluate scalable game systems and intuitive, player-focused interfaces through prototypes. Emphasizing the connection between systems and UX/UI, the course teaches how to build gameplay-enhancing, usable designs. Projects include requirements analysis, human-centered design principles, flowcharts, wireframes, and progress from early prototypes to refined designs and user testing.</p>\n","isDescriptionOutdated":true,"order":31,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":"Game Design (spilldesign)","studyOption":null,"category":"specialization"},{"code":"SPD121","name":"Game Design 1","description":"\n<p>In this course, the students will be introduced to the theories and concepts that form the foundation of a modern understanding of games and game design. Students will study and analyze a wide range of games, learning to understand how game mechanics are used to create different types of gameplay experiences. Through this course, students will gain practical experience in the iterative development of game concepts, both individually and in groups.</p>\n","isDescriptionOutdated":false,"order":20,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":"Game Design (spilldesign)","studyOption":null,"category":"specialization"},{"code":"SPD122","name":"Game Design 2","description":"\n<p>Within the course, students will develop, in group, a 2D game from initial idea to completion and release. This course will give the students an introduction to 2D artistic tools and concepts, project management insights as well as teach them how to write the fundamental documents that a game designer needs to produce during a game development cycle. Students will also learn about the work processes, tools, and roles necessary to develop a 2D game and will deliver - in addition of their game - pitch decks, Game Design documents and art bible.</p>\n","isDescriptionOutdated":false,"order":22,"points":15,"year":1,"semester":"second","isPrerequisite":false,"specialization":"Game Design (spilldesign)","studyOption":null,"category":"specialization"},{"code":"SPD123","name":"System Design 1","description":"\n<p>The work in this course will familiarize students with the fundamental processes of analyzing, developing, and implementing system-based game design. The course will provide students with knowledge of a range of advanced topics in system design, including balancing, game AI, emergence, and progression. The course will also cover a selection of systems across various game types.</p>\n","isDescriptionOutdated":false,"order":21,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":"Game Design (spilldesign)","studyOption":null,"category":"specialization"},{"code":"SPD209","name":"Narrative and Level Design","description":"\n<p>In this course, the student will get a basic introduction to narrative structures linked to level design and visual storytelling techniques in games. The student will explore how video games tell stories, and how well-known principles from game and level design can enhance the narrative through mechanics, theme and mood. Through the course, the student will be introduced to narrative and level design, and gain practical experience with the design, development and iteration of virtual areas.</p>\n","isDescriptionOutdated":true,"order":30,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":"Game Design (spilldesign)","studyOption":null,"category":"specialization"},{"code":"SPD324","name":"System Design 2","description":"\n<p>This course aims to provide students with a deeper understanding of system design through the lens of game balancing. Students will be introduced to advanced system design, which will be explored in detail. The course will cover various game mechanics, focusing on how these can be utilized, combined, and balanced to create a meaningful experience for the player.</p>\n","isDescriptionOutdated":true,"order":50,"points":7.5,"year":3,"semester":"first","isPrerequisite":false,"specialization":"Game Design (spilldesign)","studyOption":null,"category":"specialization"},{"code":"VFX116","name":"Compositing 1","description":"\n<p>The subject is the student's first encounter with the specialization visual effects (VFX) in the BA in Computer Arts and gives students a basic understanding of what VFX is and how it is used in filmmaking. The student will get the first introduction to compositing. Through lectures and exercises, the student will learn to observe the world through the camera lens and will be introduced to VFX software, methods, pipeline and processes. Emphasis is placed on independent work and exercises that enable the student to produce simple VFX clips.</p>\n","isDescriptionOutdated":false,"order":20,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":"Visual Effects","studyOption":null,"category":"specialization"},{"code":"VFX117","name":"Shot Design","description":"\n<p>In this course, the student will learn to design and plan cinematographic film shots that tell a story in an effective and aesthetic way. Through the study of shots from famous films, the student will gain insight into how cinematographers and directors design different types of shots as a tool to create a visual narrative. The student will learn to break down scripts into effective images and to previsualize these images using storyboards and animated previzualisation.</p>\n","isDescriptionOutdated":false,"order":21,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":"Visual Effects","studyOption":null,"category":"specialization"},{"code":"VFX118","name":"Compositing 2","description":"\n<p>This subject will give the student a solid introduction to VFX software. The student will get a systematic review of the software interface and the nodes that were introduced in earlier courses. Through work on the subject, the student will further develop their understanding of colorspaces, rotoscoping, paint/cleanup, color correction and keying. Furthermore, the student will gain knowledge about the integration of rendered CG elements as well as more complex nodes, LUT's, expressions and Gizmos, and Nuke's 3D system especially for 2.5D compositing.</p><p>Throughout the course, the student will work in a VFX pipeline (work process) and receive weekly feedback in the dailies.</p><p>By solving production-related tasks, the student gets a solid foundation to build on and becomes comfortable with basic VFX tasks.</p>\n","isDescriptionOutdated":false,"order":22,"points":15,"year":1,"semester":"second","isPrerequisite":false,"specialization":"Visual Effects","studyOption":null,"category":"specialization"},{"code":"VFX220","name":"Compositing 3","description":"\n<p>Compositing 3 builds on the Compositing 2 course. The focus is on more advanced projects and typical advanced compositing tasks the students will encounter in the industry as well as completion of shots. Students will get to know some of the latest techniques and be able to make the final touches needed to deliver professional shots.</p>\n","isDescriptionOutdated":true,"order":50,"points":7.5,"year":3,"semester":"first","isPrerequisite":false,"specialization":"Visual Effects","studyOption":null,"category":"specialization"},{"code":"VFX221","name":"Cinematography","description":"\n<p>The course gives students an introduction to photographic technique with a focus on composition and exposure/lighting. Students will learn to see subjects through the camera lens. Students also learn film as visual storytelling and how to use image composition, lighting and camera movement to tell a story. By filming their own VFX sequences, the students will increase their understanding of film and VFX techniques.</p>\n","isDescriptionOutdated":true,"order":30,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":"Visual Effects","studyOption":null,"category":"specialization"},{"code":"VFX222","name":"3D for VFX","description":"\n<p>In this course the students will get an introduction to 3D graphics used as a tool towards work with visual effects (VFX). The students will gain basic skills in lighting and rendering of digital 3D objects with a view to integration in a VFX work process.</p>\n","isDescriptionOutdated":true,"order":31,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":"Visual Effects","studyOption":null,"category":"specialization"},{"code":"UTV999BA30","name":"Utveksling","description":null,"isDescriptionOutdated":null,"order":1,"points":30,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Exchange","isDefault":false},"category":"obligatory"},{"code":"VAL999-7ENG","name":"Elective course","description":"\r\n<p lang=\"en-US\" style=\"text-indent:0pt;margin-left:0pt;margin-top:0pt;margin-bottom:0pt;margin-right:0pt;\"><a href=\"https://www.kristiania.no/for-studenter/valgemner-og-praksis/\" style=\"color:#0000EE;text-decoration:underline ;\">See elective courses</a><span lang=\"en-GB\">.</span></p>\r\n","isDescriptionOutdated":true,"order":31,"points":7.5,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Default path","isDefault":true},"category":"elective"}],"translations":{"studyOptions":"Options","elective":"Elective","specialization":"Specialization","selectYear":"Select year","openSubjectOverlay":"Open subject overlay","closeOverlay":"Close overlay","genericErrorMessage":"Error occured","totalStudyPointsFormat":"{points} total credits","studyPointsFormat":"{points} credits","pointsUnit":"credits","noSubjectsMessage":"Sorry, the content could not be loaded at the moment","prerequisites":"Prerequisites","goToSubject":"Read more","loading":"Loading data","year":"year","semester":"semester","single":"single","first":"first","second":"second","third":"third","fourth":"fourth","fifth":"fifth"},"type":"view","id":"study-model","teaser":"The study model is an excerpt from the program description. It provides you with an overview of mandatory courses and the opportunities you have for internships, exchanges, and specializations. The bachelor's degree spans three academic years. Each academic year is divided into two semesters. We reserve the right to make changes. To view the study model for the different specializations, you can click on Specialization and choose the one you want to see.","settings":{"disableStudyModel":false,"disabledStudyModelHeading":"Study model information","disabledStudyModelMessage":{"value":"The study model is being worked on and will be published as soon as it is ready"}},"studyProgramLink":{"label":"See program description","href":"/en/syllabus/faculty-of-society-arts-and-media/first-cycle-degree/bca/bachelor-in-computer-arts/","external":false,"showIsExternal":true}};</script></div>
</div><div>
<div id="c4ab066b"><section id="career-opportunities" class="cr4GKFNCqp2Yu1c2kbOA"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF vw2qEzBLsG8dfPFKhCCL">Career opportunities</h2><div class="eCTirCs_JIAXtZrCECpB"><div class="s4PUgF87xJpwYCH4qegZ"><div class="gOFfCOGgsoYfQDsrulwN Um_bsxrmr048dYBfonAO hfMRvjcJ6bvRCr56YbNA"><div class="KgSPjnWKLeiPJ0FM0dQy RichtextContent RichtextContent--dark">Graduates of Kristiania's Bachelor in Computer Arts are equipped for diverse career opportunities in animation, game design, 3D graphics, and visual effects, with roles in film, TV, gaming, advertising, and beyond.</p>
<p>Examples of jobs include:&nbsp;&nbsp;</p>
<ul class="Richtext__ul">
<li aria-level="1">Visual Effects (VFX) Artist</li>
<li aria-level="1">Game Designer</li>
<li aria-level="1">3D Artist</li>
<li aria-level="1">Interactive Media Designer</li>
<li aria-level="1">Virtual Reality (VR) Developer</li>
</ul></div><div><button title="More about career opportunities" aria-expanded="false" aria-controls="overlay_2106" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT RLuLMRDzYQ3XgZOh0LH6"><span class="visuallyHidden">More about career opportunities</span><span class="SvgIcon qRe66TfUwTfvEUQmJRJf"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus-circle"></use></svg></span></button><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_2106" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_2107"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Close overlay" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Close overlay</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_2107" class="visuallyHidden">More about career opportunities</span><h3 class="QyHwrlI4c0dLFrsS3esJ">More about career opportunities</h3><div class="RichtextContent RichtextContent--dark">Former students are highly sought after in the Computer Arts-industry due to the hands-on learning process. Also, some of the subjects have been created by and are being taught by leading artists within their fields. This creates impressive job opportunities for our alumni.&nbsp;</p>
<p>For instance, did you know that several Hollywood blockbuster films and TV-shows have had their visual effects made in Norway? Scenes from &ldquo;The Last of Us&rdquo;,&ldquo;Black Panther - Wakanda Forever&rdquo; and many other visual effects you may have seen were made by some of our former students.</div></div></div></div></div></div></div></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['c4ab066b-json'] = {"id":"career-opportunities","heading":{"value":"Career opportunities"},"teaser":{"value":"Graduates of Kristiania's Bachelor in Computer Arts are equipped for diverse career opportunities in animation, game design, 3D graphics, and visual effects, with roles in film, TV, gaming, advertising, and beyond.</p>\n<p>Examples of jobs include:&nbsp;&nbsp;</p>\n<ul class=\"Richtext__ul\">\n<li aria-level=\"1\">Visual Effects (VFX) Artist</li>\n<li aria-level=\"1\">Game Designer</li>\n<li aria-level=\"1\">3D Artist</li>\n<li aria-level=\"1\">Interactive Media Designer</li>\n<li aria-level=\"1\">Virtual Reality (VR) Developer</li>\n</ul>"},"linkList":[],"featuredArticle":null,"blockVariant":"default","overlayButtonLabel":"More about career opportunities","overlayHeading":"More about career opportunities","overlayContent":{"value":"Former students are highly sought after in the Computer Arts-industry due to the hands-on learning process. Also, some of the subjects have been created by and are being taught by leading artists within their fields. This creates impressive job opportunities for our alumni.&nbsp;</p>\n<p>For instance, did you know that several Hollywood blockbuster films and TV-shows have had their visual effects made in Norway? Scenes from &ldquo;The Last of Us&rdquo;,&ldquo;Black Panther - Wakanda Forever&rdquo; and many other visual effects you may have seen were made by some of our former students."},"overlayCloseLabel":"Close overlay"};</script></div>
</div><div>
<div id="1c37de01"><section id="meet-the-faculty" class="xfIZ8IPRSKGxzL5KIyLz ZG9x_vn8GvsrSWPis7bl"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF Bje8lNYEARjKXkaadcjl">Meet the faculty</h2><div class="IP4WLEZAtSgblGP4Felg"><div class="KCVvuotjBI0iy0ATTKfK"><div class="slJnKPGAAIKofsQwQBjL vPKYJ9xnnqorRitmkm3i ssmQS4h9jzEH4V0L4NSN"><picture><source sizes="(max-width: 767px) 100vw, (min-width: 768px) 552px" srcSet="/contentassets/1c9858c948994fa0ba53a410bd673be9/spilldesign_3d_datalab-10.jpg?width=375 375w, /contentassets/1c9858c948994fa0ba53a410bd673be9/spilldesign_3d_datalab-10.jpg?width=552 552w, /contentassets/1c9858c948994fa0ba53a410bd673be9/spilldesign_3d_datalab-10.jpg?width=768 768w, /contentassets/1c9858c948994fa0ba53a410bd673be9/spilldesign_3d_datalab-10.jpg?width=1536 1536w"/><img src="/contentassets/1c9858c948994fa0ba53a410bd673be9/spilldesign_3d_datalab-10.jpg?width=552" alt="Oversiktsbilde fra klasserom." style="object-position:34% 40%" loading="lazy"/></picture></div></div><ul class="tZx0pZhK8q3JNoQI8LCj"><li class="i8yQuD9MeLJCD5eDKft2"><div class="cVALO6yJDjmV1Xvkvynu"><div class="WWUAFGePNJBA0_seRWlX"><h3 class="TCpxq20heJlGBaSbNI4y">Our staff</h3><div class="AXbF9ehRSXzzERBwn1XK RichtextContent RichtextContent--light"><ul class="Richtext__ul">
<li>Assistant Professor <a href="/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/trygve-bjellvag/">Trygve Bjellv&aring;g</a> has worked at FunCom and has been teaching game design for more than 10 years.</li>
<li><a href="/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/ivar-kjellmo/">Ivar Kjellmo </a>is a visual artist with extensive industry experience and is one of the authors behind Norway's first textbook on 3D graphics.</li>
<li><a href="/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/morten-moen/">Morten Moen</a> is a former VFX Supervisor at Storm Studios. He has been instrumental in building the VFX industry in Norway and has worked on over 60 films and TV series.</li>
<li><a href="/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/hans-gunnar-brekke/">Hans Gunnar Brekke</a> has many years of experience from major productions abroad and has applied his experience from The Jungle Book, Twilight, and The Hobbit films in the development of the program.</li>
</ul></div></div></div></li><li class="i8yQuD9MeLJCD5eDKft2"><div class="cVALO6yJDjmV1Xvkvynu"><div class="WWUAFGePNJBA0_seRWlX"><h3 class="TCpxq20heJlGBaSbNI4y">How we work</h3><div class="AXbF9ehRSXzzERBwn1XK RichtextContent RichtextContent--light"><ul class="Richtext__ul">
<li>Everyday life as a student in Kristiania's Bachelor in Computer Arts is dynamic and hands-on, with a blend of lectures, workshops, and collaborative project work. You&rsquo;ll spend your time in state-of-the-art facilities honing your technical skills on industry-standard software.</li>
<li>Group projects are a central part of the experience, where you'll work closely with peers from different specializations, simulating real-world production environments. Outside of class, you&rsquo;ll engage in self-directed work, refining your creative concepts and building your professional portfolio.</li>
<li>The program also offers guest lectures, industry events, and mentorship from faculty, making each day a step closer to a career in the digital arts.</li>
</ul></div></div></div></li></ul></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['1c37de01-json'] = {"id":"meet-the-faculty","heading":{"value":"Meet the faculty"},"testimonies":[{"heading":{"value":"Our staff"},"content":{"value":"<ul class=\"Richtext__ul\">\n<li>Assistant Professor <a href=\"/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/trygve-bjellvag/\">Trygve Bjellv&aring;g</a> has worked at FunCom and has been teaching game design for more than 10 years.</li>\n<li><a href=\"/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/ivar-kjellmo/\">Ivar Kjellmo </a>is a visual artist with extensive industry experience and is one of the authors behind Norway's first textbook on 3D graphics.</li>\n<li><a href=\"/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/morten-moen/\">Morten Moen</a> is a former VFX Supervisor at Storm Studios. He has been instrumental in building the VFX industry in Norway and has worked on over 60 films and TV series.</li>\n<li><a href=\"/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/hans-gunnar-brekke/\">Hans Gunnar Brekke</a> has many years of experience from major productions abroad and has applied his experience from The Jungle Book, Twilight, and The Hobbit films in the development of the program.</li>\n</ul>"}},{"heading":{"value":"How we work"},"content":{"value":"<ul class=\"Richtext__ul\">\n<li>Everyday life as a student in Kristiania's Bachelor in Computer Arts is dynamic and hands-on, with a blend of lectures, workshops, and collaborative project work. You&rsquo;ll spend your time in state-of-the-art facilities honing your technical skills on industry-standard software.</li>\n<li>Group projects are a central part of the experience, where you'll work closely with peers from different specializations, simulating real-world production environments. Outside of class, you&rsquo;ll engage in self-directed work, refining your creative concepts and building your professional portfolio.</li>\n<li>The program also offers guest lectures, industry events, and mentorship from faculty, making each day a step closer to a career in the digital arts.</li>\n</ul>"}}],"gobiStoryId":null,"imageFallback":{"author":null,"caption":null,"url":"/contentassets/1c9858c948994fa0ba53a410bd673be9/spilldesign_3d_datalab-10.jpg","alt":"Oversiktsbilde fra klasserom.","focalPoint":{"x":0.34,"y":0.4},"lazyLoading":true},"translations":{"openPlayer":"Open player","failedToLoadVideo":"Sorry, for some reason we could not load a video"},"variant":"dark"};</script></div>
</div><div>
<div id="9ded36a8"><section id="meet-the-study-program-leader" class="cPloAW9ETJppiKf3uOg6 PS9OiuwCp_Mtf4jcUm_I"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><div class="OPDkk3SbGwWTZeDlZj4f"><div class="Za0F_aizRoRV7IW8vrhK"><span class="SvgIcon R8xM2ukm6YYDNzHE9e8V"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-quote-mark"></use></svg></span></div><div class="OBg8GbGOQ11Y_kO0y26Q"><span>I am a trained game designer and have worked at PlayStation and Funcom. I believe you learn best by working practically &ndash; and a lot!</span></div><div class="WyTuSgXamI5tDjjbW40k"><div class="ELZbSN0xkGRxudxoCGZD Jjpdm0z1lffwiYq7tJFx"><div class="slJnKPGAAIKofsQwQBjL BsNJMoWrLSwywFoZw_rI"><picture><source sizes="(max-width: 479px) 100vw, (min-width: 480px) 350px" srcSet="/contentassets/e00b8995e8114ee58347f2289f2adf1b/hanne_lien.jpg?width=350 350w, /contentassets/e00b8995e8114ee58347f2289f2adf1b/hanne_lien.jpg?width=470 470w"/><img src="/contentassets/e00b8995e8114ee58347f2289f2adf1b/hanne_lien.jpg?width=258" alt="Hanne Lien" loading="lazy"/></picture></div><div class="wgsfEYhliRuQ3OGsPPB7"><a href="/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/hanne-lien/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi A9IrxP6x1kHMxJBX5nkl" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="PafA02TiaN5DOnBONInU">Hanne Lien</span><span class="C7aWfJ5wcSGxkMQk5mVC"><ul class="ybs02MiIsdu5yS7LYwML"><li class="MkfboJs3JDCOgTmDA6XY">Assistant Professor</li></ul><span class="WNOGE5Zjbw73YZqwUfmg">Department of Performing Arts, Film and Media</span></span></div></a></div></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['9ded36a8-json'] = {"id":"meet-the-study-program-leader","quote":{"value":"<span>I am a trained game designer and have worked at PlayStation and Funcom. I believe you learn best by working practically &ndash; and a lot!</span>"},"employeeInfo":{"name":"Hanne Lien","picture":{"profile":{"defaultWidth":258,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[350,470],"sizes":["(max-width: 479px) 100vw","(min-width: 480px) 350px"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":null,"caption":null,"url":"/contentassets/e00b8995e8114ee58347f2289f2adf1b/hanne_lien.jpg","alt":"Hanne Lien","focalPoint":null,"lazyLoading":true},"jobTitles":["Assistant Professor"],"department":"Department of Performing Arts, Film and Media","organization":"Kristiania University of Applied Sciences","link":{"label":"Hanne Lien","href":"/en/about-kristiania/employees/fakultet-for-samfunn-kunst-og-medier/department-of-performing-arts-film-and-media/hanne-lien/","external":false,"showIsExternal":true}},"variant":"red"};</script></div>
</div><div>
