<div id="8e9da82a"><div class="T9s2xkF6zj_7pUCGDUHb"><div class="GVCcM3ty8VKYbJ2XT_Dk UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef nuydYi_Wd6zwyeTcuMig" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/8fe79615833f49819681a26f1888e29d/edit_shotby_lucas.esmodvisning.2025-20-1.jpg?width=375 375w, /contentassets/8fe79615833f49819681a26f1888e29d/edit_shotby_lucas.esmodvisning.2025-20-1.jpg?width=500 500w, /contentassets/8fe79615833f49819681a26f1888e29d/edit_shotby_lucas.esmodvisning.2025-20-1.jpg?width=768 768w, /contentassets/8fe79615833f49819681a26f1888e29d/edit_shotby_lucas.esmodvisning.2025-20-1.jpg?width=1024 1024w"><img src="/contentassets/8fe79615833f49819681a26f1888e29d/edit_shotby_lucas.esmodvisning.2025-20-1.jpg?width=500" alt="Modell på catwalk" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA mUg4eEAIUffj8Zar9HZK"><h2 class="ZiduBuPrxHXQhabvP6SQ">Studer på Norges ledende moteskole!</h2><div class="BrxHX8d3IdyRW2EN5wWq">ESMOD Oslo er Norges eldste og mest prestisjetunge moteskole. Vi har utdannet designere og modellører siden 1990. Utdanningene er forankret i solide tradisjoner gjennom mer enn 180 år. </div><a href="/fagskolen-kristiania/esmodoslo/" title="Les mer om ESMOD Oslo" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Les mer om ESMOD Oslo</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['8e9da82a-json'] = {"image":{"profile":{"defaultWidth":500,"form