<div id="21901ce9"><div class="T9s2xkF6zj_7pUCGDUHb"><div class="LQwCx4VsA_20nL7PJl_A UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef nuydYi_Wd6zwyeTcuMig" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/5874a6f2f32449a89c573a7314eef297/fagskolen_kristiania_nettstudier.webp?width=375 375w, /contentassets/5874a6f2f32449a89c573a7314eef297/fagskolen_kristiania_nettstudier.webp?width=500 500w, /contentassets/5874a6f2f32449a89c573a7314eef297/fagskolen_kristiania_nettstudier.webp?width=768 768w, /contentassets/5874a6f2f32449a89c573a7314eef297/fagskolen_kristiania_nettstudier.webp?width=1024 1024w"><img src="/contentassets/5874a6f2f32449a89c573a7314eef297/fagskolen_kristiania_nettstudier.webp?width=500" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA lwj1fS09bnWFOXW1AKFu"><h2 class="ZiduBuPrxHXQhabvP6SQ">Fagskole på nett</h2><div class="BrxHX8d3IdyRW2EN5wWq">Kristiania tilbyr et bredt utvalg av fagskolestudier på nett innen fagområder som helse, oppvekst, økonomi, administrasjon og markedsføring. </div><a href="/fagskolen-kristiania/nettstudier/" title="Se våre nettbaserte fagskolestudier!" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Se våre nettbaserte fagskolestudier!</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></div><script>(window.__reactProps = window.__reactProps || {})['21901ce9-json'] = {"image":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[375,500,768,1024],"sizes":["(min-width: 1440px) 768px","(min-width: 768px) 50vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":null,"caption":null,"url":"/contentassets/5874a6f2f32449a89c573a7314eef297/fagskolen_kristiania_nettstudier.webp","alt":null,"focalPoint":null,"lazyLoading":true},"imageFitBehavior":"fill","imageAlignment":"left","orientation":"horizontal","contentCardViewModel":{"title":"Fagskole på nett","description":"Kristiania tilbyr et bredt utvalg av fagskolestudier på nett innen fagområder som helse, oppvekst, økonomi, administrasjon og markedsføring. ","callToActionLink":{"label":"Se våre nettbaserte fagskolestudier!","href":"/fagskolen-kristiania/nettstudier/","external":false,"showIsExternal":true},"useLegacyLink":false,"variant":"darkRed","size":"large","buttonType":"circleButton"}};</script></div>
</section><section class="Richtext__block">


<div id="4426890b"></div>

<section class="TextSection TextSection--transparent TextSection--rounded">
    <div class="TextSection__content">
<div class="wrapper"><div class="PageLayout__grid"><div class="PageLayout__content Richtext__content">                <h2 class="TextSection__heading">Hvorfor velge fagskole?</h2>
</div></div></div>        <div class="TextSection__body">
            
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content RichtextContent--dark PageLayout__content"><ul class="Richtext__ul">
<li><strong>Kort og intensivt:</strong><span>&nbsp;</span>Studiene har kortere varighet, fra seks måneder til to år på fulltid.</li>
<li><strong>Tett koblet til arbeidslivet:</strong><span>&nbsp;</span>Utdanningene er utviklet i samarbeid med bransjen for å sikre relevans.</li>
<li><strong>Praktisk og yrkesrettet:</strong><span>&nbsp;</span>Du jobber med relevante problemstillinger og får kompetanse du kan bruke i arbeidslivet.</li>
<li><strong>Erfarne faglærere:</strong><span>&nbsp;</span>Du undervises av faglærere og gjesteforelesere med lang og relevant yrkeserfaring.</li>
<li><strong>God oppfølging:</strong><span>&nbsp;</span>Fagskole har små klasser og tett oppfølging, som sikrer et godt læringsmiljø.</li>
</ul></div></div></div>

        </div>
    </div>
</section>
</section><section class="Richtext__block">

<div id="0fd2c117"><div class="HVEFaX3Xhdad0zHYPsqr"><h2 class="visuallyHidden">2 artikler - Content card w img</h2><ul class="BHOhHAvbNpiTc98k3PWM"><li><div class="LQwCx4VsA_20nL7PJl_A UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef AHXY6KuZSDnpZWG0CfLj" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/4dfcf50a95e34f83ba3b5b27a460c197/julie-og-mathilde-innholdsproduksjon.jpg?width=375 375w, /contentassets/4dfcf50a95e34f83ba3b5b27a460c197/julie-og-mathilde-innholdsproduksjon.jpg?width=500 500w, /contentassets/4dfcf50a95e34f83ba3b5b27a460c197/julie-og-mathilde-innholdsproduksjon.jpg?width=768 768w, /contentassets/4dfcf50a95e34f83ba3b5b27a460c197/julie-og-mathilde-innholdsproduksjon.jpg?width=1024 1024w"><img src="/contentassets/4dfcf50a95e34f83ba3b5b27a460c197/julie-og-mathilde-innholdsproduksjon.jpg?width=500" alt="To personer står i en trapp i et lyst kontorlokale med arbeidsplasser i bakgrunnen." style="object-position:17% 43%" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA lwj1fS09bnWFOXW1AKFu la0uKOQNZdLd8OUc_QfI"><h2 class="ZiduBuPrxHXQhabvP6SQ">Fra praksis til drømmejobb etter studiet i Digital innholdsproduksjon</h2><div class="BrxHX8d3IdyRW2EN5wWq">Mathilde og Julie startet på fagskolestudiet i digital innholdsproduksjon, og endte opp med jobb før studiene var ferdig. Dette er historien om hvordan praksis åpnet dørene til arbeidslivet.</div><a href="/aktuelt/2026/07/fra-praksis-til-drommejobb-etter-studiet-i-digital-innholdsproduksjon/" title="Les om studentenes vei fra praksis til jobb" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Les om studentenes vei fra praksis til jobb</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></li><li><div class="LQwCx4VsA_20nL7PJl_A UmvrEMqsi3eWsu4AYzIA kysUYaVXrWoTAEshqCHx ContentCardBase--shadowed dRL3syNqwxAMSfJcjgPS KfU6iJxklWZbYVZvHgox qwPq3mKKd77HSnPCVCWg VC_CHutChDPYnxQJpTef AHXY6KuZSDnpZWG0CfLj" role="none"><div class="aF5b1xTlFkv6HfFub_RV"><div class="slJnKPGAAIKofsQwQBjL GelTlugjDlqROsEpS6Tz"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/ed465a89ce2845f3906c0e1b78988dbc/norges-storste-fagskole-kristiania.jpg?width=375 375w, /contentassets/ed465a89ce2845f3906c0e1b78988dbc/norges-storste-fagskole-kristiania.jpg?width=500 500w, /contentassets/ed465a89ce2845f3906c0e1b78988dbc/norges-storste-fagskole-kristiania.jpg?width=768 768w, /contentassets/ed465a89ce2845f3906c0e1b78988dbc/norges-storste-fagskole-kristiania.jpg?width=1024 1024w"><img src="/contentassets/ed465a89ce2845f3906c0e1b78988dbc/norges-storste-fagskole-kristiania.jpg?width=500" alt="Person sitter med sykkel utenfor Kristiania campus" style="object-position:35% 27%" loading="lazy"></picture></div></div><div class="zTp7C_PMR93tainVWKZM"><div class="TYcoq9Rh8z7xyECZudNA lwj1fS09bnWFOXW1AKFu la0uKOQNZdLd8OUc_QfI"><h2 class="ZiduBuPrxHXQhabvP6SQ">Nå blir vi Norges største fagskole</h2><div class="BrxHX8d3IdyRW2EN5wWq">Fagskolen Kristiania blir Norges største fagskole. Her kan du lese mer om hva sammenslåingen betyr for studietilbud, fagmiljøer og studenter.</div><a href="/aktuelt/2026/06/norges-storste-fagskole/" title="Les mer om Norges største fagskole her" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi gYkAa9g2NSCw73nq6w8P" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="visuallyHidden">Les mer om Norges største fagskole her</span><span class="SvgIcon ZZTVQHAQYCpOyObqO2AO"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right-circle"></use></svg></span></div></a></div></div></div></li></ul></div><script>(window.__reactProps = window.__reactProps || {})['0fd2c117-json'] = {"title":"2 artikler - Content card w img","items":[{"image":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[375,500,768,1024],"sizes":["(min-width: 1440px) 768px","(min-width: 768px) 50vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Terje Borud","caption":"Julie og Mathilde fikk jobb hos samme arbeidsgiver etter studiet i digital innholdsproduksjon.","url":"/contentassets/4dfcf50a95e34f83ba3b5b27a460c197/julie-og-mathilde-innholdsproduksjon.jpg","alt":"To personer står i en trapp i et lyst kontorlokale med arbeidsplasser i bakgrunnen.","focalPoint":{"x":0.17,"y":0.43},"lazyLoading":true},"imageFitBehavior":"fill","imageAlignment":"left","orientation":"vertical","contentCardViewModel":{"title":"Fra praksis til drømmejobb etter studiet i Digital innholdsproduksjon","description":"Mathilde og Julie startet på fagskolestudiet i digital innholdsproduksjon, og endte opp med jobb før studiene var ferdig. Dette er historien om hvordan praksis åpnet dørene til arbeidslivet.","callToActionLink":{"label":"Les om studentenes vei fra praksis til jobb","href":"/aktuelt/2026/07/fra-praksis-til-drommejobb-etter-studiet-i-digital-innholdsproduksjon/","external":false,"showIsExternal":true},"useLegacyLink":false,"variant":"darkRed","size":"large","buttonType":"circleButton"}},{"image":{"profile":{"defaultWidth":500,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[375,500,768,1024],"sizes":["(min-width: 1440px) 768px","(min-width: 768px) 50vw","100vw"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":"Terje Borud","caption":"Tre sterke fagmiljøer samles i én fagskole. ","url":"/contentassets/ed465a89ce2845f3906c0e1b78988dbc/norges-storste-fagskole-kristiania.jpg","alt":"Person sitter med sykkel utenfor Kristiania campus","focalPoint":{"x":0.35,"y":0.27},"lazyLoading":true},"imageFitBehavior":"fill","imageAlignment":"left","orientation":"vertical","contentCardViewModel":{"title":"Nå blir vi Norges største fagskole","description":"Fagskolen Kristiania blir Norges største fagskole. Her kan du lese mer om hva sammenslåingen betyr for studietilbud, fagmiljøer og studenter.","callToActionLink":{"label":"Les mer om Norges største fagskole her","href":"/aktuelt/2026/06/norges-storste-fagskole/","external":false,"showIsExternal":true},"useLegacyLink":false,"variant":"darkRed","size":"large","buttonType":"circleButton"}}]};</script></div>
</section><section class="Richtext__block">


<div id="03216157"></div>

<section class="TextSection TextSection--transparent TextSection--rounded">
    <div class="TextSection__content">
<div class="wrapper"><div class="PageLayout__grid"><div class="PageLayout__content Richtext__content">                <h2 class="TextSection__heading">Dette er fagskole</h2>
</div></div></div>        <div class="TextSection__body">
            
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content RichtextContent--dark PageLayout__content"><ul class="Richtext__ul">
<li>Fagskole er høyere yrkesfaglig utdanning, som ligger på nivået over videregående skole.</li>
<li>Toårig fagskolegrad på heltid gir 120 studiepoeng, mens ettårig fagskolegrad gir 60 studiepoeng.</li>
<li>Du kan studere <a href="/fagskolen-kristiania/nettstudier/">fagskole på nett</a>, eller på <a href="/studere-hos-oss/campus/">campus i Oslo og Bergen</a>.</li>
<li>Fagskoleutdanning passer for deg som ønsker en praktisk tilnærming til et yrke og ferdigheter du faktisk får bruk for i jobb.</li>
<li>Studiene svarer på behovet i arbeidsmarkedet. Du kan med andre ord være trygg på at det du lærer er relevant og etterspurt i arbeidslivet.</li>
</ul>
<p><a href="/aktuelt/hva-er-fagskole/">Les mer om hva fagskole er her.</a></p>
</div></div></div><section class="Richtext__block">
<div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
    <div id="4dbc863e"><div class="SLF7RES86xTPWWtki82o IJHuFtWyStsP0cGiCsM6 hL8gjEb7Q_E5XTbS9vt7"><h3 class="aCMqJVKEHAuH57tV0Yrb">Forskjeller mellom fagskole og høyskole</h3><div class="bJYngK6ypImoeEjc1Zsc"><div class="Z7wPDEVliiNixyrnGVgQ" id="FactBox__3621"><div class="RichtextContent RichtextContent--dark"><div class="bJYngK6ypImoeEjc1Zsc">
<div class="Z7wPDEVliiNixyrnGVgQ">
<div class="RichtextContent RichtextContent--dark">Fagskole tilbyr kortere studier som er praktiske og yrkesrettet, mens høyskoler tilbyr lengre, mer teoretiske og akademiske utdanninger. Les mer om <a href="/aktuelt/hva-er-forskjellen-pa-fagskole-og-hoyskole/">forskjellen på fagskole og høyskole</a>.</div>


<div class="RichtextContent RichtextContent--dark">Kristiania tilbyr flere lignende studier på fagskole- og bachelornivå. For å gjøre det enklere for deg å velge riktig utdanning, har vi laget noen guider som enkelt forklarer forskjellene.</div>
<div class="RichtextContent RichtextContent--dark"><br>
<p><strong>Se hva som skiller utdanningene våre:</strong></p>
<ul class="Richtext__ul">
<li><a href="/utdanning/interior-utdanning-pa-hoyskole-eller-fagskole/">Interiør</a></li>
<li><a href="/utdanning/grafisk-design-pa-hoyskole-eller-fagskole/">Grafisk design</a></li>
<li><a href="/utdanning/Interaksjonsdesign-pa-hoyskole-eller-fagskole/">Interaksjonsdesign</a></li>
<li><a href="/utdanning/studere-frontend-utvikling-pa-hoyskole-eller-fagskole/">Frontend</a></li>
</ul>
</div>
</div>
</div></div></div></div><button aria-expanded="false" aria-controls="FactBox__3621" type="button" class="AMdryBi_G8WFVbcuUzSv HIBx2TMQpGodNFRbYUAk cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE bQnzyEtrQzS6zXg8sIYY"><span class="SY7qxDlwf0da4MKx6771">Vis mer</span><span class="SvgIcon pyDZM0A_KbzwdqEbA_Vk"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-down"></use></svg></span></button></div><script>(window.__reactProps = window.__reactProps || {})['4dbc863e-json'] = {"heading":"Forskjeller mellom fagskole og høyskole","variant":"light","content":{"value":"<div class=\"bJYngK6ypImoeEjc1Zsc\">\n<div class=\"Z7wPDEVliiNixyrnGVgQ\">\n<div class=\"RichtextContent RichtextContent--dark\">Fagskole tilbyr kortere studier som er praktiske og yrkesrettet, mens h&oslash;yskoler tilbyr lengre, mer teoretiske og akademiske utdanninger. Les mer om <a href=\"/aktuelt/hva-er-forskjellen-pa-fagskole-og-hoyskole/\">forskjellen p&aring; fagskole og h&oslash;yskole</a>.</div>\n\n\n<div class=\"RichtextContent RichtextContent--dark\">Kristiania tilbyr flere lignende studier p&aring; fagskole- og bachelorniv&aring;. For &aring; gj&oslash;re det enklere for deg &aring; velge riktig utdanning, har vi laget noen guider som enkelt forklarer forskjellene.</div>\n<div class=\"RichtextContent RichtextContent--dark\"><br />\n<p><strong>Se hva som skiller utdanningene v&aring;re:</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/utdanning/interior-utdanning-pa-hoyskole-eller-fagskole/\">Interi&oslash;r</a></li>\n<li><a href=\"/utdanning/grafisk-design-pa-hoyskole-eller-fagskole/\">Grafisk design</a></li>\n<li><a href=\"/utdanning/Interaksjonsdesign-pa-hoyskole-eller-fagskole/\">Interaksjonsdesign</a></li>\n<li><a href=\"/utdanning/studere-frontend-utvikling-pa-hoyskole-eller-fagskole/\">Frontend</a></li>\n</ul>\n</div>\n</div>\n</div>"},"translations":{"open":"Vis mer","close":"Vis mindre"}};</script></div>
</div></div></div>
</section>

