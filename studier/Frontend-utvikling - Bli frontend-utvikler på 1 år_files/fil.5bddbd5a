<div id="70873c4b"><section id="nøkkelinformasjon" class="tDwjVFExbPlqwnaU86Wz"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF tNNRbfeiPsdi3j_gpC7k">Nøkkelinformasjon</h2><ul class="dE8scaebAaiVDo4BSvWD jQbeCSjNzeFEwKyP9FS0"><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Relevant praksis</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Som en del av utdanningen har du muligheten til &aring; gjennomf&oslash;re en to til tre m&aring;neders praksisperiode i en bedrift.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Praktisk rettet</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark"><span>Store deler av studiet best&aring;r av praktisk arbeid med yrkesn&aelig;re oppgaver og prosjekter.</span></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Bygg portef&oslash;lje</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark"><span>Skap en solid prosjektportef&oslash;lje som gir deg et fortrinn i jobbs&oslash;knader.</span></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Ansvarlig fagmilj&oslash;</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark"><a href="/om-kristiania/om-fagskolen/">Fagskolen Kristiania</a></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-user"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Opptakskrav</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Krav om fagbrev, yrkeskompetanse, <a href="/studere-hos-oss/opptaksinformasjon/#Studiekompetanse">generell studiekompetanse</a>&nbsp;eller <a href="/studere-hos-oss/opptaksinformasjon/#opptak">tilsvarende realkompetanse</a>.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-credit-card"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Pris</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">61 200 kr pr semester. Kvalifiserer til <a href="/studere-hos-oss/opptaksinformasjon/lanekassen/">st&oslash;tte fra L&aring;nekassen</a>.</div></div></li></ul><ul class="KdKtz5eB9ExUSDYJcdj8"><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Nivå"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-book"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Fagskole</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Oppstart"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-clock"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Høst 2026</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Gjennomføring"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Heltid</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studiepoeng"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-award"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">120 studiepoeng</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studiested"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-map-pin"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Oslo</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studielengde"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-calendar"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">2 år</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Språk"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-message-square"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Norsk</span></div></li></ul></div></div></section><script>(window.__reactProps = window.__reactProps || {})['70873c4b-json'] = {"id":"nøkkelinformasjon","title":{"value":"Nøkkelinformasjon"},"facts":[{"title":{"value":"Relevant praksis"},"icon":"check-circle","content":{"value":"Som en del av utdanningen har du muligheten til &aring; gjennomf&oslash;re en to til tre m&aring;neders praksisperiode i en bedrift."}},{"title":{"value":"Praktisk rettet"},"icon":"check-circle","content":{"value":"<span>Store deler av studiet best&aring;r av praktisk arbeid med yrkesn&aelig;re oppgaver og prosjekter.</span>"}},{"title":{"value":"Bygg portef&oslash;lje"},"icon":"check-circle","content":{"value":"<span>Skap en solid prosjektportef&oslash;lje som gir deg et fortrinn i jobbs&oslash;knader.</span>"}},{"title":{"value":"Ansvarlig fagmilj&oslash;"},"icon":"check-circle","content":{"value":"<a href=\"/om-kristiania/om-fagskolen/\">Fagskolen Kristiania</a>"}},{"title":{"value":"Opptakskrav"},"icon":"user","content":{"value":"Krav om fagbrev, yrkeskompetanse, <a href=\"/studere-hos-oss/opptaksinformasjon/#Studiekompetanse\">generell studiekompetanse</a>&nbsp;eller <a href=\"/studere-hos-oss/opptaksinformasjon/#opptak\">tilsvarende realkompetanse</a>."}},{"title":{"value":"Pris"},"icon":"credit-card","content":{"value":"61 200 kr pr semester. Kvalifiserer til <a href=\"/studere-hos-oss/opptaksinformasjon/lanekassen/\">st&oslash;tte fra L&aring;nekassen</a>."}}],"tags":[{"title":"Nivå","icon":"book","value":"Fagskole"},{"title":"Oppstart","icon":"clock","value":"Høst 2026"},{"title":"Gjennomføring","icon":"activity","value":"Heltid"},{"title":"Studiepoeng","icon":"award","value":"120 studiepoeng"},{"title":"Studiested","icon":"map-pin","value":"Oslo"},{"title":"Studielengde","icon":"calendar","value":"2 år"},{"title":"Språk","icon":"message-square","value":"Norsk"}]};</script></div>
</div><div>
<div id="1a5e28fa"><section id="hva-lærer-du" class="cwjtYbGmpj2Fc0XguMNM"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF aZkJAbcjSQdYr77t8LV7">Hva lærer du?</h2><div class="zOMHtRvuigbQpkhq8l0i"><div class="FHwe9agruJdTg4dYFHN9"><div class="FktOVJkMpTVphR1rGeNp RichtextContent RichtextContent--light">Som UX-designer f&aring;r du muligheten til &aring; sette brukeren i fokus, forbedre digitale opplevelser og gj&oslash;re komplekse systemer enkle &aring; navigere. Bli en del av en spennende bransje hvor du kan kombinere empati, teknologi og kreativitet.&nbsp;</p>
<p>Utdanningen gir deg solid kompetanse innen interaksjonsdesign, webutvikling og koding. Du l&aelig;rer om den kreative prosessen bak interaktive produksjoner og hvordan man jobber med id&eacute;- og konseptutvikling.</p>
<p>I l&oslash;pet av studietiden vil du blant annet l&aelig;re om:</p>
<ul class="Richtext__ul">
<li>HTML, CSS og CMS</li>
<li>Wireframing og prototying</li>
<li>Universell utforming</li>
<li>Brukertesting</li>
<li>Design thinking</li>
<li>Designsystemer</li>
</ul></div><button title="Mer om undervisningen" aria-expanded="false" aria-controls="overlay_3436" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT f_wbJQigmJWOUtJRHvmX"><span class="visuallyHidden">Mer om undervisningen</span><span class="SvgIcon Kw06kOpEjKtbccDsYKVG"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus-circle"></use></svg></span></button><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_3436" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_3437"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_3437" class="visuallyHidden">Mer om undervisningen</span><h3 class="vGAYXQ8qVh3muyCADVi0">Mer om undervisningen</h3><div class="RichtextContent RichtextContent--dark"><span>P&aring; Interaksjonsdesign l&aelig;rer du &aring; designe funksjonelle og brukervennlige webl&oslash;sninger og apper, som er bygget p&aring; en dypere forst&aring;else av brukerne og deres behov.</span></p>
<p><span>Store deler av utdanningen best&aring;r av praktisk arbeid med oppgaver og prosjekter som er like de du vil jobbe med n&aring;r du kommer ut i arbeidslivet. Du vil f&aring; ta del i spennende workshops, hackathons og tverrfaglig samarbeid med andre studenter ved Kristiania.</span></p>
<p><span><strong>Hva er interaksjonsdesign?</strong><br /><br />Interaksjonsdesign og UX-design handler om &aring; utvikle eller forbedre en digital l&oslash;sning. Det kan v&aelig;re en nettbutikk, et nettsted for en bedrift eller en app p&aring; mobilen din.</span><br /><br /><span>D&aring;rlig UX gir frustrerte brukere &ndash; der kommer interaksjonsdesigneren inn. En god brukeropplevelse kan gi mer forn&oslash;yde kunder og &oslash;ke salget. Jobben til en interaksjonsdesigner er alts&aring; &aring; tilrettelegge for at brukeren f&aring;r en best mulig totalopplevelse i m&oslash;te med en digital tjeneste, et produkt eller et system.</span></div></div></div></div></div></div></div><div class="qB4kMuPluv5Id4WqPmfn"></div><div class="uMSWbISaLHTvPMbXhnYp"><div class="VNQ7BkWJFagCE_bBjsxQ ZLbmeOzjwEPCnL8UV8zG R1wh_51Fi_Crd9RnsQsw"><span class="FxrXNHIEItswETCvk14E" style="display:block"><span class="EwPhzUN1NfTBa1XOsTE6 TVMntCe8qkWIdDcQxQb6"></span></span></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['1a5e28fa-json'] = {"id":"hva-lærer-du","title":{"value":"Hva lærer du?"},"content":{"value":"Som UX-designer f&aring;r du muligheten til &aring; sette brukeren i fokus, forbedre digitale opplevelser og gj&oslash;re komplekse systemer enkle &aring; navigere. Bli en del av en spennende bransje hvor du kan kombinere empati, teknologi og kreativitet.&nbsp;</p>\n<p>Utdanningen gir deg solid kompetanse innen interaksjonsdesign, webutvikling og koding. Du l&aelig;rer om den kreative prosessen bak interaktive produksjoner og hvordan man jobber med id&eacute;- og konseptutvikling.</p>\n<p>I l&oslash;pet av studietiden vil du blant annet l&aelig;re om:</p>\n<ul class=\"Richtext__ul\">\n<li>HTML, CSS og CMS</li>\n<li>Wireframing og prototying</li>\n<li>Universell utforming</li>\n<li>Brukertesting</li>\n<li>Design thinking</li>\n<li>Designsystemer</li>\n</ul>"},"overlayTitle":"Mer om undervisningen","overlayContent":{"value":"<span>P&aring; Interaksjonsdesign l&aelig;rer du &aring; designe funksjonelle og brukervennlige webl&oslash;sninger og apper, som er bygget p&aring; en dypere forst&aring;else av brukerne og deres behov.</span></p>\n<p><span>Store deler av utdanningen best&aring;r av praktisk arbeid med oppgaver og prosjekter som er like de du vil jobbe med n&aring;r du kommer ut i arbeidslivet. Du vil f&aring; ta del i spennende workshops, hackathons og tverrfaglig samarbeid med andre studenter ved Kristiania.</span></p>\n<p><span><strong>Hva er interaksjonsdesign?</strong><br /><br />Interaksjonsdesign og UX-design handler om &aring; utvikle eller forbedre en digital l&oslash;sning. Det kan v&aelig;re en nettbutikk, et nettsted for en bedrift eller en app p&aring; mobilen din.</span><br /><br /><span>D&aring;rlig UX gir frustrerte brukere &ndash; der kommer interaksjonsdesigneren inn. En god brukeropplevelse kan gi mer forn&oslash;yde kunder og &oslash;ke salget. Jobben til en interaksjonsdesigner er alts&aring; &aring; tilrettelegge for at brukeren f&aring;r en best mulig totalopplevelse i m&oslash;te med en digital tjeneste, et produkt eller et system.</span>"},"gobiStoryId":"ze5bx","imageFallback":{"author":null,"caption":null,"url":"/globalassets/fagskole/hvalarerdu-2.jpg","alt":"Studenter diskuterer idèer ved å henge post-it lapper på veggen. ","focalPoint":null,"lazyLoading":true},"translations":{"openOverlay":"Mer om undervisningen","closeOverlay":"Lukk overlagg","openPlayer":"Åpne videospilleren","failedToLoadVideo":"Beklager, av en eller annen grunn kunne vi ikke laste inn en video"}};</script></div>
</div><div>
<div id="056ecd5a"><section id="studiemodell" class="eXDLkCBTey4RjrTQSVwU"><div class="coBlOy78vCNQoCaBJMWq"><div class="fIm4MtcrG6MCKKd8iidQ"><h2 class="FrR9v_ssranAjR5kDzwF A9Jn0XOSrtngUTCr8gcL">Studiemodell</h2><div class="t78ozlVAuwJUrQItlgiY"><span class="IKcqvZpEOT2PNX0vgEn0">Denne fagskoleutdanningen går over to studieår, og hvert studieår er delt opp i to semestre. Her ser du en oversikt over obligatoriske emner og hvilke muligheter du har for praksis og spesialisering. Vi tar forbehold om endringer.</span></div></div></div><div class="DwbrqOYPLpXMxa_AUi5a"><div class="c4EHzShG0bxjcWsv1iba _jn80nJpcKPRabCSPcI8 o7i_4ji7xZ2pdim0DGGS r6PBO9Z23nGvfMtmlwMK dT6kOO1SWAAgm3_8NHMn"><div class="w6rdwzyeKdZC4QEQQdUG"><div class="FQnvPH3eSTnAU6bvrkhn"><div class="IbD8iYA8j6gRUkFt19Qt nUUm_USrpFGrNosOvcCN gXLqKND3fX0_VG9NQewb"><div role="tablist" class="_NQp5NLSF5eDFXAqjrMf" aria-label="Velg år"><button id="tab_1" role="tab" aria-selected="true" aria-controls="tabPanel_1" type="button" class="wSwA7V6mKnVhr5xFafzq Sqayds_IfbVRGAlPcZz1"><span class="bAoReRDLMgoAniQxqdep">Første år</span></button><button id="tab_2" role="tab" aria-selected="false" aria-controls="tabPanel_2" type="button" class="wSwA7V6mKnVhr5xFafzq"><span class="bAoReRDLMgoAniQxqdep">Andre år</span></button></div></div><span class="FaaFQQsQ1uH8384yNffh">Totalt 120 studiepoeng</span></div><div id="tabPanel_1" class="xD2nuHiyJc0KNBTM5TWg" role="tabpanel" aria-labelledby="tab_1"><div class="XtdQZg9bKtEzGXT39oxb"><span class="NPFkgrIiXfIBoY50mCiN">60 studiepoeng</span><div class="osNFPrEfj_WDLlms79Vw"><div class="gIhCJK5vlYW4N6yeTlUe C70d_1unGsLcavciTBWP g8GJRoyN3YYrck7buLCF" style="grid-template-columns:auto repeat(1, minmax(min-content, 1fr))"><div class="PVTUTdX7fee_uJTuRkiD ihFnGka9xDug5NPWFh0C"></div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY z7vhCTYrC3rO2VoUPlYT">1. semester</div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY _MLObcIsnBTnfP4F5AQg">2. semester</div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 1;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_3871" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Grunnleggende interaksjonsdesign og webutvikling</span><span class="scgJDiGbZP69e6JD2e1j">FID1100</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">30<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_3871" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_3872"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_3872" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Grunnleggende interaksjonsdesign og webutvikling</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnet gir en innføring i begreper, prosesser og verktøy innenfor interaksjonsdesign, samt en forståelse for den kreative prosessen. Kandidaten vil i tillegg få innblikk i interaksjonsdesign satt i en større tverrfaglig sammenheng.  </p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 1;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_3873" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Grunnleggende utviklingsteknologi og ux-prosess</span><span class="scgJDiGbZP69e6JD2e1j">FID1200</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">30<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_3873" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_3874"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_3874" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Grunnleggende utviklingsteknologi og ux-prosess</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnet gir en fordypning i begreper, prosesser og verktøy innenfor interaksjonsdesign og introduserer kandidatene til en rekke nye verktøy og prosesser innen brukeropplevelsesdesign, grunnleggende koding og prosjektstyring.</p><p>Etter emnet kan studentene anvende relevante ux-prosesser og verktøy for å planlegge, utarbeide og teste relevante interaktive prototyper basert på brukeranalyser samt bygge responsive nettsider.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="hUrOK4f2t5d89i_al5eu _jBcyRZzOe6QMtbojFs5"></div></div></div></div></div><div class="_qtIUhem1sc1EKjP4UhQ"><div id="tabPanel_2" role="tabpanel" aria-labelledby="tab_2"><ul><li><span>FID2101</span><span>Fordypning i interaksjonsdesign og brukeropplevelse</span><div>
<p>Emnet har fokus på interaksjonsdesign som et samfunnsrelevant fag, og på kommunikasjon i digitale medier. Kandidaten skal i større grad utarbeide helhetlige produkter med fokus på håndtering av dynamisk innhold i forskjellige digitale kanaler. Kandidaten skal også vise evne til å løse forskjellige utfordringer selvstendig og i team.</p><p>Etter emnet skal kandidaten være i stand til å planlegge og utforme nettsider og applikasjoner som er forankret i en behovsanalyse. I tillegg kan kandidaten anvende arbeidsmetoder for å drifte et prosjekt med fokus på brukeropplevelse. Emnet legger vekt på digitalt design, idéutvikling, universell utforming, innholdsstrategi, bruksanalyser og merkevareprofilering. I tillegg skal kunnskaper og ferdigheter fra tidligere temaer kombineres, for å utføre praksisnære prosjekter.</p>
</div></li><li><span>FID2200</span><span>Utviklingsteknologi, praksisperiode og spesialisering</span><div>
<p>I dette emne skal studenten i større grad, selvstendig anvende relevant teori og verktøy for å utforme nettsteder og applikasjoner med brukerens opplevelse og behov i sentrum. I tillegg skal studentene aktivt ta stilling til egen faglig utvikling og interaksjonsdesignerens rolle som premisskaper i samfunnets digitalisering. Emnet legger vekt på egenprofilering, profesjonellpraksis og faglig spesialisering.</p><p> </p><p>Studentene vil i dette emnet få mulighet til praksis i web- og designbransjen, som skal forberede studenten på utøvelse av profesjonell og etisk yrkespraksis innenfor fagfeltet.</p>
</div></li></ul></div></div></div></div></div><div class="lv4eNMiZgLixMXhAvacD"><a href="/studieportal/fagskolen-kristiania/fagskoleniva/fid/interaksjonsdesign/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 AMdryBi_G8WFVbcuUzSv LVwfmt8Qy2xfZW7GrHx_ I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY SwVWunM8J0KL5d8Ov54G" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Se programbeskrivelse</div></a></div></section><script>(window.__reactProps = window.__reactProps || {})['056ecd5a-json'] = {"heading":{"value":"Studiemodell"},"getSubjectInfoUrl":"/api/study-pages/2083/subjects-info-url","overlayContentMessages":{"outdated":{"heading":"Med forbehold om endringer","message":null,"variant":"info"},"fallback":{"heading":"Emnebeskrivelse kommer snart","message":{"value":"<span>Ved Kristiania utvikler vi studiene v&aring;re i samarbeid med arbeidslivet. Derfor oppdaterer vi emnene jevnlig, slik at du f&aring;r kompetansen som arbeidsgiverne ser etter. Snart kan du lese alt om dette emnet her, inntil da finner du mer informasjon i studieprogrambeskrivelsen.</span>"},"variant":"info"}},"subjects":[{"code":"FID1100","name":"Grunnleggende interaksjonsdesign og webutvikling","description":"\n<p>Emnet gir en innføring i begreper, prosesser og verktøy innenfor interaksjonsdesign, samt en forståelse for den kreative prosessen. Kandidaten vil i tillegg få innblikk i interaksjonsdesign satt i en større tverrfaglig sammenheng.  </p>\n","isDescriptionOutdated":false,"order":3,"points":30,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"FID1200","name":"Grunnleggende utviklingsteknologi og ux-prosess","description":"\n<p>Emnet gir en fordypning i begreper, prosesser og verktøy innenfor interaksjonsdesign og introduserer kandidatene til en rekke nye verktøy og prosesser innen brukeropplevelsesdesign, grunnleggende koding og prosjektstyring.</p><p>Etter emnet kan studentene anvende relevante ux-prosesser og verktøy fo