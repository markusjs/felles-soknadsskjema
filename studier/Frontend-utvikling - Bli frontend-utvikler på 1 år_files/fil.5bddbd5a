om skal forberede studenten på utøvelse av profesjonell og etisk yrkespraksis innenfor fagfeltet.</p>\n","isDescriptionOutdated":true,"order":6,"points":30,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"}],"translations":{"studyOptions":"Valgmuligheter","elective":"Valgemne","specialization":"Studieretning","selectYear":"Velg år","openSubjectOverlay":"Åpne emneoverlegg","closeOverlay":"Lukk overlagg","genericErrorMessage":"Feil oppsto","totalStudyPointsFormat":"Totalt {points} studiepoeng","studyPointsFormat":"{points} studiepoeng","pointsUnit":"stp.","noSubjectsMessage":"Beklager, det er problemer med å laste inn innholdet for øyeblikket","prerequisites":"Forkunnskaper","goToSubject":"Les mer","loading":"Laster inn data","year":"år","semester":"semester","single":"ett","first":"første","second":"andre","third":"tredje","fourth":"fjerde","fifth":"femte"},"type":"view","id":"studiemodell","teaser":"Denne fagskoleutdanningen går over to studieår, og hvert studieår er delt opp i to semestre. Her ser du en oversikt over obligatoriske emner og hvilke muligheter du har for praksis og spesialisering. Vi tar forbehold om endringer.","settings":{"disableStudyModel":false,"disabledStudyModelHeading":"Informasjon om studiemodeller","disabledStudyModelMessage":{"value":"Studiemodellen er under arbeid og vil bli publisert så snart den er klar"}},"studyProgramLink":{"label":"Se programbeskrivelse","href":"/studieportal/fagskolen-kristiania/fagskoleniva/fid/interaksjonsdesign/","external":false,"showIsExternal":true}};</script></div>
</div><div>
<div id="38af83ac"><section id="hva-kan-du-bli" class="cr4GKFNCqp2Yu1c2kbOA cqvKGYSQUOkDhbqS2bc7"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF vw2qEzBLsG8dfPFKhCCL">Hva kan du bli?</h2><div class="eCTirCs_JIAXtZrCECpB"><div class="s4PUgF87xJpwYCH4qegZ"><div class="gOFfCOGgsoYfQDsrulwN Um_bsxrmr048dYBfonAO hfMRvjcJ6bvRCr56YbNA"><div class="KgSPjnWKLeiPJ0FM0dQy RichtextContent RichtextContent--dark">Mange selskaper ser viktigheten av brukersentrert design og bygger egne digitale avdelinger og UX-milj&oslash;er. Mindre bedrifter leier gjerne inn denne kompetansen fra et eksternt byr&aring;.</p>
<p>Du kan blant annet jobbe som:</p>
<ul class="Richtext__ul">
<li>Interaksjonsdesigner</li>
<li>UX-designer</li>
<li>UI-designer</li>
<li>Frontend-utvikler</li>
<li>Digital designer</li>
</ul></div><div></div></div></div><div class="vtkkbZPYpUDSiSOigevy"><div role="none" class="lWrPSruci5J1Pct9eV_o g60OJyzhnb0WaPJax3FT q5hkvvHSqXSnC8c0ON1s" tabindex="-1"><div class="MgyILGUp5ZXfXioJozjl"><div class="slJnKPGAAIKofsQwQBjL vPKYJ9xnnqorRitmkm3i Rk4XtUg82KBc97x_ZRFE bdvXUDwmjTRBe1N3RN_T"><picture><source sizes="(min-width: 1024px) 1136px, (min-width: 768px) 768px, 100vw" srcSet="/contentassets/589d29dd4ef149308f988c3a0f53b37e/julie-dreier-hero2.jpg?width=375 375w, /contentassets/589d29dd4ef149308f988c3a0f53b37e/julie-dreier-hero2.jpg?width=768 768w, /contentassets/589d29dd4ef149308f988c3a0f53b37e/julie-dreier-hero2.jpg?width=1136 1136w"/><img src="/contentassets/589d29dd4ef149308f988c3a0f53b37e/julie-dreier-hero2.jpg?width=1136" alt="Jule står på en bro med hendene på hoften over Oslo S." style="object-position:55.00000000000001% 36%" loading="lazy"/></picture></div></div><div class="yMY00st3GGEGBJtEvQ73"><h3 class="c_Td561uP1rvuAN4AIF0"><a href="/aktuelt/2026/02/studiet-gjorde-meg-trygg-pa-meg-selv-som-digital-designer/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><div>&ndash; Studiet gjorde meg trygg p&aring; meg selv som digital designer&nbsp;</div></div></a></h3><div class="jEZzvXBk9gXoSYGacZ1a"><div class="upokinR30SLCCFTdntv0">Med en blanding av teori og praksis i sine grader fra Kristiania, fikk Julie både erfaringen og selvtilliten som i dag gjør henne trygg i rollen som digital designer.</div><span class="SvgIcon PVmLk9OPaS3teC0Olseh"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-&amp;"></use></svg></span></div></div></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['38af83ac-json'] = {"id":"hva-kan-du-bli","heading":{"value":"Hva kan du bli?"},"teaser":{"value":"Mange selskaper ser viktigheten av brukersentrert design og bygger egne digitale avdelinger og UX-milj&oslash;er. Mindre bedrifter leier gjerne inn denne kompetansen fra et eksternt byr&aring;.</p>\n<p>Du kan blant annet jobbe som:</p>\n<ul class=\"Richtext__ul\">\n<li>Interaksjonsdesigner</li>\n<li>UX-designer</li>\n<li>UI-designer</li>\n<li>Frontend-utvikler</li>\n<li>Digital designer</li>\n</ul>"},"linkList":[],"featuredArticle":{"title":{"value":"&ndash; Studiet gjorde meg trygg p&aring; meg selv som digital designer&nbsp;"},"description":{"value":"Med en blanding av teori og praksis i sine grader fra Kristiania, fikk Julie både erfaringen og selvtilliten som i dag gjør henne trygg i rollen som digital designer."},"url":"/aktuelt/2026/02/studiet-gjorde-meg-trygg-pa-meg-selv-som-digital-designer/","image":{"author":"Kristiania","caption":"Julie fant veien til drømmejobben som digital designer gjennom en kombinasjon av grafisk design, interaksjonsdesign og viljen til å prøve og feile.","url":"/contentassets/589d29dd4ef149308f988c3a0f53b37e/julie-dreier-hero2.jpg","alt":"Jule står på en bro med hendene på hoften over Oslo S.","focalPoint":{"x":0.55,"y":0.36},"lazyLoading":true}},"blockVariant":"default","overlayButtonLabel":"Flere karrieremuligheter","overlayHeading":"Flere karrieremuligheter","overlayContent":null,"overlayCloseLabel":"Lukk overlagg"};</script></div>
