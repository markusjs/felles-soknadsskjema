<div id="2a4d1391"><section id="møt-fagmiljøet" class="xfIZ8IPRSKGxzL5KIyLz ZG9x_vn8GvsrSWPis7bl"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF Bje8lNYEARjKXkaadcjl">Møt fagmiljøet</h2><div class="IP4WLEZAtSgblGP4Felg"><div class="KCVvuotjBI0iy0ATTKfK"><div class="VNQ7BkWJFagCE_bBjsxQ ZLbmeOzjwEPCnL8UV8zG ssmQS4h9jzEH4V0L4NSN"><span class="FxrXNHIEItswETCvk14E" style="display:block"><span class="EwPhzUN1NfTBa1XOsTE6 TVMntCe8qkWIdDcQxQb6"></span></span></div></div><ul class="tZx0pZhK8q3JNoQI8LCj"><li class="i8yQuD9MeLJCD5eDKft2"><div class="cVALO6yJDjmV1Xvkvynu"><div class="WWUAFGePNJBA0_seRWlX"><h3 class="TCpxq20heJlGBaSbNI4y">Vår fagstab</h3><div class="AXbF9ehRSXzzERBwn1XK RichtextContent RichtextContent--light"><span>Fagstaben ved interaksjonsdesign best&aring;r av et erfarent team som brenner for &aring; gi studentene en pedagogisk, grundig og praktisk utdanning. De har bred kompetanse innenfor interaksjonsdesign, frontend-utvikling, visuell design</span><span> og brukersentrert design. Vi jobber aktivt med b&aring;de yrkesfeltet og bransjerelevante interesseorganisasjoner. Dette gj&oslash;r at vi kontinuerlig kan oppdatere utdanningen og tilpasse undervisningen til arbeidslivets behov, b&aring;de n&aring; og fremover.&nbsp;</span></div></div></div></li></ul></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['2a4d1391-json'] = {"id":"møt-fagmiljøet","heading":{"value":"Møt fagmiljøet"},"testimonies":[{"heading":{"value":"Vår fagstab"},"content":{"value":"<span>Fagstaben ved interaksjonsdesign best&aring;r av et erfarent team som brenner for &aring; gi studentene en pedagogisk, grundig og praktisk utdanning. De har bred kompetanse innenfor interaksjonsdesign, frontend-utvikling, visuell design</span><span> og brukersentrert design. Vi jobber aktivt med b&aring;de yrkesfeltet og bransjerelevante interesseorganisasjoner. Dette gj&oslash;r at vi kontinuerlig kan oppdatere utdanningen og tilpasse undervisningen til arbeidslivets behov, b&aring;de n&aring; og fremover.&nbsp;</span>"}}],"gobiStoryId":"g4tcs","imageFallback":{"author":null,"caption":null,"url":"/contentassets/89c51e9cfac44b55862a13aed2786dbd/motfgenerisk.jpg","alt":null,"focalPoint":null,"lazyLoading":true},"translations":{"openPlayer":"Åpne videospilleren","failedToLoadVideo":"Beklager, av en eller annen grunn kunne vi ikke laste inn en video"},"variant":"dark"};</script></div>
</div><div>
<div id="c878d1a1"><section id="m-oslash-t-fagansvarlig" class="cPloAW9ETJppiKf3uOg6 PS9OiuwCp_Mtf4jcUm_I"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><div class="OPDkk3SbGwWTZeDlZj4f"><div class="Za0F_aizRoRV7IW8vrhK"><span class="SvgIcon R8xM2ukm6YYDNzHE9e8V"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-quote-mark"></use></svg></span></div><div class="OBg8GbGOQ11Y_kO0y26Q"><div class="elementToProof">V&aring;rt m&aring;l er ikke bare &aring; l&aelig;re bort teori, men &aring; gi deg praktiske ferdigheter innen interaksjonsdesign. Hos oss f&aring;r du bygge en portef&oslash;lje med arbeider og mulighet til &aring; s&oslash;ke praksis i en relevant bedrift.</div></div><div class="WyTuSgXamI5tDjjbW40k"><div class="ELZbSN0xkGRxudxoCGZD Jjpdm0z1lffwiYq7tJFx"><div class="slJnKPGAAIKofsQwQBjL BsNJMoWrLSwywFoZw_rI"><picture><source sizes="(max-width: 479px) 100vw, (min-width: 480px) 350px" srcSet="/contentassets/5e0d4d8d8dc54df0b7977d5a7112754d/eivind-solberg_spikersuppa_2023-12-2.jpg?width=350 350w, /contentassets/5e0d4d8d8dc54df0b7977d5a7112754d/eivind-solberg_spikersuppa_2023-12-2.jpg?width=470 470w"/><img src="/contentassets/5e0d4d8d8dc54df0b7977d5a7112754d/eivind-solberg_spikersuppa_2023-12-2.jpg?width=258" alt="Eivind Solberg" loading="lazy"/></picture></div><div class="wgsfEYhliRuQ3OGsPPB7"><a href="/om-kristiania/ansatte/fagskolen-kristiania/avdeling-for-design-og-teknologi/eivind-solberg/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi A9IrxP6x1kHMxJBX5nkl" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="PafA02TiaN5DOnBONInU">Eivind Solberg</span><span class="C7aWfJ5wcSGxkMQk5mVC"><ul class="ybs02MiIsdu5yS7LYwML"><li class="MkfboJs3JDCOgTmDA6XY">Fagansvarlig (er i permisjon)</li></ul><span class="WNOGE5Zjbw73YZqwUfmg">Avdeling for design og teknologi</span></span></div></a></div></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['c878d1a1-json'] = {"id":"m-oslash-t-fagansvarlig","quote":{"value":"<div class=\"elementToProof\">V&aring;rt m&aring;l er ikke bare &aring; l&aelig;re bort teori, men &aring; gi deg praktiske ferdigheter innen interaksjonsdesign. Hos oss f&aring;r du bygge en portef&oslash;lje med arbeider og mulighet til &aring; s&oslash;ke praksis i en relevant bedrift.</div>"},"employeeInfo":{"name":"Eivind Solberg","picture":{"profile":{"defaultWidth":258,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[350,470],"sizes":["(max-width: 479px) 100vw","(min-width: 480px) 350px"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":null,"caption":null,"url":"/contentassets/5e0d4d8d8dc54df0b7977d5a7112754d/eivind-solberg_spikersuppa_2023-12-2.jpg","alt":"Eivind Solberg","focalPoint":null,"lazyLoading":true},"jobTitles":["Fagansvarlig (er i permisjon)"],"department":"Avdeling for design og teknologi","organization":"Kristiania","link":{"label":"Eivind Solberg","href":"/om-kristiania/ansatte/fagskolen-kristiania/avdeling-for-design-og-teknologi/eivind-solberg/","external":false,"showIsExternal":true}},"variant":"red"};</script></div>
