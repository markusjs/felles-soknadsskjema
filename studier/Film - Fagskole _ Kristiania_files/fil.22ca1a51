hHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk gnwHhMF21kTUQhGmA_GV I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY MRlQkiu1Mdteq_EefGH9" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Slik er studiehverdagen</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></li></ul></div></div></section><script>(window.__reactProps = window.__reactProps || {})['8b0d1073-json'] = {"id":"livet-som-student","title":{"value":"Livet som  student"},"teaser":{"value":"&Aring; v&aelig;re student handler om mye mer enn &aring; studere. P&aring; Kristiania blir du en del av et stort kreativt milj&oslash; og f&aring;r tilgang til fasiliteter i toppklasse!&nbsp;"},"portfolioItems":[{"title":"Se studentarbeider","caption":null,"image":{"author":null,"caption":null,"url":"/contentassets/b6f197d5a7a7467c8f6a1cca1c853f23/thumbnail.jpg","alt":"Skjermbilde av en video som viser filmklipp av studentarbeider. ","focalPoint":null,"lazyLoading":true},"link":{"label":"Se studentarbeider","href":"https://youtu.be/yUdey4GuLxQ","external":true,"showIsExternal":true},"type":"video","id":"95168"},{"title":"Slik er studiehverdagen!","caption":null,"image":{"author":null,"caption":null,"url":"/contentassets/aea263a23e334317afd08bf34b08729c/film-fagskolen-2025.jpg","alt":"Bildelenke av studenter ute på opptak, leder tilm film der studentene forteller om sine erfaringer.","focalPoint":{"x":0.31,"y":0.4},"lazyLoading":true},"link":{"label":"Slik er studiehverdagen!","href":"https://vimeo.com/1141178454","external":true,"showIsExternal":true},"type":"video","id":"152208"},{"title":null,"caption":null,"image":{"author":null,"caption":null,"url":"/contentassets/31c57253a92f4d5b8f51586f863d6d30/film3.jpg","alt":null,"focalPoint":{"x":0.44,"y":0.58},"lazyLoading":true},"link":null,"type":"image","id":"95164"},{"title":null,"caption":null,"image":{"author":null,"caption":null,"url":"/contentassets/a24d253ecd