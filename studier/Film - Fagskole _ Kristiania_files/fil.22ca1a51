<div id="0dd004f1"><section id="møt-fagmiljøet" class="xfIZ8IPRSKGxzL5KIyLz ZG9x_vn8GvsrSWPis7bl"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF Bje8lNYEARjKXkaadcjl">Møt fagmiljøet</h2><div class="IP4WLEZAtSgblGP4Felg"><div class="KCVvuotjBI0iy0ATTKfK"><div class="VNQ7BkWJFagCE_bBjsxQ ZLbmeOzjwEPCnL8UV8zG ssmQS4h9jzEH4V0L4NSN"><span class="FxrXNHIEItswETCvk14E" style="display:block"><span class="EwPhzUN1NfTBa1XOsTE6 TVMntCe8qkWIdDcQxQb6"></span></span></div></div><ul class="tZx0pZhK8q3JNoQI8LCj"><li class="i8yQuD9MeLJCD5eDKft2"><div class="cVALO6yJDjmV1Xvkvynu"><div class="WWUAFGePNJBA0_seRWlX"><h3 class="TCpxq20heJlGBaSbNI4y">Vår fagstab</h3><div class="AXbF9ehRSXzzERBwn1XK RichtextContent RichtextContent--light">Fagskoleutdanning i Film ved Kristiania har et bredt og erfarent l&aelig;rerteam. Alle l&aelig;rerne er aktive i bransjen og utvikler kontinuerlig sin egen praksis. Dette gj&oslash;r undervisningen relevant og engasjerende. Du vil ogs&aring; m&oslash;te gjestel&aelig;rere som hentes inn fra bransjen for &aring; fortelle om sine spesialfelt.</div></div></div></li></ul></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['0dd004f1-json'] = {"id":"møt-fagmiljøet","heading":{"value":"Møt fagmiljøet"},"testimonies":[{"heading":{"value":"Vår fagstab"},"content":{"value":"Fagskoleutdanning i Film ved Kristiania har et bredt og erfarent l&aelig;rerteam. Alle l&aelig;rerne er aktive i bransjen og utvikler kontinuerlig sin egen praksis. Dette gj&oslash;r undervisningen relevant og engasjerende. Du vil ogs&aring; m&oslash;te gjestel&aelig;rere som hentes inn fra bransjen for &aring; fortelle om sine spesialfelt."}}],"gobiStoryId":"n27sy","imageFallback":{"author":null,"caption":null,"url":"/contentassets/0636093ef2864ca6ac845191f4e32e09/motfgenerisk.jpg","alt":null,"focalPoint":null,"lazyLoading":true},"translations":{"openPlayer":"Åpne videospilleren","failedToLoadVideo":"Beklager