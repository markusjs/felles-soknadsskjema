<div id="36e0fae6"><section id="nøkkelinformasjon" class="tDwjVFExbPlqwnaU86Wz"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF tNNRbfeiPsdi3j_gpC7k">Nøkkelinformasjon</h2><ul class="dE8scaebAaiVDo4BSvWD jQbeCSjNzeFEwKyP9FS0"><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Faglige fra bransjen</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark"><span>Alle de faglige ved dette studiet er aktive i bransjen og har et stort nettverk innen norsk filmindustri.&nbsp;&nbsp;</span></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Spesialisering</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark"><span>Andre studie&aring;r f&aring;r du mulighet til &aring; spesialisere deg innen den fagfunksjonen du vil satse p&aring;.&nbsp;</span></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Arbeidspraksis</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark"><span>Siste semester blir du tildelt praksisplass og f&aring;r jobbe i et produksjonsselskap i fire uker.&nbsp;</span></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Ansvarlig fagmilj&oslash;</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark"><a href="/om-kristiania/om-fagskolen/">Fagskolen Kristiania</a></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-user"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Opptakskrav</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Krav om fagbrev, yrkeskompetanse, <a href="/studere-hos-oss/opptaksinformasjon/#Studiekompetanse">generell studiekompetanse</a>&nbsp;eller <a href="/studere-hos-oss/opptaksinformasjon/#opptak">tilsvarende realkompetanse</a>.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-credit-card"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Pris</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">65 300 kr pr semester. Kvalifiserer til <a href="/studere-hos-oss/opptaksinformasjon/lanekassen/">st&oslash;tte fra L&aring;nekassen</a>.</div></div></li></ul><ul class="KdKtz5eB9ExUSDYJcdj8"><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Nivå"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-book"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Fagskole</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Oppstart"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-clock"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Høst 2026</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Gjennomføring"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Heltid</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studiepoeng"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-award"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">120 studiepoeng</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studiested"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-map-pin"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Oslo</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studielengde"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-calendar"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">2 år</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Språk"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-message-square"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Norsk</span></div></li></ul></div></div></section><script>(window.__reactProps = window.__reactProps || {})['36e0fae6-json'] = {"id":"nøkkelinformasjon","title":{"value":"Nøkkelinformasjon"},"facts":[{"title":{"value":"Faglige fra bransjen"},"icon":"check-circle","content":{"value":"<span>Alle de faglige ved dette studiet er aktive i bransjen og har et stort nettverk innen norsk filmindustri.&nbsp;&nbsp;</span>"}},{"title":{"value":"Spesialisering"},"icon":"check-circle","content":{"value":"<span>Andre studie&aring;r f&aring;r du mulighet til &aring; spesialisere deg innen den fagfunksjonen du vil satse p&aring;.&nbsp;</span>"}},{"title":{"value":"Arbeidspraksis"},"icon":"check-circle","content":{"value":"<span>Siste semester blir du tildelt praksisplass og f&aring;r jobbe i et produksjonsselskap i fire uker.&nbsp;</span>"}},{"title":{"value":"Ansvarlig fagmilj&oslash;"},"icon":"check-circle","content":{"value":"<a href=\"/om-kristiania/om-fagskolen/\">Fagskolen Kristiania</a>"}},{"title":{"value":"Opptakskrav"},"icon":"user","content":{"value":"Krav om fagbrev, yrkeskompetanse, <a href=\"/studere-hos-oss/opptaksinformasjon/#Studiekompetanse\">generell studiekompetanse</a>&nbsp;eller <a href=\"/studere-hos-oss/opptaksinformasjon/#opptak\">tilsvarende realkompetanse</a>."}},{"title":{"value":"Pris"},"icon":"credit-card","content":{"value":"65 300 kr pr semester. Kvalifiserer til <a href=\"/studere-hos-oss/opptaksinformasjon/lanekassen/\">st&oslash;tte fra L&aring;nekassen</a>."}}],"tags":[{"title":"Nivå","icon":"book","value":"Fagskole"},{"title":"Oppstart","icon":"clock","value":"Høst 2026"},{"title":"Gjennomføring","icon":"activity","value":"Heltid"},{"title":"Studiepoeng","icon":"award","value":"120 studiepoeng"},{"title":"Studiested","icon":"map-pin","value":"Oslo"},{"title":"Studielengde","icon":"calendar","value":"2 år"},{"title":"Språk","icon":"message-square","value":"Norsk"}]};</script></div>
</div><div>
<div id="3bb42956"><section id="hva-lærer-du" class="cwjtYbGmpj2Fc0XguMNM"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF aZkJAbcjSQdYr77t8LV7">Hva lærer du?</h2><div class="zOMHtRvuigbQpkhq8l0i"><div class="FHwe9agruJdTg4dYFHN9"><div class="FktOVJkMpTVphR1rGeNp RichtextContent RichtextContent--light">Brenner du inne med en film eller dr&oslash;mmer du om &aring; jobbe I filmbransjen? Filmutdanningen gir deg en bred forst&aring;else av prosessen bak en filmproduksjon fra manus til ferdig film.</p>
<p>Hos oss f&aring;r du trene hver dag gjennom hele studieperioden med oppdatert, profesjonelt utstyr.</p>
<ul class="Richtext__ul">
<li>Film er et samarbeidsfag. Alle produksjoner gj&oslash;res i grupper.</li>
<li>Kunstig intelligens brukes i mange fagfunksjoner og er en naturlig del av v&aring;r arbeidsflyt.</li>
<li>V&aring;rt m&aring;l er at studenten tilegner seg kompetanse p&aring; h&oslash;yde med dagens profesjonelle filmskapere.</li>
</ul></div><button title="Mer om undervisningen" aria-expanded="false" aria-controls="overlay_3049" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT f_wbJQigmJWOUtJRHvmX"><span class="visuallyHidden">Mer om undervisningen</span><span class="SvgIcon Kw06kOpEjKtbccDsYKVG"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus-circle"></use></svg></span></button><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_3049" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_3050"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_3050" class="visuallyHidden">Mer om undervisningen</span><h3 class="vGAYXQ8qVh3muyCADVi0">Mer om undervisningen</h3><div class="RichtextContent RichtextContent--dark">I l&oslash;pet av studiet gjennomg&aring;r vi en rekke sjangre innen film:</p>
<ul class="Richtext__ul">
<li>Fiksjonskortfilm</li>
<li>Dokumentar</li>
<li>Musikkvideo/avant garde</li>
</ul>
<p>Med vekt p&aring; praktisk og kreativt arbeid, f&aring;r du eksperimentere og utvikle ditt eget selvstendige uttrykk.</p>
<p>P&aring; filmstudiet l&aelig;rer du blant annet om:</p>
<ul class="Richtext__ul">
<li>Regi &amp; manus</li>
<li>Foto &amp; lys</li>
<li>Klipp &amp; lyd</li>
<li>Filmteori</li>
<li>Dramaturgi</li>
<li>Produksjonsledelse</li>
</ul></div></div></div></div></div></div></div><div class="qB4kMuPluv5Id4WqPmfn"></div><div class="uMSWbISaLHTvPMbXhnYp"><div class="VNQ7BkWJFagCE_bBjsxQ ZLbmeOzjwEPCnL8UV8zG R1wh_51Fi_Crd9RnsQsw"><span class="FxrXNHIEItswETCvk14E" style="display:block"><span class="EwPhzUN1NfTBa1XOsTE6 TVMntCe8qkWIdDcQxQb6"></span></span></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['3bb42956-json'] = {"id":"hva-lærer-du","title":{"value":"Hva lærer du?"},"content":{"value":"Brenner du inne med en film eller dr&oslash;mmer du om &aring; jobbe I filmbransjen? Filmutdanningen gir deg en bred forst&aring;else av prosessen bak en filmproduksjon fra manus til ferdig film.</p>\n<p>Hos oss f&aring;r du trene hver dag gjennom hele studieperioden med oppdatert, profesjonelt utstyr.</p>\n<ul class=\"Richtext__ul\">\n<li>Film er et samarbeidsfag. Alle produksjoner gj&oslash;res i grupper.</li>\n<li>Kunstig intelligens brukes i mange fagfunksjoner og er en naturlig del av v&aring;r arbeidsflyt.</li>\n<li>V&aring;rt m&aring;l er at studenten tilegner seg kompetanse p&aring; h&oslash;yde med dagens profesjonelle filmskapere.</li>\n</ul>"},"overlayTitle":"Mer om undervisningen","overlayContent":{"value":"I l&oslash;pet av studiet gjennomg&aring;r vi en rekke sjangre innen film:</p>\n<ul class=\"Richtext__ul\">\n<li>Fiksjonskortfilm</li>\n<li>Dokumentar</li>\n<li>Musikkvideo/avant garde</li>\n</ul>\n<p>Med vekt p&aring; praktisk og kreativt arbeid, f&aring;r du eksperimentere og utvikle ditt eget selvstendige uttrykk.</p>\n<p>P&aring; filmstudiet l&aelig;rer du blant annet om:</p>\n<ul class=\"Richtext__ul\">\n<li>Regi &amp; manus</li>\n<li>Foto &amp; lys</li>\n<li>Klipp &amp; lyd</li>\n<li>Filmteori</li>\n<li>Dramaturgi</li>\n<li>Produksjonsledelse</li>\n</ul>"},"gobiStoryId":"g89ff","imageFallback":{"author":null,"caption":null,"url":"/contentassets/a304ff865de642ddb807158dd090307d/hvlfilm.jpg","alt":"Person justerer på et filmkamera som står på et stativ. ","focalPoint":null,"lazyLoading":true},"translations":{"openOverlay":"Mer om undervisningen","closeOverlay":"Lukk overlagg","openPlayer":"Åpne videospilleren","failedToLoadVideo":"Beklager, av en eller annen grunn kunne vi ikke laste inn en video"}};</script></div>
</div><div>
<div id="2f9f3d02"><section id="studiemodell" class="eXDLkCBTey4RjrTQSVwU"><div class="coBlOy78vCNQoCaBJMWq"><div class="fIm4MtcrG6MCKKd8iidQ"><h2 class="FrR9v_ssranAjR5kDzwF A9Jn0XOSrtngUTCr8gcL">Studiemodell</h2><div class="t78ozlVAuwJUrQItlgiY"><span class="IKcqvZpEOT2PNX0vgEn0">Denne fagskoleutdanningen går over to studieår, og hvert studieår er delt opp i to semestre. Her ser du en oversikt over obligatoriske emner og hvilke muligheter du har for praksis og spesialisering. Vi tar forbehold om endringer.</span></div></div></div><div class="DwbrqOYPLpXMxa_AUi5a"><div class="c4EHzShG0bxjcWsv1iba _jn80nJpcKPRabCSPcI8 o7i_4ji7xZ2pdim0DGGS r6PBO9Z23nGvfMtmlwMK dT6kOO1SWAAgm3_8NHMn"><div class="w6rdwzyeKdZC4QEQQdUG"><div class="FQnvPH3eSTnAU6bvrkhn"><div class="IbD8iYA8j6gRUkFt19Qt nUUm_USrpFGrNosOvcCN gXLqKND3fX0_VG9NQewb"><div role="tablist" class="_NQp5NLSF5eDFXAqjrMf" aria-label="Velg år"><button id="tab_1" role="tab" aria-selected="true" aria-controls="tabPanel_1" type="button" class="wSwA7V6mKnVhr5xFafzq Sqayds_IfbVRGAlPcZz1"><span class="bAoReRDLMgoAniQxqdep">Første år</span></button><button id="tab_2" role="tab" aria-selected="false" aria-controls="tabPanel_2" type="button" class="wSwA7V6mKnVhr5xFafzq"><span class="bAoReRDLMgoAniQxqdep">Andre år</span></button></div></div><span class="FaaFQQsQ1uH8384yNffh">Totalt 120 studiepoeng</span></div><div id="tabPanel_1" class="xD2nuHiyJc0KNBTM5TWg" role="tabpanel" aria-labelledby="tab_1"><div class="XtdQZg9bKtEzGXT39oxb"><span class="NPFkgrIiXfIBoY50mCiN">60 studiepoeng</span><div class="osNFPrEfj_WDLlms79Vw"><div class="gIhCJK5vlYW4N6yeTlUe C70d_1unGsLcavciTBWP g8GJRoyN3YYrck7buLCF" style="grid-template-columns:auto repeat(1, minmax(min-content, 1fr))"><div class="PVTUTdX7fee_uJTuRkiD ihFnGka9xDug5NPWFh0C"></div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY z7vhCTYrC3rO2VoUPlYT">1. semester</div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY _MLObcIsnBTnfP4F5AQg">2. semester</div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 1;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_3051" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Prosessforståelse</span><span class="scgJDiGbZP69e6JD2e1j">FFT1101</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">30<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_3051" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_3052"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_3052" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Prosessforståelse</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnet Prosessforståelse gir studentene en grunnleggende innføring i filmproduksjonens arbeidsprosesser, fra idé til ferdig produkt. Gjennom praktisk arbeid og teoretisk innsikt skal studentene utvikle forståelse for dramaturgiske prinsipper, prosjektbasert arbeid og de ulike fagfunksjonene som inngår i en filmproduksjon. Emnet legger vekt på teknisk kompetanse, historiefortelling og samarbeid, og gir studentene verktøyene de trenger for å planlegge, gjennomføre og reflektere over en enkel filmproduksjon. Målet er å gi en helhetlig forståelse av produksjonsprosessen og hvordan faglige valg påvirker det visuelle uttrykket og budskapet i en film. </p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 1;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_3053" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Historiefortelling og dramaturgi</span><span class="scgJDiGbZP69e6JD2e1j">FFT1201</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">30<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_3053" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_3054"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_3054" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Historiefortelling og dramaturgi</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnet Historiefortelling og Dramaturgi gir studentene en innføring i hvordan visuelle og narrative virkemidler brukes til å formidle historier i film. Studentene lærer å utvikle konsepter og manus i ulike sjangre, og får innsikt i klassisk dramaturgi som grunnlag for filmfortelling. Gjennom praktisk arbeid med foto, lys, lyd og musikk, utforsker de hvordan tekniske og kreative valg påvirker filmens uttrykk og budskap. Emnet legger også vekt på forståelse for fagfunksjoner, samarbeid i produksjonsteam og hvordan ulike roller bidrar til helheten i en filmproduksjon. Målet er å gi studentene verktøyene til å skape engasjerende og profesjonelle filmfortellinger, fra idé til ferdig produkt. </p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="hUrOK4f2t5d89i_al5eu _jBcyRZzOe6QMtbojFs5"></div></div></div></div></div><div class="_qtIUhem1sc1EKjP4UhQ"><div id="tabPanel_2" role="tabpanel" aria-labelledby="tab_2"><ul><li><span>FFT2102</span><span>Overordnet idé - fra tekst til film</span><div>
<p>Emnet gir studentene innsikt i hvordan en overordnet idé utvikles og realiseres som filmatisk uttrykk. Gjennom arbeid med tekst, manus, karakterutvikling og visuelle virkemidler lærer studentene å omsette litterære og dramaturgiske elementer til levende bilder. Emnet kombinerer kreativ utvikling med praktisk produksjonsforståelse, og gir erfaring med skuespillerinstruksjon, sceneanalyse, og samarbeid mellom fagfunksjoner. Studentene får også innblikk i bransjens profesjonelle standarder, inkludert produksjonsplanlegging, budsjett og finansiering. Målet er å gi studentene kompetanse til å utvikle og gjennomføre en filmproduksjon med utgangspunkt i et tydelig konsept, og med forståelse for både kunstneriske og tekniske aspekter ved produksjonen. </p>
</div></li><li><span>FFT2201</span><span>Fordypning og bransjekunnskap</span><div>
<p>Emnet Fordypning og Bransjekunnskap gir studentene mulighet til å fordype seg i sin valgte fagfunksjon innen filmproduksjon, samtidig som de utvikler en helhetlig forståelse for bransjens profesjonelle praksis. Gjennom arbeid med egne prosjekter og refleksjon rundt filmens rolle i samfunnet, får studentene innsikt i både kunstneriske, tekniske og produksjonsmessige aspekter ved filmarbeid. Emnet legger vekt på samarbeid, kommunikasjon og strategisk planlegging, og gir studentene kompetanse til å gjennomføre en filmproduksjon med profesjonelle krav til kvalitet og produksjonsverdi. Studentene skal også tilegne seg kunnskap om finansiering, budsjettering og presentasjon av eget arbeid, og utvikle evne til å navigere i den audiovisuelle bransjen med et bevisst forhold til egen rolle og videre praksis. </p>
</div></li></ul></div></div></div></div></div><div class="lv4eNMiZgLixMXhAvacD"><a href="/studieportal/fagskolen-kristiania/fagskoleniva/fft/film/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 AMdryBi_G8WFVbcuUzSv LVwfmt8Qy2xfZW7GrHx_ I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY SwVWunM8J0KL5d8Ov54G" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Se programbeskrivelse</div></a></div></section><script>(window.__reactProps = window.__reactProps || {})['2f9f3d02-json'] = {"heading":{"value":"Studiemodell"},"getSubjectInfoUrl":"/api/study-pages/2080/subjects-info-url","overlayContentMessages":{"outdated":{"heading":"Med forbehold om endringer","message":null,"variant":"info"},"fallback":{"heading":"Emnebeskrivelse kommer snart","message":{"value":"<span>Ved Kristiania utvikler vi studiene v&aring;re i samarbeid med arbeidslivet. Derfor oppdaterer vi emnene jevnlig, slik at du f&aring;r kompetansen som arbeidsgiverne ser etter. Snart kan du lese alt om dette emnet her, inntil da finner du mer informasjon i studieprogrambeskrivelsen.</span>"},"variant":"info"}},"subjects":[{"code":"FFT1101","name":"Prosessforståelse","description":"\n<p>Emnet Prosessforståelse gir studentene en grunnleggende innføring i filmproduksjonens arbeidsprosesser, fra idé til ferdig produkt. Gjennom praktisk arbeid og teoretisk innsikt skal studentene utvikle forståelse for dramaturgiske prinsipper, prosjektbasert arbeid og de ulike fagfunksjonene som inngår i en filmproduksjon. Emnet legger vekt på teknisk kompetanse, historiefortelling og samarbeid, og gir studentene verktøyene de trenger for å planlegge, gjennomføre og reflektere over en enkel filmproduksjon. Målet er å gi en helhetlig forståelse av produksjonsprosessen og hvordan faglige valg påvirker det visuelle uttrykket og budskapet i en film. </p>\n","isDescriptionOutdated":false,"order":1,"points":30,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"FFT1201","n