<div id="b9910f40"><section id="n-oslash-kkelinformasjon" class="tDwjVFExbPlqwnaU86Wz"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF tNNRbfeiPsdi3j_gpC7k">N&oslash;kkelinformasjon</h2><ul class="dE8scaebAaiVDo4BSvWD jQbeCSjNzeFEwKyP9FS0"><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Nytt studium</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Dette studiet er helt nytt, og gir deg oppdatert og relevant kompetanse.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Utveksling</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Opplev verden mens du studerer! <a href="/studier/bachelor/rettsvitenskap/#hva-lurer-du-på">Les mer under &laquo;Ofte stilte sp&oslash;rsm&aring;l&raquo; &nbsp;</a></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Videre studiemuligheter</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Dette studiet kvalifiserer til en mastergrad i rettsvitenskap, men du kan ogs&aring; s&oslash;ke opptak til en fem&aring;rig master.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-error-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Viktige frister</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">S&oslash;knadsfristen er forlenget. Opptaket fortsetter s&aring; lenge det er ledige plasser.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-user"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Opptakskrav</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Du m&aring; innfri krav om <a href="/studere-hos-oss/opptaksinformasjon/#Studiekompetanse">generell studiekompetanse eller tilsvarende.</a></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-credit-card"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Pris</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">50 200 kr pr semester. Kvalifiserer til <a href="/studere-hos-oss/opptaksinformasjon/lanekassen/">st&oslash;tte fra L&aring;nekassen</a>.</div></div></li></ul><ul class="KdKtz5eB9ExUSDYJcdj8"><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Nivå"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-book"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Bachelor</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Oppstart"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-clock"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Høst 2026</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Gjennomføring"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Heltid</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studiepoeng"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-award"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">180 studiepoeng</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studiested"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-map-pin"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Bergen og Oslo</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studielengde"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-calendar"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">3 år</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Språk"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-message-square"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Norsk</span></div></li></ul></div></div></section><script>(window.__reactProps = window.__reactProps || {})['b9910f40-json'] = {"id":"n-oslash-kkelinformasjon","title":{"value":"N&oslash;kkelinformasjon"},"facts":[{"title":{"value":"Nytt studium"},"icon":"check-circle","content":{"value":"Dette studiet er helt nytt, og gir deg oppdatert og relevant kompetanse."}},{"title":{"value":"Utveksling"},"icon":"check-circle","content":{"value":"Opplev verden mens du studerer! <a href=\"/studier/bachelor/rettsvitenskap/#hva-lurer-du-på\">Les mer under &laquo;Ofte stilte sp&oslash;rsm&aring;l&raquo; &nbsp;</a>"}},{"title":{"value":"Videre studiemuligheter"},"icon":"check-circle","content":{"value":"Dette studiet kvalifiserer til en mastergrad i rettsvitenskap, men du kan ogs&aring; s&oslash;ke opptak til en fem&aring;rig master."}},{"title":{"value":"Viktige frister"},"icon":"error-circle","content":{"value":"S&oslash;knadsfristen er forlenget. Opptaket fortsetter s&aring; lenge det er ledige plasser."}},{"title":{"value":"Opptakskrav"},"icon":"user","content":{"value":"Du m&aring; innfri krav om <a href=\"/studere-hos-oss/opptaksinformasjon/#Studiekompetanse\">generell studiekompetanse eller tilsvarende.</a>"}},{"title":{"value":"Pris"},"icon":"credit-card","content":{"value":"50 200 kr pr semester. Kvalifiserer til <a href=\"/studere-hos-oss/opptaksinformasjon/lanekassen/\">st&oslash;tte fra L&aring;nekassen</a>."}}],"tags":[{"title":"Nivå","icon":"book","value":"Bachelor"},{"title":"Oppstart","icon":"clock","value":"Høst 2026"},{"title":"Gjennomføring","icon":"activity","value":"Heltid"},{"title":"Studiepoeng","icon":"award","value":"180 studiepoeng"},{"title":"Studiested","icon":"map-pin","value":"Bergen og Oslo"},{"title":"Studielengde","icon":"calendar","value":"3 år"},{"title":"Språk","icon":"message-square","value":"Norsk"}]};</script></div>
</div><div>
<div id="6d345e79"><section id="hva-l-aelig-rer-du" class="cwjtYbGmpj2Fc0XguMNM"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF aZkJAbcjSQdYr77t8LV7">Hva l&aelig;rer du?</h2><div class="zOMHtRvuigbQpkhq8l0i"><div class="FHwe9agruJdTg4dYFHN9"><div class="FktOVJkMpTVphR1rGeNp RichtextContent RichtextContent--light">Det er et &oslash;kende behov for medarbeidere som kan bruke juridisk kunnskap i praksis. Med en Bachelor i rettsvitenskap f&aring;r du en solid forst&aring;else av hvordan lover og regler p&aring;virker samfunnet. Studiet gir deg ferdigheter til &aring; analysere juridiske problemstillinger, vurdere l&oslash;sninger og tenke gjennom etiske sp&oslash;rsm&aring;l slik at du kan bruke jussen i virkelige situasjoner.</p>
<p><strong>Dette l&aelig;rer du i l&oslash;pet av studietiden:&nbsp;</strong></p>
<ul class="Richtext__ul">
<li>Forst&aring; hvordan rettssystemet fungerer</li>
<li>Bruke juridisk metode for &aring; l&oslash;se juridiske problemstillinger</li>
<li>F&aring; innsikt i privatrettsrettslige- og offentligrettslige emner, slik som blant annet:
<ul class="Richtext__ul">
<li>Kontraktsrett: selskapsrett, eiendomsrett og familie- og arverett</li>
<li>Offentlig rett: internasjonal rett, statsrett og forvaltningsrett</li>
</ul>
</li>
<li>&Aring; jobbe med rettsomr&aring;dene, med utgangspunkt i reelle tvister, slik at du f&aring;r praktisk og relevant erfaring.</li>
</ul></div><button title="Mer om undervisningen" aria-expanded="false" aria-controls="overlay_30765" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT f_wbJQigmJWOUtJRHvmX"><span class="visuallyHidden">Mer om undervisningen</span><span class="SvgIcon Kw06kOpEjKtbccDsYKVG"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus-circle"></use></svg></span></button><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_30765" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_30766"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_30766" class="visuallyHidden">Mer om undervisningen</span><h3 class="vGAYXQ8qVh3muyCADVi0">Mer om undervisningen</h3><div class="RichtextContent RichtextContent--dark">Bachelor i rettsvitenskap kombinerer teori og praksis, med casebasert undervisning som bygger p&aring; reelle saker fra arbeidslivet og domstolene. Du f&aring;r tilgang til moderne digitale l&aelig;ringsverkt&oslash;y og digitale rettskilder, og f&aring;r erfaring med hvordan teknologi p&aring;virker b&aring;de juridisk praksis og samfunnsutvikling. Dette gj&oslash;r utdanningen fremtidsrettet og relevant. Gjennom simuleringer av rettsm&oslash;ter, juridiske skrive&oslash;velser og forhandlingsspill f&aring;r du erfaring med hvordan jussen fungerer i praksis. Dette gir et l&aelig;ringsutbytte som ruster deg til &aring; m&oslash;te forventninger og krav fra arbeidslivet.</p>
<p>Studiet er forskningsbasert, og foreleserne bringer inn relevante forskningsprosjekter, samtidig som det legges vekt p&aring; at innholdet skal v&aelig;re direkte arbeidslivsrelevant. Du m&oslash;ter en variert kombinasjon av forelesninger, seminarer, gruppe&oslash;vinger, praktiske caseoppgaver, digitalt arbeid, selvstudium og kollokviegrupper.</div></div></div></div></div></div></div><div class="qB4kMuPluv5Id4WqPmfn"></div><div class="uMSWbISaLHTvPMbXhnYp"><div class="slJnKPGAAIKofsQwQBjL vPKYJ9xnnqorRitmkm3i R1wh_51Fi_Crd9RnsQsw"><picture><source sizes="(max-width: 767px) 100vw, (min-width: 768px) 552px" srcSet="/contentassets/4e3a7f6458eb4cf38209ed4568a464ed/master-i-okonomi-og-ledelse-kristiania-2025.jpg?width=375 375w, /contentassets/4e3a7f6458eb4cf38209ed4568a464ed/master-i-okonomi-og-ledelse-kristiania-2025.jpg?width=552 552w, /contentassets/4e3a7f6458eb4cf38209ed4568a464ed/master-i-okonomi-og-ledelse-kristiania-2025.jpg?width=768 768w, /contentassets/4e3a7f6458eb4cf38209ed4568a464ed/master-i-okonomi-og-ledelse-kristiania-2025.jpg?width=1536 1536w"/><img src="/contentassets/4e3a7f6458eb4cf38209ed4568a464ed/master-i-okonomi-og-ledelse-kristiania-2025.jpg?width=552" alt="Student jobber på PC." style="object-position:63% 42%" loading="lazy"/></picture></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['6d345e79-json'] = {"id":"hva-l-aelig-rer-du","title":{"value":"Hva l&aelig;rer du?"},"content":{"value":"Det er et &oslash;kende behov for medarbeidere som kan bruke juridisk kunnskap i praksis. Med en Bachelor i rettsvitenskap f&aring;r du en solid forst&aring;else av hvordan lover og regler p&aring;virker samfunnet. Studiet gir deg ferdigheter til &aring; analysere juridiske problemstillinger, vurdere l&oslash;sninger og tenke gjennom etiske sp&oslash;rsm&aring;l slik at du kan bruke jussen i virkelige situasjoner.</p>\n<p><strong>Dette l&aelig;rer du i l&oslash;pet av studietiden:&nbsp;</strong></p>\n<ul class=\"Richtext__ul\">\n<li>Forst&aring; hvordan rettssystemet fungerer</li>\n<li>Bruke juridisk metode for &aring; l&oslash;se juridiske problemstillinger</li>\n<li>F&aring; innsikt i privatrettsrettslige- og offentligrettslige emner, slik som blant annet:\n<ul class=\"Richtext__ul\">\n<li>Kontraktsrett: selskapsrett, eiendomsrett og familie- og arverett</li>\n<li>Offentlig rett: internasjonal rett, statsrett og forvaltningsrett</li>\n</ul>\n</li>\n<li>&Aring; jobbe med rettsomr&aring;dene, med utgangspunkt i reelle tvister, slik at du f&aring;r praktisk og relevant erfaring.</li>\n</ul>"},"overlayTitle":"Mer om undervisningen","overlayContent":{"value":"Bachelor i rettsvitenskap kombinerer teori og praksis, med casebasert undervisning som bygger p&aring; reelle saker fra arbeidslivet og domstolene. Du f&aring;r tilgang til moderne digitale l&aelig;ringsverkt&oslash;y og digitale rettskilder, og f&aring;r erfaring med hvordan teknologi p&aring;virker b&aring;de juridisk praksis og samfunnsutvikling. Dette gj&oslash;r utdanningen fremtidsrettet og relevant. Gjennom simuleringer av rettsm&oslash;ter, juridiske skrive&oslash;velser og forhandlingsspill f&aring;r du erfaring med hvordan jussen fungerer i praksis. Dette gir et l&aelig;ringsutbytte som ruster deg til &aring; m&oslash;te forventninger og krav fra arbeidslivet.</p>\n<p>Studiet er forskningsbasert, og foreleserne bringer inn relevante forskningsprosjekter, samtidig som det legges vekt p&aring; at innholdet skal v&aelig;re direkte arbeidslivsrelevant. Du m&oslash;ter en variert kombinasjon av forelesninger, seminarer, gruppe&oslash;vinger, praktiske caseoppgaver, digitalt arbeid, selvstudium og kollokviegrupper."},"gobiStoryId":null,"imageFallback":{"author":null,"caption":null,"url":"/contentassets/4e3a7f6458eb4cf38209ed4568a464ed/master-i-okonomi-og-ledelse-kristiania-2025.jpg","alt":"Student jobber på PC.","focalPoint":{"x":0.63,"y":0.42},"lazyLoading":true},"translations":{"openOverlay":"Mer om undervisningen","closeOverlay":"Lukk overlagg","openPlayer":"Åpne videospilleren","failedToLoadVideo":"Beklager, av en eller annen grunn kunne vi ikke laste inn en video"}};</script></div>
</div><div>
<div id="07dade7b"><section id="studiemodell" class="eXDLkCBTey4RjrTQSVwU"><div class="coBlOy78vCNQoCaBJMWq"><div class="fIm4MtcrG6MCKKd8iidQ"><h2 class="FrR9v_ssranAjR5kDzwF A9Jn0XOSrtngUTCr8gcL">Studiemodell</h2><div class="t78ozlVAuwJUrQItlgiY"><span class="IKcqvZpEOT2PNX0vgEn0">Studiemodellen er et utdrag av programbeskrivelsen. Den gir deg en oversikt over obligatoriske emner og hvilke muligheter du har for praksis, utveksling og spesialisering. Bachelorgraden går over tre studieår. Hvert studieår er delt opp i to semestre. Vi tar forbehold om endringer.</span></div></div></div><div class="DwbrqOYPLpXMxa_AUi5a"><div class="c4EHzShG0bxjcWsv1iba _jn80nJpcKPRabCSPcI8 o7i_4ji7xZ2pdim0DGGS r6PBO9Z23nGvfMtmlwMK dT6kOO1SWAAgm3_8NHMn"><div class="w6rdwzyeKdZC4QEQQdUG"><div class="FQnvPH3eSTnAU6bvrkhn"><div class="IbD8iYA8j6gRUkFt19Qt nUUm_USrpFGrNosOvcCN gXLqKND3fX0_VG9NQewb"><div role="tablist" class="_NQp5NLSF5eDFXAqjrMf" aria-label="Velg år"><button id="tab_1" role="tab" aria-selected="true" aria-controls="tabPanel_1" type="button" class="wSwA7V6mKnVhr5xFafzq Sqayds_IfbVRGAlPcZz1"><span class="bAoReRDLMgoAniQxqdep">Første år</span></button><button id="tab_2" role="tab" aria-selected="false" aria-controls="tabPanel_2" type="button" class="wSwA7V6mKnVhr5xFafzq"><span class="bAoReRDLMgoAniQxqdep">Andre år</span></button><button id="tab_3" role="tab" aria-selected="false" aria-controls="tabPanel_3" type="button" class="wSwA7V6mKnVhr5xFafzq"><span class="bAoReRDLMgoAniQxqdep">Tredje år</span></button></div></div><span class="FaaFQQsQ1uH8384yNffh">Totalt 180 studiepoeng</span></div><div id="tabPanel_1" class="xD2nuHiyJc0KNBTM5TWg" role="tabpanel" aria-labelledby="tab_1"><div class="XtdQZg9bKtEzGXT39oxb"><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="wpyTqNTlEGsGZ_xfFehk BK3qq6WSy_IM14HivUP2"><div class="XjUXAnCLxrJU_S3Faibn km5O6Vr04dX9qXqlrGMV Wc0G2UOdAM4L2tA07AtA"><div id="comboSelect_id30932" class="bbDHU4_JdA0hl9MD1Lrq">Valgmuligheter:</div><fieldset aria-describedby="comboSelect_id30932"><div class="drG0qWE9kXwq4x52jnrJ"><div class="Sp19XW4DI_sJH0_4zvTF"><div class="PHAoRS_eP5FouDCPNKdY GhAWyApR_JjGprSMJ2rM yje2hGysH1zQf_D0GsA7 echijgywrVRRk64pe6Cg"><input type="radio" id="FormComponents__radio__30933" class="YfHgbQjwjs4O8VWhll1c" name="study-option-selector" checked="" value="Ordinært studieløp"/><label for="FormComponents__radio__30933" class="XTEgAUAWtLfl5XRg_bT7"><span class="yUjgOv16CeoVvFj3U4nh">Ordinært studieløp</span></label></div><div class="PHAoRS_eP5FouDCPNKdY GhAWyApR_JjGprSMJ2rM yje2hGysH1zQf_D0GsA7 echijgywrVRRk64pe6Cg"><input type="radio" id="FormComponents__radio__30934" class="YfHgbQjwjs4O8VWhll1c" name="study-option-selector" value="Ordinært studieløp"/><label for="FormComponents__radio__30934" class="XTEgAUAWtLfl5XRg_bT7"><span class="yUjgOv16CeoVvFj3U4nh">Utveksling</span></label></div></div></div></fieldset></div></div><span class="NPFkgrIiXfIBoY50mCiN">60 studiepoeng</span><div class="osNFPrEfj_WDLlms79Vw"><div class="gIhCJK5vlYW4N6yeTlUe C70d_1unGsLcavciTBWP g8GJRoyN3YYrck7buLCF" style="grid-template-columns:auto repeat(6, minmax(min-content, 1fr))"><div class="PVTUTdX7fee_uJTuRkiD ihFnGka9xDug5NPWFh0C"></div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY z7vhCTYrC3rO2VoUPlYT">1. semester</div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY _MLObcIsnBTnfP4F5AQg">2. semester</div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:6 / span 2;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_30935" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Kontraktsrett</span><span class="scgJDiGbZP69e6JD2e1j">SA1002</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">10<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_30935" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_30936"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_30936" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Kontraktsrett</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnet skal gi en innføring i generell kontraktsrett hvor reglene om inngåelse av kontrakter og kjøp er sentralt. Studentene får en innføring i de grunnleggende rettskildene i avtaleretten, avtalerettslige prinsipper og ulike mekanismer for avtaleinngåelse. Videre får studentene kunnskap om reglene om fullmakt og representasjon, tolkning og utfylling av avtaler, ugyldighet og lemping. Studentene får en innføring i rettskildene i kjøpsretten og grunnleggende kjøpsrettslige prinsipper. Videref år studentene kunnskap om reglene om selgers og kjøpers plikter, kontraktsbrudd, misligholdssanksjoner og oversikt over reglene ved forbrukerkjøp.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 2;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_30937" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Erstatningsrett</span><span class="scgJDiGbZP69e6JD2e1j">SA1000</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">10<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_30937" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_30938"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_30938" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Erstatningsrett</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Studentene får en innføring i sentrale rettskilder og prinsipper i erstatningsretten. Videre får studentene kunnskap om erstatningsrettens grunnvilkår, herunder ansvarsgrunnlag, årsakssammenheng, påregnelighet og økonomisk tap. Studentene får også kunnskap om reglene for utmåling av erstatning og skadelidtes forhold.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:4 / span 2;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_30939" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Juridisk metode</span><span class="scgJDiGbZP69e6JD2e1j">SA1001</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">10<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_30939" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_30940"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_30940" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Juridisk metode</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p style="text-indent:0pt;margin-left:0pt;margin-top:6pt;margin-bottom:6pt;margin-right:0pt;">Emnet gir en innføring i juridisk metode. Emnet skal gi studenten grunnleggende innsikt og trening i bruk av juridisk metode for å løse juridiske spørsmål. Videre skal studentene få kunnskap om sentrale rettslige begreper om rett og rettsanvendelse, rettsnormer, rettskilder, tolking, vekt, rettsregel, subsumsjon, skjønn, plikt (påbud, forbud) og rettigheter. Juridisk metode skal gi studenten kjennskap til de ulike rettskildene, rettskildeprinsippene og hvordan ulike rettskilder tolkes. </p>
<p style="text-indent:0pt;margin-left:0pt;margin-top:6pt;margin-bottom:6pt;margin-right:0pt;">Videre gir emnet en ytterligere innføring i juridisk metode. Emnet skal også gi studenten kunnskap om skillet mellom lovfestet og ulovfestet rett og domstolenes rettsskapende virksomhet. Videre skal studenten kunne indentifisere og løse ulike typer rettsspørsmål og ha god kjennskap til fremgangsmåte når det gjelder løsning av både praktiske og mer «teoretiske» spørsmål. </p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 3;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_30941" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Arv og familierett</span><span class="scgJDiGbZP69e6JD2e1j">SA1003</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">15<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_30941" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_30942"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_30942" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Arv og familierett</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnet tar opp rettsforholdet mellom ektefeller, både under ekteskapet og ved ekteskapets opphør, samt sentrale rettsforhold ved ugift samliv. Sentrale temaer er de økonomiske rettsvirkningene av inngåelse av ekteskap, samt delingen av formuen ved separasjon og skilsmisse, og formuesforholdet mellom samboere og det økonomiske oppgjøret ved samlivsbrudd mellom samboere.</p><p>Emnet tar opp hva som skal skje med en persons eiendeler og gjeld etter at vedkommende er død. Det fokuseres på legalarveretten (arv etter loven), reglene om uskifte, og testamentretten (arv etter testament), herunder reglene om testamenters opprettelse, tolking, tilbakekall og bortfall og grensen mellom livs- og dødsdisposisjoner.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:5 / span 3;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_30943" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Eiendomsrett</span><span class="scgJDiGbZP69e6JD2e1j">SA1004</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">15<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_30943" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_30944"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_30944" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Eiendomsrett</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>I dette emnet får studentene en innføring i de grunnleggende reglene i eiendomsretten, deriblant eiendomsrettens utstrekning og begrensninger, opprettelse av eiendom, registrering og tinglysing. Videre får studentene kunnskap om reglene om servitutter (negative begrensninger på annen persons eiendom), hevd, sameie, forholdet til det offentlige og naborett.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="hUrOK4f2t5d89i_al5eu _jBcyRZzOe6QMtbojFs5"></div></div></div></div></div><div class="_qtIUhem1sc1EKjP4UhQ"><div id="tabPanel_2" role="tabpanel" aria-labelledby="tab_2"><ul><li><span>SA1007</span><span>Ex.phil. og Ex.fac.</span><div>
<p>Examen philosophicum (Ex.phil.) og examen facultatum (Ex.fac.) i rettsvitenskapelig variant gir studentene en innføring i grunnleggende spørsmål innen vitenskapsteori, språk, logikk, argumentasjon og rettsfilosofi. Emnet består av Ex.phil. (5 studiepoeng) og Ex.fac. (10 studiepoeng).</p><p>Ex.phil. gir en grunnleggende forståelse av kunnskapsteori, etikk, logikk og språkfilosofi, og tar opp spørsmål som hva kunnskap er, hvordan vitenskap skiller seg fra annen tenkning, og hvordan språk og begrepsbruk påvirker forståelsen av virkeligheten.</p><p>Ex.fac. er spesialtilpasset rettsvitenskap og retter seg mot juridisk argumentasjon, normanalyse og forholdet mellom rett og moral. Her vektlegges blant annet strukturen i juridiske resonnementer, normteori, rettens funksjon og legitimitet, og hvordan moralske teorier påvirker rettslige vurderinger.</p><p>Emnet er særlig relevant for studenter som ønsker å utvikle analytiske ferdigheter innenfor rettsvitenskap og få innsikt i hvordan logikk, språk og argumentasjon påvirker utforming, tolkning og anvendelse av rettsregler.</p>
</div></li><li><span>SA2000</span><span>Statsrett og rettshistorie</span><div>
<p>Emnet gir studentene en innføring i statsrett og rettshistorie, med vekt på hvordan statsforfatningen har utviklet seg i Norge og Europa.</p><p>Emnet består av følgende fagområder:</p><ul><li>Statsforfatningsrett (10 sp)</li><li>Rettshistorie (5 sp)</li></ul><p>Emnet gir studentene en innføring i statsforfatningsrett og rettshistorie, med vekt på hvordan statsforfatningen har utviklet seg i Norge og Europa. Gjennom emnet lærer studentene om Grunnloven, hvordan statsmaktene fungerer, hvilke oppgaver de har, og om ulike kontrollmekanismer. De får også kunnskap om sentrale prinsipper i rettsstaten.</p><p>I tillegg tar emnet for seg rettshistorie, der studentene får innsikt i viktige juridiske tradisjoner og hvordan rettssystemene har endret seg fra middelalderen frem til i dag. Studentene vil styrke evnene sine til å argumentere juridisk, til å gjenkjenne og løse juridiske problemstillinger, og til å analysere historiske rettsspørsmål på en reflektert måte.</p>
</div></li><li><span>SA2001</span><span>Alminnelig forvaltningsrett</span><div>
<p>Forvaltningsrett (15 sp)</p><p>Emnet gir en grundig forståelse av alminnelig forvaltningsrett.</p><p>Studentene vil lære om grunnleggende prinsipper og regler i norsk offentlig forvaltningsrett, blant annet hvordan forvaltningen er organisert, grunnleggende regler for forvaltningens virksomhet og saksbehandlingsregler. Sentrale temaer er delegasjon, myndighet, partsoffentlighet (innsyn), klageadgang, omgjøring, ugyldighet, kontroll med forvaltningen og domstolenes kompetanse til å prøve forvaltningensvedtak.</p>
</div></li><li><span>SA2003</span><span>International Law</span><div>
<p>This course in international law covers the following areas:</p><p>Public International Law (5 ECTS)</p><p>Human Rights Law (5 ECTS)</p><p>EEA Law (5 ECTS)</p><p>The course provides an introduction to public international law, international human rights, and EEA law, and offers students an understanding of how legal rules operate across national borders. Emphasis is placed on the sources, actors, and foundational principles of international law, with particular focus on state responsibility, the role of international organizations, and the legal status of individuals.</p><p>Students will also gain insight into the content, structure, and functioning of human rights—both at the international level and within the Norwegian legal system. The course aims to develop students’ ability to identify, analyze, and assess legal issues from an international perspective, and provides an essential foundation for further studies in law and international legal disciplines.</p><p>Additionally, students will gain insight into the significance of EEA law for Norwegian law, particularly the rules governing the free movement of goods, labour, services, and the right of establishment, as well as the institutions and decision-making processes within the EEA framework.</p>
</div></li><li><span>UTV999-30</span><span>Utveksling</span><div>
<p lang="en-US" style="text-indent:0pt;margin-left:0pt;margin-top:0pt;margin-bottom:0pt;margin-right:0pt;"><a href="https://www.kristiania.no/for-studenter/studier-i-utlandet/" style="color:#0000EE;text-decoration:underline ;">Les om utvekslingsmuligheter</a><span lang="nb-NO">.</span></p>
</div></li><li><span>UTV999BA30</span><span>Utveksling</span><div></div></li></ul></div><div id="tabPanel_3" role="tabpanel" aria-labelledby="tab_3"><ul><li><span>SA2002</span><span>Spesiell forvaltningsrett</span><div>
<p>Emnet består av:</p><ul><li>Velferdsrett (7,5 sp)</li><li>Miljørett (7,5 sp)</li></ul><p>Velferdsrett og miljørett er begge deler av den spesielle forvaltningsretten.</p><p>Velferdsretten handler om de materielle sidene ved velferdsstaten, og omfatter borgernes rettigheter til ulike offentlige goder og tjenester. Den setter også rammer for myndighetenes mulighet til å bruke tvang, spesielt innenfor helsevesenet og barnevernet.</p><p>Miljøretten omfatter prinsipper og virkemidler for beskyttelse av miljøet. Her inngår også sentrale bestemmelser knyttet til kommunalt planarbeid.</p><p>Begge rettsområdene har dessuten egne regler for saksbehandling, som på flere områder skiller seg fra de generelle reglene i forvaltningsretten.</p>
</div></li><li><span>SA2004</span><span>Formuerett: Kontraktsrett og avtalerett</span><div>
<p>Dette emnet består av:</p><ul><li>Kontraktsrett (10 sp)</li><li>Avtalerett (5 sp)</li></ul><p>Emnet bygger på innføringsemnet i kontraktsrett og er en videre fordypning i kontrakts- og avtaleretten. Sentralt i emnet er rettigheter og plikter i kontraktsforhold, prinsipper, reglene om mislighold og misligholdsbeføyelser samt opphør og endring av kontraktsforpliktelser. Videre gjennomgås reglene om ulike grunnlag for kontraktsinngåelse, forhandling, fullmakt og ugyldighet.</p>
</div></li><li><span>SA2005</span><span>Formuerett: Pengekravsrett og selskapsrett</span><div>
<p>Dette emnet består av:</p><ul><li>Pengekravsrett (7,5 sp)</li><li>Selskapsrett (7,5 sp)</li></ul><p>Det gis en innføring i pengekravsrett, slik som rettsregler og prinsipper om betalingsforpliktelser, samskyld, regress og foreldelse av pengekrav. Studentene får oversikt over reglene i pengekravsretten slik at de er i stand til å identifisere, tolke og løse teoretiske og praktiske pengekravsrettslige spørsmål.</p><p>Videre gis det en innføring i selskapsrett, hvor man ser på de ulike selskapsformene, selskapsorganene, forholdet til selskapsmidlene, avvikling og oppløsning av selskaper. Studentene vil få kunnskap om reglene for ansvarlige selskap, aksjeselskap og allmennaksjeselskap. Studentene får oversikt over reglene i selskapsretten, slik at de er i stand til å identifisere, tolke og løse teoretiske og praktiske selskapsrettslige spørsmål.</p>
</div></li><li><span>SA2006</span><span>Formuerett: Dynamisk tingsrett, panterett og konkursrett</span><div>
<p>Dette emnet gir studentene kunnskap om dynamisk tingsrett, herunder tredjepersonvern, panterett og konkursrett.</p><p>Emnet består av:</p><ul><li>Dynamisk tingsrett (5 sp)</li><li>Panterett (5 sp)</li><li>Konkursrett (5 sp)</li></ul><p>Studentene vil tilegne seg kunnskaper og utvikle ferdigheter for å løse teoretiske og praktiske rettslige spørsmål på tredjepersonvernrettens, panterettens og konkursrettens område.</p>
</div></li></ul></div></div></div></div></div><div class="lv4eNMiZgLixMXhAvacD"><a href="/studieportal/fakultet-for-samfunn-kunst-og-medier/bachelorniva/brv/bachelor-i-rettsvitenskap/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 AMdryBi_G8WFVbcuUzSv LVwfmt8Qy2xfZW7GrHx_ I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY SwVWunM8J0KL5d8Ov54G" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Se programbeskrivelse</div></a></div></section><script>(window.__reactProps = window.__reactProps || {})['07dade7b-json'] = {"heading":{"value":"Studiemodell"},"getSubjectInfoUrl":"/api/study-pages/152524/subjects-info-url","overlayContentMessages":{"outdated":{"heading":"Med forbehold om endringer","message":null,"variant":"info"},"fallback":{"heading":"Emnebeskrivelse kommer snart","message":{"value":"<span>Ved Kristiania utvikler vi studiene v&aring;re i samarbeid med arbeidslivet. Derfor oppdaterer vi emnene jevnlig, slik at du f&aring;r kompetansen som arbeidsgiverne ser etter. Snart kan du lese alt om dette emnet her, inntil da finner du mer informasjon i studieprogrambeskrivelsen.</span>"},"variant":"info"}},"subjects":[{"code":"SA1000","name":"Erstatningsrett","description":"\n<p>Studentene får en innføring i sentrale rettskilder og prinsipper i erstatningsretten. Videre får studentene kunnskap om erstatningsrettens grunnvilkår, herunder ansvarsgrunnlag, årsakssammenheng, påregnelighet og økonomisk tap. Studentene får også kunnskap om reglene for utmåling av erstatning og skadelidtes forhold.</p>\n","isDescriptionOutdated":false,"order":12,"points":10,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA1001","name":"Juridisk metode","description":"\r\n<p style=\"text-indent:0pt;margin-left:0pt;margin-top:6pt;margin-bottom:6pt;margin-right:0pt;\">Emnet gir en innføring i juridisk metode. Emnet skal gi studenten grunnleggende innsikt og trening i bruk av juridisk metode for å løse juridiske spørsmål. Videre skal studentene få kunnskap om sentrale rettslige begreper om rett og rettsanvendelse, rettsnormer, rettskilder, tolking, vekt, rettsregel, subsumsjon, skjønn, plikt (påbud, forbud) og rettigheter. Juridisk metode skal gi studenten kjennskap til de ulike rettskildene, rettskildeprinsippene og hvordan ulike rettskilder tolkes. </p>\r\n<p style=\"text-indent:0pt;margin-left:0pt;margin-top:6pt;margin-bottom:6pt;margin-right:0pt;\">Videre gir emnet en ytterligere innføring i juridisk metode. Emnet skal også gi studenten kunnskap om skillet mellom lovfestet og ulovfestet rett og domstolenes rettsskapende virksomhet. Videre skal studenten kunne indentifisere og løse ulike typer rettsspørsmål og ha god kjennskap til fremgangsmåte når det gjelder løsning av både praktiske og mer «teoretiske» spørsmål. </p>\r\n","isDescriptionOutdated":false,"order":13,"points":10,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA1002","name":"Kontraktsrett","description":"\n<p>Emnet skal gi en innføring i generell kontraktsrett hvor reglene om inngåelse av kontrakter og kjøp er sentralt. Studentene får en innføring i de grunnleggende rettskildene i avtaleretten, avtalerettslige prinsipper og ulike mekanismer for avtaleinngåelse. Videre får studentene kunnskap om reglene om fullmakt og representasjon, tolkning og utfylling av avtaler, ugyldighet og lemping. Studentene får en innføring i rettskildene i kjøpsretten og grunnleggende kjøpsrettslige prinsipper. Videref år studentene kunnskap om reglene om selgers og kjøpers plikter, kontraktsbrudd, misligholdssanksjoner og oversikt over reglene ved forbrukerkjøp.</p>\n","isDescriptionOutdated":false,"order":11,"points":10,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA1003","name":"Arv og familierett","description":"\n<p>Emnet tar opp rettsforholdet mellom ektefeller, både under ekteskapet og ved ekteskapets opphør, samt sentrale rettsforhold ved ugift samliv. Sentrale temaer er de økonomiske rettsvirkningene av inngåelse av ekteskap, samt delingen av formuen ved separasjon og skilsmisse, og formuesforholdet mellom samboere og det økonomiske oppgjøret ved samlivsbrudd mellom samboere.</p><p>Emnet tar opp hva som skal skje med en persons eiendeler og gjeld etter at vedkommende er død. Det fokuseres på legalarveretten (arv etter loven), reglene om uskifte, og testamentretten (arv etter testament), herunder reglene om testamenters opprettelse, tolking, tilbakekall og bortfall og grensen mellom livs- og dødsdisposisjoner.</p>\n","isDescriptionOutdated":false,"order":21,"points":15,"year":1,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA1004","name":"Eiendomsrett","description":"\n<p>I dette emnet får studentene en innføring i de grunnleggende reglene i eiendomsretten, deriblant eiendomsrettens utstrekning og begrensninger, opprettelse av eiendom, registrering og tinglysing. Videre får studentene kunnskap om reglene om servitutter (negative begrensninger på annen persons eiendom), hevd, sameie, forholdet til det offentlige og naborett.</p>\n","isDescriptionOutdated":false,"order":22,"points":15,"year":1,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA1007","name":"Ex.phil. og Ex.fac.","description":"\n<p>Examen philosophicum (Ex.phil.) og examen facultatum (Ex.fac.) i rettsvitenskapelig variant gir studentene en innføring i grunnleggende spørsmål innen vitenskapsteori, språk, logikk, argumentasjon og rettsfilosofi. Emnet består av Ex.phil. (5 studiepoeng) og Ex.fac. (10 studiepoeng).</p><p>Ex.phil. gir en grunnleggende forståelse av kunnskapsteori, etikk, logikk og språkfilosofi, og tar opp spørsmål som hva kunnskap er, hvordan vitenskap skiller seg fra annen tenkning, og hvordan språk og begrepsbruk påvirker forståelsen av virkeligheten.</p><p>Ex.fac. er spesialtilpasset rettsvitenskap og retter seg mot juridisk argumentasjon, normanalyse og forholdet mellom rett og moral. Her vektlegges blant annet strukturen i juridiske resonnementer, normteori, rettens funksjon og legitimitet, og hvordan moralske teorier påvirker rettslige vurderinger.</p><p>Emnet er særlig relevant for studenter som ønsker å utvikle analytiske ferdigheter innenfor rettsvitenskap og få innsikt i hvordan logikk, språk og argumentasjon påvirker utforming, tolkning og anvendelse av rettsregler.</p>\n","isDescriptionOutdated":false,"order":41,"points":15,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Ordinært studieløp","isDefault":true},"category":"obligatory"},{"code":"SA2000","name":"Statsrett og rettshistorie","description":"\n<p>Emnet gir studentene en innføring i statsrett og rettshistorie, med vekt på hvordan statsforfatningen har utviklet seg i Norge og Europa.</p><p>Emnet består av følgende fagområder:</p><ul><li>Statsforfatningsrett (10 sp)</li><li>Rettshistorie (5 sp)</li></ul><p>Emnet gir studentene en innføring i statsforfatningsrett og rettshistorie, med vekt på hvordan statsforfatningen har utviklet seg i Norge og Europa. Gjennom emnet lærer studentene om Grunnloven, hvordan statsmaktene fungerer, hvilke oppgaver de har, og om ulike kontrollmekanismer. De får også kunnskap om sentrale prinsipper i rettsstaten.</p><p>I tillegg tar emnet for seg rettshistorie, der studentene får innsikt i viktige juridiske tradisjoner og hvordan rettssystemene har endret seg fra middelalderen frem til i dag. Studentene vil styrke evnene sine til å argumentere juridisk, til å gjenkjenne og løse juridiske problemstillinger, og til å analysere historiske rettsspørsmål på en reflektert måte.</p>\n","isDescriptionOutdated":false,"order":32,"points":15,"year":2,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA2001","name":"Alminnelig forvaltningsrett","description":"\n<p>Forvaltningsrett (15 sp)</p><p>Emnet gir en grundig forståelse av alminnelig forvaltningsrett.</p><p>Studentene vil lære om grunnleggende prinsipper og regler i norsk offentlig forvaltningsrett, blant annet hvordan forvaltningen er organisert, grunnleggende regler for forvaltningens virksomhet og saksbehandlingsregler. Sentrale temaer er delegasjon, myndighet, partsoffentlighet (innsyn), klageadgang, omgjøring, ugyldighet, kontroll med forvaltningen og domstolenes kompetanse til å prøve forvaltningensvedtak.</p>\n","isDescriptionOutdated":false,"order":31,"points":15,"year":2,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA2002","name":"Spesiell forvaltningsrett","description":"\n<p>Emnet består av:</p><ul><li>Velferdsrett (7,5 sp)</li><li>Miljørett (7,5 sp)</li></ul><p>Velferdsrett og miljørett er begge deler av den spesielle forvaltningsretten.</p><p>Velferdsretten handler om de materielle sidene ved velferdsstaten, og omfatter borgernes rettigheter til ulike offentlige goder og tjenester. Den setter også rammer for myndighetenes mulighet til å bruke tvang, spesielt innenfor helsevesenet og barnevernet.</p><p>Miljøretten omfatter prinsipper og virkemidler for beskyttelse av miljøet. Her inngår også sentrale bestemmelser knyttet til kommunalt planarbeid.</p><p>Begge rettsområdene har dessuten egne regler for saksbehandling, som på flere områder skiller seg fra de generelle reglene i forvaltningsretten.</p>\n","isDescriptionOutdated":false,"order":51,"points":15,"year":3,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA2003","name":"International Law","description":"\n<p>This course in international law covers the following areas:</p><p>Public International Law (5 ECTS)</p><p>Human Rights Law (5 ECTS)</p><p>EEA Law (5 ECTS)</p><p>The course provides an introduction to public international law, international human rights, and EEA law, and offers students an understanding of how legal rules operate across national borders. Emphasis is placed on the sources, actors, and foundational principles of international law, with particular focus on state responsibility, the role of international organizations, and the legal status of individuals.</p><p>Students will also gain insight into the content, structure, and functioning of human rights—both at the international level and within the Norwegian legal system. The course aims to develop students’ ability to identify, analyze, and assess legal issues from an international perspective, and provides an essential foundation for further studies in law and international legal disciplines.</p><p>Additionally, students will gain insight into the significance of EEA law for Norwegian law, particularly the rules governing the free movement of goods, labour, services, and the right of establishment, as well as the institutions and decision-making processes within the EEA framework.</p>\n","isDescriptionOutdated":false,"order":42,"points":15,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Ordinært studieløp","isDefault":true},"category":"obligatory"},{"code":"SA2004","name":"Formuerett: Kontraktsrett og avtalerett","description":"\n<p>Dette emnet består av:</p><ul><li>Kontraktsrett (10 sp)</li><li>Avtalerett (5 sp)</li></ul><p>Emnet bygger på innføringsemnet i kontraktsrett og er en videre fordypning i kontrakts- og avtaleretten. Sentralt i emnet er rettigheter og plikter i kontraktsforhold, prinsipper, reglene om mislighold og misligholdsbeføyelser samt opphør og endring av kontraktsforpliktelser. Videre gjennomgås reglene om ulike grunnlag for kontraktsinngåelse, forhandling, fullmakt og ugyldighet.</p>\n","isDescriptionOutdated":false,"order":52,"points":15,"year":3,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA2005","name":"Formuerett: Pengekravsrett og selskapsrett","description":"\n<p>Dette emnet består av:</p><ul><li>Pengekravsrett (7,5 sp)</li><li>Selskapsrett (7,5 sp)</li></ul><p>Det gis en innføring i pengekravsrett, slik som rettsregler og prinsipper om betalingsforpliktelser, samskyld, regress og foreldelse av pengekrav. Studentene får oversikt over reglene i pengekravsretten slik at de er i stand til å identifisere, tolke og løse teoretiske og praktiske pengekravsrettslige spørsmål.</p><p>Videre gis det en innføring i selskapsrett, hvor man ser på de ulike selskapsformene, selskapsorganene, forholdet til selskapsmidlene, avvikling og oppløsning av selskaper. Studentene vil få kunnskap om reglene for ansvarlige selskap, aksjeselskap og allmennaksjeselskap. Studentene får oversikt over reglene i selskapsretten, slik at de er i stand til å identifisere, tolke og løse teoretiske og praktiske selskapsrettslige spørsmål.</p>\n","isDescriptionOutdated":false,"order":61,"points":15,"year":3,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SA2006","name":"Formuerett: Dynamisk tingsrett, panterett og konkursrett","description":"\n<p>Dette emnet gir studentene kunnskap om dynamisk tingsrett, herunder tredjepersonvern, panterett og konkursrett.</p><p>Emnet består av:</p><ul><li>Dynamisk tingsrett (5 sp)</li><li>Panterett (5 sp)</li><li>Konkursrett (5 sp)</li></ul><p>Studentene vil tilegne seg kunnskaper og utvikle ferdigheter for å løse teoretiske og praktiske rettslige spørsmål på tredjepersonvernrettens, panterettens og konkursrettens område.</p>\n","isDescriptionOutdated":false,"order":62,"points":15,"year":3,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"UTV999-30","name":"Utveksling","description":"\r\n<p lang=\"en-US\" style=\"text-indent:0pt;margin-left:0pt;margin-top:0pt;margin-bottom:0pt;margin-right:0pt;\"><a href=\"https://www.kristiania.no/for-studenter/studier-i-utlandet/\" style=\"color:#0000EE;text-decoration:underline ;\">Les om utvekslingsmuligheter</a><span lang=\"nb-NO\">.</span></p>\r\n","isDescriptionOutdated":true,"order":42,"points":30,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Utveksling","isDefault":false},"category":"obligatory"},{"code":"UTV999BA30","name":"Utveksling","description":null,"isDescriptionOutdated":null,"order":1,"points":30,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Utveksling","isDefault":false},"category":"obligatory"}],"translations":{"studyOptions":"Valgmuligheter","elective":"Valgemne","specialization":"Studieretning","selectYear":"Velg år","openSubjectOverlay":"Åpne emneoverlegg","closeOverlay":"Lukk overlagg","genericErrorMessage":"Feil oppsto","totalStudyPointsFormat":"Totalt {points} studiepoeng","studyPointsFormat":"{points} studiepoeng","pointsUnit":"stp.","noSubjectsMessage":"Beklager, det er problemer med å laste inn innholdet for øyeblikket","prerequisites":"Forkunnskaper","goToSubject":"Les mer","loading":"Laster inn data","year":"år","semester":"semester","single":"ett","first":"første","second":"andre","third":"tredje","fourth":"fjerde","fifth":"femte"},"type":"view","id":"studiemodell","teaser":"Studiemodellen er et utdrag av programbeskrivelsen. Den gir deg en oversikt over obligatoriske emner og hvilke muligheter du har for praksis, utveksling og spesialisering. Bachelorgraden går over tre studieår. Hvert studieår er delt opp i to semestre. Vi tar forbehold om endringer.","settings":{"disableStudyModel":false,"disabledStudyModelHeading":"Informasjon om studiemodeller","disabledStudyModelMessage":{"value":"Studiemodellen er under arbeid og vil bli publisert så snart den er klar"}},"studyProgramLink":{"label":"Se programbeskrivelse","href":"/studieportal/fakultet-for-samfunn-kunst-og-medier/bachelorniva/brv/bachelor-i-rettsvitenskap/","external":false,"showIsExternal":true}};</script></div>
</div><div>
<div id="3a6592bf"><section id="hva-kan-du-bli" class="cr4GKFNCqp2Yu1c2kbOA"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF vw2qEzBLsG8dfPFKhCCL">Hva kan du bli?</h2><div class="eCTirCs_JIAXtZrCECpB"><div class="s4PUgF87xJpwYCH4qegZ"><div class="gOFfCOGgsoYfQDsrulwN Um_bsxrmr048dYBfonAO hfMRvjcJ6bvRCr56YbNA"><div class="KgSPjnWKLeiPJ0FM0dQy RichtextContent RichtextContent--dark">Denne utdanningen &aring;pner for mange spennende karrieremuligheter b&aring;de i offentlig sektor og privat n&aelig;ringsliv. Etter fullf&oslash;rt studium kan du blant annet jobbe med:</p>
<ul class="Richtext__ul">
<li>Juridisk saksbehandling og forvaltning</li>
<li>HR-, compliance- og r&aring;dgivningsroller</li>
<li>Juridiske stillinger i organisasjoner og interessegrupper</li>
</ul>
<p>Bachelorgraden gir ogs&aring; et solid grunnlag for videre studier, b&aring;de i Norge og internasjonalt. Etter fullf&oslash;rt grad kan du s&oslash;ke 2-&aring;rige masterprogrammer i rettsvitenskap, eller s&oslash;ke om faglig godkjenning for overgang til 5-&aring;rige masterprogrammer ved andre universiteter. Graden kan ogs&aring; gi opptak til masterprogrammer innen for eksempel offentlig administrasjon, ledelse og innovasjon. Kontakt studieprogramleder for mer informasjon om videre studier.<strong> </strong></div><div></div></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['3a6592bf-json'] = {"id":"hva-kan-du-bli","heading":{"value":"Hva kan du bli?"},"teaser":{"value":"Denne utdanningen &aring;pner for mange spennende karrieremuligheter b&aring;de i offentlig sektor og privat n&aelig;ringsliv. Etter fullf&oslash;rt studium kan du blant annet jobbe med:</p>\n<ul class=\"Richtext__ul\">\n<li>Juridisk saksbehandling og forvaltning</li>\n<li>HR-, compliance- og r&aring;dgivningsroller</li>\n<li>Juridiske stillinger i organisasjoner og interessegrupper</li>\n</ul>\n<p>Bachelorgraden gir ogs&aring; et solid grunnlag for videre studier, b&aring;de i Norge og internasjonalt. Etter fullf&oslash;rt grad kan du s&oslash;ke 2-&aring;rige masterprogrammer i rettsvitenskap, eller s&oslash;ke om faglig godkjenning for overgang til 5-&aring;rige masterprogrammer ved andre universiteter. Graden kan ogs&aring; gi opptak til masterprogrammer innen for eksempel offentlig administrasjon, ledelse og innovasjon. Kontakt studieprogramleder for mer informasjon om videre studier.<strong> </strong>"},"linkList":[],"featuredArticle":null,"blockVariant":"default","overlayButtonLabel":null,"overlayHeading":null,"overlayContent":null,"overlayCloseLabel":"Lukk overlagg"};</script></div>
</div><div>
<div id="c8eb86b0"><section id="m-oslash-t-fagmilj-oslash-et" class="xfIZ8IPRSKGxzL5KIyLz ZG9x_vn8GvsrSWPis7bl"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF Bje8lNYEARjKXkaadcjl">M&oslash;t fagmilj&oslash;et</h2><div class="IP4WLEZAtSgblGP4Felg"><div class="KCVvuotjBI0iy0ATTKfK"><div class="VNQ7BkWJFagCE_bBjsxQ ZLbmeOzjwEPCnL8UV8zG ssmQS4h9jzEH4V0L4NSN"><span class="FxrXNHIEItswETCvk14E" style="display:block"><span class="EwPhzUN1NfTBa1XOsTE6 TVMntCe8qkWIdDcQxQb6"></span></span></div></div><ul class="tZx0pZhK8q3JNoQI8LCj"><li class="i8yQuD9MeLJCD5eDKft2"><div class="cVALO6yJDjmV1Xvkvynu"><div class="WWUAFGePNJBA0_seRWlX"><h3 class="TCpxq20heJlGBaSbNI4y">Slik jobber vi</h3><div class="AXbF9ehRSXzzERBwn1XK RichtextContent RichtextContent--light">Kristiania har et engasjert fagmilj&oslash; innen rettsvitenskap, der foreleserne har bred erfaring b&aring;de akademia, rettsvesen, forvaltning og n&aelig;ringsliv. Fagmilj&oslash;et best&aring;r av jurister, advokater, dommere og forskere. Studiet er utviklet i tett dialog med arbeidslivet, og hele fagmilj&oslash;et jobber for &aring; gi deg en utdanning som speiler det juridiske feltet slik det faktisk fungerer i dag. Som student m&oslash;ter du undervisere som tar med seg ekte problemstillinger, faglige diskusjoner og metodisk innsikt inn i klasserommet.</div></div></div></li><li class="i8yQuD9MeLJCD5eDKft2"><div class="cVALO6yJDjmV1Xvkvynu"><div class="WWUAFGePNJBA0_seRWlX"><h3 class="TCpxq20heJlGBaSbNI4y">Slik er studiehverdagen</h3><div class="AXbF9ehRSXzzERBwn1XK RichtextContent RichtextContent--light">Som student ved Kristiania blir du del av et inkluderende studiemilj&oslash; der samarbeid, faglige samtaler og lav terskel for &aring; stille sp&oslash;rsm&aring;l er en naturlig del av hverdagen. Du f&aring;r tett oppf&oslash;lging fra forelesere som kjenner deg og f&oslash;lger utviklingen din. I tillegg til undervisningen skjer mye av l&aelig;ringen i fellesskapet &ndash; gjennom diskusjoner i klassen og faglige aktiviteter som binder studentene sammen. Campuslivet er aktivt og sosialt, og du blir en del av et milj&oslash; som gir plass til b&aring;de faglig utvikling og engasjement utenfor forelesningssalen.</div></div></div></li></ul></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['c8eb86b0-json'] = {"id":"m-oslash-t-fagmilj-oslash-et","heading":{"value":"M&oslash;t fagmilj&oslash;et"},"testimonies":[{"heading":{"value":"Slik jobber vi"},"content":{"value":"Kristiania har et engasjert fagmilj&oslash; innen rettsvitenskap, der foreleserne har bred erfaring b&aring;de akademia, rettsvesen, forvaltning og n&aelig;ringsliv. Fagmilj&oslash;et best&aring;r av jurister, advokater, dommere og forskere. Studiet er utviklet i tett dialog med arbeidslivet, og hele fagmilj&oslash;et jobber for &aring; gi deg en utdanning som speiler det juridiske feltet slik det faktisk fungerer i dag. Som student m&oslash;ter du undervisere som tar med seg ekte problemstillinger, faglige diskusjoner og metodisk innsikt inn i klasserommet."}},{"heading":{"value":"Slik er studiehverdagen"},"content":{"value":"Som student ved Kristiania blir du del av et inkluderende studiemilj&oslash; der samarbeid, faglige samtaler og lav terskel for &aring; stille sp&oslash;rsm&aring;l er en naturlig del av hverdagen. Du f&aring;r tett oppf&oslash;lging fra forelesere som kjenner deg og f&oslash;lger utviklingen din. I tillegg til undervisningen skjer mye av l&aelig;ringen i fellesskapet &ndash; gjennom diskusjoner i klassen og faglige aktiviteter som binder studentene sammen. Campuslivet er aktivt og sosialt, og du blir en del av et milj&oslash; som gir plass til b&aring;de faglig utvikling og engasjement utenfor forelesningssalen."}}],"gobiStoryId":"84cgw","imageFallback":{"author":null,"caption":null,"url":"/contentassets/4e9f72260b674132a364703c7d631f84/ervik-studiepoeng.jpg","alt":"Foreleser snakker til publikum.","focalPoint":{"x":0.56,"y":0.36},"lazyLoading":true},"translations":{"openPlayer":"Åpne videospilleren","failedToLoadVideo":"Beklager, av en eller annen grunn kunne vi ikke laste inn en video"},"variant":"dark"};</script></div>
</div><div>
<div id="de796d10"><section id="m-oslash-t-studieprogramleder" class="cPloAW9ETJppiKf3uOg6 PS9OiuwCp_Mtf4jcUm_I"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><div class="OPDkk3SbGwWTZeDlZj4f"><div class="Za0F_aizRoRV7IW8vrhK"><span class="SvgIcon R8xM2ukm6YYDNzHE9e8V"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-quote-mark"></use></svg></span></div><div class="OBg8GbGOQ11Y_kO0y26Q">Du vil m&oslash;te forelesere med erfaring fra juridisk virksomhet, og de har gjerne jobbet som dommere eller advokater. De er tett p&aring; og &oslash;nsker &aring; hjelpe deg.</div><div class="WyTuSgXamI5tDjjbW40k"><div class="ELZbSN0xkGRxudxoCGZD Jjpdm0z1lffwiYq7tJFx"><div class="slJnKPGAAIKofsQwQBjL BsNJMoWrLSwywFoZw_rI"><picture><source sizes="(max-width: 479px) 100vw, (min-width: 480px) 350px" srcSet="/contentassets/f9c3c95915384319807b513d471609d0/kjell_ove_ernes.jpg?width=350 350w, /contentassets/f9c3c95915384319807b513d471609d0/kjell_ove_ernes.jpg?width=470 470w"/><img src="/contentassets/f9c3c95915384319807b513d471609d0/kjell_ove_ernes.jpg?width=258" alt="Kjell Ove Ernes" loading="lazy"/></picture></div><div class="wgsfEYhliRuQ3OGsPPB7"><a href="/om-kristiania/ansatte/fakultet-for-samfunn-kunst-og-medier/institutt-for-psykologi-pedagogikk-og-juss/kjell-ove-ernes/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi A9IrxP6x1kHMxJBX5nkl" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span class="PafA02TiaN5DOnBONInU">Kjell Ove Ernes</span><span class="C7aWfJ5wcSGxkMQk5mVC"><ul class="ybs02MiIsdu5yS7LYwML"><li class="MkfboJs3JDCOgTmDA6XY">Dosent</li></ul><span class="WNOGE5Zjbw73YZqwUfmg">Institutt for psykologi, pedagogikk og juss</span></span></div></a></div></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['de796d10-json'] = {"id":"m-oslash-t-studieprogramleder","quote":{"value":"Du vil m&oslash;te forelesere med erfaring fra juridisk virksomhet, og de har gjerne jobbet som dommere eller advokater. De er tett p&aring; og &oslash;nsker &aring; hjelpe deg."},"employeeInfo":{"name":"Kjell Ove Ernes","picture":{"profile":{"defaultWidth":258,"format":"preserve","maxImageDimension":null,"sources":[{"mediaCondition":null,"allowedWidths":[350,470],"sizes":["(max-width: 479px) 100vw","(min-width: 480px) 350px"],"mode":"default","targetAspectRatio":{"ratio":-1,"hasValue":false},"quality":{"quality":-1}}]},"author":null,"caption":null,"url":"/contentassets/f9c3c95915384319807b513d471609d0/kjell_ove_ernes.jpg","alt":"Kjell Ove Ernes","focalPoint":null,"lazyLoading":true},"jobTitles":["Dosent"],"department":"Institutt for psykologi, pedagogikk og juss","organization":"Kristiania","link":{"label":"Kjell Ove Ernes","href":"/om-kristiania/ansatte/fakultet-for-samfunn-kunst-og-medier/institutt-for-psykologi-pedagogikk-og-juss/kjell-ove-ernes/","external":false,"showIsExternal":true}},"variant":"red"};</script></div>
