<div id="0c862d62"><section class="_eq_qg_GewgPhGwcAzq8"><div class="j3a8ThoYc55mASLNSyjA"><div class="gU_G1Slvf8yBx2ryAztw"><div class="slJnKPGAAIKofsQwQBjL ZzhzXHPuPB7hJ0J9hHZ_"><picture><source sizes="(min-width: 1440px) 500px, (min-width: 768px) 33vw, 100vw" srcset="/contentassets/65fa6168fb3c4170be2167ae4a6455df/odisee-brussel-campus.jpg?width=375 375w, /contentassets/65fa6168fb3c4170be2167ae4a6455df/odisee-brussel-campus.jpg?width=500 500w, /contentassets/65fa6168fb3c4170be2167ae4a6455df/odisee-brussel-campus.jpg?width=768 768w"><img src="/contentassets/65fa6168fb3c4170be2167ae4a6455df/odisee-brussel-campus.jpg?width=500" loading="lazy"></picture></div><div class="wU_SjsF8OT2a75wibltn"><div class="XC3UYwLQI6HU5ecnktFV"><h3 class="tPC6boHRNBJEqwqOsqQR">ODISEE Hogeschool-Universiteit&nbsp;(Brussel)</h3><div class="RichtextContent _2jNkfmwAxq1ve9tHJyCg"><span><a href="https://www.odisee.be/en">ODISEE University of Applied Sciences </a>har 6 campuser, bl.a. i Ghent og Brussel.&nbsp;</span><p></p>
