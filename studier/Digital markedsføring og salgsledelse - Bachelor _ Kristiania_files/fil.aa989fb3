 ingen valgte studier. Gå til studieoversikten for å komme i gang.","seeAllStudies":"Se alle studier"},"languages":[{"code":"no","label":"Norwegian","url":"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/tyrkia/"},{"code":"en","label":"English","url":null}],"variant":"default","searchPageUrl":"/sok","menuColumnsCount":4,"startPageUrl":"/","loginPageUrl":"/login/","myPageUrl":"/min-side/","isUserLoggedIn":false,"studySearchPageUrl":"/studier/"},"infoBanner":{"infoText":null,"infoUrl":null}};</script></div>
