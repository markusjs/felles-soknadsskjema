ist Table 7 Colorful Accent 3\"/>\n  <w:LsdException Locked=\"false\" Priority=\"46\"\n   Name=\"List Table 1 Light Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"47\" Name=\"List Table 2 Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"48\" Name=\"List Table 3 Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"49\" Name=\"List Table 4 Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"50\" Name=\"List Table 5 Dark Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"51\"\n   Name=\"List Table 6 Colorful Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"52\"\n   Name=\"List Table 7 Colorful Accent 4\"/>\n  <w:LsdException Locked=\"false\" Priority=\"46\"\n   Name=\"List Table 1 Light Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"47\" Name=\"List Table 2 Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"48\" Name=\"List Table 3 Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"49\" Name=\"List Table 4 Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"50\" Name=\"List Table 5 Dark Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"51\"\n   Name=\"List Table 6 Colorful Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"52\"\n   Name=\"List Table 7 Colorful Accent 5\"/>\n  <w:LsdException Locked=\"false\" Priority=\"46\"\n   Name=\"List Table 1 Light Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"47\" Name=\"List Table 2 Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"48\" Name=\"List Table 3 Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"49\" Name=\"List Table 4 Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"50\" Name=\"List Table 5 Dark Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"51\"\n   Name=\"List Table 6 Colorful Accent 6\"/>\n  <w:LsdException Locked=\"false\" Priority=\"52\"\n   Name=\"List Table 7 Colorful Accent 6\"/>\n  <w:LsdException Locked=\"false\" SemiHidden=\"true\" UnhideWhenUsed=\"true\"\n   Name=\"Mention\"/>\n  <w:LsdException Locked=\"false\" SemiHidden=\"true\" UnhideWhenUsed=\"true\"\n   Name=\"Smart Hyperlink\"/>\n  <w:LsdException Locked=\"false\" SemiHidden=\"true\" UnhideWhenUsed=\"true\"\n   Name=\"Hashtag\"/>\n  <w:LsdException Locked=\"false\" SemiHidden=\"true\" UnhideWhenUsed=\"true\"\n   Name=\"Unresolved Mention\"/>\n  <w:LsdException Locked=\"false\" SemiHidden=\"true\" UnhideWhenUsed=\"true\"\n   Name=\"Smart Link\"/>\n </w:LatentStyles>\n</xml><![endif]--> <!-- [if gte mso 10]>\n<style>\n /* Style Definitions */\n table.MsoNormalTable\n\t{mso-style-name:\"Vanlig tabell\";\n\tmso-tstyle-rowband-size:0;\n\tmso-tstyle-colband-size:0;\n\tmso-style-noshow:yes;\n\tmso-style-priority:99;\n\tmso-style-parent:\"\";\n\tmso-padding-alt:0cm 5.4pt 0cm 5.4pt;\n\tmso-para-margin:0cm;\n\tmso-pagination:widow-orphan;\n\tfont-size:10.0pt;\n\tfont-family:\"Times New Roman\",serif;}\n</style>\n<![endif]--> <!--StartFragment--></p>\n<p><a href=\"https://pums.ump.edu.pl/\" target=\"_blank\" rel=\"noopener\"><span><span>Poznan University of Medical Sciences (PUMS)</span></span></a><span><span> ligger midt mellom Warzawa og Berlin, med i underkant av tre timer med tog fra begge hovedstedene. En velkjent by for mange medisinstudenter fra Skandinavia og det f&oslash;rste universitetet i Polen som tilb&oslash;d medisinutdanning p&aring; engelsk. Dette er universitetet for deg som vil ha et opphold ved et veldrevet medisinsk fakultet, med gode tilpassede fasiliteter og tett samarbeid med de lokale sykehusene. Byen er en av Polens eldste og med et innbyggertall p&aring; en halv million </span></span><span><span>p&aring; st&oslash;rrelse med Bergen</span></span><span><span>.</span></span></p>\n<p><span><span>Bachelor i Biomedisin har PUMS som utvekslingsalternativ. Emner som m&aring; dekkes i fjerde semester for biomedisin-studenter er: Immunology, Microbiology, og Anatomy and Histology (alle med 10 studiepoeng/ECTS hver). Tilbudet om utveksling p&aring; biomedisin, tar forbehold om at man til enhver tid finner matchende fagkombinasjoner.</span></span></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"https://pums.edu.pl/about-pums/welcome-to-pums/\" target=\"_blank\" rel=\"noopener\"><span><span>Generell informasjon</span></span></a></li>\n<li><a href=\"https://pums.edu.pl/admissions/why-pums/\" target=\"_blank\" rel=\"noopener\">Hvorfor velge PUMS</a></li>\n<li><a href=\"https://pums.edu.pl/admissions/useful-information-for-incoming-students/\" target=\"_blank\" rel=\"noopener\">Infoside innkommende studenter</a></li>\n<li><a href=\"https://pums.edu.pl/about-pums/city-of-poznan/\"><span><span>Poznan by</span></span></a></li>\n</ul>\n<p><span><span>Semesterinndelingen ved PUMS er som f&oslash;lger:<br /></span></span><span><span>- H&oslash;stsemesteret g&aring;r fra august - </span></span><span><span>desember<br /></span></span><span><span>- V&aring;rsemesteret g&aring;r fra januar&nbsp;</span><span><span>-</span></span></span><span><span> mai</span></span></p>\n<p><!--EndFragment-->"},"backgroundVariant":"transparent"};</script></div>
</section><div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
<p><a id="Silesian"></a></p>
</div></div></div><section class="Richtext__block">
<div id="ab40c467"><section class="_eq_qg_GewgPhGwcAzq8"><div class="j3a8ThoYc55mASLNSyjA"><div class="gU_G1Slvf8yBx2ryAztw"><div class="slJnKPGAAIKofsQwQBjL ZzhzXHPuPB7hJ0J9hHZ_"><picture><source sizes="(min-width: 1440px) 500px, (min-width: 768px) 33vw, 100vw" srcset="/contentassets/f90520c9569b405db14f9c458da205d0/kampus-770-x-3-1.jpg?width=375 375w, /contentassets/f90520c9569b405db14f9c458da205d0/kampus-770-x-3-1.jpg?width=500 500w, /contentassets/f90520c9569b405db14f9c458da205d0/kampus-770-x-3-1.jpg?width=768 768w"><img src="/contentassets/f90520c9569b405db14f9c458da205d0/kampus-770-x-3-1.jpg?width=500" loading="lazy"></picture></div><div class="wU_SjsF8OT2a75wibltn"><div class="XC3UYwLQI6HU5ecnktFV"><h3 class="tPC6boHRNBJEqwqOsqQR">Silesian University of Technology</h3><div class="RichtextContent _2jNkfmwAxq1ve9tHJyCg"><a href="https://www.polsl.pl/en/">Silesian University of Technology</a> er et universitet med emner innen bl.a. ledelse og markedsføring, og fjorten andre institutter og fakulteter. Det ligger nær Katowice, mellom Wroclaw og Krakow.&nbsp;<p></p>
<ul class="Richtext__ul">
<li><a href="/contentassets/f90520c9569b405db14f9c458da205d0/info_sheet2024-1-1-1.pdf" target="_blank" rel="noopener">Fact sheet</a></li>
<li><a href="https://www.polsl.pl/uczelnia/en/about-us/" target="_blank" rel="noopener">Les mer om universitetet</a></li>
<li><a href="https://www.polsl.pl/rn3-1-dwz-swm/en/" target="_blank" rel="noopener">Infoside Erasmus+</a></li>
</ul>
<p><span>Semesterinndelingen ved Silesian University of Technology er som følger:<br>- Vintersemesteret går fra september til februar<br>- Sommersemesteret går fra februar til juni</span></p></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['ab40c467-json'] = {"image":{"author":null,"caption":null,"url":"/contentassets/f90520c9569b405db14f9c458da205d0/kampus-770-x-3-1.jpg","alt":null,"focalPoint":null,"lazyLoading":true},"heading":"Silesian University of Technology","htmlText":{"value":"<a href=\"https://www.polsl.pl/en/\">Silesian University of Technology</a> er et universitet med emner innen bl.a. ledelse og markedsf&oslash;ring, og fjorten andre institutter og fakulteter. Det ligger n&aelig;r Katowice, mellom Wroclaw og Krakow.&nbsp;</p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/contentassets/f90520c9569b405db14f9c458da205d0/info_sheet2024-1-1-1.pdf\" target=\"_blank\" rel=\"noopener\">Fact sheet</a></li>\n<li><a href=\"https://www.polsl.pl/uczelnia/en/about-us/\" target=\"_blank\" rel=\"noopener\">Les mer om universitetet</a></li>\n<li><a href=\"https://www.polsl.pl/rn3-1-dwz-swm/en/\" target=\"_blank\" rel=\"noopener\">Infoside Erasmus+</a></li>\n</ul>\n<p><span>Semesterinndelingen ved Silesian University of Technology er som f&oslash;lger:<br />- Vintersemesteret g&aring;r fra september til februar<br />- Sommersemesteret g&aring;r fra februar til juni</span>"},"backgroundVariant":"transparent"};</script></div>
</section><div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
<p><a id="Lodz"></a></p>
</div></div></div><section class="Richtext__block">
<div id="18b38f3c"><section class="_eq_qg_GewgPhGwcAzq8"><div class="j3a8ThoYc55mASLNSyjA"><div class="gU_G1Slvf8yBx2ryAztw"><div class="slJnKPGAAIKofsQwQBjL ZzhzXHPuPB7hJ0J9hHZ_"><picture><source sizes="(min-width: 1440px) 500px, (min-width: 768px) 33vw, 100vw" srcset="/contentassets/87dcebf938f944b38704157a7b63b05b/wfl.jpg?width=375 375w, /contentassets/87dcebf938f944b38704157a7b63b05b/wfl.jpg?width=500 500w, /contentassets/87dcebf938f944b38704157a7b63b05b/wfl.jpg?width=768 768w"><img src="/contentassets/87dcebf938f944b38704157a7b63b05b/wfl.jpg?width=500" loading="lazy"></picture></div><div class="wU_SjsF8OT2a75wibltn"><div class="XC3UYwLQI6HU5ecnktFV"><h3 class="tPC6boHRNBJEqwqOsqQR">University of Lodz</h3><div class="RichtextContent _2jNkfmwAxq1ve9tHJyCg"><a href="https://www.uni.lodz.pl/en">University of Lodz</a> er det største universitetet i den sentrale delen av Polen. Byen Łódź er den tredje største byen, og samtidig hovedsenteret for tekstil- og filmindustrien samt elektronikk- og underholdningsbransjen i Polen. Her vil du ha muligheten til å besøke en av de lengste handlegatene i Europa, og oppleve byens museer og kulturelle scener. I tillegg vil du finne parker som <span>Łagiewniki Park og Manufaktura Park, som tilbyr en fin kontrast til byens travle gater.</span><p></p>
<ul class="Richtext__ul">
<li><a href="https://www.uni.lodz.pl/en/aboutus" target="_blank" rel="noopener">Informasjon om universitetet</a></li>
<li><a href="https://www.uni.lodz.pl/en/about-the-university/mission-vision-values-strategy" target="_blank" rel="noopener">Universitetets 'core values'</a></li>
<li><a href="/contentassets/87dcebf938f944b38704157a7b63b05b/unilodz_file_fact_unic.pdf" target="_blank" rel="noopener">University of Lodz brosjyre</a></li>
<li><a href="https://www.youtube.com/watch?v=dZbjM_R8Y_I" target="_blank" rel="noopener">presentasjonsvideo</a></li>
</ul>
<p>Semesterinndeling ved University of Lodz er som følger<br>- Vintersemesteret går fra 1. oktober - 25. februar<br>- Sommersemesteret går fra 26. februar - 30. september</p></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['18b38f3c-json'] = {"image":{"author":null,"caption":null,"url":"/contentassets/87dcebf938f944b38704157a7b63b05b/wfl.jpg","alt":null,"focalPoint":null,"lazyLoading":true},"heading":"University of Lodz","htmlText":{"value":"<a href=\"https://www.uni.lodz.pl/en\">University of Lodz</a> er det st&oslash;rste universitetet i den sentrale delen av Polen. Byen Ł&oacute;dź er den tredje st&oslash;rste byen, og samtidig hovedsenteret for tekstil- og filmindustrien samt elektronikk- og underholdningsbransjen i Polen. Her vil du ha muligheten til &aring; bes&oslash;ke en av de lengste handlegatene i Europa, og oppleve byens museer og kulturelle scener. I tillegg vil du finne parker som <span>Łagiewniki Park og Manufaktura Park, som tilbyr en fin kontrast til byens travle gater.</span></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"https://www.uni.lodz.pl/en/aboutus\" target=\"_blank\" rel=\"noopener\">Informasjon om universitetet</a></li>\n<li><a href=\"https://www.uni.lodz.pl/en/about-the-university/mission-vision-values-strategy\" target=\"_blank\" rel=\"noopener\">Universitetets 'core values'</a></li>\n<li><a href=\"/contentassets/87dcebf938f944b38704157a7b63b05b/unilodz_file_fact_unic.pdf\" target=\"_blank\" rel=\"noopener\">University of Lodz brosjyre</a></li>\n<li><a href=\"https://www.youtube.com/watch?v=dZbjM_R8Y_I\" target=\"_blank\" rel=\"noopener\">presentasjonsvideo</a></li>\n</ul>\n<p>Semesterinndeling ved University of Lodz er som f&oslash;lger<br />- Vintersemesteret g&aring;r fra 1. oktober - 25. februar<br />- Sommersemesteret g&aring;r fra 26. februar - 30. september"},"backgroundVariant":"transparent"};</script></div>
</section><div class="Richtext__wrapper"><div class="PageLayout__grid"><div class="Richtext__content PageLayout__content">
<p><a id="chopina"></a></p>
</div></div></div><section class="Richtext__block">
<div id="c3d21809"><section class="_eq_qg_GewgPhGwcAzq8"><div class="j3a8ThoYc55mASLNSyjA"><div class="gU_G1Slvf8yBx2ryAztw"><div class="slJnKPGAAIKofsQwQBjL ZzhzXHPuPB7hJ0J9hHZ_"><picture><source sizes="(min-width: 1440px) 500px, (min-width: 768px) 33vw, 100vw" srcset="/contentassets/0fb886f6ffef478b8306f24e5f88ce1c/1722452021_zdjecie-w-top.jpg?width=375 375w, /contentassets/0fb886f6ffef478b8306f24e5f88ce1c/1722452021_zdjecie-w-top.jpg?width=500 500w, /contentassets/0fb886f6ffef478b8306f24e5f88ce1c/1722452021_zdjecie-w-top.jpg?width=768 768w"><img src="/contentassets/0fb886f6ffef478b8306f24e5f88ce1c/1722452021_zdjecie-w-top.jpg?width=500" loading="lazy"></picture></div><div class="wU_SjsF8OT2a75wibltn"><div class="XC3UYwLQI6HU5ecnktFV"><h3 class="tPC6boHRNBJEqwqOsqQR">Uniwersytet Muzyczny Fryderyka Chopina</h3><div class="RichtextContent _2jNkfmwAxq1ve9tHJyCg"><a href="https://chopin.edu.pl/en" target="_blank" rel="noopener">Uniwersytet Muzyczny Fryderyka Chopina (UMFC)</a> er Polens eldste og største musikkutdanningsinstitusjon, etablert i 1810. Beliggende i sentrum av Warszawa, tilbyr UMFC et bredt spekter av studier innen klassisk musikk, komposisjon og dirigering.<p></p>
<ul class="Richtext__ul">
<li><a href="https://chopin.edu.pl/university/about-the-umfc" target="_blank" rel="noopener">Infoside om institusjonen</a></li>
<li><a href="https://www.youtube.com/watch?v=cIEy8K647ko" target="_blank" rel="noopener">Presentasjonsvideo</a></li>
</ul>
<p>Semesterinndelingen ved UMFC er som følger:&nbsp;<br>- Vintersemesteret går fra oktober - februar<br>- Sommersemesteret går fra februar - juni</p></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['c3d21809-json'] = {"image":{"author":null,"caption":null,"url":"/contentassets/0fb886f6ffef478b8306f24e5f88ce1c/1722452021_zdjecie-w-top.jpg","alt":null,"focalPoint":null,"lazyLoading":true},"heading":"Uniwersytet Muzyczny Fryderyka Chopina","htmlText":{"value":"<a href=\"https://chopin.edu.pl/en\" target=\"_blank\" rel=\"noopener\">Uniwersytet Muzyczny Fryderyka Chopina (UMFC)</a> er Polens eldste og st&oslash;rste musikkutdanningsinstitusjon, etablert i 1810. Beliggende i sentrum av Warszawa, tilbyr UMFC et bredt spekter av studier innen klassisk musikk, komposisjon og dirigering.</p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"https://chopin.edu.pl/university/about-the-umfc\" target=\"_blank\" rel=\"noopener\">Infoside om institusjonen</a></li>\n<li><a href=\"https://www.youtube.com/watch?v=cIEy8K647ko\" target=\"_blank\" rel=\"noopener\">Presentasjonsvideo</a></li>\n</ul>\n<p>Semesterinndelingen ved UMFC er som f&oslash;lger:&nbsp;<br />- Vintersemesteret g&aring;r fra oktober - februar<br />- Sommersemesteret g&aring;r fra februar - juni"},"backgroundVariant":"transparent"};</script></div>
