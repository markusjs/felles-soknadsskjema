<div id="d93d76c2"><section class="_eq_qg_GewgPhGwcAzq8"><div class="j3a8ThoYc55mASLNSyjA"><div class="gU_G1Slvf8yBx2ryAztw"><div class="slJnKPGAAIKofsQwQBjL ZzhzXHPuPB7hJ0J9hHZ_"><picture><source sizes="(min-width: 1440px) 500px, (min-width: 768px) 33vw, 100vw" srcset="/contentassets/f710932aa1ca4ed3a1bd05d4fb87e875/frankfurt.jpg?width=375 375w, /contentassets/f710932aa1ca4ed3a1bd05d4fb87e875/frankfurt.jpg?width=500 500w, /contentassets/f710932aa1ca4ed3a1bd05d4fb87e875/frankfurt.jpg?width=768 768w"><img src="/contentassets/f710932aa1ca4ed3a1bd05d4fb87e875/frankfurt.jpg?width=500" loading="lazy"></picture></div><div class="wU_SjsF8OT2a75wibltn"><div class="XC3UYwLQI6HU5ecnktFV"><h3 class="tPC6boHRNBJEqwqOsqQR">Frankfurt University of Applied Sciences</h3><div class="RichtextContent _2jNkfmwAxq1ve9tHJyCg"><a href="https://www.frankfurt-university.de/en/">Frankfurt University of Applied Sciences</a> har emner innen flere tekniske fag, bl.a. informasjonsteknologi.<p></p>
<ul class="Richtext__ul">
<li><a href="/contentassets/f710932aa1ca4ed3a1bd05d4fb87e875/fact-sheet_2020_21-uas-frankfurt.pdf" target="_blank" rel="noopener">Fact Sheet</a></li>
