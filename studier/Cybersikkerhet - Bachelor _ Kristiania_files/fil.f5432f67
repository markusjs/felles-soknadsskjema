<div id="858bac85"><section id="derfor-b-oslash-r-du-dra-p-aring-utveksling" class="cwjtYbGmpj2Fc0XguMNM"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF aZkJAbcjSQdYr77t8LV7">Derfor bør du dra på utveksling</h2><div class="zOMHtRvuigbQpkhq8l0i"><div class="FHwe9agruJdTg4dYFHN9"><div class="FktOVJkMpTVphR1rGeNp RichtextContent RichtextContent--light"><ol class="Richtext__ol">
<li><strong>Opplev andre kulturer</strong>: Utveksling gir deg muligheten til å oppleve en ny kultur.</li>
<li><strong>Personlig vekst</strong>: Å bo i et annet land utfordrer deg til å bli mer selvstendig, tilpasningsdyktig og selvsikker.</li>
<li><strong>Akademisk utvikling</strong>: Du får tilgang til unike studiemuligheter som kan berike din faglige kompetanse.</li>
<li><strong>Få venner fra hele verden</strong>: Du får sjansen til å knytte bånd med studenter fra hele verden og skape samarbeidsmuligheter for fremtiden.</li>
<li><strong>Lær språk</strong>: Å være omgitt av et fremmedspråk gir deg mulighet til å forbedre språkkunnskapene dine.</li>
</ol>
</div></div><div class="qB4kMuPluv5Id4WqPmfn"></div><div class="uMSWbISaLHTvPMbXhnYp"><div class="VNQ7BkWJFagCE_bBjsxQ ZLbmeOzjwEPCnL8UV8zG R1wh_51Fi_Crd9RnsQsw"><span class="FxrXNHIEItswETCvk14E" style="display:block"><span class="EwPhzUN1NfTBa1XOsTE6 TVMntCe8qkWIdDcQxQb6"></span></span></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['858bac85-json'] = {"id":"derfor-b-oslash-r-du-dra-p-aring-utveksling","title":{"value":"Derfor b&oslash;r du dra p&aring; utveksling"},"content":{"value":"<ol class=\"Richtext__ol\">\n<li><strong>Opplev andre kulturer</strong>: Utveksling gir deg muligheten til &aring; oppleve en ny kultur.</li>\n<li><strong>Personlig vekst</strong>: &Aring; bo i et annet land utfordrer deg til &aring; bli mer selvstendig, tilpasningsdyktig og selvsikker.</li>\n<li><strong>Akademisk utvikling</strong>: Du f&aring;r tilgang til unike studiemuligheter som kan berike din faglige kompetanse.</li>\n<li><strong>F&aring; venner fra hele verden</strong>: Du f&aring;r sjansen til &aring; knytte b&aring;nd med studenter fra hele verden og skape samarbeidsmuligheter for fremtiden.</li>\n<li><strong>L&aelig;r spr&aring;k</strong>: &Aring; v&aelig;re omgitt av et fremmedspr&aring;k gir deg mulighet til &aring; forbedre spr&aring;kkunnskapene dine.</li>\n</ol>\n"},"overlayTitle":null,"overlayContent":{"value":"<strong>Og ikke nok med det</strong>: Unders&oslash;kelser viser at utveksling bidrar til ferdigheter som har en positiv effekt p&aring; fremtidige jobbmuligheter. Ikke bare opparbeider du deg internasjonal erfaring &ndash; du viser ogs&aring; arbeidsgivere at du er nysgjerrig, fleksibel og selvstendig (<a href=\"https://op.europa.eu/en/publication-detail/-/publication/94d97f5c-7ae2-11e9-9f05-01aa75ed71a1\">Erasmus Impact Study</a><span>&nbsp;</span>fra<span>&nbsp;</span><a href=\"https://www.esn.org/erasmus-impact-study\">Erasmus Student Network</a>)."},"gobiStoryId":"4hdg2","imageFallback":null,"translations":{"openOverlay":"Flere grunner til å dra på utveksling","closeOverlay":"Lukk overlagg","openPlayer":"Åpne videospilleren","failedToLoadVideo":"Beklager, av en eller annen grunn kunne vi ikke laste inn en video"}};</script></div>
</section><section class="Richtext__block">

