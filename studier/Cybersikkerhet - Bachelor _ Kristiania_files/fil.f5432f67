<div id="1de4930a"><section class="cHJuzEmXmacjVj5xP6iZ mt6a75ovnlMLPE9Loln5"><div class="DXb3Ua5pMEXHHEWX1SA7"><div id="266c4bf2-fec7-4b3d-94a3-ea31d1cbdc57" class="DvegeScMnacdRemVyrm0"></div><h2 class="aiIhzQ_HVaul7y_AkKJm">Les om studenter på utveksling</h2><div class="XRp6wsxkeTvkZeQyXQxl"><ul class="oRspAuvbMi0pXLrX9u7q uVxmZbynFdMeBQDxj2Og"><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 768px) 70vw, 100vw" srcset="/contentassets/b421e13df1564463ac1fec0713be6a39/handstrykk-beskaret-versjon-2.jpg?width=500 500w, /contentassets/b421e13df1564463ac1fec0713be6a39/handstrykk-beskaret-versjon-2.jpg?width=768 768w, /contentassets/b421e13df1564463ac1fec0713be6a39/handstrykk-beskaret-versjon-2.jpg?width=1024 1024w, /contentassets/b421e13df1564463ac1fec0713be6a39/handstrykk-beskaret-versjon-2.jpg?width=1300 1300w"><img src="/contentassets/b421e13df1564463ac1fec0713be6a39/handstrykk-beskaret-versjon-2.jpg?width=500" alt="To kvinner gir hverandre et håndtrykk og smiler" style="object-position:21% 34%" loading="lazy"></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Utveksling</span><h3 class="qELDWCSeSJ1SDxUrtw0c">Kristiania samarbeider med Japan</h3><div class="kF4KqV8ac8a9rdoWGCg8">Ny samarbeids- og utvekslingsavtale med Japan University of Economics (JUE). </div></div><a href="/aktuelt/2026/09/kristiania-samarbeider-med-japan/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">Kristiania samarbeider med Japan</div></a></li><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/89febe4e9264474887ab6c8b9453ab8f/carl_joakim_gagnon.webp?width=375 375w, /contentassets/89febe4e9264474887ab6c8b9453ab8f/carl_joakim_gagnon.webp?width=500 500w, /contentassets/89febe4e9264474887ab6c8b9453ab8f/carl_joakim_gagnon.webp?width=768 768w, /contentassets/89febe4e9264474887ab6c8b9453ab8f/carl_joakim_gagnon.webp?width=1024 1024w"><img src="/contentassets/89febe4e9264474887ab6c8b9453ab8f/carl_joakim_gagnon.webp?width=500" alt="Portrett av Carl Joakim som står på campus" style="object-position:45% 36%" loading="lazy"></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Utveksling</span><h3 class="qELDWCSeSJ1SDxUrtw0c">Kristiania har fått økte Erasmus-midler til utveksling</h3><div class="kF4KqV8ac8a9rdoWGCg8">Kristiania har gode støtteordninger for de som ønsker å studere i utlandet.</div></div><a href="/aktuelt/2026/07/storre-erasmus-tildeling-gir-flere-studenter-mulighet-til-a-reise-pa-utveksling/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">Kristiania har fått økte Erasmus-midler til utveksling</div></a></li><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/5ed8092efb514366acee66e5116da182/untitled-design.jpeg?width=375 375w, /contentassets/5ed8092efb514366acee66e5116da182/untitled-design.jpeg?width=500 500w, /contentassets/5ed8092efb514366acee66e5116da182/untitled-design.jpeg?width=768 768w, /contentassets/5ed8092efb514366acee66e5116da182/untitled-design.jpeg?width=1024 1024w"><img src="/contentassets/5ed8092efb514366acee66e5116da182/untitled-design.jpeg?width=500" alt="Bilder av ulike steder i verden. Australia, Frankrike, Italia, Spania, England og Nederland. " style="object-position:48% 48%" loading="lazy"></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Utveksling</span><h3 class="qELDWCSeSJ1SDxUrtw0c">10 gode grunner til å dra på utveksling</h3><div class="kF4KqV8ac8a9rdoWGCg8">Dette er hvorfor du burde gjøre deg klar til å pakke kofferten!</div></div><a href="/aktuelt/10-gode-grunner-til-a-dra-pa-utveksling/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">10 gode grunner til å dra på utveksling</div></a></li><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/ca51484e8d994fd584cf7a8622cd0f01/pakke-til-utlandet.jpeg?width=375 375w, /contentassets/ca51484e8d994fd584cf7a8622cd0f01/pakke-til-utlandet.jpeg?width=500 500w, /contentassets/ca51484e8d994fd584cf7a8622cd0f01/pakke-til-utlandet.jpeg?width=768 768w, /contentassets/ca51484e8d994fd584cf7a8622cd0f01/pakke-til-utlandet.jpeg?width=1024 1024w"><img src="/contentassets/ca51484e8d994fd584cf7a8622cd0f01/pakke-til-utlandet.jpeg?width=500" alt="Joggesko, tjukke gensere, skjøteledning og pakkebokser ved siden av koffert. " style="object-position:52% 43%" loading="lazy"></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Utveksling</span><h3 class="qELDWCSeSJ1SDxUrtw0c">Dette bør du ta med deg på utveksling&nbsp;</h3><div class="kF4KqV8ac8a9rdoWGCg8">Pakk som en helt til et semester i utlandet!</div></div><a href="/aktuelt/dette-bor-du-ta-med-deg-pa-utveksling/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">Dette bør du ta med deg på utveksling&nbsp;</div></a></li><li class="LLzQvFszIj0jwBYa09Tw"><div class="SeJuexySANjxyiOM29ba"><div class="slJnKPGAAIKofsQwQBjL jUpUc0uR97EfldwPz00H"><picture><source sizes="(min-width: 1440px) 768px, (min-width: 768px) 50vw, 100vw" srcset="/contentassets/34b8cfbfcf8d49e589233516bbc0b6d2/friday-visit-to-roseslottet-students---edit.jpg?width=375 375w, /contentassets/34b8cfbfcf8d49e589233516bbc0b6d2/friday-visit-to-roseslottet-students---edit.jpg?width=500 500w, /contentassets/34b8cfbfcf8d49e589233516bbc0b6d2/friday-visit-to-roseslottet-students---edit.jpg?width=768 768w, /contentassets/34b8cfbfcf8d49e589233516bbc0b6d2/friday-visit-to-roseslottet-students---edit.jpg?width=1024 1024w"><img src="/contentassets/34b8cfbfcf8d49e589233516bbc0b6d2/friday-visit-to-roseslottet-students---edit.jpg?width=500" alt="Alejandra Caro Alcazar and Ateeq Riaz from Odisee University of Applied Sciences." style="object-position:52% 51%" loading="lazy"></picture></div></div><div class="WZDjz9zYQgsPRbumUD_v"><span class="AwtpKg9okCi1XkA7NreX">Utveksling</span><h3 class="qELDWCSeSJ1SDxUrtw0c">- Å være med på BIP har inspirert meg til å strebe etter positiv endring i verden.</h3><div class="kF4KqV8ac8a9rdoWGCg8">Kristiania var med på å arrangere det EU-finansierte Blended Intensive Programme (BIP). </div></div><a href="/aktuelt/2024/06/blended-intensive-programme-bip-2024/" class="PosterListRow__linkOverlay"><div class="visuallyHidden">- Å være med på BIP har inspirert meg til å strebe etter positiv endring i verden.</div></a></li></ul></div><div class="Il_qdxf2TN2nYj4Jn0mz"><div class="VQF0u2qRs2qtpyVLGNYs"><button type="button" class="NtmtjnwY8FdZxOUBkRwT YBPRkb9AIKTsMfnifn6d"><span>Vis flere</span><span class="SvgIcon cVzq0GUVWaVur9PebxdU"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-chevron-right"></use></svg></span></button></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['1de4930a-json'] = {"displayRows":[{"type":"oneLeftAndTwoOnTwoRight","itemsCount":5}],"posters":[{"id":"54e899b7-910b-4ac0-9d26-21286be703be","category":"Utveksling","title":{"value":"Kristiania samarbeider med Japan"},"text":{"value":"Ny samarbeids- og utvekslingsavtale med Japan University of Economics (JUE). "},"primaryLinkUrl":"/aktuelt/2026/09/kristiania-samarbeider-med-japan/","image":{"author":"Vibeche Klaveness/Høyskolen Kristiania","caption":"Rektor Asuka Tsuzuki ved Japan University of Economics (til venstre) og rektor Solfrid Lind ved Høyskolen Kristiania, hadde et hjertelig møte da den nye avtalen mellom de to institusjonene ble signer