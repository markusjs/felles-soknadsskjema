<div id="22578a42"><section id="ofte-stilte-spørsmål" class="B_EDxoOxVgAU8kPXBQWa"><h2 class="FrR9v_ssranAjR5kDzwF Lz7bstkpq5d6FanMqkLu">Ofte stilte spørsmål</h2><div class="XmC_S2INgPyqbncnXLoy XL4KGq1qGQz8WwtKJ_pg"><div class="YKYBQ3jDmxdtO9SEemuL"><div class="uJgrlGAPM7ozrDvgjXt0"><ul class="csX3C9e9jiZog4fiK1f5"><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__3579" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Hva slags utstyr trenger jeg?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__3579" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">Dette f&aring;r du vite n&aring;r du begynner p&aring; studiet. Vi anbefaler deg &aring; vente med &aring; skaffe utstyr til da.</div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__3580" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Kan jeg spesialisere meg?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__3580" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">P&aring; dette studiet har du i ditt andre studie&aring;r muligheten til &aring; enten dra p&aring; utveksling, eller et prosjektemne og et valgfritt emne p&aring; 15 studiepoeng.</div><div class="UuEJiQnPXE3nLUxfPzcq"><a href="/for-studenter/valgemner-og-praksis/valgemner/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn hk2sUgQrAH9UK8YJmMUQ Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Se studiets valgemner</div></a></div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__3581" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Kan jeg dra på utveksling?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__3581" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">I fjerde semester p&aring; dette studiet har du muligheten til &aring; s&oslash;ke om utveksling til disse samarbeidspartnerne i utlandet:</p>
<p><strong>Belgia</strong></p>
<ul class="Richtext__ul">
<li>Howest University</li>
</ul>
<p><strong>Danmark</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/danmark/#Zealand">Zealand Sj&aelig;llands Erhvervsakademi</a></li>
</ul>
<p><strong>Finland</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/finland/#TUA">Tampere University of Applied Sciences</a></li>
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/finland/#metro">Metropolia University of Applied Sciences</a>, Helsinki og omegn</li>
</ul>
<p><strong>Island</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/island/#UOR">Reykjavik University</a></li>
</ul>
<p><strong>Nederland</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/nederland/#Saxion">Saxion University of Applied Sciences</a></li>
</ul>
<p><strong>Polen</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/polen/?language=no#WSB">WSB University</a></li>
<li>Warsaw Management University</li>
</ul>
<p><strong>Pakistan</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/pakistan/">Superior University</a></li>
</ul>
<p><strong>Storbritannia</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/storbritannia/#Solent">Southampton Solent</a></li>
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/storbritannia/#Hertfordshire">University of Hertfordshire</a></li>
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/storbritannia/#Lincoln">University of Lincoln</a></li>
</ul>
<p><strong>Spania</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/spania/#BarcelonaTech">UPS-Barcelona Tech</a></li>
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/spania/#Granada">University of Granada</a></li>
</ul>
<p><strong>S&oslash;r-Korea</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/sor-korea/#seoul">Seoul National University of Science and Technology</a> (SeoulTech)</li>
</ul>
<p><strong>USA</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/usa/#SSU">Southern Utah University</a></li>
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/usa/#Stanislaus">California State University, Stanislaus</a></li>
</ul>
<p><strong>&Oslash;sterrike</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/osterrike/#Kufstein"><span>FH Kufstein Tirol University of Applied Sciences</span></a></li>
</ul>
<p><strong>&Aring;land</strong></p>
<ul class="Richtext__ul">
<li><a href="/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/aland/"><span>H&ouml;gskolan p&aring; &Aring;land</span></a></li>
</ul>
<p><strong>Institusjoner innen Norden og Baltikum&nbsp;</strong></p>
<ul class="Richtext__ul">
<li>I Norden og Baltikum kan du reise p&aring;<span>&nbsp;</span>EkoTekNord nettverket&nbsp;<br /><br /></li>
</ul></div><div class="UuEJiQnPXE3nLUxfPzcq"><a href="/for-studenter/studier-i-utlandet/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn hk2sUgQrAH9UK8YJmMUQ Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Les mer om å dra på utveksling </div></a></div></div></div></div></div></li><li><div class="zsrYitxhmI4Rdxl8AcId te60PfIJAvlwZ2RBbGqe o80VkuFKdpLspcd2K6XW"><button aria-expanded="false" aria-controls="AccordionItem__3582" type="button" class="NtmtjnwY8FdZxOUBkRwT GNG_gRf6Dl3NsaHoWAUO OyyOerhMVj5mV5WQNX5V xZxJs8W876NY1tCMuMwq UM1jfJqOS1COdaoBDFKC"><div class="YSRmfctHOQ5noBfQfMH5"><div class="DnD1xRazitrvmLCwsQvo"><h3 class="Y1lcLNcJwl0MgDDEuPIe">Hva kan jeg studere videre?</h3></div><span class="SvgIcon MFUfNtxb_KMTBmiHESl8"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus"></use></svg></span></div></button><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="ZgXVgEgkOVHpOr6mpnZu"><div id="AccordionItem__3582" class="pxYchGNIM3U95N_8sY2T"><div class="BcPDQdbKyOolxjjq14w1"><div class="RichtextContent">Bachelor i Cybersikkerhet gir mange gode muligheter til videre studier.</p>
<p>Det finnes relevante masterprogrammer innen IT, programvareutvikling, informasjonssystemer og informasjonssikkerhet ved flere universiteter i Norge.&nbsp;</p>
<p>Ved endt bachelorstudium kan du s&oslash;ke p&aring; masterprogram i <a href="/studier/master/cyber-security/">cybersikkerhet ved Kristiania</a>. Du kan ogs&aring; s&oslash;ke p&aring; mastergrad i utlandet. Dersom du har relevant erfaring, kan du ogs&aring; velge en erfaringsbasert mastergrad.</div><div class="UuEJiQnPXE3nLUxfPzcq"><a href="/studier/master/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn hk2sUgQrAH9UK8YJmMUQ Pf5HgbFCxXwoDDfyfLsp I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Se våre masterstudier</div></a></div></div></div></div></div></li></ul></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['22578a42-json'] = {"id":"ofte-stilte-spørsmål","heading":{"value":"Ofte stilte spørsmål"},"accordionItems":[{"id":"91001","displayName":"Hva slags utstyr trenger jeg?","introText":{"value":"Dette f&aring;r du vite n&aring;r du begynner p&aring; studiet. Vi anbefaler deg &aring; vente med &aring; skaffe utstyr til da."},"callToAction":null,"linkAsButton":false},{"id":"91002","displayName":"Kan jeg spesialisere meg?","introText":{"value":"P&aring; dette studiet har du i ditt andre studie&aring;r muligheten til &aring; enten dra p&aring; utveksling, eller et prosjektemne og et valgfritt emne p&aring; 15 studiepoeng."},"callToAction":{"label":"Se studiets valgemner","href":"/for-studenter/valgemner-og-praksis/valgemner/","external":false,"showIsExternal":true},"linkAsButton":true},{"id":"91003","displayName":"Kan jeg dra på utveksling?","introText":{"value":"I fjerde semester p&aring; dette studiet har du muligheten til &aring; s&oslash;ke om utveksling til disse samarbeidspartnerne i utlandet:</p>\n<p><strong>Belgia</strong></p>\n<ul class=\"Richtext__ul\">\n<li>Howest University</li>\n</ul>\n<p><strong>Danmark</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/danmark/#Zealand\">Zealand Sj&aelig;llands Erhvervsakademi</a></li>\n</ul>\n<p><strong>Finland</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/finland/#TUA\">Tampere University of Applied Sciences</a></li>\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/finland/#metro\">Metropolia University of Applied Sciences</a>, Helsinki og omegn</li>\n</ul>\n<p><strong>Island</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/island/#UOR\">Reykjavik University</a></li>\n</ul>\n<p><strong>Nederland</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/nederland/#Saxion\">Saxion University of Applied Sciences</a></li>\n</ul>\n<p><strong>Polen</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/polen/?language=no#WSB\">WSB University</a></li>\n<li>Warsaw Management University</li>\n</ul>\n<p><strong>Pakistan</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/pakistan/\">Superior University</a></li>\n</ul>\n<p><strong>Storbritannia</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/storbritannia/#Solent\">Southampton Solent</a></li>\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/storbritannia/#Hertfordshire\">University of Hertfordshire</a></li>\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/storbritannia/#Lincoln\">University of Lincoln</a></li>\n</ul>\n<p><strong>Spania</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/spania/#BarcelonaTech\">UPS-Barcelona Tech</a></li>\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/spania/#Granada\">University of Granada</a></li>\n</ul>\n<p><strong>S&oslash;r-Korea</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/sor-korea/#seoul\">Seoul National University of Science and Technology</a> (SeoulTech)</li>\n</ul>\n<p><strong>USA</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/usa/#SSU\">Southern Utah University</a></li>\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/usa/#Stanislaus\">California State University, Stanislaus</a></li>\n</ul>\n<p><strong>&Oslash;sterrike</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/osterrike/#Kufstein\"><span>FH Kufstein Tirol University of Applied Sciences</span></a></li>\n</ul>\n<p><strong>&Aring;land</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/aland/\"><span>H&ouml;gskolan p&aring; &Aring;land</span></a></li>\n</ul>\n<p><strong>Institusjoner innen Norden og Baltikum&nbsp;</strong></p>\n<ul class=\"Richtext__ul\">\n<li>I Norden og Baltikum kan du reise p&aring;<span>&nbsp;</span>EkoTekNord nettverket&nbsp;<br /><br /></li>\n</ul>"},"callToAction":{"label":"Les mer om å dra på utveksling ","href":"/for-studenter/studier-i-utlandet/","external":false,"showIsExternal":true},"linkAsButton":true},{"id":"116256","displayName":"Hva kan jeg studere videre?","introText":{"value":"Bachelor i Cybersikkerhet gir mange gode muligheter til videre studier.</p>\n<p>Det finnes relevante masterprogrammer innen IT, programvareutvikling, informasjonssystemer og informasjonssikkerhet ved flere universiteter i Norge.&nbsp;</p>\n<p>Ved endt bachelorstudium kan du s&oslash;ke p&aring; masterprogram i <a href=\"/studier/master/cyber-security/\">cybersikkerhet ved Kristiania</a>. Du kan ogs&aring; s&oslash;ke p&aring; mastergrad i utlandet. Dersom du har relevant erfaring, kan du ogs&aring; velge en erfaringsbasert mastergrad."},"callToAction":{"label":"Se våre masterstudier","href":"/studier/master/","external":false,"showIsExternal":true},"linkAsButton":true}]};</script></div>
