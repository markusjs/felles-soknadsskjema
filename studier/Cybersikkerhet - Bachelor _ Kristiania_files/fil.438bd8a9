tyle="object-position:51% 46%" loading="lazy"/></picture></div></div><div class="yMY00st3GGEGBJtEvQ73"><h3 class="c_Td561uP1rvuAN4AIF0"><a href="/aktuelt/2023/11/Na-kan-du-studere-Bachelor-i-cybersikkerhet-ved-Kristianias-Campus-Bergen/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><div>N&aring; kan du studere Bachelor i cybersikkerhet ved Kristianias Campus Bergen</div></div></a></h3><div class="jEZzvXBk9gXoSYGacZ1a"><span class="SvgIcon PVmLk9OPaS3teC0Olseh"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-n"></use></svg></span></div></div></div></li></ul></div></div></section><script>(window.__reactProps = window.__reactProps || {})['6887ee0f-json'] = {"id":"les-mer-om-våre-studenter","heading":{"value":"Les mer om våre studenter"},"teaser":null,"articles":[{"id":"75309","title":{"value":"Stian f&aring;r betalt for &aring; tenke som en hacker"},"description":{"value":"Stian Kvålshagen jobber med å beskytte systemer, lede team og bygge løsninger som faktisk blir brukt. "},"url":"/aktuelt/2026/04/stian-far-betalt-for-a-tenke-som-en-hacker/","image":{"author":"Jonatan Arvid Quintero","caption":"Stian gikk fra å drive bakeri til å bygge og sikre digitale løsninger. I dag gjør han komplekse sikkerhetsutfordringer forståelige og brukbare for andre.","url":"/contentassets/d79def7392874399b0f67b11effbbb56/microsoftteams-image-1.jpeg","alt":"Stian Kvålshagen avbildet utenfor Kristiania.","focalPoint":{"x":0.62,"y":0.28},"lazyLoading":true}},{"id":"116955","title":{"value":"Karine vil sikre samfunnet mot digitale angrep"},"description":{"value":"– Jeg kunne ikke stort om dette feltet før jeg begynte å studere, men jeg var veldig interessert i å lære, sier Karine som allerede har fått relevant jobb."},"url":"/aktuelt/2023/12/karine-vil-sikre-samfunnet-mot-digitale-angrep/","image":{"author":null,"caption":"Karine er på sporet av en lys fremtid: – Alt jeg har lært på studiet, spesielt i fagene Etisk Hacking, Cyberforsvar og Governance, Risk & Compliance, får jeg god bruk for i jobben. Utdanningen har gitt meg bred kunnskap gjennom alle emnene jeg har vært gjennom, og emnene bidrar på forskjellig måter til å gjøre meg rustet for rollen, sier hun. Foto: Pressworks/Kristiania. ","url":"/contentassets/2a6abccae3aa4c8dbbab1890c987bbce/l1060272.jpg","alt":"Karine Asperud står foran trikkeskinnene. Hun har langt, mellomblondt hår","focalPoint":{"x":0.29,"y":0.39},"lazyLoading":true}},{"id":"116272","title":{"value":"N&aring; kan du studere Bachelor i cybersikkerhet ved Kristianias Campus Bergen"},"description":{"value":"Arbeidslivet trenger titusener med denne kompetansen!"},"url":"/aktuelt/2023/11/Na-kan-du-studere-Bachelor-i-cybersikkerhet-ved-Kristianias-Campus-Bergen/","image":{"author":"Kristiania/Theodor Haugen","caption":"Tidligere Kristiania-student Amina Mujnovic jobber i dag i konsulentselskapet Deloitte med kollegaer og kunder på tvers av by- og landegrenser. – IT-kompetanse trengs i helsevesen, finans og egentlig overalt, forteller hun.","url":"/contentassets/84fc3289cc694a3dbb464a1821e5c0dd/amina_mujnovic_cyber-1.jpg","alt":"Portrett av Amina Mujnovic foran bylandskap.","focalPoint":{"x":0.51,"y":0.46},"lazyLoading":true}}]};</script></div>
