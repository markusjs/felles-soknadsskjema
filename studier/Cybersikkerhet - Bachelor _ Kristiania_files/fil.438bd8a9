<div id="17246d2e"><section id="nøkkelinformasjon" class="tDwjVFExbPlqwnaU86Wz"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF tNNRbfeiPsdi3j_gpC7k">Nøkkelinformasjon</h2><ul class="dE8scaebAaiVDo4BSvWD jQbeCSjNzeFEwKyP9FS0"><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Praksis</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Du kan s&oslash;ke om praksis i en bedrift som en del av denne utdanningen.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Utveksling</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Du kan s&oslash;ke om utveksling som en del av utdanningen. <a href="/studier/bachelor/cybersikkerhet/#ofte-stilte-spørsmål"><strong>Se hvor du kan dra nederst p&aring; siden!</strong></a></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-check-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Gjesteforelesere</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Har gjesteforelesere med relevant erfaring fra bransjen.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-error-circle"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Viktige frister</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">S&oslash;knadsfristen er forlenget. Opptaket fortsetter s&aring; lenge det er ledige plasser.</div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-user"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Opptakskrav</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">Du m&aring; innfri krav om <a href="/studere-hos-oss/opptaksinformasjon/#Studiekompetanse">generell studiekompetanse eller tilsvarende.</a></div></div></li><li class="iIoZpbf7rJjFaPayfYGd"><div class="i9mvzE2ZVt1U_mgl53yZ NBkadhPtSiaEbuC1H71t"><div class="_HPUHJNlNHRSzaUJfTVb"><span class="SvgIcon tA8I0a90PWzmxCh2AhM3"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-credit-card"></use></svg></span><h3 class="ecyElYvuOSSL_6pZBv9V">Pris</h3></div><div class="cZ1dIE6oJgjjufj0oSwG RichtextContent RichtextContent--dark">56 600 kr pr semester. Kvalifiserer til <a href="/studere-hos-oss/opptaksinformasjon/lanekassen/">st&oslash;tte fra L&aring;nekassen</a>.</div></div></li></ul><ul class="KdKtz5eB9ExUSDYJcdj8"><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Nivå"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-book"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Bachelor</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Oppstart"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-clock"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Høst 2026</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Gjennomføring"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-activity"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Heltid</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studiepoeng"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-award"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">180 studiepoeng</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studiested"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-map-pin"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Bergen og Oslo</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Studielengde"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-calendar"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">3 år</span></div></li><li><div class="QfpSu3R9osOn5mtmUmRN lgn5jtFtWmCfY3jJKvE1 _YiOaSqqzZqBucsGKGGx U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5" title="Språk"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-message-square"></use></svg></span><span class="usSRVYlqJnoDeG8iYItA">Norsk</span></div></li></ul></div></div></section><script>(window.__reactProps = window.__reactProps || {})['17246d2e-json'] = {"id":"nøkkelinformasjon","title":{"value":"Nøkkelinformasjon"},"facts":[{"title":{"value":"Praksis"},"icon":"check-circle","content":{"value":"Du kan s&oslash;ke om praksis i en bedrift som en del av denne utdanningen."}},{"title":{"value":"Utveksling"},"icon":"check-circle","content":{"value":"Du kan s&oslash;ke om utveksling som en del av utdanningen. <a href=\"/studier/bachelor/cybersikkerhet/#ofte-stilte-spørsmål\"><strong>Se hvor du kan dra nederst p&aring; siden!</strong></a>"}},{"title":{"value":"Gjesteforelesere"},"icon":"check-circle","content":{"value":"Har gjesteforelesere med relevant erfaring fra bransjen."}},{"title":{"value":"Viktige frister"},"icon":"error-circle","content":{"value":"S&oslash;knadsfristen er forlenget. Opptaket fortsetter s&aring; lenge det er ledige plasser."}},{"title":{"value":"Opptakskrav"},"icon":"user","content":{"value":"Du m&aring; innfri krav om <a href=\"/studere-hos-oss/opptaksinformasjon/#Studiekompetanse\">generell studiekompetanse eller tilsvarende.</a>"}},{"title":{"value":"Pris"},"icon":"credit-card","content":{"value":"56 600 kr pr semester. Kvalifiserer til <a href=\"/studere-hos-oss/opptaksinformasjon/lanekassen/\">st&oslash;tte fra L&aring;nekassen</a>."}}],"tags":[{"title":"Nivå","icon":"book","value":"Bachelor"},{"title":"Oppstart","icon":"clock","value":"Høst 2026"},{"title":"Gjennomføring","icon":"activity","value":"Heltid"},{"title":"Studiepoeng","icon":"award","value":"180 studiepoeng"},{"title":"Studiested","icon":"map-pin","value":"Bergen og Oslo"},{"title":"Studielengde","icon":"calendar","value":"3 år"},{"title":"Språk","icon":"message-square","value":"Norsk"}]};</script></div>
</div><div>
<div id="c1b28ffc"><section id="hva-lærer-du" class="cwjtYbGmpj2Fc0XguMNM"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF aZkJAbcjSQdYr77t8LV7">Hva lærer du?</h2><div class="zOMHtRvuigbQpkhq8l0i"><div class="FHwe9agruJdTg4dYFHN9"><div class="FktOVJkMpTVphR1rGeNp RichtextContent RichtextContent--light"><span>Har du tenkt over hvor s&aring;rbar den digitale verden er? </span>Med innf&oslash;ring av stadig flere digitale systemer &oslash;ker behovet for gode sikkerhetsl&oslash;sninger innen for eksempel str&oslash;mnettet, flytrafikk og banktjenester.</p>
<p>P&aring; Bachelor i cybersikkerhet l&aelig;rer du om:</p>
<ul class="Richtext__ul">
<li>hvordan beskytte data og applikasjoner mot trusler</li>
<li>&aring; teste systemers sikkerhet og hvordan forbedre dem</li>
<li>&aring; utvikle nye forsvar og metoder for &aring; sikre alt fra nettsider til databaser</li>
<li>programmering (introduksjon)</li>
</ul>
<p>Kristiania samarbeider tett med n&aelig;ringslivet. Du kan derfor forvente gjesteforelesere, praktiske workshops og forelesere med lang bransjeerfaring innen cybersikkerhet.&nbsp;&nbsp;</div><button title="Mer om undervisningen" aria-expanded="false" aria-controls="overlay_3563" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT f_wbJQigmJWOUtJRHvmX"><span class="visuallyHidden">Mer om undervisningen</span><span class="SvgIcon Kw06kOpEjKtbccDsYKVG"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus-circle"></use></svg></span></button><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_3563" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_3564"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_3564" class="visuallyHidden">Mer om undervisningen</span><h3 class="vGAYXQ8qVh3muyCADVi0">Mer om undervisningen</h3><div class="RichtextContent RichtextContent--dark"><span>N&aring;r hele kloden snakker sammen gjennom internett, &aring;pner det seg mange muligheter, men vi blir ogs&aring; mer s&aring;rbare.</span></p>
<p>V&aring;r cyber security-utdanning gir deg en unik innsikt i hvordan cybertrusler i dag p&aring;virker oss gjennom alt fra svindel av enkeltpersoner til nasjonal infrastruktur som elektrisitet og transport.&nbsp;</p>
<p><span>&Aring; jobbe med cybersikkerhet inneb&aelig;rer &aring; sikre IT-systemer mot angrep fra hackere, statsmakter og andre trusselakt&oslash;rer. Denne utdanningen l&aelig;rer deg hvordan du kan gj&oslash;re slike systemer sikrere.&nbsp;</span></p>
<p><strong>Fleksible studier</strong><br />Cybersikkerhet er ett av flere studier vi tilbyr innen informasjonsteknologi. Alle disse studiene har et felles f&oslash;rste &aring;r der du f&aring;r en grunnleggende innf&oslash;ring i IT, programmering og prosjektarbeid.</p>
<p>Dersom du ombestemmer deg, og &oslash;nsker &aring; spesialisere deg innen noe annet enn cybersikkerhet andre og tredje &aring;ret, kan du s&oslash;ke om &aring; bytte til <a href="/utdanning/teknologi-og-innovasjon/informasjonsteknologi-og-kunstig-intelligens/it-utdanning/">et annet studium innen informasjonsteknologi</a>.&nbsp;</div></div></div></div></div></div></div><div class="qB4kMuPluv5Id4WqPmfn"></div><div class="uMSWbISaLHTvPMbXhnYp"><div class="slJnKPGAAIKofsQwQBjL vPKYJ9xnnqorRitmkm3i R1wh_51Fi_Crd9RnsQsw"><picture><source sizes="(max-width: 767px) 100vw, (min-width: 768px) 552px" srcSet="/contentassets/f0bd0e81a0174bc28c01ee3398bd5ae8/roboter_studenter_teknologi-20.jpg?width=375 375w, /contentassets/f0bd0e81a0174bc28c01ee3398bd5ae8/roboter_studenter_teknologi-20.jpg?width=552 552w, /contentassets/f0bd0e81a0174bc28c01ee3398bd5ae8/roboter_studenter_teknologi-20.jpg?width=768 768w, /contentassets/f0bd0e81a0174bc28c01ee3398bd5ae8/roboter_studenter_teknologi-20.jpg?width=1536 1536w"/><img src="/contentassets/f0bd0e81a0174bc28c01ee3398bd5ae8/roboter_studenter_teknologi-20.jpg?width=552" alt="Studenter peker på skjerm." style="object-position:46% 51%" loading="lazy"/></picture></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['c1b28ffc-json'] = {"id":"hva-lærer-du","title":{"value":"Hva lærer du?"},"content":{"value":"<span>Har du tenkt over hvor s&aring;rbar den digitale verden er? </span>Med innf&oslash;ring av stadig flere digitale systemer &oslash;ker behovet for gode sikkerhetsl&oslash;sninger innen for eksempel str&oslash;mnettet, flytrafikk og banktjenester.</p>\n<p>P&aring; Bachelor i cybersikkerhet l&aelig;rer du om:</p>\n<ul class=\"Richtext__ul\">\n<li>hvordan beskytte data og applikasjoner mot trusler</li>\n<li>&aring; teste systemers sikkerhet og hvordan forbedre dem</li>\n<li>&aring; utvikle nye forsvar og metoder for &aring; sikre alt fra nettsider til databaser</li>\n<li>programmering (introduksjon)</li>\n</ul>\n<p>Kristiania samarbeider tett med n&aelig;ringslivet. Du kan derfor forvente gjesteforelesere, praktiske workshops og forelesere med lang bransjeerfaring innen cybersikkerhet.&nbsp;&nbsp;"},"overlayTitle":"Mer om undervisningen","overlayContent":{"value":"<span>N&aring;r hele kloden snakker sammen gjennom internett, &aring;pner det seg mange muligheter, men vi blir ogs&aring; mer s&aring;rbare.</span></p>\n<p>V&aring;r cyber security-utdanning gir deg en unik innsikt i hvordan cybertrusler i dag p&aring;virker oss gjennom alt fra svindel av enkeltpersoner til nasjonal infrastruktur som elektrisitet og transport.&nbsp;</p>\n<p><span>&Aring; jobbe med cybersikkerhet inneb&aelig;rer &aring; sikre IT-systemer mot angrep fra hackere, statsmakter og andre trusselakt&oslash;rer. Denne utdanningen l&aelig;rer deg hvordan du kan gj&oslash;re slike systemer sikrere.&nbsp;</span></p>\n<p><strong>Fleksible studier</strong><br />Cybersikkerhet er ett av flere studier vi tilbyr innen informasjonsteknologi. Alle disse studiene har et felles f&oslash;rste &aring;r der du f&aring;r en grunnleggende innf&oslash;ring i IT, programmering og prosjektarbeid.</p>\n<p>Dersom du ombestemmer deg, og &oslash;nsker &aring; spesialisere deg innen noe annet enn cybersikkerhet andre og tredje &aring;ret, kan du s&oslash;ke om &aring; bytte til <a href=\"/utdanning/teknologi-og-innovasjon/informasjonsteknologi-og-kunstig-intelligens/it-utdanning/\">et annet studium innen informasjonsteknologi</a>.&nbsp;"},"gobiStoryId":null,"imageFallback":{"author":null,"caption":null,"url":"/contentassets/f0bd0e81a0174bc28c01ee3398bd5ae8/roboter_studenter_teknologi-20.jpg","alt":"Studenter peker på skjerm.","focalPoint":{"x":0.46,"y":0.51},"lazyLoading":true},"translations":{"openOverlay":"Mer om undervisningen","closeOverlay":"Lukk overlagg","openPlayer":"Åpne videospilleren","failedToLoadVideo":"Beklager, av en eller annen grunn kunne vi ikke laste inn en video"}};</script></div>
</div><div>
<div id="a7027693"><section id="studiemodell" class="eXDLkCBTey4RjrTQSVwU"><div class="coBlOy78vCNQoCaBJMWq"><div class="fIm4MtcrG6MCKKd8iidQ"><h2 class="FrR9v_ssranAjR5kDzwF A9Jn0XOSrtngUTCr8gcL">Studiemodell</h2><div class="t78ozlVAuwJUrQItlgiY"><span class="IKcqvZpEOT2PNX0vgEn0">Studiemodellen er et utdrag av programbeskrivelsen. Den gir deg en oversikt over obligatoriske emner og hvilke muligheter du har for praksis, utveksling og spesialisering. Bachelorgraden går over tre studieår. Hvert studieår er delt opp i to semestre. Vi tar forbehold om endringer.</span></div></div></div><div class="DwbrqOYPLpXMxa_AUi5a"><div class="c4EHzShG0bxjcWsv1iba _jn80nJpcKPRabCSPcI8 o7i_4ji7xZ2pdim0DGGS r6PBO9Z23nGvfMtmlwMK dT6kOO1SWAAgm3_8NHMn"><div class="w6rdwzyeKdZC4QEQQdUG"><div class="FQnvPH3eSTnAU6bvrkhn"><div class="IbD8iYA8j6gRUkFt19Qt nUUm_USrpFGrNosOvcCN gXLqKND3fX0_VG9NQewb"><div role="tablist" class="_NQp5NLSF5eDFXAqjrMf" aria-label="Velg år"><button id="tab_1" role="tab" aria-selected="true" aria-controls="tabPanel_1" type="button" class="wSwA7V6mKnVhr5xFafzq Sqayds_IfbVRGAlPcZz1"><span class="bAoReRDLMgoAniQxqdep">Første år</span></button><button id="tab_2" role="tab" aria-selected="false" aria-controls="tabPanel_2" type="button" class="wSwA7V6mKnVhr5xFafzq"><span class="bAoReRDLMgoAniQxqdep">Andre år</span></button><button id="tab_3" role="tab" aria-selected="false" aria-controls="tabPanel_3" type="button" class="wSwA7V6mKnVhr5xFafzq"><span class="bAoReRDLMgoAniQxqdep">Tredje år</span></button></div></div><span class="FaaFQQsQ1uH8384yNffh">Totalt 180 studiepoeng</span></div><div id="tabPanel_1" class="xD2nuHiyJc0KNBTM5TWg" role="tabpanel" aria-labelledby="tab_1"><div class="XtdQZg9bKtEzGXT39oxb"><div style="will-change:height;overflow:hidden;visibility:hidden;height:0" class="wpyTqNTlEGsGZ_xfFehk BK3qq6WSy_IM14HivUP2"><div class="XjUXAnCLxrJU_S3Faibn km5O6Vr04dX9qXqlrGMV Wc0G2UOdAM4L2tA07AtA"><div id="comboSelect_id4252" class="bbDHU4_JdA0hl9MD1Lrq">Valgmuligheter:</div><fieldset aria-describedby="comboSelect_id4252"><div class="drG0qWE9kXwq4x52jnrJ"><div class="Sp19XW4DI_sJH0_4zvTF"><div class="PHAoRS_eP5FouDCPNKdY GhAWyApR_JjGprSMJ2rM yje2hGysH1zQf_D0GsA7 echijgywrVRRk64pe6Cg"><input type="radio" id="FormComponents__radio__4253" class="YfHgbQjwjs4O8VWhll1c" name="study-option-selector" checked="" value="Ordinært studieløp"/><label for="FormComponents__radio__4253" class="XTEgAUAWtLfl5XRg_bT7"><span class="yUjgOv16CeoVvFj3U4nh">Ordinært studieløp</span></label></div><div class="PHAoRS_eP5FouDCPNKdY GhAWyApR_JjGprSMJ2rM yje2hGysH1zQf_D0GsA7 echijgywrVRRk64pe6Cg"><input type="radio" id="FormComponents__radio__4254" class="YfHgbQjwjs4O8VWhll1c" name="study-option-selector" value="Ordinært studieløp"/><label for="FormComponents__radio__4254" class="XTEgAUAWtLfl5XRg_bT7"><span class="yUjgOv16CeoVvFj3U4nh">Utveksling</span></label></div></div></div></fieldset></div></div><span class="NPFkgrIiXfIBoY50mCiN">60 studiepoeng</span><div class="osNFPrEfj_WDLlms79Vw"><div class="gIhCJK5vlYW4N6yeTlUe C70d_1unGsLcavciTBWP g8GJRoyN3YYrck7buLCF" style="grid-template-columns:auto repeat(4, minmax(min-content, 1fr))"><div class="PVTUTdX7fee_uJTuRkiD ihFnGka9xDug5NPWFh0C"></div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY z7vhCTYrC3rO2VoUPlYT">1. semester</div><div class="PH6z9gi7b9kHBB9jOhSt nPbPqGrz5Ue0OKa68YnY _MLObcIsnBTnfP4F5AQg">2. semester</div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:3 / span 1;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_4255" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Introduksjon til programmering</span><span class="scgJDiGbZP69e6JD2e1j">PGR102</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">7,5<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_4255" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_4256"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_4256" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Introduksjon til programmering</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnets fokus er å gi studenten en første innføring i grunnleggende programmering. Studenten lærer blant annet om variabler, datatyper, løkker, betingelsessetninger, funksjoner, og bruk av DOM-funksjoner for å endre på HTML og CSS. Det fokuseres på å lage små applikasjoner for nettsider, på klientside, som tar i bruk av funksjoner. Emnet anvender kun ren JavaScript, det vil si gjør ikke bruk av biblioteker eller rammeverk.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 1;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_4257" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Databaser</span><span class="scgJDiGbZP69e6JD2e1j">DB1102</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">7,5<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_4257" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_4258"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_4258" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Databaser</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Etter å ha fullført emnet Databaser skal man kunne forklare hva en relasjonsdatabase er, hva den kan brukes til og hvordan den skiller seg fra andre former for lagring av data. Man skal kunne modellere og strukturere data for et domene. Man skal kunne opprette tabeller, legge inn ulike typer data i disse, kople tabellene sammen og hente ut data og gjøre endringer ved hjelp av SQL spørringer. Man skal kunne forklare og anvende prinsippene for godt databasedesign (normalisering, nøkkelbruk).</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:5 / span 1;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_4259" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Digital teknologi</span><span class="scgJDiGbZP69e6JD2e1j">TK1104</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">7,5<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_4259" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_4260"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_4260" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Digital teknologi</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>For å tilegne seg en grunnleggende digital allmenndannelse, må studenten forstå hvordan informasjon kodes digitalt, lagres, behandles og overføres mellom maskinvare og programvare. I dette emnet lærer studenten å analysere datasystemer på ulike nivåer, fra bit-nivå til digitale kretser og maskinvarekomponenter som CPU, minne og I/O-utstyr. Studenten vil også lære om operativsystemer, applikasjoner og nettverkskommunikasjon. Studenten skal kunne forklare hvordan binærtall representerer ulike typer informasjon og bruke modeller for å forstå systemer. Studenten vil også lære seg sentrale begreper for å kunne forstå og kommunisere om maskinvare og systemer. Dette hjelper studenten med å feilsøke både enkeltmaskiner og nettverkskommunikasjon effektivt.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:4 / span 1;grid-row:1"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_4261" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Kreativt webprosjekt</span><span class="scgJDiGbZP69e6JD2e1j">PRO105</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">7,5<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_4261" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_4262"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_4262" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Kreativt webprosjekt</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Studenten skal gjennom et prosjekt kunne benytte HTML- og CSS-teknikker for å kunne lage en interaktiv og kreativ løsning med animasjoner (CSS3-animasjon). Etter å ha fullført emnet skal studenten gjennom teamarbeid kunne utføre en kreativ prosess.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:3 / span 2;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_4263" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Objektorientert programmering</span><span class="scgJDiGbZP69e6JD2e1j">PGR112</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">15<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_4263" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_4264"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_4264" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Objektorientert programmering</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Emnet gir en innføring i objektorientert programmering. Objektorientert programmering gir vesentlige fordeler når man utvikler store og komplekse systemer, og gir derfor stor relevans for alle som skal delta i systemutviklingsprosjekter i samfunnet. Studenten vil gjennom emnet lære seg å definere og anvende spesialiseringer av klasser gjennom arv/interface/polymorfi. Studenten blir introdusert til noen sentrale begreper innen analyse og design ifm utvikling av objektorientert kode. Studenten vil mestre å kommunisere med en database ved hjelp av et objektorientert språk, og på den måten tilegne seg sentral kompetanse for lagring, endring og uthenting av data. Kommunikasjon med database vil være særlig relevant for studenter som går videre i studier innen systemutvikling.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:5 / span 1;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_4265" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Informasjonssikkerhet</span><span class="scgJDiGbZP69e6JD2e1j">TK2100</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">7,5<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_4265" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_4266"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_4266" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Informasjonssikkerhet</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Dagens trusselbilde er preget av stadig flere og mer avanserte angrep mot private og offentlige mål. Både organiserte cyberkriminelle og nasjonalstater ønsker å bruke det digitale domene til å utføre cyberangrep for økonomisk vinning eller for å ta kontroll over tredjeparts systemer. Bevissthet om de ulike truslene som finnes på internett er en forutsetning for å treffe riktige tiltak. Etter å ha fullført emnet skal studenten være i stand til å analysere trusselbildet og foreta egnede sikringstiltak på egen maskin, i hjemmenettverk og gi faglige råd i forhold til oppsett og teknologivalg for internetteksponerte systemer. Studenten skal ha oversikt over hvilke lover og forskrifter som gjelder for bruk av datamaskiner til lagring, prosessering og formidling av data, herunder personvern og opphavsrett. Studenten skal også ha innsikt i hvordan brukerbevissthet og brukeropplæring spiller en viktig rolle i informasjonssikkerhet.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="Ka1VIQ2BSAPjauIEHrxP" style="grid-column:2 / span 1;grid-row:3"><div role="none" class="jkzRoAa60jRsn7WFC38b W_ipeNxzDR7tVIgpSCZn" tabindex="-1"><h3 class="YG1nlAZdhHLMRy9GYzR4"><button aria-expanded="false" aria-controls="overlay_4267" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT H8BBXS4M_AkAanZLMEqS"><div class="Lv5sVd5u45Hei4dM91D6"><span class="cLkCE07zhLnMWRjri1dT">Etikk, samfunnsansvar og bærekraft</span><span class="scgJDiGbZP69e6JD2e1j">ESB1100</span></div></button></h3><div class="k1UzcGuDdqoVJEx_3umq"><div class="QfpSu3R9osOn5mtmUmRN AK7QRdIj4UViy_jglQrq jno52DfczcFYoXwAJOAu U9uDXh99G9DWi_Yh96aO EPjsXy4Ah89AtUfpopbN Iga6BKVCOIbIKJLg1wb5 RNsXkIAukZjr8f4x_HXA iFv6rrcS3ouLeLPVmLv7">7,5<!-- --> <!-- -->stp.</div></div></div><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_4267" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_4268"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_4268" class="visuallyHidden">Åpne emneoverlegg</span><div><h3 class="E3lyE2pUr4JODpEYbHMe">Etikk, samfunnsansvar og bærekraft</h3><div class="vyo8UTe2MiSR4m0iLBYR">
<p>Kunnskap om etikk, samfunnsansvar og bærekraft er viktig både for å ta etisk funderte beslutninger og fordi organisasjoners omdømme og lønnsomhet er knyttet til deres sosiale og miljømessige resultater. Dette emnet gir en grunnleggende innføring i problemstillinger, teori og verktøy innen etikk, samfunnsansvar og bærekraft. Sentrale temaer i emnet er etisk teori, etiske dilemmaer, interessentteori, miljø og bærekraft, og bedrifters samfunnsansvar.</p>
</div><div class="iCNqjCRL4lMHUFqVaQaB"><button disabled="" type="button" class="yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk Pf5HgbFCxXwoDDfyfLsp cJMgeHEGyMPOPNoeRPfY I0dQ9KoNo8oj51pfedVE yWrwquZkc56N0bYjqb7s"><span>Les mer</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div></div></div></div></div></div><div class="hUrOK4f2t5d89i_al5eu _jBcyRZzOe6QMtbojFs5"></div></div></div></div></div><div class="_qtIUhem1sc1EKjP4UhQ"><div id="tabPanel_2" role="tabpanel" aria-labelledby="tab_2"><ul><li><span>CYB2100</span><span>Cyberforsvar</span><div>
<p>Cyber Defense inkluderer mekanismer og ferdigheter for å forhindre at datasystemer og ulike enheter blir angrepet og utnyttet av hackere og lignende aktører. Etter å ha fullført emnet skal studenten kunne forstå hvordan IT systemer sikres gjennom sikkerhetsverktøy og metoder, overvåkning og hendelseshåndtering. Studentene skal lære hvordan man jobber med sikring av systemer, hendelseshåndtering og etterforskning knyttet til kompromitterte systemer. Man skal kunne forklare og anvende prinsippene for sikker design og arkitektur, og se dette fra en forsvarers synspunkt. </p>
</div></li><li><span>ETH2100</span><span>Etisk hacking</span><div>
<p>Etisk hacking er metoden som brukes av autorisert personell for å omgå systemets sikkerhet for å identifisere potensielle datainnbrudd og trusler i et nettverk. Dette emnet handler om hvordan du tenker som en angriper for å finne svake punkter i infrastrukturen. Etter å fullført emnet Etisk Hacking skal man forstå hvordan simulerte angrep og offensive tester brukes for å styrke sikkerheten i et system eller program. Studentene skal kunne gjennomføre penetrasjonstester av web-applikasjoner for å avdekke sårbarheter, og man skal kunne vurdere og teste et nettverk eller et helt selskap for svakheter som kan utnyttes av en ondsinnet hacker. Man skal kunne forklare og anvende prinsippene for sikker design og arkitektur, og se dette fra en angripers synspunkt. </p>
</div></li><li><span>SKY2100</span><span>Skysikkerhet</span><div>
<p>Skytjenester har blitt kjernen i den moderne digitaliserte infrastrukturen. Med det økende antallet av nettangrep, må man orkestrere og etablere skytjenester på en sikker måte. Etter å ha fullført emnet Skysikkerhet skal studenten kunne forstå hvordan skytjenester sikres. Man skal kunne planlegge, installere og konfigurere en skybasert løsning, med sikkerhet som en grunnsten gjennom hele prosessen. Man skal kunne forklare og anvende prinsippene for sikker design og arkitektur, og se dette fra et skyperspektiv. </p>
</div></li><li><span>ØA1005</span><span>Problemløsning i TEAM</span><div>
<p><strong>Problemløsning i TEAM</strong> - <strong>T</strong>verrfaglig, <strong>E</strong>ngasjerende, <strong>A</strong>rbeid i prosjekt, med <strong>M</strong>estring</p><p>Dette kurset tilbyr en tverrfaglig læringsopplevelse der studentene jobber i team for å håndtere virkelige utfordringer i skjæringspunktet mellom økonomi, innovasjon og teknologi. Gjennom en problembasert læringstilnærming (PBL) går studentene gjennom en strukturert prosess med problemdefinisjon, prosjektskisse, utvikling, evaluering og presentasjon.</p><p>Organisert i temabaserte camps, hver ledet av faglige eksperter, samarbeider studentene på tvers av fagbakgrunn for å analysere, undersøke og utvikle løsninger, forstått som funderte forslag, modeller, konsepter eller tiltak som kan bidra til bedre praksis, innovasjon eller bærekraftige endringer innenfor temaet de arbeider med. Roterende lederroller og strukturerte leveranser sikrer aktiv deltakelse og ansvarlighet gjennom hele prosjektet.</p><p>Kurset vektlegger teamarbeid, kritisk tenkning, problemløsning, ansvarlig innovasjon og evnen til å kommunisere komplekse ideer. Ved slutten av semesteret vil studentene ikke bare ha styrket sin teoretiske forståelse innenfor økonomi, innovasjon eller teknologi sine kjernefelt, men også tilegnet seg praktiske ferdigheter i prosjektledelse, relasjonsbygging, refleksjon og løsningsorientert samarbeid - noe som forbereder dem på å bidra meningsfullt til næringsliv og samfunn.</p>
</div></li><li><span>UTV999BA30</span><span>Utveksling</span><div></div></li><li><span>VAL999-15V</span><span>Valgemne eller praksis</span><div></div></li></ul></div><div id="tabPanel_3" role="tabpanel" aria-labelledby="tab_3"><ul><li><span>BAO304</span><span>Bachelorprosjekt</span><div>
<p>I dette emnet har studentene mulighet for at opnå yrkeserfaring ved å gjennomføre et IT-prosjekt i en bedrift. Studentene skal demonstrere bred kunnskap om sentrale temaer og teorier, samt vise ferdigheter i metode, bruk av verktøy og teknologier innenfor fagområdet. Prosjektet gjennomføres i grupper og resultatet av arbeidet dokumenteres i en prosjektrapport. Prosjektleveransen defineres og utvikles i samråd med klienten, samt at studentene følges opp av en intern veileder ved Kristiania. Dette emnet bygger også på tidligere emner i bachelorløpet, i form av blant annet kunnskap om utviklingsmetoder, risikohåndtering, prosjektarbeid og prosjektstyring. Utover dette må også studentene regne med å sette seg inn i ny kunnskap relatert til prosjektet de skal gjennomføre. Det kan være knyttet til bruk av programmeringsspråk, metode eller programvare. Emnet har en sterk arbeidslivsrelevans og studentene får reell og nyttig arbeidserfaring i løpet av prosjektperioden.</p>
</div></li><li><span>GRC1100</span><span>Governance, Risk and Compliance</span><div>
<p>Etter å ha fullført emnet Governance, risk & compliance (GRC) skal man kunne forstå sentrale konsepter og prosesser som bidrar til god eier- og virksomhetsstyring (Governance). Man vil lære hvordan risikostyring og compliance krav bidrar til god governance og hvordan GRC styrker måloppnåelse og samtidig kontrollerer og styrer sikkerhetsarbeidet i organisasjonen/selskapet. Man skal kunne forklare og anvende prinsippene innen GRC i en cybersikkerhet sammenheng, samt forstå hvordan cybersikkerhet spiller inn i den store sammenhengen og samspillet mellom IT, ansatte, ledelse og eiere av organisasjonen/selskapet.</p>
</div></li><li><span>IOS3100</span><span>IoT/OT sikkerhet</span><div>
<p>Etter å fullført emnet IoT/OT sikkerhet skal studenten kunne forstå hvordan IoT (Internet of Things) og OT (Operasjonell Teknologi) virker inn på informasjonssikkerhet, både på individ og samfunnsnivå. Fremveksten av Internet of Things medfører at mange flere enheter kobles til og blir tilgjengelig fra Internett, dette gjelder alt fra kjøkkenutstyr i hjemmet og til livskritisk medisinsk utstyr i helsesektoren. Tidligere var dette isolerte komponenter - men som nå er koblet til store skyløsninger og kan styres av brukerne via Internett. Samtidig har Operasjonell Teknologi, som styrer strømnett, fabrikker og annen infrastruktur, i økende grad blitt koblet direkte eller indirekte til Internett. Kombinasjonen av disse to samfunnsendringene vil ha stor påvirkning for oss alle de neste tiårene, og studenten vil gjennom dette emnet forstå både sikkerhetsproblematikk og hvordan vi kan sikre dette på best mulig måte. Man skal kunne forklare og anvende prinsippene for sikker design og arkitektur, og se dette fra et IoT og OT-synspunkt.</p>
</div></li><li><span>IT2000</span><span>KI-drevet smidig prosjekt</span><div>
<p>Hensikten med emnet er å gi studenten en dypere erfaring i å mestre helheten i et større prosjekt med støtte av kunstig intelligens (KI), med vekt på bruk av smidig metode spesielt egnet for programvareutvikling. Gjennom en prosess for utvikling av en teknisk løsning skal studenten planlegge og gjennomføre en omfattende prosjektcase for en bedrift i en tverrfaglig gruppe, og vil få trening i å bruke moderne agile teknikker og KI-verktøy underveis som støtter prosessen knyttet til blant annet estimering, utvikling, backlog prioritering, avdekke motstridende krav og produsere prosjektrapporter.</p>
</div></li><li><span>PJ6100</span><span>Undersøkelsesmetoder</span><div>
<p>Emnet skal gjøre studenten kjent med strategier og metoder med særlig vekt på undersøkelser som har relevans for informasjonsteknologibransjen. Forskningsundersøkelser er en syklisk prosess der tilnærminger er justert og raffinert over tid.</p><p>Målet med dette emnet er å gi studentene en grunnleggende forståelse av forskning som en konseptuell, empirisk og praktisk tilnærming til å samle ny innsikt og kunnskap innen informasjonsteknologi. Undervisningen fokuserer på anvendt forskning innen informasjonssystemer og informatikk og presenterer studentene for relevante metoder fra dette domenet, sammen med deres muligheter og begrensninger. </p><p>Emnet er et støtteemne til bachelorprosjektet, primært i forhold til utvikling av undersøkelsesstrategi, anvendelse av hensiktsmessige metoder for datainnsamling og rapportskriving.</p>
</div></li></ul></div></div></div></div></div><div class="lv4eNMiZgLixMXhAvacD"><a href="/studieportal/fakultet-for-helse-og-teknologi/bachelorniva/bcs/bachelor-i-cybersikkerhet/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 AMdryBi_G8WFVbcuUzSv LVwfmt8Qy2xfZW7GrHx_ I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY SwVWunM8J0KL5d8Ov54G" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi">Se programbeskrivelse</div></a></div></section><script>(window.__reactProps = window.__reactProps || {})['a7027693-json'] = {"heading":{"value":"Studiemodell"},"getSubjectInfoUrl":"/api/study-pages/58427/subjects-info-url","overlayContentMessages":{"outdated":{"heading":"Med forbehold om endringer","message":null,"variant":"info"},"fallback":{"heading":"Emnebeskrivelse kommer snart","message":{"value":"<span>Ved Kristiania utvikler vi studiene v&aring;re i samarbeid med arbeidslivet. Derfor oppdaterer vi emnene jevnlig, slik at du f&aring;r kompetansen som arbeidsgiverne ser etter. Snart kan du lese alt om dette emnet her, inntil da finner du mer informasjon i studieprogrambeskrivelsen.</span>"},"variant":"info"}},"subjects":[{"code":"BAO304","name":"Bachelorprosjekt","description":"\n<p>I dette emnet har studentene mulighet for at opnå yrkeserfaring ved å gjennomføre et IT-prosjekt i en bedrift. Studentene skal demonstrere bred kunnskap om sentrale temaer og teorier, samt vise ferdigheter i metode, bruk av verktøy og teknologier innenfor fagområdet. Prosjektet gjennomføres i grupper og resultatet av arbeidet dokumenteres i en prosjektrapport. Prosjektleveransen defineres og utvikles i samråd med klienten, samt at studentene følges opp av en intern veileder ved Kristiania. Dette emnet bygger også på tidligere emner i bachelorløpet, i form av blant annet kunnskap om utviklingsmetoder, risikohåndtering, prosjektarbeid og prosjektstyring. Utover dette må også studentene regne med å sette seg inn i ny kunnskap relatert til prosjektet de skal gjennomføre. Det kan være knyttet til bruk av programmeringsspråk, metode eller programvare. Emnet har en sterk arbeidslivsrelevans og studentene får reell og nyttig arbeidserfaring i løpet av prosjektperioden.</p>\n","isDescriptionOutdated":false,"order":52,"points":22.5,"year":3,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"CYB2100","name":"Cyberforsvar","description":"\n<p>Cyber Defense inkluderer mekanismer og ferdigheter for å forhindre at datasystemer og ulike enheter blir angrepet og utnyttet av hackere og lignende aktører. Etter å ha fullført emnet skal studenten kunne forstå hvordan IT systemer sikres gjennom sikkerhetsverktøy og metoder, overvåkning og hendelseshåndtering. Studentene skal lære hvordan man jobber med sikring av systemer, hendelseshåndtering og etterforskning knyttet til kompromitterte systemer. Man skal kunne forklare og anvende prinsippene for sikker design og arkitektur, og se dette fra en forsvarers synspunkt. </p>\n","isDescriptionOutdated":true,"order":33,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"DB1102","name":"Databaser","description":"\n<p>Etter å ha fullført emnet Databaser skal man kunne forklare hva en relasjonsdatabase er, hva den kan brukes til og hvordan den skiller seg fra andre former for lagring av data. Man skal kunne modellere og strukturere data for et domene. Man skal kunne opprette tabeller, legge inn ulike typer data i disse, kople tabellene sammen og hente ut data og gjøre endringer ved hjelp av SQL spørringer. Man skal kunne forklare og anvende prinsippene for godt databasedesign (normalisering, nøkkelbruk).</p>\n","isDescriptionOutdated":false,"order":12,"points":7.5,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"ESB1100","name":"Etikk, samfunnsansvar og bærekraft","description":"\n<p>Kunnskap om etikk, samfunnsansvar og bærekraft er viktig både for å ta etisk funderte beslutninger og fordi organisasjoners omdømme og lønnsomhet er knyttet til deres sosiale og miljømessige resultater. Dette emnet gir en grunnleggende innføring i problemstillinger, teori og verktøy innen etikk, samfunnsansvar og bærekraft. Sentrale temaer i emnet er etisk teori, etiske dilemmaer, interessentteori, miljø og bærekraft, og bedrifters samfunnsansvar.</p>\n","isDescriptionOutdated":false,"order":23,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"ETH2100","name":"Etisk hacking","description":"\n<p>Etisk hacking er metoden som brukes av autorisert personell for å omgå systemets sikkerhet for å identifisere potensielle datainnbrudd og trusler i et nettverk. Dette emnet handler om hvordan du tenker som en angriper for å finne svake punkter i infrastrukturen. Etter å fullført emnet Etisk Hacking skal man forstå hvordan simulerte angrep og offensive tester brukes for å styrke sikkerheten i et system eller program. Studentene skal kunne gjennomføre penetrasjonstester av web-applikasjoner for å avdekke sårbarheter, og man skal kunne vurdere og teste et nettverk eller et helt selskap for svakheter som kan utnyttes av en ondsinnet hacker. Man skal kunne forklare og anvende prinsippene for sikker design og arkitektur, og se dette fra en angripers synspunkt. </p>\n","isDescriptionOutdated":true,"order":31,"points":15,"year":2,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"GRC1100","name":"Governance, Risk and Compliance","description":"\n<p>Etter å ha fullført emnet Governance, risk & compliance (GRC) skal man kunne forstå sentrale konsepter og prosesser som bidrar til god eier- og virksomhetsstyring (Governance). Man vil lære hvordan risikostyring og compliance krav bidrar til god governance og hvordan GRC styrker måloppnåelse og samtidig kontrollerer og styrer sikkerhetsarbeidet i organisasjonen/selskapet. Man skal kunne forklare og anvende prinsippene innen GRC i en cybersikkerhet sammenheng, samt forstå hvordan cybersikkerhet spiller inn i den store sammenhengen og samspillet mellom IT, ansatte, ledelse og eiere av organisasjonen/selskapet.</p>\n","isDescriptionOutdated":true,"order":51,"points":15,"year":3,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"IOS3100","name":"IoT/OT sikkerhet","description":"\n<p>Etter å fullført emnet IoT/OT sikkerhet skal studenten kunne forstå hvordan IoT (Internet of Things) og OT (Operasjonell Teknologi) virker inn på informasjonssikkerhet, både på individ og samfunnsnivå. Fremveksten av Internet of Things medfører at mange flere enheter kobles til og blir tilgjengelig fra Internett, dette gjelder alt fra kjøkkenutstyr i hjemmet og til livskritisk medisinsk utstyr i helsesektoren. Tidligere var dette isolerte komponenter - men som nå er koblet til store skyløsninger og kan styres av brukerne via Internett. Samtidig har Operasjonell Teknologi, som styrer strømnett, fabrikker og annen infrastruktur, i økende grad blitt koblet direkte eller indirekte til Internett. Kombinasjonen av disse to samfunnsendringene vil ha stor påvirkning for oss alle de neste tiårene, og studenten vil gjennom dette emnet forstå både sikkerhetsproblematikk og hvordan vi kan sikre dette på best mulig måte. Man skal kunne forklare og anvende prinsippene for sikker design og arkitektur, og se dette fra et IoT og OT-synspunkt.</p>\n","isDescriptionOutdated":true,"order":52,"points":7.5,"year":3,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"IT2000","name":"KI-drevet smidig prosjekt","description":"\n<p>Hensikten med emnet er å gi studenten en dypere erfaring i å mestre helheten i et større prosjekt med støtte av kunstig intelligens (KI), med vekt på bruk av smidig metode spesielt egnet for programvareutvikling. Gjennom en prosess for utvikling av en teknisk løsning skal studenten planlegge og gjennomføre en omfattende prosjektcase for en bedrift i en tverrfaglig gruppe, og vil få trening i å bruke moderne agile teknikker og KI-verktøy underveis som støtter prosessen knyttet til blant annet estimering, utvikling, backlog prioritering, avdekke motstridende krav og produsere prosjektrapporter.</p>\n","isDescriptionOutdated":false,"order":53,"points":7.5,"year":3,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"PGR102","name":"Introduksjon til programmering","description":"\n<p>Emnets fokus er å gi studenten en første innføring i grunnleggende programmering. Studenten lærer blant annet om variabler, datatyper, løkker, betingelsessetninger, funksjoner, og bruk av DOM-funksjoner for å endre på HTML og CSS. Det fokuseres på å lage små applikasjoner for nettsider, på klientside, som tar i bruk av funksjoner. Emnet anvender kun ren JavaScript, det vil si gjør ikke bruk av biblioteker eller rammeverk.</p>\n","isDescriptionOutdated":false,"order":11,"points":7.5,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"PGR112","name":"Objektorientert programmering","description":"\n<p>Emnet gir en innføring i objektorientert programmering. Objektorientert programmering gir vesentlige fordeler når man utvikler store og komplekse systemer, og gir derfor stor relevans for alle som skal delta i systemutviklingsprosjekter i samfunnet. Studenten vil gjennom emnet lære seg å definere og anvende spesialiseringer av klasser gjennom arv/interface/polymorfi. Studenten blir introdusert til noen sentrale begreper innen analyse og design ifm utvikling av objektorientert kode. Studenten vil mestre å kommunisere med en database ved hjelp av et objektorientert språk, og på den måten tilegne seg sentral kompetanse for lagring, endring og uthenting av data. Kommunikasjon med database vil være særlig relevant for studenter som går videre i studier innen systemutvikling.</p>\n","isDescriptionOutdated":false,"order":21,"points":15,"year":1,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"PJ6100","name":"Undersøkelsesmetoder","description":"\n<p>Emnet skal gjøre studenten kjent med strategier og metoder med særlig vekt på undersøkelser som har relevans for informasjonsteknologibransjen. Forskningsundersøkelser er en syklisk prosess der tilnærminger er justert og raffinert over tid.</p><p>Målet med dette emnet er å gi studentene en grunnleggende forståelse av forskning som en konseptuell, empirisk og praktisk tilnærming til å samle ny innsikt og kunnskap innen informasjonsteknologi. Undervisningen fokuserer på anvendt forskning innen informasjonssystemer og informatikk og presenterer studentene for relevante metoder fra dette domenet, sammen med deres muligheter og begrensninger. </p><p>Emnet er et støtteemne til bachelorprosjektet, primært i forhold til utvikling av undersøkelsesstrategi, anvendelse av hensiktsmessige metoder for datainnsamling og rapportskriving.</p>\n","isDescriptionOutdated":false,"order":51,"points":7.5,"year":3,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"PRO105","name":"Kreativt webprosjekt","description":"\n<p>Studenten skal gjennom et prosjekt kunne benytte HTML- og CSS-teknikker for å kunne lage en interaktiv og kreativ løsning med animasjoner (CSS3-animasjon). Etter å ha fullført emnet skal studenten gjennom teamarbeid kunne utføre en kreativ prosess.</p>\n","isDescriptionOutdated":false,"order":14,"points":7.5,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"SKY2100","name":"Skysikkerhet","description":"\n<p>Skytjenester har blitt kjernen i den moderne digitaliserte infrastrukturen. Med det økende antallet av nettangrep, må man orkestrere og etablere skytjenester på en sikker måte. Etter å ha fullført emnet Skysikkerhet skal studenten kunne forstå hvordan skytjenester sikres. Man skal kunne planlegge, installere og konfigurere en skybasert løsning, med sikkerhet som en grunnsten gjennom hele prosessen. Man skal kunne forklare og anvende prinsippene for sikker design og arkitektur, og se dette fra et skyperspektiv. </p>\n","isDescriptionOutdated":true,"order":32,"points":7.5,"year":2,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"TK1104","name":"Digital teknologi","description":"\n<p>For å tilegne seg en grunnleggende digital allmenndannelse, må studenten forstå hvordan informasjon kodes digitalt, lagres, behandles og overføres mellom maskinvare og programvare. I dette emnet lærer studenten å analysere datasystemer på ulike nivåer, fra bit-nivå til digitale kretser og maskinvarekomponenter som CPU, minne og I/O-utstyr. Studenten vil også lære om operativsystemer, applikasjoner og nettverkskommunikasjon. Studenten skal kunne forklare hvordan binærtall representerer ulike typer informasjon og bruke modeller for å forstå systemer. Studenten vil også lære seg sentrale begreper for å kunne forstå og kommunisere om maskinvare og systemer. Dette hjelper studenten med å feilsøke både enkeltmaskiner og nettverkskommunikasjon effektivt.</p>\n","isDescriptionOutdated":false,"order":13,"points":7.5,"year":1,"semester":"first","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"TK2100","name":"Informasjonssikkerhet","description":"\n<p>Dagens trusselbilde er preget av stadig flere og mer avanserte angrep mot private og offentlige mål. Både organiserte cyberkriminelle og nasjonalstater ønsker å bruke det digitale domene til å utføre cyberangrep for økonomisk vinning eller for å ta kontroll over tredjeparts systemer. Bevissthet om de ulike truslene som finnes på internett er en forutsetning for å treffe riktige tiltak. Etter å ha fullført emnet skal studenten være i stand til å analysere trusselbildet og foreta egnede sikringstiltak på egen maskin, i hjemmenettverk og gi faglige råd i forhold til oppsett og teknologivalg for internetteksponerte systemer. Studenten skal ha oversikt over hvilke lover og forskrifter som gjelder for bruk av datamaskiner til lagring, prosessering og formidling av data, herunder personvern og opphavsrett. Studenten skal også ha innsikt i hvordan brukerbevissthet og brukeropplæring spiller en viktig rolle i informasjonssikkerhet.</p>\n","isDescriptionOutdated":false,"order":22,"points":7.5,"year":1,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":null,"category":"obligatory"},{"code":"ØA1005","name":"Problemløsning i TEAM","description":"\n<p><strong>Problemløsning i TEAM</strong> - <strong>T</strong>verrfaglig, <strong>E</strong>ngasjerende, <strong>A</strong>rbeid i prosjekt, med <strong>M</strong>estring</p><p>Dette kurset tilbyr en tverrfaglig læringsopplevelse der studentene jobber i team for å håndtere virkelige utfordringer i skjæringspunktet mellom økonomi, innovasjon og teknologi. Gjennom en problembasert læringstilnærming (PBL) går studentene gjennom en strukturert prosess med problemdefinisjon, prosjektskisse, utvikling, evaluering og presentasjon.</p><p>Organisert i temabaserte camps, hver ledet av faglige eksperter, samarbeider studentene på tvers av fagbakgrunn for å analysere, undersøke og utvikle løsninger, forstått som funderte forslag, modeller, konsepter eller tiltak som kan bidra til bedre praksis, innovasjon eller bærekraftige endringer innenfor temaet de arbeider med. Roterende lederroller og strukturerte leveranser sikrer aktiv deltakelse og ansvarlighet gjennom hele prosjektet.</p><p>Kurset vektlegger teamarbeid, kritisk tenkning, problemløsning, ansvarlig innovasjon og evnen til å kommunisere komplekse ideer. Ved slutten av semesteret vil studentene ikke bare ha styrket sin teoretiske forståelse innenfor økonomi, innovasjon eller teknologi sine kjernefelt, men også tilegnet seg praktiske ferdigheter i prosjektledelse, relasjonsbygging, refleksjon og løsningsorientert samarbeid - noe som forbereder dem på å bidra meningsfullt til næringsliv og samfunn.</p>\n","isDescriptionOutdated":false,"order":41,"points":15,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Ordinært studieløp","isDefault":true},"category":"obligatory"},{"code":"UTV999BA30","name":"Utveksling","description":null,"isDescriptionOutdated":null,"order":1,"points":30,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Utveksling","isDefault":false},"category":"obligatory"},{"code":"VAL999-15V","name":"Valgemne eller praksis","description":null,"isDescriptionOutdated":null,"order":1,"points":15,"year":2,"semester":"second","isPrerequisite":false,"specialization":null,"studyOption":{"label":"Ordinært studieløp","isDefault":true},"category":"elective"}],"translations":{"studyOptions":"Valgmuligheter","elective":"Valgemne","specialization":"Studieretning","selectYear":"Velg år","openSubjectOverlay":"Åpne emneoverlegg","closeOverlay":"Lukk overlagg","genericErrorMessage":"Feil oppsto","totalStudyPointsFormat":"Totalt {points} studiepoeng","studyPointsFormat":"{points} studiepoeng","pointsUnit":"stp.","noSubjectsMessage":"Beklager, det er problemer med å laste inn innholdet for øyeblikket","prerequisites":"Forkunnskaper","goToSubject":"Les mer","loading":"Laster inn data","year":"år","semester":"semester","single":"ett","first":"første","second":"andre","third":"tredje","fourth":"fjerde","fifth":"femte"},"type":"view","id":"studiemodell","teaser":"Studiemodellen er et utdrag av programbeskrivelsen. Den gir deg en oversikt over obligatoriske emner og hvilke muligheter du har for praksis, utveksling og spesialisering. Bachelorgraden går over tre studieår. Hvert studieår er delt opp i to semestre. Vi tar forbehold om endringer.","settings":{"disableStudyModel":false,"disabledStudyModelHeading":"Informasjon om studiemodeller","disabledStudyModelMessage":{"value":"Studiemodellen er under arbeid og vil bli publisert så snart den er klar"}},"studyProgramLink":{"label":"Se programbeskrivelse","href":"/studieportal/fakultet-for-helse-og-teknologi/bachelorniva/bcs/bachelor-i-cybersikkerhet/","external":false,"showIsExternal":true}};</script></div>
</div><div>
<div id="fcc53f4b"><section id="hva-kan-du-bli" class="cr4GKFNCqp2Yu1c2kbOA cqvKGYSQUOkDhbqS2bc7"><div class="Fov3KMlE7osNR74JI44t"><div class="Wf6h4ZdN2S9XvO6RoMCf"><h2 class="FrR9v_ssranAjR5kDzwF vw2qEzBLsG8dfPFKhCCL">Hva kan du bli?</h2><div class="eCTirCs_JIAXtZrCECpB"><div class="s4PUgF87xJpwYCH4qegZ"><div class="gOFfCOGgsoYfQDsrulwN Um_bsxrmr048dYBfonAO hfMRvjcJ6bvRCr56YbNA"><div class="KgSPjnWKLeiPJ0FM0dQy RichtextContent RichtextContent--dark">Fremtidens jobbmarked ser lyst for for deg med kompetanse innen cybersikkerhet. Tidligere studenter har f&aring;tt relevante stillinger i bedrifter og organisasjoner som:</div><div><ul class="qkBUwgQDLi4p_RY0dWv6"><li><a href="https://www.forsvaret.no/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Forsvaret</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></li><li><a href="https://www.politiet.no/om-politiet/organisasjonen/sarorganene/kripos/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Kripos</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></li><li><a href="https://www.politiet.no/om-politiet/organisasjonen/sarorganene/pit/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Politiets IT-enhet</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></li><li><a href="https://www.pwc.no/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">PwC Norge</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></li><li><a href="https://www.skatteetaten.no/person/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Skatteetaten</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></li><li><a href="https://www.statnett.no/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Statnett</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></li><li><a href="https://www.soprasteria.no/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Sopra Steria</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></li><li><a href="https://www.tietoevry.com/no/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Tietoevry</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></li><li><a href="https://www.udi.no/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi Ij1dPkiPlaTD3uo6se1x edl31Fo4Oj6a7JbI7uJy IUuKHagAD1zfQdGeQEQh GMFlTxWOaPaSRlpWaL1Q" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi LAgZMr1fyvbOVgj7_PsL"><span class="MUBYvmBUPBzTdaNqh8X9">Utlendingsdirektoratet</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></li></ul><button title="Flere karrieremuligheter " aria-expanded="false" aria-controls="overlay_3565" aria-haspopup="dialog" type="button" class="NtmtjnwY8FdZxOUBkRwT RLuLMRDzYQ3XgZOh0LH6"><span class="visuallyHidden">Flere karrieremuligheter </span><span class="SvgIcon qRe66TfUwTfvEUQmJRJf"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-plus-circle"></use></svg></span></button><div style="display:none"><div class="QhFNlQLYGSl_aaOQtwwl" style="display:none" id="overlay_3565" role="dialog" aria-modal="true" aria-labelledby="overlayLabel_3566"><div class="lAKZZQugItoUqTlu8DRV"></div><div tabindex="-1"><div class="po18YUo5kkFOZqsiTnKR"><div class="eOdUoHIpgD7QwsaR1kGn"><button title="Lukk overlagg" type="button" class="NtmtjnwY8FdZxOUBkRwT sZg2Vy20YIsqTNv9TcIX"><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-circle-close"></use></svg></span><span class="visuallyHidden">Lukk overlagg</span></button></div><div class="fyYha0cYX3WzsCpMkhUB"><span id="overlayLabel_3566" class="visuallyHidden">Flere karrieremuligheter </span><h3 class="QyHwrlI4c0dLFrsS3esJ">Flere karrieremuligheter </h3><div class="RichtextContent RichtextContent--dark"><a href="https://www.nho.no/contentassets/07d0f9c814094babae078a1cb397429f/nifu-rapport2023-1.pdf" target="_blank" rel="noopener">NHOs kompetansebarometer 2022</a> viser at halvparten av bedriftene som har et udekket IKT-behov trenger folk med kompetanse p&aring; digital sikkerhet.&nbsp;</p>
<p>Med en utdanning i cybersikkerhet &aring;pner det seg et bredt spekter av relevante jobber. Du kan f&aring; jobber som:&nbsp;&nbsp;</p>
<ul class="Richtext__ul">
<li><strong>Analytiker</strong><span>&nbsp;</span>p&aring; Security Operations Center (SOC) med arbeidsoppgaver som &aring; utarbeide responsstrategier, trusseletterretning samt planlegging, gjennomf&oslash;ring og analysering av avvikende hendelser i infrastruktur.&nbsp;</li>
<li><strong>Hendelsesh&aring;ndterer og etterforsker</strong>, blant annet med ansvar for &aring; h&aring;ndtere sikkerhetsbrudd for raskt &aring; gjenvinne kontroll over en situasjon, samt &aring; sikre, analysere og etterforske digital kriminialitet.</li>
<li><strong>Driftstekniker</strong><span>&nbsp;</span>med ansvar for &aring; sikre stabile og gode sikkerhetsprodukter og -l&oslash;sninger p&aring; arbeidsplassen. &nbsp;</li>
<li><strong>Etisk hacker</strong><span>&nbsp;</span>eller penetrasjonstester med ansvar for &aring; identifisere sikkerhetshull og systemsvakheter, samt peke p&aring; hvor bedriften m&aring; iverksette tiltak for &aring; styrke sikkerheten.&nbsp;</li>
</ul></div></div></div></div></div></div></div></div></div><div class="vtkkbZPYpUDSiSOigevy"><div role="none" class="lWrPSruci5J1Pct9eV_o g60OJyzhnb0WaPJax3FT q5hkvvHSqXSnC8c0ON1s" tabindex="-1"><div class="MgyILGUp5ZXfXioJozjl"><div class="slJnKPGAAIKofsQwQBjL vPKYJ9xnnqorRitmkm3i Rk4XtUg82KBc97x_ZRFE bdvXUDwmjTRBe1N3RN_T"><picture><source sizes="(min-width: 1024px) 1136px, (min-width: 768px) 768px, 100vw" srcSet="/contentassets/d79def7392874399b0f67b11effbbb56/microsoftteams-image-1.jpeg?width=375 375w, /contentassets/d79def7392874399b0f67b11effbbb56/microsoftteams-image-1.jpeg?width=768 768w, /contentassets/d79def7392874399b0f67b11effbbb56/microsoftteams-image-1.jpeg?width=1136 1136w"/><img src="/contentassets/d79def7392874399b0f67b11effbbb56/microsoftteams-image-1.jpeg?width=1136" alt="Stian Kvålshagen avbildet utenfor Kristiania." style="object-position:62% 28.000000000000004%" loading="lazy"/></picture></div></div><div class="yMY00st3GGEGBJtEvQ73"><h3 class="c_Td561uP1rvuAN4AIF0"><a href="/aktuelt/2026/04/stian-far-betalt-for-a-tenke-som-en-hacker/" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><div>Stian f&aring;r betalt for &aring; tenke som en hacker</div></div></a></h3><div class="jEZzvXBk9gXoSYGacZ1a"><div class="upokinR30SLCCFTdntv0">Stian Kvålshagen jobber med å beskytte systemer, lede team og bygge løsninger som faktisk blir brukt. </div><span class="SvgIcon PVmLk9OPaS3teC0Olseh"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-s"></use></svg></span></div></div></div></div></div></div></div></section><script>(window.__reactProps = window.__reactProps || {})['fcc53f4b-json'] = {"id":"hva-kan-du-bli","heading":{"value":"Hva kan du bli?"},"teaser":{"value":"Fremtidens jobbmarked ser lyst for for deg med kompetanse innen cybersikkerhet. Tidligere studenter har f&aring;tt relevante stillinger i bedrifter og organisasjoner som:"},"linkList":[{"label":"Forsvaret","href":"https://www.forsvaret.no/","external":true,"showIsExternal":true},{"label":"Kripos","href":"https://www.politiet.no/om-politiet/organisasjonen/sarorganene/kripos/","external":true,"showIsExternal":true},{"label":"Politiets IT-enhet","href":"https://www.politiet.no/om-politiet/organisasjonen/sarorganene/pit/","external":true,"showIsExternal":true},{"label":"PwC Norge","href":"https://www.pwc.no/","external":true,"showIsExternal":true},{"label":"Skatteetaten","href":"https://www.skatteetaten.no/person/","external":true,"showIsExternal":true},{"label":"Statnett","href":"https://www.statnett.no/","external":true,"showIsExternal":true},{"label":"Sopra Steria","href":"https://www.soprasteria.no/","external":true,"showIsExternal":true},{"label":"Tietoevry","href":"https://www.tietoevry.com/no/","external":true,"showIsExternal":true},{"label":"Utlendingsdirektoratet","href":"https://www.udi.no/","external":true,"showIsExternal":true}],"featuredArticle":{"title":{"value":"Stian f&aring;r betalt for &aring; tenke som en hacker"},"description":{"value":"Stian Kvålshagen jobber med å beskytte systemer, lede team og bygge løsninger som faktisk blir brukt. "},"url":"/aktuelt/2026/04/stian-far-betalt-for-a-tenke-som-en-hacker/","image":{"author":"Jonatan Arvid Quintero","caption":"Stian gikk fra å drive bakeri til å bygge og sikre digitale løsninger. I dag gjør han komplekse sikkerhetsutfordringer forståelige og brukbare for andre.","url":"/contentassets/d79def7392874399b0f67b11effbbb56/microsoftteams-image-1.jpeg","alt":"Stian Kvålshagen avbildet utenfor Kristiania.","focalPoint":{"x":0.62,"y":0.28},"lazyLoading":true}},"blockVariant":"default","overlayButtonLabel":"Flere karrieremuligheter ","overlayHeading":"Flere karrieremuligheter ","overlayContent":{"value":"<a href=\"https://www.nho.no/contentassets/07d0f9c814094babae078a1cb397429f/nifu-rapport2023-1.pdf\" target=\"_blank\" rel=\"noopener\">NHOs kompetansebarometer 2022</a> viser at halvparten av bedriftene som har et udekket IKT-behov trenger folk med kompetanse p&aring; digital sikkerhet.&nbsp;</p>\n<p>Med en utdanning i cybersikkerhet &aring;pner det seg et bredt spekter av relevante jobber. Du kan f&aring; jobber som:&nbsp;&nbsp;</p>\n<ul class=\"Richtext__ul\">\n<li><strong>Analytiker</strong><span>&nbsp;</span>p&aring; Security Operations Center (SOC) med arbeidsoppgaver som &aring; utarbeide responsstrategier, trusseletterretning samt planlegging, gjennomf&oslash;ring og analysering av avvikende hendelser i infrastruktur.&nbsp;</li>\n<li><strong>Hendelsesh&aring;ndterer og etterforsker</strong>, blant annet med ansvar for &aring; h&aring;ndtere sikkerhetsbrudd for raskt &aring; gjenvinne kontroll over en situasjon, samt &aring; sikre, analysere og etterforske digital kriminialitet.</li>\n<li><strong>Driftstekniker</strong><span>&nbsp;</span>med ansvar for &aring; sikre stabile og gode sikkerhetsprodukter og -l&oslash;sninger p&aring; arbeidsplassen. &nbsp;</li>\n<li><strong>Etisk hacker</strong><span>&nbsp;</span>eller penetrasjonstester med ansvar for &aring; identifisere sikkerhetshull og systemsvakheter, samt peke p&aring; hvor bedriften m&aring; iverksette tiltak for &aring; styrke sikkerheten.&nbsp;</li>\n</ul>"},"overlayCloseLabel":"Lukk overlagg"};</script></div>
