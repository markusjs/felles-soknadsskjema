px) 90vw, (min-width: 768px) 45vw" srcSet="/contentassets/12e84b5001de4282a03655be8249657d/studiesider_ma_design-4.jpg?width=260 260w, /contentassets/12e84b5001de4282a03655be8249657d/studiesider_ma_design-4.jpg?width=340 340w, /contentassets/12e84b5001de4282a03655be8249657d/studiesider_ma_design-4.jpg?width=410 410w, /contentassets/12e84b5001de4282a03655be8249657d/studiesider_ma_design-4.jpg?width=560 560w, /contentassets/12e84b5001de4282a03655be8249657d/studiesider_ma_design-4.jpg?width=675 675w, /contentassets/12e84b5001de4282a03655be8249657d/studiesider_ma_design-4.jpg?width=710 710w, /contentassets/12e84b5001de4282a03655be8249657d/studiesider_ma_design-4.jpg?width=810 810w, /contentassets/12e84b5001de4282a03655be8249657d/studiesider_ma_design-4.jpg?width=870 870w"/><img src="/contentassets/12e84b5001de4282a03655be8249657d/studiesider_ma_design-4.jpg?width=675" alt="Hender som jobber med bøker." loading="lazy"/></picture></div><div class="Pmg09aY_TfqRZuMur5zk QJzMpJy28o1qXfXyEydw"></div><div class="sPTS1rMd8cfKEfPWR1Ls"><div class="SkW9abafH6X8KqtaoReu"><div class="BNAfc54g0J03ydAhK9Tl hvg8Co5pgJCzMwuorQ60 st07ccj5wNaeXB9Y4Dqw"></div></div></div></div></li><li class="BJhDL1ivRTBTTz1M1jNJ"><div role="link" tabindex="-1" class="cebw0X3OhBm1h7iQsiYf EsE9RThZNAFgiUOaDSqu BQNFUP7onZ3DlFRnNk81 mPz0mRIinDxP5lStpF2M vXp_Fkav2sqPTRRNnREp"><div class="slJnKPGAAIKofsQwQBjL vPKYJ9xnnqorRitmkm3i"><picture><source sizes="(max-width: 767px) 90vw, (min-width: 768px) 45vw" srcSet="/contentassets/827cddf7650742bcb07d998c798c3e35/fasiliteter-sadm.jpg?width=260 260w, /contentassets/827cddf7650742bcb07d998c798c3e35/fasiliteter-sadm.jpg?width=340 340w, /contentassets/827cddf7650742bcb07d998c798c3e35/fasiliteter-sadm.jpg?width=410 410w, /contentassets/827cddf7650742bcb07d998c798c3e35/fasiliteter-sadm.jpg?width=560 560w, /contentassets/827cddf7650742bcb07d998c798c3e35/fasiliteter-sadm.jpg?width=675 675w, /contentassets/827cddf7650742bcb07d998c798c3e35/fasiliteter-sadm.jpg?width=710 710w, /contentassets/827cddf7650742bcb07d998c798c3e35/fasiliteter-sadm.jpg?width=810 810w, /contentassets/827cddf7650742bcb07d998c798c3e35/fasiliteter-sadm.jpg?width=870 870w"/><img src="/contentassets/827cddf7650742bcb07d998c798c3e35/fasiliteter-sadm.jpg?width=675" alt="Bildelenke til video på Vimeo." style="object-position:50% 22%" loading="lazy"/></picture></div><div class="Pmg09aY_TfqRZuMur5zk"></div><div class="sPTS1rMd8cfKEfPWR1Ls"><span class="SvgIcon bb8Dm_nUe5QNENNcsbAA"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-film"></use></svg></span><div class="SkW9abafH6X8KqtaoReu"><div class="BNAfc54g0J03ydAhK9Tl JBFSDJXW2ok2RfS0fEqa"><div class="KVcXmhm9VNM86o03E7VR"><a href="https://vimeo.com/782920639" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi qZPLN8RAtOldsdgz0jVh" target="_blank" rel="noopener noreferrer" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><div class="y92h1QcKH9ifsM8elUj8">Welcome to Kristiania</div></div></a><span class="SvgIcon nf4v32IKEcrP1llPTS_m"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-play-circle"></use></svg></span></div></div></div></div></div></li><li class="BJhDL1ivRTBTTz1M1jNJ"><div class="qYi24uBym7aZ9bV1Dw1c ZiV_pbi2dmr8WWmMB29l"><a href="https://www.artsdesignmedia.no/" class="XezMfDvRba8HKhHr79wm UssovIOXlEuxxbOHY4c4 yEK9biWpMxeKit4W3SEn HIBx2TMQpGodNFRbYUAk gnwHhMF21kTUQhGmA_GV I0dQ9KoNo8oj51pfedVE cJMgeHEGyMPOPNoeRPfY MRlQkiu1Mdteq_EefGH9" target="_blank" rel="noopener noreferrer" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><span>Campus life</span><span class="SvgIcon"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-arrow-right"></use></svg></span></div></a></div></li></ul></div></div></section><script>(window.__reactProps = window.__reactProps || {})['6d534607-json'] = {"id":"campus-life","title":{"value":"Campus life"},"teaser":{"value":"<span>We dare to claim that Kristiania has one of the best student environments in the country. We actively work to ensure that everyone f