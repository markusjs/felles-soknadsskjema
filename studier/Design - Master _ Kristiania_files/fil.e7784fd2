svg></span><div class="SkW9abafH6X8KqtaoReu"><div class="BNAfc54g0J03ydAhK9Tl hvg8Co5pgJCzMwuorQ60"><div class="KVcXmhm9VNM86o03E7VR"><a href="https://player.gobistories.com/pbrjo" class="XezMfDvRba8HKhHr79wm B5Z4_vbRcPt248iwmQXi qZPLN8RAtOldsdgz0jVh" target="_blank" rel="noopener noreferrer" data-owned=""><div class="DdPYOTimBd1c8zDeoFgi"><div class="y92h1QcKH9ifsM8elUj8">Academic poster</div></div></a><span class="SvgIcon nf4v32IKEcrP1llPTS_m"><svg><use xlink:href="/dist/iconsSprite.ff403ecca.svg#sprite-play-circle"></use></svg></span></div></div></div></div></div></li><li class="BJhDL1ivRTBTTz1M1jNJ"><div role="link" tabindex="-1" class="cebw0X3OhBm1h7iQsiYf nVCNJ_7Vd2IBYiFJKg1X BQNFUP7onZ3DlFRnNk81 mPz0mRIinDxP5lStpF2M vXp_Fkav2sqPTRRNnREp HuwFiB0Vkd6mPM9EtyRn"><div class="slJnKPGAAIKofsQwQBjL vPKYJ9xnnqorRitmkm3i"><picture><source sizes="(max-width: 767px) 90vw, (min-width: 768px) 45vw" srcSet="/contentassets/a3773465e2d6408b87fc3a6181584258/instagram-logo-kristiania.jpg?width=260 260w, /contentassets/a3773465e2d6408b87fc3a6181584258/instagram-logo-kristiania.jpg?width=340 340w, /contentassets/a3773465e2d6408b87fc3a6181584258/instagram-logo-kristiania.jpg?width=410 410w, /contentassets/a3773465e2d6408b87fc3a6181584258/instagram-logo-kristiania.jpg?width=560 560w, /contentassets/a3773465e2d6408b87fc3a6181584258/instagram-logo-kristiania.jpg?width=675 675w, /contentassets/a3773465e2d6408b87fc3a6181584258/instagram-logo-kristiania.jpg?width=710 710w, /contentassets/a3773465e2d6408b87fc3a6181584258/instagram-logo-kristiania.jpg?width=810 810w, /contentassets/a3773465e2d6408b87fc3a6181584258/instagram-logo-kristiania.jpg?width=870 870w"/><img src="/contentassets/a3773465e2d6408b87fc3a6181584258/instagram-logo-kristiania.jpg?width=675" alt="Bildelenke til Instagram." style="object-position:50% 38%" loading="lazy"/></picture></div><div class="Pmg09aY_TfqRZuMur5zk QJzMpJy28o1qXfXyEydw"></div><div class="sPTS1rMd8cfKEfPWR1Ls"><div class="SkW9abafH6X8KqtaoReu"><div class