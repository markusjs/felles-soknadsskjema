ecca.svg#sprite-arrow-right"></use></svg></span></button></div></div></div><script>(window.__reactProps = window.__reactProps || {})['589e312b-json'] = {"sections":[{"id":"key-information","label":"Key information"},{"id":"learning-outcomes","label":"Learning Outcomes"},{"id":"study-model","label":"Study model "},{"id":"career-opportunities","label":"Career Opportunities"},{"id":"meet-the-faculty","label":"Meet the faculty"},{"id":"meet-the-program-director","label":"Meet the program director"},{"id":"this-is-the-application-process","label":"The application process"},{"id":"any-questions","label":"Any questions?"},{"id":"frequently-asked-questions","label":"Frequently Asked Questions"}],"translations":{"navigationLabel":"In-page navigation","apply":"Apply","home":"Home"}};</script></div>
