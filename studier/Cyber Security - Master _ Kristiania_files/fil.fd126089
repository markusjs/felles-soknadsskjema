e\"\n   Name=\"Smart Link\"/>\n </w:LatentStyles>\n</xml><![endif]--> <!-- [if gte mso 10]>\n<style>\n /* Style Definitions */\n table.MsoNormalTable\n\t{mso-style-name:\"Vanlig tabell\";\n\tmso-tstyle-rowband-size:0;\n\tmso-tstyle-colband-size:0;\n\tmso-style-noshow:yes;\n\tmso-style-priority:99;\n\tmso-style-parent:\"\";\n\tmso-padding-alt:0cm 5.4pt 0cm 5.4pt;\n\tmso-para-margin-top:0cm;\n\tmso-para-margin-right:0cm;\n\tmso-para-margin-bottom:8.0pt;\n\tmso-para-margin-left:0cm;\n\tline-height:107%;\n\tmso-pagination:widow-orphan;\n\tfont-size:11.0pt;\n\tfont-family:\"Calibri\",sans-serif;\n\tmso-ascii-font-family:Calibri;\n\tmso-ascii-theme-font:minor-latin;\n\tmso-hansi-font-family:Calibri;\n\tmso-hansi-theme-font:minor-latin;\n\tmso-bidi-font-family:\"Times New Roman\";\n\tmso-bidi-theme-font:minor-bidi;\n\tmso-fareast-language:EN-US;}\n</style>\n<![endif]--> <!--StartFragment--></p>\n<p><strong>Denmark</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/danmark/#Zealand\">Zealand Sj&aelig;llands Erhvervsakademi</a></li>\n</ul>\n<p><strong>Finland&nbsp;</strong></p>\n<ul class=\"Richtext__ul\">\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"2\" data-aria-level=\"1\"><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/finland/#Arcada\"><span data-contrast=\"none\">Arcada University of Applied Sciences</span></a>, Helsinki<span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<p><strong>Great Britain</strong></p>\n<ul class=\"Richtext__ul\">\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"3\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/storbritannia/#Kingston\"><span data-contrast=\"none\">Kingston University</span></a>, London</li>\n</ul>\n<p><strong>Pakistan</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/pakistan/\">Superior University</a>, Lahore</li>\n</ul>\n<p><strong>Poland</strong></p>\n<ul class=\"Richtext__ul\">\n<li><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/polen/?language=no#WSB\">Akademia WSB</a>, <span>Dąbrowa</span><span>&nbsp;</span><span>G&oacute;rnicza</span></li>\n</ul>\n<p><strong>South Korea</strong></p>\n<ul class=\"Richtext__ul\">\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/sor-korea/#seoul\"><span data-contrast=\"none\">Seoul National University of Science and Technology</span></a><span data-ccp-props=\"{}\">&nbsp;</span></li>\n</ul>\n<p><strong>Thailand&nbsp;</strong></p>\n<ul class=\"Richtext__ul\">\n<li data-leveltext=\"\" data-font=\"Symbol\" data-listid=\"4\" data-list-defn-props=\"{&quot;335552541&quot;:1,&quot;335559684&quot;:-2,&quot;335559685&quot;:720,&quot;335559991&quot;:360,&quot;469769226&quot;:&quot;Symbol&quot;,&quot;469769242&quot;:[8226],&quot;469777803&quot;:&quot;left&quot;,&quot;469777804&quot;:&quot;&quot;,&quot;469777815&quot;:&quot;hybridMultilevel&quot;}\" aria-setsize=\"-1\" data-aria-posinset=\"1\" data-aria-level=\"1\"><a href=\"/for-studenter/studier-i-utlandet/internasjonale-samarbeidspartnere/thailand/\"><span data-contrast=\"auto\">Assumption University</span></a>, Bangkok</li>\n</ul>\n<p><span>&nbsp;</span></p>\n<p><!--EndFragment-->"},"callToAction":null,"linkAsButton":true},{"id":"97160","displayName":"What kind of equipment do I need?","introText":{"value":"This programme does not impose any specific requirements on equipment."},"callToAction":null,"linkAsButton":false},{"id":"97161","displayName":"How’s campus life?","introText":{"value":"We dare to say that Kristiania has among the country's best student environments. We work actively to make everyone feel that they fit in, regardless of background, and offer a wide range of activities, events, student associations and social meeting places. In addition, we ensure small classes, close follow-up and interdisciplinary projects, which helps to strengthen the cohesion and make everyone feel included."},"callToAction":null,"linkAsButton":false},{"id":"97162","displayName":"What can I study next?","introText":{"value":"The programme qualifies students for admission to doctoral programmes in several relevant subject areas."},"callToAction":null,"linkAsButton":false},{"id":"117236","displayName":"* Price outside EU/EEA","introText":{"value":"<span>Kristiania University, along with other universities in Norway, faced changes in tuition policies following the legislation passed by the Norwegian government on June 16, 2023. The new regulations required all universities, including Kristiania University, to implement tuition fees for new international students originating from outside the EU/EEA/Switzerland.</span></p>\n<p><a href=\"/en/study-at-kristiania/price-overview/\"><span>You can read more about tuition fees for applicants outside EU/EEA here.&nbsp;</span></a>"},"callToAction":null,"linkAsButton":false}]};</script></div>
</div></div>
    </div>
</article>

    </main>
